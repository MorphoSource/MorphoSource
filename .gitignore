# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle
/?
/vendor/bundle

/vendor/bundle

/?
/.claude
/.config
/.npm

# Ignore the default SQLite database.
/db/*.sqlite3
/db/*.sqlite3-journal

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

/node_modules
/yarn-error.log

/storage

.byebug_history
.env
.irb_history

.claude
storage/

# Ignore application configuration
/config/application.yml

# Browse Everything providers config
/config/browse_everything_providers.yml

# ---------------------------------------------------
# Below are copied from RDR. Might need them later
# ---------------------------------------------------

# Pre-compiled assets
/public/assets

# Export files
/public/export_files

/public/system
/public/terms
/public/uploads

/public/uv/*
!/public/uv/README.md

# Batch import config
/config/batch_import.yml

# FITS log file
/fits.log

.DS_Store
._*
/bin

# ---------------------------------------------------
# MorphoSource specific changes
# ---------------------------------------------------

/derivatives

#ignore banners and logos added to collections
/public/branding

# Local UniversalViewer clone/build cache used by bin/uv-install-local
/vendor/uv-local

# ---------------------------------------------------
# MorphoSource Python module changes
# ---------------------------------------------------

vendor/alembic/__pycache__/*
*.pyc

# ---------------------------------------------------
# Docker related rules
# ---------------------------------------------------

/vendor/docker/apache/certs/*
/vendor/docker/credentials.env

# For temporary local files (e.g., batch submission files) that should not be checked into repo
/docker_files/*

# ---------------------------------------------------
# Webpacker related rules
# ---------------------------------------------------

/public/packs
/public/packs-test
/node_modules
/yarn-error.log
yarn-debug.log*
.yarn-integrity

# ---------------------------------------------------
# Valkyrie related rules
# ---------------------------------------------------

storage/
uploads/