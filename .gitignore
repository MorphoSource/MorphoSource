# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore the default SQLite database.
/db/*.sqlite3
/db/*.sqlite3-journal

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

/node_modules
/yarn-error.log

.byebug_history
.env

# Ignore application configuration
/config/application.yml

# Google Analytics config
/config/analytics.yml

# Browse Everything providers config
/config/browse_everything_providers.yml

# ---------------------------------------------------
# Below are copied from RDR. Might need them later
# ---------------------------------------------------

# Ignore role_map.yml
/config/role_map.yml

# Pre-compiled assets
/public/assets

# Export files
/public/export_files

/public/system
/public/uploads

# Batch import config
/config/batch_import.yml

# Resque pool config
/config/resque-pool.yml

# FITS log file
/fits.log

.DS_Store
._*
/bin

# ---------------------------------------------------
# MorphoSource specific changes
# ---------------------------------------------------

/derivatives

#ignore banners and logos added to collections 
/public/branding

# ---------------------------------------------------
# MorphoSource Python module changes
# ---------------------------------------------------

vendor/alembic/__pycache__/*
*.pyc

# ---------------------------------------------------
# Docker related rules
# ---------------------------------------------------

/vendor/docker/apache/certs/*
/vendor/docker/credentials.env
