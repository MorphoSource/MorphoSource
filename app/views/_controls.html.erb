<div class="controls">
  <nav class="navbar navbar-default navbar-static-top" role="navigation" aria-label="Root Menu">
    <div class="container-fluid">
      <div class="row no-padding" style="display:flex; justify-content: space-between; flex-wrap: wrap;">
        <div class="nav-left">
          <ul class="nav navbar-nav col-sm-12">
            <li class="dropdown">
              <%= link_to hyrax.root_path, role: 'button', data: { toggle: 'dropdown' }, aria: { haspopup: true, expanded: false, controls: "about-links" } do %>
                <span><%= t("hyrax.controls.about")%></span>
                <span class="caret"></span>
              <% end %>
              <ul id="about-links" class="dropdown-menu dropdown-menu-left" role="menu">
                <li><%= link_to t("docs.about.title"),
                  Rails.application.routes.url_helpers.about_path,
                  aria: current_page?(Rails.application.routes.url_helpers.about_path) ? {current: 'page'} : nil
                %></li>
                <li class="divider"></li>
                <li><%= link_to t("docs.mission.title"),
                  Rails.application.routes.url_helpers.mission_path,
                  aria: current_page?(Rails.application.routes.url_helpers.mission_path) ? {current: 'page'} : nil
                %></li>
              </ul>
            </li>
            <%= render partial: "control", locals: { links_yml: Hyrax.config.header_community, label: "community" } %>
            <%= render partial: "control", locals: { links_yml: Hyrax.config.header_docs, label: "docs" } %>
            <%= render partial: "control", locals: { links_yml: Hyrax.config.header_resources, label: "resources" } %>
          </ul><!-- /.nav -->
        </div>
        <div class="nav-right">
          <li style="list-style-type: none;">
            <div class="donate-button-wrapper">
              <%= render 'donate_button' %>
            </div>
          </li>
        </div>
      </div>
    </div>
  </nav><!-- /.navbar -->
</div>