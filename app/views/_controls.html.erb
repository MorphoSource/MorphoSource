<% docs_paths = [
  Rails.application.routes.url_helpers.guide_docs_path, 
  Rails.application.routes.url_helpers.glossary_docs_path, 
  Rails.application.routes.url_helpers.contributors_docs_path,
  Rails.application.routes.url_helpers.citation_docs_path
] %>
<% resources_paths = [
  Rails.application.routes.url_helpers.api_docs_path,
  Rails.application.routes.url_helpers.rss_docs_path
] %>
<div class="controls">
  <nav class="navbar navbar-default navbar-static-top" role="navigation" aria-label="Root Menu">
    <div class="container-fluid">
      <div class="row no-vertical-padding">
        <ul class="nav navbar-nav col-sm-12">
          <li>
            <%= link_to t(:'hyrax.controls.about'), Rails.application.routes.url_helpers.about_docs_path, aria: current_page?(Rails.application.routes.url_helpers.about_docs_path) ? {current: 'page'} : nil %>
          </li>
          <li class="dropdown">
            <%= link_to hyrax.root_path, role: 'button', data: { toggle: 'dropdown' }, aria: { haspopup: true, expanded: false, controls: 'docs-links' } do %>
              <span><%= t('hyrax.controls.docs.title')%></span>
              <span class="caret"></span>
            <% end %>
            <ul id="docs-links" class="dropdown-menu dropdown-menu-right" role="menu">
              <li><%= link_to t("hyrax.controls.docs.guide"), Rails.application.routes.url_helpers.guide_docs_path %></li>
              <li class="divider"></li>
              <li><%= link_to t("hyrax.controls.resources.glossary"), Rails.application.routes.url_helpers.glossary_docs_path %></li>
              <li class="divider"></li>
              <li><%= link_to t("hyrax.controls.resources.contributors"), Rails.application.routes.url_helpers.contributors_docs_path %></li>
              <li class="divider"></li>
              <li><%= link_to t("hyrax.controls.resources.citation"), Rails.application.routes.url_helpers.citation_docs_path %></li>
            </ul>
          </li>
          <li class="dropdown">
            <%= link_to hyrax.root_path, role: 'button', data: { toggle: 'dropdown' }, aria: { haspopup: true, expanded: false, controls: 'resource-links' } do %>
              <span><%= t('hyrax.controls.resources.title')%></span>
              <span class="caret"></span>
            <% end %>
            <ul id="resource-links" class="dropdown-menu dropdown-menu-right" role="menu">
              <li><%= link_to t("hyrax.controls.resources.api"), Rails.application.routes.url_helpers.api_docs_path %></li>
              <li class="divider"></li>
              <li><%= link_to t("hyrax.controls.resources.rss"), Rails.application.routes.url_helpers.rss_docs_path %></li>
            </ul>
          </li>
        </ul><!-- /.nav -->
      </div>
    </div>
  </nav><!-- /.navbar -->
</div>