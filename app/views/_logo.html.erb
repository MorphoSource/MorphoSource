<% is_core_site = Hyrax.config.site_title == Hyrax.config.default_site_title %>
<div id="logo" class="navbar-brand" style="display: flex; align-items: center;">
  <div style="margin-right: 5px">
    <a href="<%= hyrax.root_path %>" data-no-turbolink="true">
      <span style="<%= !is_core_site ? 'top: -8px;' : '' %>">
        <%= image_tag(Hyrax.config.logo_image, size: '40') %>
      </span>
    </a>
  </div>
  <div class="<%= controller_name.downcase.include?("catalog") ? "" : "collapse navbar-collapse" %>">
    <a href="<%= hyrax.root_path %>" data-no-turbolink="true" style="color: unset; text-decoration: none;">
      <span class="organization_name" style="<%= !is_core_site ? 'display: block;' : '' %>">
        <%= application_name %>
      </span>
    </a>
    <span style="font-size: small; <%= !is_core_site ? 'display: block;' : 'display: none;' %>">
      <a href="https://www.morphosource.org" data-no-turbolink="true" style="color: unset;">By MorphoSource</a>
    </span>
  </div>
</div>
