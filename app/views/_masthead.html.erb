<% # render sitewide banner above masthead if enabled %>
<%= render partial: 'sitewide_banner' %>

<header aria-label="header">
  <nav id="masthead" class="navbar navbar-dark bg-dark navbar-expand-md" role="navigation" aria-label="masthead">
    <h1 class="sr-only"><%= application_name %></h1>
    <div class="container-fluid flex-grow-1">
      <div class="col-6 px-3 p-md-0 logo">
        <%= render '/logo' %>
      </div>

      <div class="col-2 col-md-3 text-right ml-auto navbar-toggler" style="border: none;">
        <!-- mobile hamburger menu -->
        <button type="button" class="navbar-toggler" data-toggle="collapse" data-target="#top-navbar-collapse" aria-expanded="false" style="color: white;">
          <span class="sr-only">Toggle navigation</span>
          <i class="fas fa-bars"></i>
        </button>
      </div>

      <div class="col-12 col-md-3 ml-auto px-3 px-md-0 collapse navbar-collapse" id="top-navbar-collapse">
          <%= content_for?(:user_util_links) ? yield(:user_util_links) : render('/user_util_links') %>
      </div>
    </div>
  </nav>
</header>
