<% # render sitewide banner above masthead if enabled %>
<%= render partial: 'sitewide_banner' %>

<header aria-label="header">
  <nav id="masthead" class="navbar navbar-inverse navbar-static-top" role="navigation" aria-label="masthead">
    <h1 class="sr-only"><%= application_name %></h1>
    <div class="container-fluid mr-sm-0 mr-md-3 pr-0 pr-md-3 flex-grow-1 d-block">
      <!-- Brand and toggle get grouped for better mobile display -->
      <div class="navbar-header mr-sm-0 mr-md-3 pr-0 pr-md-3 float-md-left">
        <button type="button" class="navbar-toggle collapsed d-md-none position-relative float-right bg-transparent" data-toggle="collapse" data-target="#top-navbar-collapse" aria-expanded="false">
          <span class="sr-only">Toggle navigation</span>
          <span class="icon-bar d-block bg-white rounded-sm"></span>
          <span class="icon-bar d-block bg-white rounded-sm"></span>
          <span class="icon-bar d-block bg-white rounded-sm"></span>
        </button>
        <%= render '/logo' %>
      </div>

      <div class="collapse navbar-collapse d-md-flex" id="top-navbar-collapse">
        <%= render '/user_util_links' %>
      </div>
    </div>
  </nav>
</header>
