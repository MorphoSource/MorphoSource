<% # render sitewide banner above masthead if enabled %>
<%= render partial: 'sitewide_banner' %>

<header>
  <nav id="masthead" class="navbar navbar-dark bg-dark navbar-expand-md" role="navigation">
    <div class="container" style="color:white">
      <!-- Brand and toggle get grouped for better mobile display -->
      <div class="col-12 col-md-3 text-center text-lg-left logo no-horizontal-padding">
        <%= render '/logo' %>
      </div>

      <% if !controller_name.downcase.include? "catalog" %>
        <div class="col-10 col-md-6">
          <%= content_for?(:search_form) ? yield(:search_form) : render('/catalog/search_form') %>
        </div>
      <% end %>

      <div class="col-2 col-md-3 text-right ml-auto no-horizontal-padding navbar-toggler" style="border: none;">
        <!-- mobile hamburger menu -->
        <button type="button" class="navbar-toggler" data-toggle="collapse" data-target="#top-navbar-collapse" aria-expanded="false" style="color: white;">
          <span class="sr-only">Toggle navigation</span>
          <i class="fas fa-bars"></i> 
        </button>
      </div>

      <div class="col-12 col-md-3 ml-auto no-horizontal-padding collapse navbar-collapse" id="top-navbar-collapse">
          <%= content_for?(:user_util_links) ? yield(:user_util_links) : render('/user_util_links') %>
      </div>
    </div>
  </nav>
</header>

<%= content_for(:navbar) %>
