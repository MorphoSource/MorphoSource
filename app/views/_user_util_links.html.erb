<div id="user_utility_links" class="nav navbar-nav nav navbar-nav navbar-right ml-auto mr-auto mr-md-0 justify-content-center justify-content-sm-end flex-row">
  <%#= render 'shared/locale_picker' if available_translations.size > 1 %>
  <div class="dropdown browse-links nav-item">
    <%= link_to hyrax.root_path, class: 'dropdown-toggle nav-link', role: 'button', data: { toggle: 'dropdown' }, aria: { haspopup: true, expanded: false, controls: 'browse-links' } do %>
      <span>Browse</span>
    <% end %>
    <div id="browse-links" class="dropdown-menu dropdown-menu-sm-end" style="margin-left: 10px; margin-right: 10px">
      <%= link_to t("hyrax.toolbar.browse.media_types_and_modalities"), main_app.browse_media_types_and_modalities_path, class: 'dropdown-item' %>
      <div class="dropdown-divider"></div>
      <%= link_to t("hyrax.toolbar.browse.physical_object_types"), main_app.browse_physical_object_types_path, class: 'dropdown-item' %>
      <div class="dropdown-divider"></div>
      <%= link_to t("hyrax.toolbar.browse.taxonomy"), main_app.browse_taxonomies_path, class: 'dropdown-item' %>
      <div class="dropdown-divider"></div>
      <%= link_to t("hyrax.toolbar.browse.projects"), main_app.browse_projects_path, class: 'dropdown-item' %>
      <div class="dropdown-divider"></div>
      <%= link_to t("hyrax.toolbar.browse.teams"), main_app.browse_teams_path, class: 'dropdown-item' %>
      <div class="dropdown-divider"></div>
      <%= link_to t("hyrax.toolbar.browse.organizations"), main_app.browse_organizations_path, class: 'dropdown-item' %>
    </div>
  </div><!-- /.btn-group -->

  <% if user_signed_in? %>

    <div class="nav-item notifications">
      <%= render_notifications(user: current_user) %>
    </div>

    <div class="nav-item">
      <%= link_to main_app.my_cart_path, class: 'nav-link' do %>
        <span class="fa fa-shopping-cart" aria-hidden="true"></span>
      <% end %>
    </div>

    <% has_become = session[:become_user] %>
    <div class="dropdown nav-item">
      <%= link_to hyrax.dashboard_profile_path(current_user), class: 'dropdown-toggle nav-link', role: 'button', data: { toggle: 'dropdown' }, aria: { haspopup: true, expanded: false, controls: 'user-util-links' } do %>
        <span class="sr-only"><%= t("hyrax.toolbar.profile.sr_action") %></span>
        <!-- span class="d-none d-sm-block">&nbsp;<%# = current_user.name %></span-->
        <span class="sr-only"> <%= t("hyrax.toolbar.profile.sr_target") %></span>
        <span class="fa <%= has_become ? "fas fa-user-cog" : "fa-user" %>" aria-hidden="true"></span>
      <% end %>
      <div id="user-util-links" class="dropdown-menu dropdown-menu-right">
        <% if has_become %>
          <div class="dropdown-item dropdown-header admin-message">Admin temporarily signed in as <%= current_user&.name || "unknown user" %>.</div>
          <div class="dropdown-divider"></div>
        <% end %>

        <%= link_to t("hyrax.toolbar.dashboard.menu"), hyrax.dashboard_path, class: 'dropdown-item' %>
        <div class="dropdown-divider"></div>
        <%= link_to t("hyrax.toolbar.profile.logout"), main_app.destroy_user_session_path, class: 'dropdown-item' %>
      </div>
    </div><!-- /.btn-group -->

  <% else %>

    <div class="nav-item">
      <%= link_to main_app.new_user_session_path, class: 'nav-link' do %>
        <i class="fas fa-sign-in-alt"></i> <%= t("hyrax.toolbar.profile.login") %>
      <% end %>
    </div>

  <% end %>
</div>
