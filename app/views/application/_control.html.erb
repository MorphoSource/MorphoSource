<% if links_yml.present? %>
  <div class="dropdown nav-item">
    <%= link_to hyrax.root_path, class: 'dropdown-toggle nav-link', role: 'button', data: { toggle: 'dropdown' }, aria: { haspopup: true, expanded: false, controls: "#{label}-links" } do %>
      <span><%= t("hyrax.controls.links.#{label}.title")%></span>
    <% end %>
    <div id="<%= label %>-links" class="dropdown-menu dropdown-menu-left" role="menu">
      <% links_yml.each_with_index do |link_yml, idx| %>
        <% if idx != 0 %>
          <div class="dropdown-divider"></div>
        <% end %>
        <%= link_to t(link_yml["label"]), link_yml["url"], class: 'dropdown-item' %>
      <% end %>
    </div> 
  </div>
<% end %>