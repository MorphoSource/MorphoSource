<% if links_yml.present? %>
  <div class="col-3">
    <div class="row no-gutters justify-content-center" style='padding-top: 0;'><span class='footer-label'><%= t("hyrax.controls.links.#{label}.title_footer") %></span></div>
    <% links_yml.each do |link_yml| %>
      <div class="row no-gutters justify-content-center footer-sublink"><%= link_to t(link_yml["label"]), link_yml["url"] %></div>
    <% end %>
  </div>
<% end %>