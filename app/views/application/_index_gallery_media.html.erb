<% byebug %>
<dl class="document-metadata dl-horizontal dl-invert">
  <dd>
    <%= link_to [main_app, document], target: :_blank do %>
      <div><%= document.id %></div>
    <% end %>
  </dd>
  <dd class="text-truncate"><%= document.part&.first || t("value_null.part") %></dd>
  <dd class="text-truncate-lines two-lines"><%= document["physical_object_title_ssim"]&.first %></dd>
  <dd class="text-truncate"><i><%= document["taxonomy_ssim"]&.first %></i></dd>
</dl>
