<div class="modal-dialog modal-dialog-centered">
  <div class="modal-content text-center" style="border: 10px #286090 solid;">
    <div class="modal-body">
      <h5 class="modal-title mb-3" style="margin-bottom: 20px !important; font-size: 22px !important;"><%= modal_title %></h5>
      <p class="modal-text" style="margin-bottom: 40px;"><%= modal_body %></p>
      <a href="/donate" class="btn btn-primary mb-3">Donate Now</a>
      <div style="width: 100%; display: flex; justify-content: center; align-items: center; gap: 30px;">
        <%= link_to "Already Donated", main_app.admin_modal_snooze_week_path, method: :post, remote: true, class: "already-donated d-block" %>
        <%= link_to "Maybe Later", main_app.admin_modal_snooze_day_path, method: :post, remote: true, class: "maybe-later d-block" %>
        <a href="#" class="no-thanks d-block text-danger">No Thanks</a>
      </div>
    </div>
  </div>
</div>