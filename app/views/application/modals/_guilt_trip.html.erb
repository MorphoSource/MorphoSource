<div class="modal-dialog modal-dialog-centered">
  <div class="modal-content text-center">
    <div class="modal-body">
      <h5 class="modal-title mb-3"><%= modal_title %></h5>
      <div class="modal-text">
        <%= guilt_trip_text&.html_safe %>
      </div>
      <div id="modal-donate-wrapper">
        <button type="button" class="btn btn-secondary not-now">Not Now</button>
        <a href=<%= donate_link %> class="btn btn-primary me-2">Donate Now</a>
      </div>
    </div>
  </div>
</div>


