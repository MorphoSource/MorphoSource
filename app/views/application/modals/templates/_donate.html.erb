<div class="modal-dialog modal-dialog-centered">
  <div class="modal-content text-center">
    <div class="modal-body">
      <h5 class="modal-title mb-3"><%= modal_title %></h5>
      <div class="modal-text">
        <%= modal_body&.html_safe %>
      </div>
      <a href=<%= donate_link %> class="btn btn-primary mb-3">Donate Now</a>
      <div class="modal-dismiss-options">
        <%= modal_snooze_button "Already Donated", modal.snooze_week_path, "already-donated btn btn-link p-0", preview: local_assigns[:preview] %>
        <%= modal_snooze_button "Maybe Later", modal.snooze_hour_path, "maybe-later btn btn-link p-0", preview: local_assigns[:preview] %>
        <button type="button" class="no-thanks btn btn-link p-0 text-danger">No Thanks</button>
      </div>
      <p class="snooze-error text-danger small mt-2 mb-0" role="alert" hidden>We couldn't snooze this message. Please refresh the page and try again.</p>
    </div>
  </div>
</div>