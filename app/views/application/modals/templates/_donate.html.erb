<div class="modal-dialog modal-dialog-centered">
  <div class="modal-content text-center">
    <div class="modal-body">
      <h5 class="modal-title mb-3"><%= modal_title %></h5>
      <div class="modal-text">
        <%= modal_body&.html_safe %>
      </div>
      <a href=<%= donate_link %> class="btn btn-primary mb-3">Donate Now</a>
      <div class="modal-dismiss-options">
        <%= button_to modal.snooze_week_path, remote: true, class: "already-donated btn btn-link p-0", form_class: "snooze-form" do %>Already Donated<% end %>
        <%= button_to modal.snooze_hour_path, remote: true, class: "maybe-later btn btn-link p-0", form_class: "snooze-form" do %>Maybe Later<% end %>
        <button type="button" class="no-thanks btn btn-link p-0 text-danger">No Thanks</button>
      </div>
    </div>
  </div>
</div>