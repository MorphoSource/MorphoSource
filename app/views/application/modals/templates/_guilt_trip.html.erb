<div class="modal-dialog modal-dialog-centered">
  <div class="modal-content text-center">
    <div class="modal-body">
      <h5 class="modal-title mb-3"><%= modal_title %></h5>
      <div class="modal-text">
        <%= modal_body&.html_safe %>
      </div>
      <a href=<%= donate_link %> class="btn btn-primary mb-3">Donate Now</a>
      <div id="modal-donate-wrapper">
        <%= link_to "Not Now", modal.snooze_day_path, method: :post, remote: true, class: "btn btn-secondary not-now" %>
      </div>
    </div>
  </div>
</div>


