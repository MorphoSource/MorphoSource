<% content_for :body_css_classes do %>showcase showcase-edit batch-submission<% end %>
<% provide :page_title, "Batch Submission || MorphoSource" %>

<h1>Batch Submission</h1>

<p>On this page you can create new batch submissions or monitor the status of your current batch submissions. Please read the <a href="#">documentation</a>.</p>

<% if job.present? %>
	<h2>Job Status</h2>
	<table class="table">
		<tr>
			<th>Job ID</th>
			<th>Status</th>
			<th>Created</th>
			<th>Exception</th>
		</tr>
		<tr>
			<td><%= job.main_job_id %></td>
			<td><%= job.status.capitalize %></td>
			<td><%= job.created_at %></td>
			<td><%= job.exceptions %></td>
		</tr>
	</table>
	<p>Only one batch submission job is allowed at a time.  Please contact MorphoSource team if you see any issue.</p>
<% end %>

<% if current_user.can_submit_new_batch_submission? %>
	<p><i class="fa fa-hand-point-right" aria-hidden="true"></i> <%= link_to "Create a new batch upload submission", main_app.new_batch_submission_path %></p>
<% end %>
