<% content_for :body_css_classes do %>showcase showcase-edit batch-submission batch-submission-dashboard<% end %>
<% provide :page_title, "Batch Submission || MorphoSource" %>

<h1>Batch Submission</h1>

<% content_for :flash %>

<% if flash.notice.nil? %>
	<p>On this page you can create a new batch submission or monitor the status of your current batch submission. Please read the <a href="//duke.atlassian.net/wiki/spaces/MD/pages/35423526/Batch+Submitting+Multiple+Media" target="_blank">documentation</a>.</p>
<% end %>

<% if job.present? %>
	<table class="table">
		<tr class="bg-light-gray">
			<th class="col-3"><%= job.running? ? "Current" : "Last" %> Job</th>
			<th class="col-1	">Status</th>
			<th class="col-3">Submitted</th>
			<th class="col-5">Error Message</th>
		</tr>
		<tr>
			<td><%= job.job_id %></td>
			<td><%= job.status.capitalize %></td>
			<td><%= time_ago_in_words(job.created_at).capitalize %> ago</td>
			<td><%= job.exceptions %></td>
		</tr>
	</table>
<% end %>

<% if flash.notice.nil? %>
	<% if current_user.can_submit_new_batch_submission? %>
		<p><i class="fa fa-hand-point-right" aria-hidden="true"></i> <%= link_to "Create a new batch upload submission", main_app.new_batch_submission_path %></p>
	<% else %>
		<p>Only one batch submission job is allowed at a time.  Please contact MorphoSource team if you need assistence.</p>
	<% end %>
<% end %>
