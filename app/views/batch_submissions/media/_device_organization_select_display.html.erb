<div class="col-sm-12 block showcase-edit showcase-section form-group">

  <div class="showcase-section-header">
    <span class="h2">SELECTED ORGANIZATION</span>
    <i id="device-organization-select-close" class="fas fa-times clickable" style='float: right;'></i>
  </div>

  <div class="row text-left">
    <div class="col-6 showcase-label">Organization Type</div>
    <div class="col-6 showcase-value" id="organization_type"><%= organization_attrs['organization_type'] %></div>
  </div>
  <div class="row text-left">
    <div class="col-6 showcase-label">Institution Name</div>
    <div class="col-6 showcase-value" id="institution_name"><%= organization_attrs['institution_name'] %></div>
  </div>
  <div class="row text-left">
    <div class="col-6 showcase-label">Organization Name</div>
    <div class="col-6 showcase-value" id="title"><%= organization_attrs['title'] %></div>
  </div>
  <div class="row text-left">
    <div class="col-6 showcase-label">Institution Code</div>
    <div class="col-6 showcase-value" id="institution_code"><%= organization_attrs['institution_code'] %></div>
  </div>
  <div class="row text-left">
    <div class="col-6 showcase-label">Collection Code</div>
    <div class="col-6 showcase-value" id="collection_code"><%= organization_attrs['collection_code'] %></div>
  </div>
  <div class="row text-left">
    <div class="col-6 showcase-label">Related URL</div>
    <div class="col-6 showcase-value" id="related_url"><%= organization_attrs['related_url'] %></div>
  </div>
  <div class="row text-left">
    <div class="col-6 showcase-label">Address</div>
    <div class="col-6 showcase-value" id="address"><%= organization_attrs['address'] %></div>
  </div>
  <div class="row text-left">
    <div class="col-6 showcase-label">City</div>
    <div class="col-6 showcase-value" id="city"><%= organization_attrs['city'] %></div>
  </div>
  <div class="row text-left">
    <div class="col-6 showcase-label">State/Province</div>
    <div class="col-6 showcase-value" id="state_province"><%= organization_attrs['state_province'] %></div>
  </div>
  <div class="row text-left">
    <div class="col-6 showcase-label">Postal Code</div>
    <div class="col-6 showcase-value" id="postal_code"><%= organization_attrs['postal_code'] %></div>
  </div>
  <div class="row text-left">
    <div class="col-6 showcase-label">Country</div>
    <div class="col-6 showcase-value" id="country"><%= organization_attrs['country'] %></div>
  </div>
  <div class="row text-left">
    <div class="col-6 showcase-label">Contact Person</div>
    <div class="col-6 showcase-value" id="contact_person"><%= organization_attrs['contact_person'] %></div>
  </div>
  <div class="row text-left">
    <div class="col-6 showcase-label">Description</div>
    <div class="col-6 showcase-value" id="description"><%= organization_attrs['description'] %></div>
  </div>

</div>
