
  <div class="row form-group">
    <div class="">

      <div class="submission-select2-container">
        <%= f.input :device_organization_search, 
          label: false,
          input_html: {
            id: :submission_device_select_organization_search,
            class: 'mb-1 input-for-select2',
            style: 'padding: 0; border: none;'
          }
        %>
      </div>

      <% if Hyrax.config.null_organization_id.present? && Organization.exists?(Hyrax.config.null_organization_id) %>
        <div class='mb-1'>
          <b><%= t('morphosource.submission.or') %></b>
        </div>

        <div>
          <a href="#" id="submission_select_device_no_organization" class="btn btn-primary btn-continue">
            <%= t('morphosource.submission.no_organization') %>
          </a>
        </div>
      <% end %>

      <label class="select-device">Then select from devices associated with the organization.</label>

      <div class="submission-select2-container">
        <%= f.input :device_id,
          collection: [],
          label: false,
          required: true,
          input_html: {
            style: 'padding: 0; border: none;'
          },
          disabled: true
        %>
      </div>
    </div>
  </div>


<%# div class="row text-center">
  <a href="#" id="submission_select_device_continue" class="btn btn-primary btn-continue" disabled="disabled">
    <%= t('morphosource.submission.continue') % >
  </a>
</div %>