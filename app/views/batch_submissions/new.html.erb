<% content_for :body_css_classes do %>showcase showcase-edit batch-submission batch-submission-form<% end %>
<% provide :page_title, "Batch Submission || MorphoSource" %>

<script type="text/javascript">
  var depositor = <%= current_user&.user_key.to_json.html_safe %>;
  var deviceOrgsData = <%= @device_organizations_select2.to_json.html_safe %>;
  var objectOrgsData = <%= @object_organizations_select2.to_json.html_safe %>;
  var orgData = objectOrgsData
  var nullOrg = <%= @null_organization.to_json.html_safe %>;
  var deviceData = <%= @devices_with_ids.to_json.html_safe %>;
</script>

<h1><span class="fa fa-upload" aria-hidden="true"></span> Batch Submission</h1>

<div class="row">
  <div class="col-xs-12">
    <b>Create New Batch Submission</b>
    <p><i class="fa fa-hand-point-right"></i> <%= link_to "Download blank submission manifest Excel file (XLSX) <i class='fa fa-file-alt'></i>".html_safe, asset_path("ingest_manifest_template.xlsx"), target: "_blank" %> <span>(Updated May 2025)</span></p>
    <p class="mt-2"><i class="fa fa-hand-point-right"></i> <b>Fill out the required and optional fields below as appropriate and then upload your completed blank submission manifest.</b></p>
  </div>
</div>

<div class="row flash-wrapper restored-message hide">
  <div class="alert alert-info alert-dismissable" role="alert">
    <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">×</span></button>
    Your batch submission form has been restored.  If you are submitting media associated with an organization that has recommended permission settings, some settings have been restored to the organization’s recommendations.  Please review and make changes as needed.
  </div>
</div>

<%= simple_form_for @batch_submission, 
    html: { 
      id: :batch_submission_form, multipart: true, 
      class: 'new_media', # new_media class is needed by submission_form.js for form fields handling
      data: { behavior: 'work-form', 'param-key' => 'media' }
    } do |f| %>
<input class="organization_recordset_id" type="hidden" name="organization_recordset_id" value="" />

<div class="row">

  <div class="col-sm-6"><%# left column %>
    <h2>Basic details</h2>

    <div class="row">
      <label class="required-flag select-organization"><span class="label"></span> Select the organization that represents the physical objects in this batch submission.</label>
      <%= render 'batch_submissions/physical_object/organization', f: f %>
    </div>

    <div class="row mt-2">
      <label class="required-flag select-device"><span class="label"></span> Select the device used to image media in this batch submission. To do so, first find the organization that manages the device.</label>
      <%= render 'batch_submissions/media/device', f: f %>

    </div>

    <div class="row mt-2">
      <label class="required-flag select-modality"><span class="label"></span> Select the modality used to image media (must match the device modality):</label>
      <%= render 'batch_submissions/media/modality', f: f %>
    </div>

    <% if current_user.fund_codes.present? %>
      <div class="row mt-2">
        <label class="required-flag"><span class="label"></span> Select the appropriate fund code for the media in this batch submission. If you are not the final manager of these date, select the manager on whose behalf you are acting as a proxy.</label>
        <%= f.input :fund_code, label: 'What fund code supports this deposit?', 
          collection: current_user.fund_codes.where(can_add_media: true), prompt: "None (Data Supported By MorphoSource)" %>
      </div>        
    <% end %>

    <% if Flipflop.proxy_deposit? && current_user.can_make_deposits_for.any? 
        my_name = current_user.display_name.present? ? "(#{current_user.display_name})" : ""
      %>
      <div class="row mt-2">
        <%= f.input :on_behalf_of, label: 'Which user are you depositing this media for?', 
          collection: current_user.can_make_deposits_for.map{ |u| [u.display_name, u.user_key] }, prompt: "Myself #{my_name}" %>
      </div>
    <% end %>

  </div><%# /left column %>

  <div class="col-sm-6"><%# right column %>
    <%= f.fields_for @media_form,
      wrapper: :showcase_default,
      html: {
        data: { behavior: 'work-form', 'param-key' => 'media' }
      } do |builder| %>
      <%= render  "batch_submissions/media/media", :f => builder %>
    <% end %>
  </div><%# /right column %>

</div>

<div class="row">
  <div class="col-sm-12">
    <h2>UPLOAD MANIFEST</h2>
    <div class="upload-file">
      <label class="required-flag select-manifest"><span class="label"></span> <b>Upload the completed submission manifest.</b></label>
      <div class="mt-1">
        <%= f.file_field_tag :manifest, id: 'manifest_file', :accept => "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" %>
      </div>
      <div class="mt-2 text-center btn-submit-wrapper">
        <%= f.submit 'Next Step', id: 'btn-submit', class: 'btn btn-primary btn-lg', disabled: 'disabled' %>
        <a href="javascript:void(0)" id='start-over' class='small'>Start Over</a>
      </div>
    </div>
  </div>
</div>

<% end # /simple_form_for @batch_submission %>

<%= render(partial: 'submissions/media/organization_transfer_modal') %>
<%= render(partial: 'submissions/media/organization_transfer_collection_modal') %>
<%= render(partial: 'submissions/media/organization_data_manager_modal') %>
