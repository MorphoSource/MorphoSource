<% content_for :body_css_classes do %>showcase showcase-edit batch-submission<% end %>
<% provide :page_title, "Batch Submission || MorphoSource" %>

<script type="text/javascript">

  var orgData = <%= @organizations_select2.to_json.html_safe %>;
  var nullOrg = <%= @null_organization.to_json.html_safe %>;
  var deviceData = <%= @devices_with_ids.to_json.html_safe %>;
</script>

<h1><span class="fa fa-upload" aria-hidden="true"></span> Batch Submission</h1>

<div class="row">
	<div class="col-xs-12">
		<p>On this page you can create new batch submissions or monitor the status of your current batch submissions. Please read the <a href="#">documentation</a>.</p>
		<b>Create New Batch Submission</b>
		<p><%= link_to "Download blank submission manifest Excel file (XLSX)", asset_path("ingest_manifest_template.xlsx"), target: "_blank" %></p>
		<p>Fill out the required and optional fields below as appropriate and then upload your completed blank submission manifest.</p>

	</div>
</div>

<div class="row">
	<div class="col-sm-6">
		<h2>Basic details</h2>

		<div class="row">
			<label class="required-flag"><span class="label"></span> Select the organization that represents the physical objects in this batch submission.</label>
		  <%= render(partial: 'batch_submissions/physical_object/organization') %>
		</div>

		<div class="row mt-2">
			<label class="required-flag"><span class="label"></span> Select the device used to image media in this batch submission. To do so, first find the organization that manages the device.</label>
		  <%= render(partial: 'batch_submissions/media/device') %>
		</div>

	  <%= simple_form_for @batch_submission, html: {id: :batch_submission_form } do |f| %>

	    <% if current_user.fund_codes.present? %>
	      <div class="row mt-2">
	      	<label>Select the appropriate fund code for the media in this batch submission. If you are not the final manager of these date, select the manager on whose behalf you are acting as a proxy.</label>
          <%= f.input :fund_code, label: 'What fund code supports this deposit?', 
            collection: current_user.fund_codes, prompt: "None (Data Supported By MorphoSource)" %>
	      </div>	      
	    <% end %>

      <% if Flipflop.proxy_deposit? && current_user.can_make_deposits_for.any? 
          my_name = current_user.display_name.present? ? "(#{current_user.display_name})" : ""
        %>
        <div class="row mt-2">
          <%= f.input :on_behalf_of, label: 'Which user are you depositing this media for?', 
            collection: current_user.can_make_deposits_for.map{ |u| [u.display_name, u.user_key] }, prompt: "Myself #{my_name}" %>
        </div>
      <% end %>

    <% end %>

      <div class="row mt-2">
				<label>Select one or more projects media in the batch submission should be associated with.</label>


    <%# todo: remove the media form later if not needed %>
    <%= simple_form_for @media_form,
    wrapper: :showcase_default,
    url: { controller: 'submissions', action: 'create' },
    html: {
      data: { behavior: 'work-form', 'param-key' => 'media' },
      multipart: true
    } do |f| %>

          <% if @batch_submission.collection_id %>
            <div class="row">
              <div class="content-block">
                <span>Media will be added to <%= @batch_submission.collection_name %>. Add to additional teams and projects below if desired.</span>
                <input class="collection_id" type="hidden" name="collection_id" value="<%= @batch_submission.collection_id %>" />
              </div>

            </div>
          <% end %>

          <div class="content-block">
            <%= render 'form_member_of_collections', f: f %>
          </div>

    <% end %>

			</div>


	</div>

	<div class="col-sm-6">
		<h2>Ownership and Permissions</h2>
		<label class="optional-flag"><span class="label"></span> These ownership and permissions settings will be applied to all media in the batch submission.</label>
	</div>
</div>