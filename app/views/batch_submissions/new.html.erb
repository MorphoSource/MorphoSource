<% content_for :body_css_classes do %>showcase showcase-edit batch-submission batch-submission-form<% end %>
<% provide :page_title, "Batch Submission || MorphoSource" %>

<script type="text/javascript">

  var orgData = <%= @organizations_select2.to_json.html_safe %>;
  var nullOrg = <%= @null_organization.to_json.html_safe %>;
  var deviceData = <%= @devices_with_ids.to_json.html_safe %>;
</script>

<h1><span class="fa fa-upload" aria-hidden="true"></span> Batch Submission</h1>

<div class="row">
	<div class="col-xs-12">
		<p>On this page you can create new batch submissions or monitor the status of your current batch submissions. Please read the <a href="#">documentation</a>.</p>
		<b>Create New Batch Submission</b>
		<p><i class="fa fa-hand-point-right"></i> <%= link_to "Download blank submission manifest Excel file (XLSX) <i class='fa fa-file-alt'></i>".html_safe, asset_path("ingest_manifest_template.xlsx"), target: "_blank" %></p>
		<p class="mt-2"><i class="fa fa-hand-point-right"></i> <b>Fill out the required and optional fields below as appropriate and then upload your completed blank submission manifest.</b></p>

	</div>
</div>

<div class="row">

  <div class="col-sm-6 pull-right">

  <%# todo: remove the media form later if not needed %>
  <%= simple_form_for @media_form,
  wrapper: :showcase_default,
  url: { controller: 'submissions', action: 'create' },
  html: {
    id: 'batch_submission_media', # setting specific form id to avoid being called in ms_media_form.js
    data: { behavior: 'work-form', 'param-key' => 'media' },
    multipart: true
  } do |f| %>

    <div class="media-permissions">
      <h2>OWNERSHIP AND PERMISSIONS</h2>

      <label class="optional-flag"><span class="label"></span> These ownership and permissions settings will be applied to all media in the batch submission.</label>

      <div id="submission-media-ownership" class="content-block">
        <div id="ownership-section-header-text" class="row hide">
          <div class="col-sm-12" style="text-align: center;">
            <span><span id='organization-name'></span> has suggested default permission settings, indicated by the <i class='fas fa-university'></i> icon. If you have agreed to abide by this organization's preferences for media ownership, take caution before changing these settings.</span>
          </div>
        </div>
        <div class="row media_download_permission">
          <div class="col-xs-6 showcase-label">
            <label class="control-label select optional" for="media_download_permission">Download permission</label>
            <i class="material-icons tooltip-icon" data-original-title="" title="" style='margin-left: -1px;'></i>
          </div>
          <div class="col-xs-6 showcase-value">
            <div class="m-0 p-0 text-nowrap">
            <a aria-label="collapse/expand" data-toggle="collapse" href="#collapse-block-visibility" class="btn collapse-block-visibility pl-0">

              <span class="label" id="current_visibility_value"></span>

              <span class="glyphicon glyphicon-triangle-bottom collapse-block-visibility"></span></a></div>
            <div id="collapse-block-visibility" class="panel-collapse collapse-block glyphicon-only table collapse out m-0 p-0" aria-expanded="false">
              <%= render 'hyrax/media/ms_form_visibility_component', f: f %>
            </div>
          </div>
        </div>

        <%= render_edit_field_partial('download_reviewer', f: f) %>
        <%= render_edit_field_partial('rights_holder', f: f) %>
        <%= render_edit_field_partial('rights_statement', f: f) %>
        <%= render_edit_field_partial('license', f: f) %>
        
        <%= render_edit_field_partial('morphosource_use_agreement_type', f: f) %>
        <%= render_edit_field_partial('permits_commercial_use', f: f) %>
        <%= render_edit_field_partial('permits_3d_use', f: f) %>
        <%= render_edit_field_partial('required_archival_of_published_derivatives', f: f) %>

        <%= render_edit_field_partial('funding', f: f) %>
        <%= render_edit_field_partial('publisher', f: f) %>
        <%= render_edit_field_partial('cite_as', f: f) %>

        <div>
          <div id='organization-attachment-section' class='hide'>
            <div id='organization-attachment-row' class="row">
              <div class="col-xs-6 showcase-label">
                <label class="control-label optional" for="organization_attachment"><span>Additional usage agreement </span></label>
              </div>
              <div class="col-xs-6 showcase-value" id="organization_attachment">
                An <a href='#' id='organization-attachment-url'>agreement file</a> has been suggested by physical object organization. <a href='#' id='organization-attachment-remove'>Remove or replace.</a>
              </div>
            </div>
          </div>
          <div id='work-attachment-section'>
            <%= render_edit_field_partial('agreement_uri', f: f) %>
            <div id='organization-attachment-replace-row' class="row hide">
              <div class="col-xs-6 showcase-label"></div>
              <div class="col-xs-6 showcase-value">
                <a href='#' id='organization-attachment-replace'>Use suggested organization usage agreement</a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <%= render_edit_field_partial('preview_mode', f: f) %>

    </div>

    <div class="row mt-2 select-projects">
      <h2>Projects</h2>
      <label class="optional-flag"><span class="label"></span> Select one or more projects which the media in the batch submission should be associated with.</label>

      <% if @batch_submission.collection_id %>
        <div class="row">
          <div class="content-block">
            <span>Media will be added to <%= @batch_submission.collection_name %>. Add to additional teams and projects below if desired.</span>
            <input class="collection_id" type="hidden" name="collection_id" value="<%= @batch_submission.collection_id %>" />
          </div>

        </div>
      <% end %>

      <div class="content-block">
        <%= render 'form_member_of_collections', f: f %>
      </div>
    </div>

  <% end # /simple_form_for @media_form %>
  </div>

	<div class="col-sm-6">
		<h2>Basic details</h2>

		<div class="row">
			<label class="required-flag select-organization"><span class="label"></span> Select the organization that represents the physical objects in this batch submission.</label>
		  <%= render(partial: 'batch_submissions/physical_object/organization') %>
		</div>

		<div class="row mt-2">
			<label class="required-flag select-device"><span class="label"></span> Select the device used to image media in this batch submission. To do so, first find the organization that manages the device.</label>
		  <%= render(partial: 'batch_submissions/media/device') %>
		</div>

<%= simple_form_for @batch_submission, html: { id: :batch_submission_form, multipart: true } do |f| %>
<input class="organization_institution_code" type="hidden" name="organization_institution_code" value="" />
<input class="organization_recordset_id" type="hidden" name="organization_recordset_id" value="" />

    <div class="row mt-2">
      <label class="required-flag select-modality"><span class="label"></span> Select the modality used to image media.</label>
      <%= render 'batch_submissions/media/modality', f: f %>
    </div>

    <% if current_user.fund_codes.present? %>
      <div class="row mt-2">
      	<label class="required-flag"><span class="label"></span> Select the appropriate fund code for the media in this batch submission. If you are not the final manager of these date, select the manager on whose behalf you are acting as a proxy.</label>
        <%= f.input :fund_code, label: 'What fund code supports this deposit?', 
          collection: current_user.fund_codes, prompt: "None (Data Supported By MorphoSource)" %>
      </div>	      
    <% end %>

    <% if Flipflop.proxy_deposit? && current_user.can_make_deposits_for.any? 
        my_name = current_user.display_name.present? ? "(#{current_user.display_name})" : ""
      %>
      <div class="row mt-2">
        <%= f.input :on_behalf_of, label: 'Which user are you depositing this media for?', 
          collection: current_user.can_make_deposits_for.map{ |u| [u.display_name, u.user_key] }, prompt: "Myself #{my_name}" %>
      </div>
    <% end %>

	</div>


</div>

<div class="row">
  <h2>UPLOAD MANIFEST</h2>
  <div class="col-sm-6 col-sm-offset-3">
    <div class="mt-3 mb-3">
      <label class="required-flag select-manifest"><span class="label"></span> <b>Upload the completed submission manifest.</b>
      <div class="mt-2">
        <%= f.file_field_tag :manifest, id: 'manifest_file', :accept => "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" %>
      </div>
      <div class="mt-2 text-center btn-submit-wrapper">
        <%= f.submit 'Submit', id: 'btn-submit', class: 'btn btn-primary btn-lg', disabled: 'disabled' %>
      </div>

    </div>
  </div>
</div>

<% end # /simple_form_for @batch_submission %>
