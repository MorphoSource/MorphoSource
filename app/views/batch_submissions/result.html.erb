<% content_for :body_css_classes do %>showcase showcase-edit<% end %>
<% provide :page_title, "Batch Submission || MorphoSource" %>

<h1>Result</h1>

<% rows.map do |line, row| %>
	<div class="text-alert">Line <%= line %>: <%= messages[line] %></div>
	<table class="table">
	<tr>
		<%= row.keys.to_wrapped_html('th')%>
	</tr>
	<tr>
		<%= row.values.to_wrapped_html('td')%>
	</tr>
	</table>
<% end %>












