<% content_for :body_css_classes do %>showcase showcase-edit batch-submission<% end %>
<% provide :page_title, "Batch Submission || MorphoSource" %>

<h1><span class="fa fa-upload" aria-hidden="true"></span> Batch Submission</h1>

<p><%= row_count %> <%= "row".pluralize(row_count) %> parsed.</p>

<p><%= general_error_msg %></p>

<p><i class="fa fa-hand-point-right" aria-hidden="true"></i> <%= link_to "Submit again", main_app.new_batch_submission_path %></p>

<% error_rows.map do |row_number, row| %>
	<ul class="error-list">Row <%= row_number %>: <%= error_messages[row_number].to_wrapped_html('li') %></ul>
	<table class="table error-rows">
	<tr>
		<% field_names.each_with_index do |field_name, index| %>
			<th<%= " class=text-alert" if error_cell_numbers[row_number].include? index %>><%= field_name %></th>
		<% end %>
	</tr>
	<tr>
		<%= row.to_wrapped_html('td')%>
	</tr>
	</table>
<% end %>

<% if warn_rows.present? %>
	<p><i class="fa fa-exclamation-triangle"></i> <a class="link-alert" aria-label="collapse/expand" data-toggle="collapse" href="#collapse-block-warnings">Click here to see other warnings</a>.

	<div id="collapse-block-warnings" class="collapse-block collapse out" aria-expanded="true">
		<% warn_rows.map do |row_number, row| %>
			<ul class="warn-list">Row <%= row_number %>: <%= warn_messages[row_number].to_wrapped_html('li') %></ul>
		<% end %>
	</div>
<% end %>

<% if error_rows.count > 0 %>
	<p><i class="fa fa-hand-point-right" aria-hidden="true"></i> <%= link_to "Submit again", main_app.new_batch_submission_path %></p>
<% end %>
