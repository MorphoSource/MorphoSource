<% content_for :body_css_classes do %>showcase showcase-edit batch-submission batch-submission-proceed<% end %>
<% provide :page_title, "Batch Submission || MorphoSource" %>

<h1>Batch Submission</h1>

<p><%= row_count %> <%= "row".pluralize(row_count) %> parsed 
<% if warn_rows.present? %>
	with <a aria-label="collapse/expand" data-toggle="collapse" href="#collapse-block-warnings">warnings</a>.

	<div id="collapse-block-warnings" class="collapse-block collapse out" aria-expanded="true">
		<% warn_rows.map do |row_number, row| %>
			<ul class="warn-list">Row <%= row_number %>: <%= warn_messages[row_number].to_wrapped_html('li') %></ul>
		<% end %>
	</div>
<% else %>
.
<% end %>
</p>

<p>Your batch submission manifest successfully passed validation, and is ready for ingestion.</p>

<%= form_tag main_app.batch_submissions_ingest_path, id: 'form-proceed' do %>
	<%= hidden_field_tag "manifest_object", manifest_object.to_json %>
	<%= submit_tag 'Proceed with ingestion', id: 'btn-submit', class: 'btn btn-primary btn-lg', data: { disable_with: "Submitting..." } %>
<% end %>

<div class="mt-1"><i class="fa fa-hand-point-right" aria-hidden="true"></i> <%= link_to "Submit again", main_app.new_batch_submission_path %></div>
