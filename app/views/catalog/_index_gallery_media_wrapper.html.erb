<div class="document col-xs-5 col-sm-4 col-md-3 media">
  <div class="thumbnail text-center" style="padding-top:10px;">
    <div class="media text-center">
      <%= link_to [main_app, document], class: "media-center", target: :_blank do %>
        <%= render_thumbnail_tag document, { class: "file_listing_thumbnail" }, { suppress_link: true } %>
      <% end %>
    </div>

    <div class="caption text-center">
      <%= render_document_partials document, blacklight_config.view_config(:gallery).partials, :document_counter => document_counter %>
    </div>
  </div>
</div>