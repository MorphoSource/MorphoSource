<% doc_presenter = index_presenter(document) %>
<% collection_models = [ "Collection", "MediaList", "SequentialSectionList" ] %>
<% collection_result = collection_models.include?(document["has_model_ssim"]&.first) %>

<div class="<%= collection_result ? "col-md-7" : "col-md-10" %>">
  <div class="metadata">
    <dl class="dl-horizontal">
    
    <% index_fields(document).each do |field_name, field| -%>

      <% if should_render_index_field? document, field %>
        <div class="index-field-item">
          <% if document["has_model_ssim"]&.first == "Collection" %>
            <% if field_name == "date_uploaded_dtsi" %>
              <dt>Date Created</dt>
            <% else %>
              <dt><%= render_index_field_label document, field: field_name %></dt>
            <% end %>
          <% else %>
            <dt><%= render_index_field_label document, field: field_name %></dt>
          <% end %>          

          <dd><%= doc_presenter.field_value field %></dd>
        </div> 
      <% end %>
    <% end %>

    <% if document["has_model_ssim"]&.first == "BiologicalSpecimen" %>
      <% object_presenter = Hyrax::BiologicalSpecimenPresenter.new(document, current_ability) %>
    <% elsif document["has_model_ssim"]&.first == "CulturalHeritageObject" %>
      <% object_presenter = Hyrax::CulturalHeritageObjectPresenter.new(document, current_ability) %>
    <% end %>

    <% if object_presenter.present? %>
      <% media_count = object_presenter.total_viewable_media %>
      <dt>Number of Media</dt>
      <dd><%= media_count %></dd>
    <% end %>

    <% if document["has_model_ssim"]&.first == "Organization" %>
      <% org_presenter = Hyrax::OrganizationPresenter.new(document, current_ability) %>
      <% linked_team = org_presenter.linked_team %>
      <% if linked_team.present? %>
        <dt>Team</dt>
        <dd><%= linked_team %></dd>
      <% end %>
    <% end %>

    </dl>
  </div>
</div>

<% if collection_result %>
  <% collection_presenter = Morphosource::CollectionPresenter.new(document, current_ability) %>
  <div class="col-md-3">
    <div class="collection-counts-wrapper">
      <div class="collection-counts-item">
        <span><%= collection_presenter.total_viewable_media %></span>Media
      </div>
      <% if document["human_readable_type_tesim"]&.first == "Team" %>
        <div class="collection-counts-item">
          <span><%= collection_presenter.total_viewable_collections %></span>Projects
        </div>
      <% end %>
    </div>
  </div>
<% end %>
