<div class="col-md-10">
  <div class="metadata">
    <dl class="dl-horizontal">
    <% doc_presenter = index_presenter(document) %>
    <% index_fields(document).each do |field_name, field| -%>
      <% if should_render_index_field? document, field %>
        <div class="index-field-item">
          <% if (doc_presenter.field_value('has_model_ssim') == 'Collection') %>
            <% if field_name == "date_uploaded_dtsi" %>
              <dt>Date Created</dt>
            <% else %>
              <dt><%= render_index_field_label document, field: field_name %></dt>
            <% end %>
          <% else %>
            <dt><%= render_index_field_label document, field: field_name %></dt>
          <% end %>          

          <% 
          # temporary catch the key not found: "term" error 
          # in order to display the search result and to output the problematic media id
          # todo: remove the catch block later if not needed
          begin %>
          <dd><%= doc_presenter.field_value field_name %></dd>
          <% 
          rescue StandardError => e 
            Rails.logger.debug "EXCEPTION in catalog index page: #{e.message}, ID: #{doc_presenter.field_value('id')}"
            %>
            <dd><!-- EXCEPTION IN MEDIA <%= doc_presenter.field_value('id') %> --></dd> 
            <%
          end
          %>
        </div> 
      <% end %>
    <% end %>
    <% if(doc_presenter.field_value('has_model_ssim') == 'BiologicalSpecimen') %>
      <% object_presenter = Hyrax::BiologicalSpecimenPresenter.new(document, current_ability) %>
    <% elsif(doc_presenter.field_value('has_model_ssim') == 'CulturalHeritageObject') %>
      <% object_presenter = Hyrax::CulturalHeritageObjectPresenter.new(document, current_ability) %>
    <% end %>
    <% if object_presenter.present? %>
      <% media_count = object_presenter.total_viewable_media %>
      <dt>Number of Media</dt>
      <dd><%= media_count %></dd>
    <% end %>
    <% if(doc_presenter.field_value('has_model_ssim') == 'Organization') %>
      <% org_presenter = Hyrax::OrganizationPresenter.new(document, current_ability) %>
      <% linked_team = org_presenter.linked_team %>
      <% if linked_team.present? %>
        <dt>Team</dt>
        <dd><%= linked_team %></dd>
      <% end %>
    <% end %>
    </dl>
  </div>
</div>
<% if(doc_presenter.field_value('has_model_ssim') == 'Collection') %>
    <% collection_presenter = Hyrax::CollectionPresenter.new(document, current_ability) %>
<div class="col-md-4">
  <div class="collection-counts-wrapper">
    <% if (doc_presenter.field_value('human_readable_type_tesim') == 'Team') %>
      <div class="collection-counts-item">
        <span><%= collection_presenter.total_viewable_collections %></span>Projects
      </div>
    <% end %>
    <div class="collection-counts-item">
      <span><%= collection_presenter.total_viewable_works %></span>Media
    </div>
  </div>
</div>
<% end %>
