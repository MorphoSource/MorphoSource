<div id="exports" class="facets sidenav">
  <div class="top-panel-heading panel-heading">
    <h2 class="facets-heading">Export your search</h2>
  </div>
  <div style="padding-bottom: 10px; padding-left: 15px;">
  	<div style="margin-bottom: 10px;">
	    <%= link_to "As CSV", request.parameters.merge({:format => :csv, :per_page => 1000000})%>
		</div>
		<div style="margin-bottom: 10px;">
			<%= link_to "As JSON", request.parameters.merge({:format => :json, :per_page => 1000000}), target: :_blank %>
		</div>
		<div>
			Interested in JSON export? See <%= link_to "API Documentation", "https://morphosource.stoplight.io/docs/morphosource-api", target: :_blank %>.
		</div>
	</div>
</div>