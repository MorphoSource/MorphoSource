<div id="exports" class="facets sidenav mb-2">
  <div class="facets-header">
    <h2 class="facets-heading">Export your search</h2>
  </div>
  <div style="padding-bottom: 10px;">
  	<div style="margin-bottom: 10px;">
	    <%= link_to "As CSV (Current Page)", request.parameters.merge({ :format => :csv }) %>
		</div>
		<div style="margin-bottom: 10px;">
			<% if user_signed_in? %>
				<%= link_to "As CSV (Entire Search)", request.parameters.merge({ :format => :csv, :scope => :all }) %>
			<% else %>
				As CSV (Entire Search) &mdash; <%= link_to "log in", main_app.new_user_session_path %> to export your entire search as CSV.
			<% end %>
		</div>
		<div style="margin-bottom: 10px;">
			<%= link_to "As JSON (Current Page)", request.parameters.merge({ :format => :json }), target: :_blank %>
		</div>
		<div>
			Interested in JSON export? See <%= link_to "API Documentation", "https://morphosource.stoplight.io/docs/morphosource-api", target: :_blank %>.
		</div>
	</div>
</div>
