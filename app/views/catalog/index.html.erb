<% content_for :body_css_classes do %>catalog-body<% end %>

<% content_for(:container_header) do -%>
  <%= render 'ms_catalog_search' %>
  <%= render 'did_you_mean' %>
  <%= render 'sort_and_per_page' %>
<% end %>

<div class="row" style="padding: 0; padding-top: 6px;">
  <div id="content" class="order-2 order-md-2 col-md-9 col-12">
      <%= render 'search_results' %>
  </div>

  <div id="sidebar" class="order-1 order-md-1 col-md-3 col-12">
    <%= render 'facets' %>
  </div>

  <div class="order-3 order-md-3 col-md-3 col-12">
    <%= render 'search_export' %>
  </div>
</div>
