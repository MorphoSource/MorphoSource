<% content_for :body_css_classes do %>catalog-body<% end %>

<% content_for(:container_header) do -%>
  <%= render 'ms_catalog_search' %>
  <%= render 'did_you_mean' %>
  <%= render 'sort_and_per_page' %>
<% end %>

<div class="row" style="padding-top: 6px; padding-bottom: 3rem !important;">
  <div id="sidebar" class="col-md-3 col-12">
    <%= render 'facets' %>
    <div class="d-none d-md-block">
      <%= render 'search_export' %>
    </div>
  </div>

  <div id="content" class="col-md-9 col-12">
      <%= render 'search_results' %>
  </div>

  <div class="d-block d-md-none col-md-2 col-12">
    <%= render 'search_export' %>
  </div>
</div>
