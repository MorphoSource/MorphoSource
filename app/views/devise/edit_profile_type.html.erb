<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: 'edit_profile_type' }) do |f| %>
<%= f.hidden_field :email, value: @user_email %>
<%= f.hidden_field :password, value: @user_password %>
<h2>Please Select Your Profile Type</h2>
<p class="mt-1 mb-2"><%= t("morphosource.dashboard.profiles.login_form_instructions").html_safe %></p>
<div class="panel panel-default">
  <div class="panel-body">
    <%= render partial: 'hyrax/dashboard/profiles/edit_profile_type_section', locals: {f: f} %>
  </div>
</div>
<div class="actions text-center mt-2 mb-2">
  <%= f.submit "Update Profile and Sign In", class: "btn btn-primary" %>
</div>
<% end %>

<script>
  <%= render partial: 'hyrax/dashboard/profiles/ms_profile_scripts', formats: [:js] %>
</script>