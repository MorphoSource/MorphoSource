<h2>Change your password</h2>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <div class="field">
    <%= f.label :password, "New password" %><br />
    <% if @minimum_password_length %>
      <em>(<%= @minimum_password_length %> characters minimum)</em><br />
    <% end %>
    <%= f.password_field :password, autofocus: true, autocomplete: "new-password" %><br />
  </div>

  <div class="field">
    <%= f.label :password_confirmation, "Confirm new password" %><br />
    <%= f.password_field :password_confirmation, autocomplete: "new-password" %><br />
  </div>

  <div class="field">
    <%= f.check_box :terms_read, {checked: false, required: true}, true %>
    <%= t("devise.passwords.edit.terms").html_safe %>
  </div><!-- .form-group -->
  <br />

  <div class="actions">
    <%= f.submit "Change my password" %>
  </div>
<% end %>

<%#  Don't show sign up / log in links if MS1 user %>
<% unless User.with_reset_password_token(params[:reset_password_token]) %>
  <%= render "devise/shared/links" %>
<% end %>
