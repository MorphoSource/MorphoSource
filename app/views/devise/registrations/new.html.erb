<% content_for :body_css_classes do %>showcase profile<% end %>
<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
<h1>Sign up</h1>
<div class="row">
  <%= render "devise/shared/error_messages", resource: resource %>
</div>

<div class="panel panel-default">
  <div class="row">
    <div class="col-sm-12 col-md-6 profile">

      <%= render partial: 'hyrax/dashboard/profiles/edit_email', locals: {f: f} %>

      <div class="form-group row">
        <% if @minimum_password_length %>
          <%= f.label "Password (" + @minimum_password_length.to_s + " characters minimum)", class: 'col-xs-4 control-label required' %>
        <% else %>
          <%= f.label :password, class: 'col-xs-4 control-label' %>
        <% end %>
        <div class="col-xs-8">
          <%= f.password_field :password, autocomplete: "new-password" %>
        </div>
      </div>

      <div class="form-group row">
        <%= f.label :password_confirm, class: 'col-xs-4 control-label required' %>
        <div class="col-xs-8">
          <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
        </div>
      </div>

      <%= render partial: 'hyrax/dashboard/profiles/edit_profile_name_section', locals: {f: f} %>
      <%= render partial: 'hyrax/dashboard/profiles/ms_profile', locals: {f: f} %>

    </div>

    <div class="col-sm-12 col-md-6">
      <%= render partial: 'hyrax/dashboard/profiles/edit_profile_type_section', locals: {f: f} %>
      <%= render partial: 'hyrax/dashboard/profiles/edit_intent', locals: {f: f} %>  
    </div>
  </div>

  <div class="row">
    <div class='col-xs-12 text-center'>
      <p>
        <%= f.check_box :terms_read, {checked: false, required: true}, true %>
        <%= t("devise.passwords.edit.terms").html_safe %>       
      </p>
      <p><%= f.submit "Sign up", class: 'btn btn-primary btn-lg' %></p>
    </div>
  </div>

</div>
<% end %>

<script>
<%= render partial: 'hyrax/dashboard/profiles/ms_profile_scripts', formats: [:js] %>
</script>
