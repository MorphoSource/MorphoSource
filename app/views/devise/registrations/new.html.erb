<% content_for :body_css_classes do %>showcase profile<% end %>
<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
<h1>Sign up</h1>
<div class="row">
  <%= render "devise/shared/error_messages", resource: resource %>
</div>

<div class="panel panel-default">
  <div class="row">
    <div class="col-xs-6 profile">

        <div class="form-group">
          <%= f.label :email, class: 'control-label', style: 'width: 33%; position: relative; left: 15px;'  %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", style: 'position: relative; left: 15px;' %>
        </div>

        <div class="form-group">
          <% if @minimum_password_length %>
            <%= f.label ("Password (" + @minimum_password_length.to_s + " characters minimum)"), class: 'control-label', style: 'width: 33%; position: relative; left: 15px;' %>
          <% else %>
            <%= f.label :password, class: 'control-label', style: 'width: 33%; position: relative; left: 15px;' %>
          <% end %>
          <%= f.password_field :password, autocomplete: "new-password", style: 'position: relative; left: 15px;' %>
        </div>

        <div class="form-group">
          <%= f.label :password_confirmation, class: 'control-label', style: 'width: 33%; position: relative; left: 15px;' %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", style: 'position: relative; left: 15px;' %>
        </div>

    </div>
    <div class="col-xs-6">
      <%= render partial: 'hyrax/dashboard/profiles/edit_profile_name_section', locals: {f: f} %>
    </div>
  </div>

  <div class= "row">  

    <%= render partial: 'hyrax/dashboard/profiles/edit_profile_type_section', locals: {f: f} %>

    <div class="col-lg-6 col-md-12 mt-2">
      <%= render partial: 'hyrax/dashboard/profiles/ms_profile', locals: {f: f} %>
    </div>
  </div>

  <div class="row">

    <%= render partial: 'hyrax/dashboard/profiles/edit_profile_bottom_section', locals: {f: f} %>  

    <div class='col-sm-4 control-label'></div>
    <div class='col-sm-8'>
      <%= f.submit "Sign up", class: 'btn btn-primary' %>
    </div>

  </div>

</div>
<% end %>

<script>
<%= render partial: 'hyrax/dashboard/profiles/ms_profile_scripts', formats: [:js] %>
</script>
