<% # Users taking the cultural heritage survey will be redirected to this page after they submit their answers. %>
<% content_for :body_css_classes do %>showcase<% end %>
  <% provide :page_title, @title %>

  <div class="survey">
    <h1><%= @title %></h1>
    <div class="col-12 flash-wrapper" style="margin-bottom: 10px;">
      <div class="alert alert-success alert-dismissable" role="alert">
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">×</span></button>
        Thank you for taking the time to complete this survey. Your feedback is very important to us. If you have any questions or comments, please contact us at <a href="mailto: morphosource@duke.edu">morphosource@duke.edu</a>.
      </div>
    </div>
    <div>
      <%= render(partial: 'docs/survey/front_banner') %>
    </div>
  </div>

