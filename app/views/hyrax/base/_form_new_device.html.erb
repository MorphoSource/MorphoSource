<h2>NEW DEVICE</h2>

<p>Create a new device by filling in fields below and selecting Create new device. You can also go back and select device instead. </p>

<%= f.input :title, label_wrapper_html: { class: 'required-flag' }  %>
<%= f.input :creator, label_wrapper_html: { class: 'required-flag' }, as: :multi_value %>

<% modalities_service = Morphosource::ModalitiesService.new %>
<%= f.input :modality, as: :multi_value_select,
    collection: modalities_service.select_all_options,
    include_blank: true,
    item_helper: modalities_service.method(:include_current_value),
    input_html: { class: 'form-control', multiple: true },
    label_wrapper_html: { class: 'required-flag' }
%>
<%= f.input :description, as: :text, label: 'Description' %>

<div>
  <%= f.submit 'Create new device', class: "btn btn-primary" %>
  <button type="button" class="btn btn-secondary cancel">Cancel</button>
</div>
