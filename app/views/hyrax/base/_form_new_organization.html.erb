<h2>NEW ORGANIZATION</h2>

<p>Create a new organization by filling in fields below and selecting Create New Organization. You can also go back and <a class="cancel">select organization or no organization</a> instead. </p>

<%= render_edit_field_partial('organization_type', f: i) %>
<%= i.input :institution_name %>
<%= i.input :title, label_wrapper_html: { class: 'required-flag' }  %>
<%= i.input :institution_code, as: :multi_value, label_wrapper_html: { class: 'required-flag' }  %>
<%= i.input :collection_code, as: :multi_value %>
<%= i.input :related_url, as: :multi_value %>
<%= i.input :address %>
<%= i.input :city %>
<%= i.input :state_province %>
<%= i.input :postal_code %>
<%= i.input :country, as: :select,
    collection: @countries_service.select_all_options,
    include_blank: true,
    item_helper: @countries_service.method(:include_current_value),
    input_html: { class: 'form-control' }
%>
<%= i.input :contact_person %>
<%= i.input :description, as: :text, label: 'Description' %>

<div>
  <%= i.submit 'Create new organization', class: "btn btn-primary" %>
  <button type="button" class="btn btn-secondary cancel">Cancel</button>
</div>
