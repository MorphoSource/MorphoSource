<h2>NEW PROCESSING EVENT</h2>

<p>To select a parent media, please enter the processing event details, then search and click "Select media".</p>

    <%= p.input :creator, as: :multi_value %>
    <%= p.input :date_created %>
    <%= p.input :software, as: :multi_value %>
    <%= p.input :description, label: 'Full description' %>

  	<h2>INDIVIDUAL PROCESSING STEPS</h2>

	  <%= render_edit_field_partial('processing_activity', f: p) %>
	  <%# passing the current media id to be set as the child of this PE 
	    # child < PE < parent %>
	  <input name="child_media_id" type="hidden" value="<%= curation_concern.id %>">

<div>
  <%= p.submit 'Create new processing event', class: "btn btn-primary hidden" %>
  <!-- button type="button" class="btn btn-secondary cancel">Cancel</button -->
</div>