<div class='organization-details'>
  <h2>CURRENT ORGANIZATION</h2>

  <div class="message has-warning hidden"></div>
  <table>
    <tbody></tbody>
  </table>

  <input id="organization-id-value" type="hidden" value="<%= presenter.parent_organization_id %>" />
  <input id="organization-recordset-id" type="hidden" value="<%= presenter.parent_organization_recordset_id %>" />

  <tr>
    <td>
        <div class="row">
            <div class="col-xs-6 showcase-label"><%= t('simple_form.labels.organization.organization_type') %></div>
            <div class="col-xs-6 showcase-value" id="organization_type">
              <%= presenter.parent_organization_organization_type %>
            </div>
        </div>

        <div class="row">
            <div class="col-xs-6 showcase-label"><%= t('simple_form.labels.organization.institution_name') %></div>
            <div class="col-xs-6 showcase-value" id="institution_name">
              <%= presenter.parent_organization_institution_name %>
            </div>
        </div>

        <div class="row">
            <div class="col-xs-6 showcase-label"><%= t('simple_form.labels.organization.title') %></div>
            <div class="col-xs-6 showcase-value" id="title">
              <%= presenter.parent_organization_title %>
            </div>
        </div>

        <div class="row">
            <div class="col-xs-6 showcase-label"><%= t('simple_form.labels.organization.institution_code') %></div>
            <div class="col-xs-6 showcase-value" id="institution_code">
              <%= presenter.parent_organization_institution_code.join(', ') %>
            </div>
        </div>

        <div class="row">
            <div class="col-xs-6 showcase-label"><%= t('simple_form.labels.organization.collection_code') %></div>
            <div class="col-xs-6 showcase-value" id="collection_code">
              <%= presenter.parent_organization_collection_code.join(', ') %>
            </div>
        </div>

        <div class="row">
            <div class="col-xs-6 showcase-label"><%= t('simple_form.labels.organization.related_url') %></div>
            <div class="col-xs-6 showcase-value" id="related_url">
              <%= presenter.parent_organization_related_url.join(', ') %>
            </div>
        </div>

        <div class="row">
            <div class="col-xs-6 showcase-label"><%= t('simple_form.labels.organization.address') %></div>
            <div class="col-xs-6 showcase-value" id="address">
              <%= presenter.parent_organization_address %>
            </div>
        </div>

        <div class="row">
            <div class="col-xs-6 showcase-label"><%= t('simple_form.labels.organization.city') %></div>
            <div class="col-xs-6 showcase-value" id="city">
              <%= presenter.parent_organization_city %>
            </div>
        </div>

        <div class="row">
            <div class="col-xs-6 showcase-label"><%= t('simple_form.labels.organization.state_province') %></div>
            <div class="col-xs-6 showcase-value" id="state_province">
              <%= presenter.parent_organization_state_province %>
            </div>
        </div>

        <div class="row">
            <div class="col-xs-6 showcase-label"><%= t('simple_form.labels.organization.postal_code') %></div>
            <div class="col-xs-6 showcase-value" id="postal_code">
              <%= presenter.parent_organization_postal_code %>
            </div>
        </div>

        <div class="row">
            <div class="col-xs-6 showcase-label"><%= t('simple_form.labels.organization.country') %></div>
            <div class="col-xs-6 showcase-value" id="country">
              <%= presenter.parent_organization_country %>
            </div>
        </div>

        <div class="row">
            <div class="col-xs-6 showcase-label"><%= t('simple_form.labels.organization.contact_person') %></div>
            <div class="col-xs-6 showcase-value" id="contact_person">
              <%= presenter.parent_organization_contact_person.join(', ') %>
            </div>
        </div>

        <div class="row">
            <div class="col-xs-6 showcase-label"><%= t('simple_form.labels.organization.description') %></div>
            <div class="col-xs-6 showcase-value" id="description">
              <%= presenter.parent_organization_description %>
            </div>
        </div>
    </td>
  </tr>
</div>