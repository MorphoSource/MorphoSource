<% content_for :body_css_classes do %>showcase<% end %>
<% provide :page_title, "Not Found" %>

<% if respond_to?(:curation_concern) && curation_concern %>
  <% resource_type = curation_concern.human_readable_type %>
  <% resource_id = curation_concern.id %>
<% else %>
  <% resource_id = nil %>
<% end %>

<div class="error">
  <div class="col-10 col-offset-1 col-sm-8 col-sm-offset-2 col-md-4 col-md-offset-4 block">
    <div class="row title">
      <h1 style="text-align: center;">
        <%= "#{ resource_type.titleize } Not Found" %>
      </h1>
    </div>
    <div class="row">
      <%= "The #{ resource_type.downcase } resource#{ resource_id.present? ? " (ID: #{resource_id})" : "" }" %>  does not exist, is unavailable, or has been deleted.
    </div>
  </div>
</div>