<h2>NEW INSTITUTION</h2>

<p>Create a new institution by filling in fields below and selecting Create New Institution. You can also go back and <a class="cancel">select institution or no institution</a> instead. </p>

<%= i.input :institution_code, label_wrapper_html: { class: 'required-flag' }  %>
<%= i.input :title, label_wrapper_html: { class: 'required-flag' }  %>
<%= i.input :description, as: :text, label: 'Description' %>
<%= i.input :address %>
<%= i.input :city %>
<%= i.input :state_province %>
<%= i.input :country, as: :select,
    collection: @countries_service.select_all_options,
    include_blank: true,
    item_helper: @countries_service.method(:include_current_value),
    input_html: { class: 'form-control' }
%>
<div>
  <%= i.submit 'Create new institution', class: "btn btn-primary btn-save" %>
  <button type="button" class="btn btn-secondary cancel">Cancel</button>
</div>
