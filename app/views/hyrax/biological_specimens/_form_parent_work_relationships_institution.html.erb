<h2>INSTITUTION</h2>
<div id="parent-relationships-institutions" class="form-group" data-behavior="parent-relationships-institutions" data-param-key="<%= f.object.model_name.param_key %>" data-members="<%= f.object.member_of_institutions_json('Institution') %>" data-new-work-created="" data-repeatable="no" data-work-type="institution">

  <p>If this object is managed by an institution, either select it from the list or create a new institution record if it is not currently present in the list. If the object is not managed by an institution, select No Institution.</p>

  <div class="form-inline">
    <%= f.input_field :find_parent_work,
                      prompt: :translate,
                      autocomplete: 'off',
                      data: {
                        autocomplete: 'work',
                        'autocomplete-url' => find_institution_autocomplete_url()
                      } %>
  </div>

  <div class="text-center button-wrapper">
    <a class="btn btn-md btn-primary" id="btn-add-institution" data-behavior="add-relationship">Select institution</a>
    <a class="btn btn-md btn-primary" id="btn_new_institution">Create new institution</a>
    <a class="btn btn-md btn-primary" id="btn_no_institution">No institution</a>    
  </div>

  <div class="message has-warning hidden"></div>
  <table class="table table-striped">
    <div style="margin-top: 10px"></div>
    <tbody></tbody>
  </table>
</div>

<script type="text/x-tmpl" id="tmpl-parent-work-institutions">
<tr>
  <td>

      <div class="row">
          <div class="col-xs-6 showcase-label">Institution code</div>
          <div class="col-xs-6 showcase-value">{%= o.institution_code %}</div>
      </div>
      <div class="row">
          <div class="col-xs-6 showcase-label">Institution title</div>
          <div class="col-xs-6 showcase-value">{%= o.title %}</div>
      </div>
      <div class="row">
          <div class="col-xs-6 showcase-label">Institution description</div>
          <div class="col-xs-6 showcase-value">{%= o.description %}</div>
      </div>
      <div class="row">
          <div class="col-xs-6 showcase-label">Institution address</div>
          <div class="col-xs-6 showcase-value">{%= o.address %}</div>
      </div>
      <div class="row">
          <div class="col-xs-6 showcase-label">Institution city</div>
          <div class="col-xs-6 showcase-value">{%= o.city %}</div>
      </div>
      <div class="row">
          <div class="col-xs-6 showcase-label">Institution state/province</div>
          <div class="col-xs-6 showcase-value">{%= o.state_province %}</div>
      </div>
      <div class="row">
          <div class="col-xs-6 showcase-label">Institution country</div>
          <div class="col-xs-6 showcase-value">{%= o.country %}</div>
      </div>

  </td>
  <td><button class="btn btn-sm btn-danger" data-behavior="remove-relationship"><%= t('.actions.remove') %></button></td>
</tr>
</script>


      <%= f.input :institution_code %>

      <div class="form-group">


        <div id="embedded_div_new_institution" class="embedded_div ui-loading" data-relationship-control="#parent-relationships-institutions" data-add-button="#btn-add-institution" style="display: none;">
          <!-- new institution form will be loaded here -->
        </div>
      </div>
