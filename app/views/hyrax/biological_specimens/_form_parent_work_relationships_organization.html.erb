<div id="organization_details" class="mt-0">
  <h2>ORGANIZATION</h2>

  <div class="form-inline">
    <div class="mb-1">
      <div>
        Search for and select the organization that manages this physical object.
      </div>
    </div>

    <%= f.input_field :find_organization,
                      prompt: :translate,
                      autocomplete: 'off',
                      placeholder: 'Enter complete words in organization name',
                      data: {
                        autocomplete: 'work',
                        'autocomplete-url' => find_object_organization_autocomplete_url()
                      } %>
  </div>

  <div class="text-center button-wrapper mt-1">
    <a class="btn btn-md btn-primary" id="btn_select_organization">Select organization</a>

    <!-- only admins can create a new organization or select 'no organization' -->
    <% if current_user.admin? %>
      <a class="btn btn-md btn-primary" id="btn_no_organization">No organization</a>
    <% end %>

  </div>

</div>

<div class="block mt-2">
  <%= t('morphosource.physical_object.edit.select_organization').html_safe %>
</div>
