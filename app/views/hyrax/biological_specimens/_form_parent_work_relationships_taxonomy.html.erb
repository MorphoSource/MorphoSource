<h2>BIOLOGICAL SPECIMEN TAXONOMY</h2>

  <div class="form-inline">
    <div><label><%= f.label "Taxonomies" %></label></div>
    <%= f.input_field :find_parent_work,
                      prompt: :translate,
                      autocomplete: 'off',
                      data: {
                        autocomplete: 'work',
                        'autocomplete-url' => find_taxonomy_autocomplete_url()
                      } %>
    <a class="btn btn-sm btn-primary" id="btn-add-taxonomy" data-behavior="add-relationship">Add taxonomy</a>
  </div>


<script type="text/x-tmpl" id="tmpl-parent-work-taxonomies">
<tr>
  <td>{%= o.title %}</td>
  <td><button class="btn btn-sm btn-danger" data-behavior="remove-relationship" data-confirm-text="<%= t('.confirm.text') %>" data-confirm-cancel="<%= t('.confirm.cancel') %>" data-confirm-remove="<%= t('.confirm.remove') %>"><%= t('.actions.remove') %></button></td>
</tr>
</script>
