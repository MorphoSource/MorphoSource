<%= render "edit_work_title", presenter: @presenter, f: f %>

    <div class="panel panel-default tabs" role="main">
      <!-- Nav tabs -->
      <ul class="nav nav-tabs" role="tablist">
        <li role="presentation" class="">
          <a href="#institution" aria-controls="institution" role="tab" data-toggle="tab" aria-expanded="true">
          <i class="fa fa-university"></i> Institution
          </a>
        </li>
        <li role="presentation" class="active">
          <a href="#taxonomy" aria-controls="taxonomy" role="tab" data-toggle="tab" aria-expanded="false">
          <i class="fab fa-pagelines"></i> Taxonomy
          </a>
        </li>
        <li role="presentation" id="tab-physical-object-details" class="">
          <a href="#physical-object-details" aria-controls="physical-object-details" role="tab" data-toggle="tab" aria-expanded="false">
            <i class="fa fa-frog"></i> Object Details
          </a>
        </li>
      </ul>

      <!-- Tab panes -->
      <div class="tab-content">
        <div role="tabpanel" class="tab-pane" id="institution">
          <div class="form-tab-content">

            <%= render 'tab_institution', f: f %>

          </div>
        </div>

        <div role="tabpanel" class="tab-pane active" id="taxonomy">
          <div class="form-tab-content">

            <%= render 'tab_taxonomy', f: f %>

          </div>
        </div>

        <div role="tabpanel" class="tab-pane" id="physical-object-details">
          <div class="form-tab-content">

            <%= render 'tab_object_details', f: f %>

          </div>
        </div>
      </div>

    </div><!-- /panel panel-default tabs -->
