<div class="modal fade" id="modal-idigbio-multi-result" tabindex="-1" role="dialog" aria-labelledby="modal-label" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modal-label">More than one iDigBio record found
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
        </h5>
      </div>
      <div class="modal-body">
        <p>An <a href="#" target="_blank" id="idb-link">iDigBio specimen</a> <span class="glyphicon glyphicon-new-window"></span> with the occurrence ID has been found.  Please check the details below.  If you click Save, the specimen will be updated to match the iDigBio record.  Or you can click Cancel and return to the edit page.</p>
      </div>
      <div class="modal-footer">
        <button id="btn-save" type="button" class="btn btn-primary">Save</button>
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
      </div>
    </div>
  </div>
</div>
