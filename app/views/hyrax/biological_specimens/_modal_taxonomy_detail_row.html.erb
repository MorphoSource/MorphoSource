<div class="panel-group taxonomy-accordion-group <%= label %>">
  <div class="panel m-0">
    <div class="row">
      <div class="col-5 showcase-label taxonomy-label"><%= label %></div>
      <div class="col-5 showcase-value taxonomy-title"><i>(No title)</i></div>
      <div class="col-1 pl-0"><span data-toggle="collapse" data-parent="#taxonomy-accordion-group" href="#collapse-taxonomy-<%= label %>" class="col-1 glyphicon collapse-taxonomy-<%= label %> glyphicon-triangle-bottom collapsed" aria-expanded="false"></span></div>
    </div>

    <div id="collapse-taxonomy-<%= label %>" class="panel-collapse collapse-accordion collapse" aria-expanded="false" style="height: 0px;">
      <div class="row taxonomy-rank">
          <div class="col-6 showcase-label">Domain</div>
          <div class="col-6 showcase-value taxonomy-domain"></div>
      </div>
      <div class="row taxonomy-rank">
          <div class="col-6 showcase-label">Kingdom</div>
          <div class="col-6 showcase-value taxonomy-kingdom"></div>
      </div>
      <div class="row taxonomy-rank">
          <div class="col-6 showcase-label">Phylum</div>
          <div class="col-6 showcase-value taxonomy-phylum"></div>
      </div>
      <div class="row taxonomy-rank">
          <div class="col-6 showcase-label">Superclass</div>
          <div class="col-6 showcase-value taxonomy-superclass"></div>
      </div>
      <div class="row taxonomy-rank">
          <div class="col-6 showcase-label">Class</div>
          <div class="col-6 showcase-value taxonomy-class"></div>
      </div>
      <div class="row taxonomy-rank">
          <div class="col-6 showcase-label">Subclass</div>
          <div class="col-6 showcase-value taxonomy-subclass"></div>
      </div>
      <div class="row taxonomy-rank">
          <div class="col-6 showcase-label">Superorder</div>
          <div class="col-6 showcase-value taxonomy-superorder"></div>
      </div>
      <div class="row taxonomy-rank">
          <div class="col-6 showcase-label">Order</div>
          <div class="col-6 showcase-value taxonomy-order"></div>
      </div>
      <div class="row taxonomy-rank">
          <div class="col-6 showcase-label">Suborder</div>
          <div class="col-6 showcase-value taxonomy-suborder"></div>
      </div>
      <div class="row taxonomy-rank">
          <div class="col-6 showcase-label">Superfamily</div>
          <div class="col-6 showcase-value taxonomy-superfamily"></div>
      </div>
      <div class="row taxonomy-rank">
          <div class="col-6 showcase-label">Family</div>
          <div class="col-6 showcase-value taxonomy-family"></div>
      </div>
      <div class="row taxonomy-rank">
          <div class="col-6 showcase-label">Subfamily</div>
          <div class="col-6 showcase-value taxonomy-subfamily"></div>
      </div>
      <div class="row taxonomy-rank">
          <div class="col-6 showcase-label">Tribe</div>
          <div class="col-6 showcase-value taxonomy-tribe"></div>
      </div>
      <div class="row taxonomy-rank">
          <div class="col-6 showcase-label">Genus</div>
          <div class="col-6 showcase-value taxonomy-genus"></div>
      </div>
      <div class="row taxonomy-rank">
          <div class="col-6 showcase-label">Subgenus</div>
          <div class="col-6 showcase-value taxonomy-subgenus"></div>
      </div>
      <div class="row taxonomy-rank">
          <div class="col-6 showcase-label">Species</div>
          <div class="col-6 showcase-value taxonomy-species"></div>
      </div>
      <div class="row taxonomy-rank">
          <div class="col-6 showcase-label">Subspecies</div>
          <div class="col-6 showcase-value taxonomy-subspecies"></div>
      </div>
    </div>
  </div>
</div>