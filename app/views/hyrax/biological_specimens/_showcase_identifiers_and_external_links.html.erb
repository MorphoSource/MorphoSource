<h2>IDENTIFIERS AND EXTERNAL LINKS</h2>
<%= presenter.attribute_to_html(:institution_code, render_as: :showcase_default, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:collection_code, render_as: :showcase_default, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:catalog_number, render_as: :showcase_default, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:occurrence_id, label: 'Occurrence ID', render_as: :showcase_default, include_empty: true, html_dl: false, css_classes: 'break-all') %>
<%= presenter.attribute_to_html(:identifier, render_as: :showcase_default, include_empty: true, html_dl: false, css_classes: 'break-all') %>
<%= presenter.attribute_to_html(:related_url, label: 'External object URL', render_as: :showcase_external_link, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:idigbio_uuid, label: 'iDigBio UUID', link: "https://www.idigbio.org/portal/records/#{presenter.idigbio_uuid&.first}", render_as: :showcase_idigbio_link, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:idigbio_recordset_id, label: 'iDigBio recordset ID', link: "https://www.idigbio.org/portal/recordsets/#{presenter.idigbio_recordset_id&.first}",  render_as: :showcase_idigbio_link, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:bibliographic_citation, label: 'Bibliographic Citation', render_as: :showcase_default, include_empty: true, html_dl: false) %>
