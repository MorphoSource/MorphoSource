<div class="mt-0">
  <h2>TAXONOMIES ASSOCIATED WITH THIS SPECIMEN <i class="material-icons tooltip-icon" data-toggle="tooltip" title="Taxonomies associated with this specimen"></i></h2>

  <div class="message has-warning hidden"></div>
  <table>
    <tbody></tbody>
  </table>

  <input name="biological_specimen[taxonomy_id][]" id="taxonomy_id" type="hidden" value="" />

  <div id='taxonomy_detail_rows'>
    <% if presenter.canonical_taxonomy_object.present? %>
      <%= render 'taxonomy_detail_row', t: presenter.canonical_taxonomy_object, label: presenter.canonical_taxonomy_label %>
    <% end %>

    <% presenter.gbif_taxonomies.each do |t| %>
      <%= render 'taxonomy_detail_row', t: t, label: I18n.t('morphosource.taxonomy.labels.gbif') %>
    <% end %>

    <% presenter.user_taxonomies.each do |t| %>
      <%= render 'taxonomy_detail_row', t: t, label: I18n.t('morphosource.taxonomy.labels.user') %>
    <% end %>
  </div>

  <template id='new_taxonomy_detail_row'>
    <div class="panel-group taxonomy-accordion-group" data-taxonomy-id="" data-gbif-key="">
      <input name="biological_specimen[taxonomy_id][]" id="taxonomy_id" type="hidden" value="" />
      <div class="card m-0">
        <div class="row align-items-center">
          <div class="col-5 showcase-label taxonomy-label"></div>
          <div class="col-5 showcase-value taxonomy-title pt-0" style="font-style: unset;"></div>
          <div class="col-1 offset-1 p-0 text-center" id="remove-taxonomy"><i class="fas fa-times-circle" aria-hidden="true"></i></div>
        </div>
      </div>
    </div>
  </template>
</div>
