<% content_for :body_css_classes do %>showcase<% end %>
<% content_for :content_css_classes do %>fixed-width<% end %>

<div class="object-showcase">
  <%= render @presenter.showcase_work_title_partial, presenter: @presenter %>

  <!-- .media-order-# determines flexbox column order when screen width is less than 768px -->
  <div class="row object-content-blocks-wrapper">

    <div class="media-order-2 content-block-wrapper">
      <div class="content-block">
        <%= render @presenter.showcase_general_details_partial, presenter: @presenter %>
      </div>
    </div>

    <div class="media-order-3" style="break-after:column;">
      <div class="content-block">
        <%= render @presenter.showcase_taxonomy_partial, presenter: @presenter %>
      </div>
      <div class="content-block">
        <%= render @presenter.showcase_identifiers_and_external_links_partial, presenter: @presenter %>
      </div>
      <div class="content-block">
        <%= render @presenter.showcase_time_details_partial, presenter: @presenter %>
      </div>
    </div>

    <!-- second column start -->
    <div class="media-order-1" style="break-before:column;">
      <div class="content-block">
        <%= render @presenter.showcase_media_items_partial, presenter: @presenter %>
      </div>
      <div class="content-block" style="">
        <%= render @presenter.showcase_collections_partial, presenter: @presenter %>
      </div>
    </div>

    <div class="media-order-4">
      <div class="content-block">
        <%= render @presenter.showcase_location_details_partial, presenter: @presenter %>
      </div>
      <div class="content-block">
        <%= render @presenter.showcase_provenance_partial, presenter: @presenter %>
      </div>
    </div>
  </div> <!-- object-content-blocks-wrapper -->
</div> <!--object-showcase -->
