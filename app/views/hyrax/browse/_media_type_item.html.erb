<% media_types_service = Morphosource::MediaTypesService.new %>
<h2>
	<%= link_to t("hyrax.browse.title."+media_type), main_app.media_search_path("f.media_type" => media_types_service.fetch(media_type, :short)) %><br/>
  <span class="counts">
  	<%= "#{media_count_by_media_type(media_type)} Media".pluralize(media_count_by_media_type(media_type)) %>
	</span>
</h2>
<p><%= t("hyrax.browse.page_description."+media_type) %></p>
