<% id = collection_presenter.id %>
<tr>
  <td class="title-min-width">
    <%= link_to Rails.application.routes.url_helpers.project_path(id) do %>
      <span class="sr-only"><%= t("hyrax.dashboard.my.sr.show_label") %></span>
      <%= collection_presenter.title_or_label %>
    <% end %>
  </td>
  <td><span class="text-truncate-lines three-lines"><%= collection_presenter.description&.first %></span></td>
  <td><%= collection_presenter.project_team_title_link %></td>
  <td><%= collection_presenter.creator&.first %></td>
  <td><%= collection_presenter.total_media %></td>
  <td><%= collection_presenter.total_po %></td>
</tr>
