<% id = collection_presenter.id %>
<tr>
  <td>
    <%= link_to Rails.application.routes.url_helpers.team_path(id) do %>
      <span class="sr-only"><%= t("hyrax.dashboard.my.sr.show_label") %></span>
      <%= collection_presenter.title_or_label %>
    <% end %>
  </td>
  <td><%= collection_presenter.organization&.title&.first %></td>
  <td><%= collection_presenter.creator&.first %></td>
  <td><%= collection_presenter.total_team_projects %></td>
  <td><%= collection_presenter.total_media %></td>
  <td><%= collection_presenter.total_po %></td>
</tr>
