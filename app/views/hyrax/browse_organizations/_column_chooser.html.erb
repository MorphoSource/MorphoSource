<div class="view-type float-right">
  <span class="sr-only"><%= t('blacklight.search.view_title') %></span>
  <div class="view-type-group btn-group">

      <div class="btn-group choose-columns-organizations">
        <button type="button" class="btn btn-primary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
          <i class="fa fa-columns"></i> <span class="caret"></span>
        </button>
        <ul class="dropdown-menu">
          <li><input type="checkbox" class="toggle-vis" data-column="0" checked="checked" /> Parent Institution</li>
          <li><input type="checkbox" class="toggle-vis" data-column="1" checked="checked" /> Organization Name</li>
          <li><input type="checkbox" class="toggle-vis" data-column="2" checked="checked" /> Institution Codes</li>
          <li><input type="checkbox" class="toggle-vis" data-column="3" checked="checked" /> Collection Codes</li>
          <li><input type="checkbox" class="toggle-vis" data-column="4" checked="checked" /> Type</li>
          <li><input type="checkbox" class="toggle-vis" data-column="5" checked="checked" /> Media</li>
          <li><input type="checkbox" class="toggle-vis" data-column="6" checked="checked" /> Objects</li>
          <li><input type="checkbox" class="toggle-vis" data-column="7" checked="checked" /> Devices</li>
        </ul>
      </div>

  </div>
</div>
