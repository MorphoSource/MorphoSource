<table id="organizations-list-table" class="table table-striped organizations-list-table">
  <caption class="sr-only"><%= t("hyrax.dashboard.my.sr.listing") %> <%= application_name %></caption>
  <thead>
  <tr>
    <th><%= t("hyrax.dashboard.my.heading.parent_institution") %></th>
    <th><%= t("hyrax.dashboard.my.heading.organization_name") %></th>
    <th><%= t("hyrax.dashboard.my.heading.institution_codes") %></th>
    <th><%= t("hyrax.dashboard.my.heading.collection_codes") %></th>
    <th><%= t("hyrax.dashboard.my.heading.type") %></th>
    <th><%= t("hyrax.dashboard.my.heading.media") %></th>
    <th><%= t("hyrax.dashboard.my.heading.objects") %></th>
    <th><%= t("hyrax.dashboard.my.heading.devices") %></th>
  </tr>
  </thead>
  <tbody>
  <% docs.each_with_index do |document| %>
    <% organization_presenter = Hyrax::OrganizationPresenter.new(document, current_ability, nil) %>
    <%= render 'list_items', document: document, presenter: organization_presenter %>
  <% end %>
  </tbody>
</table>
