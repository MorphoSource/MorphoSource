<% content_for :body_css_classes do %>showcase organizations browse<% end %>
<% provide :page_title, t("hyrax.browse.title.organizations") %>
<div class="browse">

  <% provide :page_header do %>
    <div class="col-9 title browse">
      <h1><span class="fa fa-university" aria-hidden="true"></span> 
        <%= t("hyrax.browse.title.organizations") %><br/>
        <span class="counts"><%= render 'counts' %></span>
      </h1>
    </div>
  <% end %>
  <div class="col-12 page-description">
    <p><%= t("hyrax.browse.page_description.organizations") %></p>
  </div>
  <div class="collections-wrapper">
    <div class="card panel-default collections-panel-wrapper">
      <div class="card-body">
        <%= render 'search_header' %>
        <%= render 'document_list' %>
        <%= render 'results_pagination' %>
      </div>
    </div>
  </div><!-- /collections-wrapper -->

</div>
<%= render 'shared/back_to_top' %>
