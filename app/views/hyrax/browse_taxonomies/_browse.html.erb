<div id="taxonomy-browse">
  <% genus_term = '' %>
  <div class="row">
    <div id='taxonomy-select' class="col-sm-12 col-md-6">
      <div id="tree" class="block">
        <div class="row list-item" style='text-align: center;'>
          <span class="h4">Taxonomic Names</span>
        </div>
        <div id="root-link">
          <div class="row list-item">
            <div class="col-sm-7">
              <div><%= link_to 'Root', main_app.browse_taxonomies_path, :remote => true %></div>
              <div class='smaller-text'>Return to root or top taxonomy</div>
            </div>
            <div class="col-sm-5 smaller-text">
              <div><%= pluralize(@root_taxonomy_number, 'taxonomic name') %></div>
              <div><%= pluralize(@root_specimen_number, 'specimen') %></div>
            </div>
          </div>
        </div>
        <div id="current-path">
          <% previous_params = {} %>
          <% higher_names.each do |higher_name| %>
            <% name = higher_name[:name] %>
            <% rank = higher_name[:rank] %>
            <% genus_term = name if rank == 'genus' %>
            <% previous_params.merge!({ rank => name }) %>
              <div class="row list-item">
                <div class="col-sm-7">
                  <% if name == higher_names.last[:name] %>
                    <div><b>
                      <% if rank == 'species' && !genus_term.blank? %>
                        <span style='font-style: italic;'><%= "#{genus_term} #{name}" %></span>
                      <% else %>
                        <%= name %>
                      <% end %>
                    </b></div>
                  <% else %>
                    <div><%= link_to name, main_app.browse_taxonomies_path(previous_params), :remote => true %></div>
                  <% end %>
                  <div class='smaller-text'>
                    <%= rank.titleize %>
                  </div>
                </div>
                <div class="col-sm-5 smaller-text">
                  <div><%= pluralize(higher_name[:count], 'taxonomic name') %></div>
                  <% if higher_name[:specimen_count].present? %>
                    <div><%= pluralize(higher_name[:specimen_count], 'specimen') %></div>
                  <% elsif name == higher_names.last[:name] && specimens['numFound'].present? %>
                    <div><%= pluralize(specimens['numFound'], 'specimen') %></div>
                  <% end %>
                </div>
              </div>
          <% end %>
        </div>
        <% if names.present? %>
          <% if higher_names.present? %>
            <div class='row list-item'>
              <div class='col-sm-7' style='padding-top: 10px;'>
                <b class='smaller-text'>Immediate Children</b>
              </div>
              <div class='col-sm-5 smaller-text' style='padding-top: 13px;'>
                <a href='#specimen-list' id='jump-to-specimens'><b>Jump to specimens</b></a>
              </div>
            </div>
          <% end %>
          <div>
            <% names.each do |rank, rank_names| %>
              <% rank_names.each do |name, counts| %>
                <% genus_term = name if rank == 'genus' %>
                <div class="row list-item child-item">
                  <div class="col-sm-7 child-item-title">
                    <% if rank == 'species' && !genus_term.blank? %>
                      <div style='font-style: italic;'><%= link_to "#{genus_term} #{name}", main_app.browse_taxonomies_path(previous_params.merge({ rank => name })), :remote => true %></div>
                    <% else %>
                      <div><%= link_to name, main_app.browse_taxonomies_path(previous_params.merge({ rank => name })), :remote => true %></div>
                    <% end %>
                    <div class='smaller-text'>
                      <%= rank.titleize %>
                    </div>
                  </div>
                  <div class="col-sm-5 smaller-text">
                    <div><%= pluralize(counts[:count], 'taxonomic name') %></div>
                    <% if counts[:specimen_count].present? %>
                      <div><%= pluralize(counts[:specimen_count], 'specimen') %></div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
    <div id='specimen-list' class="col-sm-12 col-md-6">
      <div id="objects" class="block">
        <% if specimens['numFound'] > 0 %>
          <div>
            <div class="row list-item" style="text-align: center;">
              <span class="h4">Specimens For Selected Taxonomy (<%= specimens['numFound'] %>)</span>
            </div>
            <div>
              <% specimens['docs'].each do |specimen| %>
                <div class="row list-item">
                  <div>
                    <%= link_to "#{ specimen['title_tesim']&.first }", main_app.hyrax_biological_specimen_path(id: specimen['id']) %>
                  </div>
                  <% if specimen['taxonomy_tesim'].present? %>
                    <div class='smaller-text'>
                      <%= specimen['taxonomy_tesim']&.first %>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
            <% if specimens['numFound'] > 100 %>
              <div style='margin-top: 20px; font-weight: bold'>
                <%= link_to "See all #{specimens['numFound']} specimens for this taxonomy", main_app.object_search_path( { 'f[external_taxonomy_ssim]' => specimen_taxonomy_terms } ) %>
              </div>
            <% end %>
          </div>
        <% else %>
          <span>No specimens found for this taxon.</span>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
  $(function(){
    $('div#taxonomy-select a').click(function() {
      $('div#taxonomy-browse').addClass('ui-loading-whole-page');
    });
  });
</script>