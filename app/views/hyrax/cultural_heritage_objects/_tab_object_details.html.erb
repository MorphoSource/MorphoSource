<div class="row">
  <!-- left column  -->
  <div class="col-sm-6">

    <div class="content-block">
      <h2>OBJECT IDENTIFIERS AND EXTERNAL LINKS</h2>
      <%= @presenter.attribute_to_html(:work_id, label: "Object ID", render_as: :showcase_default, include_empty: true, html_dl: false) %>
      <%= f.input :vouchered, as: :select,
          collection: ['Yes','No'],
          include_blank: true,
          # item_helper: method(:include_current_value),
          input_html: { class: 'form-control' },
          label_wrapper_html: { class: 'required-flag' }
      %>
      <%= f.input :institution_code, label_wrapper_html: { class: 'recommended-flag' }  %>
      <%= f.input :collection_code, label_wrapper_html: { class: 'recommended-flag' }  %>
      <%= f.input :catalog_number, label_wrapper_html: { class: 'recommended-flag' }  %>
      <%= f.input :short_title, label_wrapper_html: { class: 'recommended-flag' }  %>
      <%= f.input :identifier, as: :multi_value %>
      <%= f.input :related_url, as: :multi_value %>
      <%= f.input :bibliographic_citation, label: 'Bibliographic Citation', as: :multi_value %>
    </div>

    <div class="content-block">
      <h2>OBJECT DESCRIPTION</h2>
      <% if @presenter.parent_organization.present? %>
        <%= @presenter.attribute_to_html(
          :parent_organization_title,
          label: 'Organization',
          link: Rails.application.routes.url_helpers.hyrax_organization_path(@presenter.parent_organization.id),
          render_as: :showcase_organization_title,
          html_dl: false)
        %>
      <% else %>
        <%= @presenter.attribute_to_html(:parent_organization_title, label: 'Organization', render_as: :showcase_organization_title, html_dl: false) %>
      <% end %>
      <%= f.input :description, label: 'Description', as: :text %>
      <%= f.input :creator, label: 'Creator', as: :multi_value %>
      <%= f.input :contributor, label: 'Collector/Contributor', as: :multi_value %>
      <%= f.input :publisher %>
      <%= f.label 'Object Type', style: "padding-left: 8px;" %>
      <div style='margin-bottom:10px;'>
        <%= f.input :aat_type, label: 'AAT Type', as: :multi_value, label_wrapper_html: { class: 'indent' } %>
        <%= f.input :cho_type, label: 'Custom Type', as: :multi_value, label_wrapper_html: { class: 'indent' } %>
      </div>
      <%= f.label 'Object Material', style: "padding-left: 8px;" %>
      <div style='margin-bottom:10px;'>
        <%= render "records/edit_fields/aat_material", f: f, key: 'based_near' %>
        <%= f.input :material, label: 'Custom Material', as: :multi_value, label_wrapper_html: { class: 'indent' } %>
      </div>
      <%= f.label 'Object Attributes', style: "padding-left: 8px;" %>
      <div style='margin-bottom:10px;'>
        <%= f.input :aat_attributes, label: 'AAT Object Attributes', as: :multi_value, label_wrapper_html: { class: 'indent' } %>
        <%= f.input :cho_attributes, label: 'Custom Object Attributes', as: :multi_value, label_wrapper_html: { class: 'indent' } %>
      </div>
      <%= f.input :dimensions, label: 'Object Dimensions/Measurements' %>

      </div>
      <div class="content-block">
        <h2>OBJECT DATE</h2>
      <%# todo: render date_field in simple_form_bootstrap %>
      <div class="row">
        <div class="col-xs-6 showcase-label">Date Created</div>
        <div class="col-xs-6 showcase-value">
        <%= f.date_field :date_created, wrapper: :inline, value: f.object.date_created, class: 'datepicker form-control' %>
          </div>
      </div>
      <%= f.input :numeric_time, label: 'Absolute Age' %>
      <%= f.input :periodic_time, label: 'Time Period', as: :multi_value %>
      <%= f.input :dating_method, label: 'Dating Method' %>
      </div>
      <div class="content-block">
      <h2>OBJECT ORIGINAL LOCATION</h2>
      <%= f.input :tgn, label: 'TGN Location' %>
      <%= f.input :original_location, label: 'Locality' %>
      <%= f.input :address, label: 'Address' %>
      <%= f.input :city, label: 'City' %>
      <%= f.input :state_province, label: 'State or Province' %>
      <%= render 'records/edit_fields/country', f: f %>
      <%= f.input 'Geographical Coordinates', value_wrapper: false %>
      <%= f.input :latitude, tooltip_wrapper: false, label_wrapper_html: { class: 'indent' } %>
      <%= f.input :longitude, tooltip_wrapper: false, label_wrapper_html: { class: 'indent' } %>
    </div>

    <div class="content-block">
      <h2>PROVENANCE INFORMATION</h2>
      <%= f.input :context, label: 'Context' %>
      <%= f.input :formation, label: 'Formation' %>
      <%= f.input :provenance_name, label: 'Excavation Name' %>
      <div class="row">
        <div class="col-xs-6 showcase-label">Excavation/Collection Date</div>
        <div class="col-xs-6 showcase-value">
        <%= f.date_field :provenance_date, wrapper: :inline, value: f.object.provenance_date, class: 'datepicker form-control' %>
          </div>
      </div>
      <%= f.input :provenance_location, label: 'Excavation/Collection Location' %>
      <%= f.input :provenance_details, label: 'Excavation/Collection Details', as: :text %>
      <%= f.input :current_location, label: 'Current Location' %>
      <!--  todo: the html below can be removed if simpleform config wrapper can be used.  In that case, we need to figure out pass the content for the tooltip
      <div class="form-group row">
          <div class="col-xs-12 showcase-label">
              <label class="control-label">Geographical coordinates</label><span class="glyphicon glyphicon-question-sign tooltip-icon" data-original-title="" title=""></span>
          </div>
      </div>
      -->
    </div>

  </div>
  <!-- /left column  -->

  <!-- right column  -->
  <div class="col-sm-6">

    <%= render 'edit_media_items', presenter: @presenter, f: f %>

    <div class="content-block">
      <%= render 'form_member_of_collections', f: f %>
    </div>

  </div>
  <!-- / right column -->

</div>
