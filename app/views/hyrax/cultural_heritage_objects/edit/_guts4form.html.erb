<%= render "hyrax/physical_objects/edit_work_title", presenter: @presenter, f: f %>

    <div class="card panel-default tabs" role="main">
      <!-- Nav tabs -->
      <ul class="nav nav-tabs" role="tablist">
        <li role="presentation" id="tab-physical-object-details" class="active">
          <a href="#physical-object-details" aria-controls="physical-object-details" role="tab" data-toggle="tab" aria-expanded="false">
            <i class="ms2-icon-bowl icon-bowl"></i> Object Details
          </a>
        </li>
        <li role="presentation" class="">
          <a href="#organization" aria-controls="organization" role="tab" data-toggle="tab" aria-expanded="true">
          <i class="fa fa-university"></i> Organization
          </a>
        </li>
      </ul>

      <!-- Tab panes -->
      <div class="tab-content">
        <div role="tabpanel" class="tab-pane active" id="physical-object-details">
          <div class="form-tab-content">

            <%= render 'hyrax/cultural_heritage_objects/edit/tab_object_details', f: f %>

          </div>
        </div>

        <div role="tabpanel" class="tab-pane" id="organization">
          <div class="form-tab-content">

            <%= render 'tab_organization', f: f %>

          </div>
        </div>
      </div>

    </div><!-- /card panel-default tabs -->
