<%# Override to include Media Cart %>
<% menu = Hyrax::MenuPresenter.new(self) %>
<div class="sidebar-toggle"><span class="fa fa-chevron-circle-right"></span></div>
<nav>
  <ul class="nav nav-pills nav-stacked">
    <li class="nav-item">
      <div class="profile">
        <div class="profile-image">
          <%= image_tag current_user.avatar.url(:thumb), width: 100 if current_user.avatar.present? %>
        </div>
        <div class="profile-data">
          <div class="profile-data-name"><%= current_user.name %></div>
        </div>
      </div>
    </li>

    <%= render 'hyrax/dashboard/sidebar/user', menu: menu %>
    <% if current_user.contributor? || current_user.admin? %>
      <%= render 'hyrax/dashboard/sidebar/my_media', menu: menu %>
      <%= render 'hyrax/dashboard/sidebar/my_media_collections', menu: menu %>
      <%= render 'hyrax/dashboard/sidebar/my_downloads', menu: menu %>
      <%= render 'hyrax/dashboard/sidebar/contributor_tools', menu: menu %>
    <% else %>
      <%= render 'hyrax/dashboard/sidebar/my_downloads', menu: menu %>
      <%= render 'hyrax/dashboard/sidebar/my_media', menu: menu %>
      <%= render 'hyrax/dashboard/sidebar/my_media_collections', menu: menu %>
    <% end %>
    <%= render 'hyrax/dashboard/sidebar/admin_tools', menu: menu %>
  </ul>
</nav>
