<% show_filter_by = false %>

<%= simple_form_for @form, url: edit_dashboard_collection_url + '#biological_specimens', html: { class: 'filters', id: "bso-filters", name: "bso-filters", method: "get" } do |bf| %>

	<div class="filters row">

		<div class="col-sm-2 col-lg-1 filter-label">Filter:</div>
		<div class="col-sm-10 col-lg-11">

			<% if params['b_visibility'].present? 
					 show_filter_by = true %>
				<input type="hidden" name="b_visibility" value="<%= params['b_visibility'] %>" class="filter-param" />
			<% else %>
		  	<select name="b_visibility" data-form="bso-filters">
		  		<option value="">Visibility</option>
		  		<% @visibility_options.each do |v| %>
			  		<option><%= v %></option>
		  		<% end %>
		  	</select>
		  <% end %>

		 	<% if params['b_source'].present? 
					 show_filter_by = true %>
				<input type="hidden" name="b_source" value="<%= params['b_source'] %>" class="filter-param" />
			<% else %>
		  	<select name="b_source" data-form="bso-filters">
		  		<option value="">Source</option>
		  		<% @bso_source_options.each do |v| %>
			  		<option><%= v %></option>
		  		<% end %>
		  	</select>
		  <% end %>

		 	<% if params['b_organization'].present? 
					 show_filter_by = true %>
				<input type="hidden" name="b_organization" value="<%= params['b_organization'] %>" class="filter-param" />
			<% else %>
		  	<select name="b_organization" data-form="bso-filters">
		  		<option value="">Organization</option>
		  		<% @organization_options.each do |v| %>
			  		<option><%= v %></option>
		  		<% end %>
		  	</select>
		  <% end %>

		 	<% if params['b_origin'].present? 
					 show_filter_by = true %>
				<input type="hidden" name="b_origin" value="<%= params['b_origin'] %>" class="filter-param" />
			<% else %>
		  	<select name="b_origin" data-form="bso-filters">
		  		<option value="">Origin</option>
		  		<option>Team</option>
		  		<option>Org.</option>
		  	</select>
		  <% end %>

		</div>

	</div>

	<% if show_filter_by == true %>
		<div class="filter-by row">

			<div class="col-sm-2 col-lg-1 filter-label">Filtering by:</div>
			<div class="col-sm-8 col-lg-9">
				<% if params['b_visibility'].present? %>
					<p id="b_visibility" class="filter-param">Visibility > <%= params['b_visibility'] %> <i class="fa fa-times-circle" aria-hidden="true" data-behavior="remove-filter" data-form="bso-filters" data-param="b_visibility"></i></p>
				<% end %>
				<% if params['b_source'].present? %>
					<p id="b_source" class="filter-param">Source > <%= params['b_source'] %> <i class="fa fa-times-circle" aria-hidden="true" data-behavior="remove-filter" data-form="bso-filters" data-param="b_source"></i></p>
				<% end %>
				<% if params['b_organization'].present? %>
					<p id="b_organization" class="filter-param">Organization > <%= params['b_organization'] %> <i class="fa fa-times-circle" aria-hidden="true" data-behavior="remove-filter" data-form="bso-filters" data-param="b_organization"></i></p>
				<% end %>
				<% if params['b_origin'].present? %>
					<p id="b_origin" class="filter-param">Origin > <%= params['b_origin'] %> <i class="fa fa-times-circle" aria-hidden="true" data-behavior="remove-filter" data-form="bso-filters" data-param="b_origin"></i></p>
				<% end %>
			</div>
			<div class="col-sm-2 col-lg-2 text-right"><a href="javascript:void(0)" class="remove-filter-all" aria-hidden="true" data-behavior="remove-filter" data-form="bso-filters" data-param="all">Remove all <i class="fa fa-times-circle"></i></a></div>
		</div>
	<% end %>

<% end %>
