<% @all_checked = false %>
<% @user = current_user %>
<% if documents.nil? || documents.empty? %>
  <div class="alert alert-warning" role="alert"><%= t('hyrax.collection.document_list.no_visible_works') %></div>
<% else %>
  <% @document_list = documents %>
  <% @disable_select_all = (@document_list.count <= 1) %>
  <% if defined? work_type %>
	  <%# if params[:action] == "edit" %>
	    <%#= render 'default_group', documents: documents, docs: documents %>
	  <% if work_type == "media" %>
	    <%= render 'hyrax/teams/show_media_document_list', documents: documents %>
	  <% elsif work_type == "biological_specimen" %>
	    <%= render 'hyrax/teams/show_biological_specimen_document_list', documents: documents %>
	  <% elsif work_type == "cultural_heritage_object" %>
	    <%= render 'hyrax/teams/show_cultural_heritage_object_document_list', documents: documents %>
	  <% else %>
	    ERROR: no work_type
	  <% end %>
	<% else %>
	  <%= render 'show_document_list', documents: documents %>
	<% end %>

<% end %>
