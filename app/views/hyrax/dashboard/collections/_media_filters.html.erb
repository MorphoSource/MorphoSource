<% show_filter_by = false %>

<%= simple_form_for @form, url: edit_dashboard_collection_url + '#media', html: { class: 'filters', id: "media-filters", name: "media-filters", method: "get" } do |mf| %>
	<%= hidden_params_for_filters('m_') %>
	
	<div class="filters row">

		<div class="col-sm-2 col-lg-1 filter-label">Filter:</div>
		<div class="col-sm-10 col-lg-11">

			<% if params['m_visibility'].present? 
					 show_filter_by = true %>
				<input type="hidden" name="m_visibility" value="<%= params['m_visibility'] %>" class="filter-param" />
			<% else %>
		  	<select name="m_visibility" data-form="media-filters">
		  		<option value="">Visibility</option>
		  		<% @visibility_options.each do |v| %>
			  		<option><%= v %></option>
		  		<% end %>
		  	</select>
		  <% end %>

			<% if params['m_pub_status'].present? 
					 show_filter_by = true %>
				<input type="hidden" name="m_pub_status" value="<%= params['m_pub_status'] %>" class="filter-param" />
			<% else %>
		  	<select name="m_pub_status" data-form="media-filters">
		  		<option value="">Publication status</option>
		  		<% @pub_status_options.each do |v| %>
			  		<option value="<%= v %>"><%= publication_status_label(v) %></option>
		  		<% end %>
		  	</select>
		  <% end %>

		 	<% if params['m_media_type'].present? 
					 show_filter_by = true %>
				<input type="hidden" name="m_media_type" value="<%= params['m_media_type'] %>" class="filter-param" />
			<% else %>
		  	<select name="m_media_type" data-form="media-filters">
		  		<option value="">Media type</option>
		  		<% @media_type_options.each do |v| %>
			  		<option><%= v %></option>
		  		<% end %>
		  	</select>
		  <% end %>

		 	<% if params['m_team_project'].present? 
					 show_filter_by = true %>
				<input type="hidden" name="m_team_project" value="<%= params['m_team_project'] %>" class="filter-param" />
			<% else %>
		  	<select name="m_team_project" data-form="media-filters">
		  		<option value="">Project</option>
		  		<% @team_project_options.each do |v| %>
			  		<option><%= v %></option>
		  		<% end %>
		  	</select>
		  <% end %>

		 	<% if params['m_organization'].present? 
					 show_filter_by = true %>
				<input type="hidden" name="m_organization" value="<%= params['m_organization'] %>" class="filter-param" />
			<% else %>
		  	<select name="m_organization" data-form="media-filters">
		  		<option value="">Organization</option>
		  		<% @organization_options.each do |v| %>
			  		<option><%= v %></option>
		  		<% end %>
		  	</select>
		  <% end %>

		 	<% if params['m_origin'].present? 
					 show_filter_by = true %>
				<input type="hidden" name="m_origin" value="<%= params['m_origin'] %>" class="filter-param" />
			<% else %>
		  	<select name="m_origin" data-form="media-filters">
		  		<option value="">Origin</option>
		  		<option>Team</option>
		  		<option>Org.</option>
		  	</select>
		  <% end %>

		</div>

	</div>

	<% if show_filter_by == true %>
		<div class="filter-by row">

			<div class="col-sm-2 col-lg-1 filter-label">Filtering by:</div>
			<div class="col-sm-8 col-lg-9">
				<% if params['m_visibility'].present? %>
					<p id="m_visibility" class="filter-param">Visibility > <%= params['m_visibility'] %> <i class="fa fa-times-circle" aria-hidden="true" data-behavior="remove-filter" data-form="media-filters" data-param="m_visibility"></i></p>
				<% end %>
				<% if params['m_pub_status'].present? %>
					<p id="m_pub_status" class="filter-param">Publication status > <%= params['m_pub_status'] %> <i class="fa fa-times-circle" aria-hidden="true" data-behavior="remove-filter" data-form="media-filters" data-param="m_pub_status"></i></p>
				<% end %>
				<% if params['m_media_type'].present? %>
					<p id="m_media_type" class="filter-param">Media type > <%= params['m_media_type'] %> <i class="fa fa-times-circle" aria-hidden="true" data-behavior="remove-filter" data-form="media-filters" data-param="m_media_type"></i></p>
				<% end %>
				<% if params['m_team_project'].present? %>
					<p id="m_team_project" class="filter-param">Project > <%= params['m_team_project'] %> <i class="fa fa-times-circle" aria-hidden="true" data-behavior="remove-filter" data-form="media-filters" data-param="m_team_project"></i></p>
				<% end %>
				<% if params['m_organization'].present? %>
					<p id="m_organization" class="filter-param">Organization > <%= params['m_organization'] %> <i class="fa fa-times-circle" aria-hidden="true" data-behavior="remove-filter" data-form="media-filters" data-param="m_organization"></i></p>
				<% end %>
				<% if params['m_origin'].present? %>
					<p id="m_origin" class="filter-param">Origin > <%= params['m_origin'] %> <i class="fa fa-times-circle" aria-hidden="true" data-behavior="remove-filter" data-form="media-filters" data-param="m_origin"></i></p>
				<% end %>
			</div>
			<div class="col-sm-2 col-lg-2 text-right"><a href="javascript:void(0)" class="remove-filter-all" aria-hidden="true" data-behavior="remove-filter" data-form="media-filters" data-param="all">Remove all <i class="fa fa-times-circle"></i></a></div>

		</div>
	<% end %>

<% end %>
