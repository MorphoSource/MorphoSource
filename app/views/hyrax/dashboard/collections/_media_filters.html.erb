<% show_filter_by = false %>
<%= simple_form_for @form, url: edit_dashboard_collection_url + '#media', html: { class: 'filters', id: "media-filters", name: "media-filters", method: "get" } do |mf| %>
  <%= hidden_params_for_filters('m_') %>
  
  <div class="filters row">

    <div class="col-sm-2 col-lg-1 filter-label">Filter:</div>
    <div class="col-sm-10 col-lg-11">

      <% if params['m_pub_status'].present? 
        show_filter_by = true %>
        <input type="hidden" name="m_pub_status" value="<%= params['m_pub_status'] %>" class="filter-param" />
      <% else %>
        <select name="m_pub_status" data-form="media-filters" style='width: 150px;'>
          <option value="">Publication Status</option>
          <% Array(@collection_media_groups['fileset_accessibility']).each do |v, n| %>
            <option value="<%= v %>"><%= "#{publication_status_label(v)} (#{n})" %></option>
          <% end %>
        </select>
      <% end %>

      <% if params['m_media_type'].present? 
        show_filter_by = true %>
        <input type="hidden" name="m_media_type" value="<%= params['m_media_type'] %>" class="filter-param" />
      <% else %>
        <select name="m_media_type" data-form="media-filters" style='width: 150px;'>
          <option value="">Media Type</option>
          <% Array(@collection_media_groups['media_type']).each do |v, n| %>
            <option value="<%= v %>"><%= "#{media_type_label(v)} (#{n})" %></option>
          <% end %>
        </select>
      <% end %>

      <% if params['m_organization'].present? 
        show_filter_by = true %>
        <input type="hidden" name="m_organization" value="<%= params['m_organization'] %>" class="filter-param" />
      <% else %>
        <select name="m_organization" data-form="media-filters" style='width: 150px;'>
          <option value="">Organization</option>
          <% Array(@collection_media_groups['organization']).each do |v, n| %>
            <option value="<%= v %>"><%= "#{v} (#{n})" %></option>
          <% end %>
        </select>
      <% end %>

      <% if @collection.team? %>
        <% if params['m_origin'].present? 
          show_filter_by = true %>
          <input type="hidden" name="m_origin" value="<%= params['m_origin'] %>" class="filter-param" />
        <% else %>
          <select name="m_origin" data-form="media-filters" style='width: 150px;'>
            <option value="">Origin</option>
            <% Array(@collection_media_groups['origin']).each do |v, n| %>
              <option value="<%= v %>"><%= "#{origin_label(v)} (#{n})" %></option>
            <% end %>
          </select>
        <% end %>
      <% end %>

      <% if params['cq'].present? 
        show_filter_by = true %>
        <input type="hidden" name="cq" value="<%= params['cq'] %>" class="filter-param" />
      <% end %>

    </div>

  </div>

  <% if show_filter_by == true %>
    <div class="filter-by row">

      <div class="col-sm-2 col-lg-1 filter-label">Filtering by:</div>
      <div class="col-sm-8 col-lg-9">
        <% if params['m_pub_status'].present? %>
          <p id="m_pub_status" class="filter-param">Publication status > <%= publication_status_label(params['m_pub_status']) %> <i class="fa fa-times-circle" aria-hidden="true" data-behavior="remove-filter" data-form="media-filters" data-param="m_pub_status"></i></p>
        <% end %>
        <% if params['m_media_type'].present? %>
          <p id="m_media_type" class="filter-param">Media type > <%= media_type_label(params['m_media_type']) %> <i class="fa fa-times-circle" aria-hidden="true" data-behavior="remove-filter" data-form="media-filters" data-param="m_media_type"></i></p>
        <% end %>
        <% if params['m_organization'].present? %>
          <p id="m_organization" class="filter-param">Organization > <%= params['m_organization'] %> <i class="fa fa-times-circle" aria-hidden="true" data-behavior="remove-filter" data-form="media-filters" data-param="m_organization"></i></p>
        <% end %>
        <% if params['m_origin'].present? %>
          <p id="m_origin" class="filter-param">Origin > <%= origin_label(params['m_origin']) %> <i class="fa fa-times-circle" aria-hidden="true" data-behavior="remove-filter" data-form="media-filters" data-param="m_origin"></i></p>
        <% end %>

        <% if params['cq'].present? %>
          <p id="search_param" class="filter-param">Search > <%= params['cq'] %> <i class="fa fa-times-circle" aria-hidden="true" data-behavior="remove-filter" data-form="media-filters" data-param="cq"></i></p>
        <% end %>
      </div>
      <div class="col-sm-2 col-lg-2 text-right"><a href="javascript:void(0)" class="remove-filter-all" aria-hidden="true" data-behavior="remove-filter" data-form="media-filters" data-param="all">Remove all <i class="fa fa-times-circle"></i></a></div>

    </div>
  <% end %>

<% end %>
