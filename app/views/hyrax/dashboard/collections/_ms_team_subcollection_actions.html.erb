<div class="text-right">
  <!-- Add a subcollection button -->
  <div>
    <div class="sr-only"><% t('morphosource.collection.actions.nest_collections.desc') %></div>
    <%= button_tag t('morphosource.collection.actions.nest_collections.button_label'),
      class: 'btn btn-primary add-subcollection',
      title: t('morphosource.collection.actions.nest_collections.desc'),
      data: { nestable: true,
              hasaccess: true,
              presenter_id: presenter.id } %>
  </div>

  <!-- Create new collection as subcollection link -->
  <div>
    <% if presenter.current_ability.can?(:create_collection_of_type, Hyrax::CollectionType.find_by(machine_id: "project")) %>
      <div class="sr-only"><% t('morphosource.collection.actions.add_new_nested_collection.desc') %></div>
      <%= link_to t('morphosource.collection.actions.add_new_nested_collection.label'),
      hyrax.dashboard_create_subcollection_under_path(parent_id: presenter.id, collection_type: "project"),
      title: t('morphosource.collection.actions.add_new_nested_collection.desc'),
      class: 'btn btn-link side-arrows' %>
    <% end %>
  </div>
</div>
