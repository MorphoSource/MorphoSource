<%# taken from _ms_linked_organization.html %>

<!-- TODO: removing form tags below makes add group form hit the collections controller - needs more investigation -->
<form></form>

<% if @current_user.admin? %>
  <div class="form-add-organization-wrapper">
    <div class="form-inline add-sharing-form sharing-row-form">
      <%= simple_form_for @collection,
          url: main_app.dashboard_collection_link_organization_path,
          method: 'post',
          html: { id: 'add-organization-form' } do |f| %>
        <%= f.select(:organization_id, unlinked_organizations, { prompt: "Select an organization", class: 'form-control'})  %> 
        <%= submit_tag 'Link to organization', class: 'btn btn-sm btn-default' %> 
        <a class="btn btn-link" href="javascript:void(0)">Remove organization</a>
      <% end %>
    </div>
  </div>
<% end %>

<div class="col-sm-6">
<% if @presenter.collection_type.machine_id == 'team' %>  
  <h2>ORGANIZATION</h2>
  <%= @presenter.attribute_to_html(:organization_title, label: 'Name', render_as: :showcase_default, include_empty: true, html_dl: false) %>
  <%= @presenter.attribute_to_html(:organization_institution_name, label: 'Institution', render_as: :showcase_default, include_empty: false, html_dl: false) %>
  <%= @presenter.attribute_to_html(:organization_institution_code, label: 'Institution code', render_as: :showcase_default, include_empty: false, html_dl: false) %>
  <%= @presenter.attribute_to_html(:organization_collection_code, label: 'Collection code', render_as: :showcase_default, include_empty: false, html_dl: false) %>
  <%= @presenter.attribute_to_html(:organization_description, label: 'Description', render_as: :showcase_default, include_empty: false, html_dl: false) %>
  <%= @presenter.attribute_to_html(:organization_address, label: 'Address', render_as: :showcase_default, include_empty: false, html_dl: false) %>
  <%= @presenter.attribute_to_html(:organization_city, label: 'City', render_as: :showcase_default, include_empty: false, html_dl: false) %>
  <%= @presenter.attribute_to_html(:organization_state_province, label: 'State/Province', render_as: :showcase_default, include_empty: false, html_dl: false) %>
  <%= @presenter.attribute_to_html(:organization_country, label: 'Country', render_as: :showcase_default, include_empty: false, html_dl: false) %>
<% end %>
</div>

<div class="col-sm-6">
  <h2>STATISTICS</h2>
  <div class="row">
    <div class="col-xs-6 showcase-label">Number of media</div>
    <div class="col-xs-6 showcase-value "><%= @media_member_count %></div>
  </div>
  <div class="row">
    <div class="col-xs-6 showcase-label">Number of represented specimens</div>
    <div class="col-xs-6 showcase-value "><%= @bso_member_count %></div>
  </div>
  <div class="row">
    <div class="col-xs-6 showcase-label">Number of represented cultural heritage objects</div>
    <div class="col-xs-6 showcase-value "><%= @cho_member_count %></div>
  </div>
  <div class="row">
    <div class="col-xs-6 showcase-label">Organization views</div>
    <div class="col-xs-6 showcase-value ">(Not yet implemented)</div>
  </div>
  <div class="row">
    <div class="col-xs-6 showcase-label">Number of media downloads</div>
    <div class="col-xs-6 showcase-value ">(Not yet implemented)</div>
  </div>
</div>
