<div class="checkbox-list" style="display: flex; flex-direction: row;">
  <div class="profile-column">
    <% values.each_with_index do |value, i| %>
      <% if (i + 1) <= ((values.count + 1)/2.0).round %>
        <%= f.check_box field, { multiple: true, checked: (@user.send(field.to_sym).include? value) }, value, false %>
        <%= f.label(field.to_sym, value) %>
        <br/>
      <% end %>
    <% end %>
  </div>
  <div class="profile-column" style="margin-left: 20px;">
    <% values.each_with_index do |value, i| %>
      <% if (i + 1) > ((values.count + 1)/2.0).round %>
        <%= f.check_box field, { multiple: true, checked: (@user.send(field.to_sym).include? value) }, value, false %>
        <%= f.label(field.to_sym, value) %>
        <br/>
      <% end %>
    <% end %>
    <%= f.label 'Other: ' %>
    <%= f.text_field field, { multiple: true, value: @user.send('other_'.concat(field).to_sym) } %>
  </div>
</div>
