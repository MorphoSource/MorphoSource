<%= form_for @user,
             url: hyrax.dashboard_profile_path(@user.to_param),
             html: { multipart: true, class: 'form-horizontal' } do |f| %>

<div class="row">
  <div class="col-sm-12 col-md-6">
    <%= render partial: 'hyrax/dashboard/profiles/edit_email', locals: {f: f} %>

    <div class="form-group">
      <%= f.label :avatar, t("morphosource.dashboard.profiles.edit_primary.change_picture").html_safe, class: "col-sm-4 control-label" %>
      <div class="col-sm-8">
        <div class="col-sm-7">
          <%= f.file_field :avatar %>
          <%= f.hidden_field :avatar_cache %>
        </div>
        <div class="col-sm-5">
          <% if @user.avatar? %>
            <%= image_tag @user.avatar.url(:thumb) %>
            <div class="checkbox">
              <%= f.label :remove_avatar do %>
                <%= f.check_box :remove_avatar %>
                <%= t("morphosource.dashboard.profiles.edit_primary.delete_picture") %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%= render partial: 'hyrax/dashboard/profiles/edit_profile_name_section', locals: {f: f} %>
    <%= render partial: 'hyrax/dashboard/profiles/ms_profile', locals: {f: f} %>
    <%= render partial: 'hyrax/dashboard/profiles/edit_sftp_share', locals: {f: f} %>
  </div>

  <div class="col-sm-12 col-md-6">
    <%= render partial: 'hyrax/dashboard/profiles/edit_profile_type_section', locals: {f: f} %>
    <%= render partial: 'hyrax/dashboard/profiles/edit_intent', locals: {f: f} %>  
  </div>

</div>

<div class="row">
  <div class='col-xs-12 text-center'>
    <%= render 'trophy_edit', trophies: @trophies %>
    <p>
      <%= f.check_box :terms_read, {checked: false, required: true}, true %>
      <%= t("devise.passwords.edit.terms").html_safe %>
    </p>
    <p><%= f.button t(".save_profile").html_safe, type: 'submit', class: "btn btn-primary btn-lg" %></p>
  </div>
</div>
<% end %>

<script>
  <%= render partial: 'hyrax/dashboard/profiles/ms_profile_scripts', formats: [:js] %>
</script>
