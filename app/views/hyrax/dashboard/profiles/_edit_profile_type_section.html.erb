  <div class="col-lg-6 col-md-12 block block-fill">
    <div class="form-group">
      <%= f.label :profile_type, t("morphosource.dashboard.profiles.edit_primary.profile_type").html_safe, class: 'col-sm-4 control-label' %>
      <div class="col-sm-8">
        <%= f.select_tag 'user[profile_type]', options_for_select(Morphosource::UserProfile::ProfileTypesHelper::PROFILE_TYPES, @user.profile_type), class: "form-control", include_blank: true, required: true %>
      </div>
    </div>
  </div>
  <div class="col-lg-6 col-md-12 float-right block block-fill">
    <%= render partial: 'hyrax/dashboard/profiles/ms_profile_metadata', collection: @all_metadata_fields.keys, as: :member, :locals => { f: f } %>

    <div class="checkbox-form-group">
      <%= f.label :demographics, t("morphosource.dashboard.profiles.edit_primary.demographics").html_safe, class: 'col-sm-4 control-label dg-group' %>
      <div class="col-sm-8 dg-group">
        <%= render partial: 'hyrax/dashboard/profiles/ms_profile_demographics', locals: {field: 'demographics', values: @all_demographics_values, f: f} %>
      </div>
    </div>
  </div>
