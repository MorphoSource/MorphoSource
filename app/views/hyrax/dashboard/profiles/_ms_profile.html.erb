  <div class="col-sm-8">
     <%= f.text_field :telephone, class: "form-control" %>
  </div>
</div>

<div class="checkbox-form-group">
  <%= f.label :demographics, t("morphosource.dashboard.profiles.edit_primary.demographics").html_safe, class: 'col-sm-4 control-label' %>
  <div class="col-sm-8">
    <%= render partial: 'hyrax/dashboard/profiles/checkbox_columns', locals: {field: 'demographics', values: Morphosource::UserProfile::CheckboxValues::DEMOGRAPHICS, f: f} %>
  </div>
</div>

<div class="checkbox-form-group">
  <%= f.label :intent, t("morphosource.dashboard.profiles.edit_primary.intent").html_safe, class: 'col-sm-4 control-label' %>
  <div class="col-sm-8">
    <div class="checkbox-list">
      <% intended_use = Morphosource::UserProfile::CheckboxValues::INTENT %>
      <% intended_use.each do |use| %>
        <%= f.check_box 'intent', { multiple: true, checked: (@user.intent.include? use) }, use, false %>
        <%= f.label :intent, use %>
        <br/>
      <% end %>
      <%= f.label 'Other: ' %>
      <%= f.text_field 'intent', { multiple: true, value: @user.other_intent } %>
    </div>
  </div>
</div>

<div class="checkbox-form-group">
  <%= f.label :software, t("morphosource.dashboard.profiles.edit_primary.software").html_safe, class: 'col-sm-4 control-label' %>
