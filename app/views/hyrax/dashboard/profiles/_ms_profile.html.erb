<div class="form-group">
  <%= f.label :country, t("morphosource.dashboard.profiles.edit_primary.country").html_safe, class: 'col-sm-4 control-label' %>
  <div class="col-sm-8">
    <%= f.select_tag 'user[country]', options_for_select(Morphosource::UserProfile::LocationHelper::COUNTRY, @user.country), class: "form-control", include_blank: true, :onchange => "updateStates();" %>
  </div>
</div>

<div class="form-group">
  <%= f.label :state, t("morphosource.dashboard.profiles.edit_primary.state").html_safe, class: 'col-sm-4 control-label' %>
  <div id='state-select' class="col-sm-8">
    <%= f.select_tag 'user[state]', options_for_select(Morphosource::UserProfile::LocationHelper::STATE['US'], @user.state), class: "form-control", include_blank: true %>
  </div>
  <div id='province-select' class="col-sm-8">
    <%= f.select_tag 'user[state]', options_for_select(Morphosource::UserProfile::LocationHelper::STATE['CA'], @user.state), class: "form-control", include_blank: true %>
  </div>
</div>

<div class="form-group">
