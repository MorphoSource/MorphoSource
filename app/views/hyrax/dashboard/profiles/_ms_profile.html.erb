<div class="form-group">
  <%= f.label :address, t("morphosource.dashboard.profiles.edit_primary.address").html_safe, class: 'col-sm-4 control-label' %>
  <div class="col-sm-8">
     <%= f.text_field :address, class: "form-control" %>
  </div>
</div>

<div class="form-group">
  <%= f.label :city, t("morphosource.dashboard.profiles.edit_primary.city").html_safe, class: 'col-sm-4 control-label' %>
  <div class="col-sm-8">
     <%= f.text_field :city, class: "form-control" %>
  </div>
</div>

<div class="form-group">
  <%= f.label :country, t("morphosource.dashboard.profiles.edit_primary.country").html_safe, class: 'col-sm-4 control-label required' %>
  <div class="col-sm-8">
    <%= f.select_tag 'user[country]', options_for_select(Morphosource::UserProfile::LocationHelper::COUNTRY, @user.country), class: "form-control", include_blank: true, required: true, :onchange => "updateStates();" %>
  </div>
</div>

<div class="form-group">
  <%= f.label :state, t("morphosource.dashboard.profiles.edit_primary.state").html_safe, class: 'col-sm-4 control-label required' %>
  <div id='state-select' class="col-sm-8">
    <%= f.select_tag 'user[state]', options_for_select(Morphosource::UserProfile::LocationHelper::STATE['US'], @user.state), class: "form-control", include_blank: true, required: true %>
  </div>
  <div id='province-select' class="col-sm-8">
    <%= f.select_tag 'user[state]', options_for_select(Morphosource::UserProfile::LocationHelper::STATE['CA'], @user.state), class: "form-control", include_blank: true, required: true %>
  </div>
</div>

<div class="form-group">
  <%= f.label :orcid, class: 'col-sm-4 control-label' do %>
    <%= orcid_label %>
  <% end %>
  <div class="col-sm-8">
     <%= f.text_field :orcid, class: "form-control" %>
  </div>
</div>

<div class="form-group">
  <%= f.label :social_media_handles, t("morphosource.dashboard.profiles.edit_primary.social_media_handles").html_safe, class: 'col-sm-4 control-label' %>
  <div class="col-sm-8">
     <%= f.text_field :social_media_handles, class: "form-control" %>
  </div>
</div>

<div class="form-group">
  <%= f.label :twitter_handle, t("morphosource.dashboard.profiles.edit_primary.twitter_handle").html_safe, class: 'col-sm-4 control-label' %>
  <div class="col-sm-8">
     <%= f.text_field :twitter_handle, class: "form-control" %>
  </div>
</div>

<div class="form-group">
  <%= f.label :facebook_handle, t("morphosource.dashboard.profiles.edit_primary.facebook_handle").html_safe, class: 'col-sm-4 control-label' %>
  <div class="col-sm-8">
     <%= f.text_field :facebook_handle, class: "form-control" %>
  </div>
</div>

<div class="form-group">
  <%= f.label :website, t("morphosource.dashboard.profiles.edit_primary.website").html_safe, class: 'col-sm-4 control-label' %>
  <div class="col-sm-8">
     <%= f.text_field :website, class: "form-control" %>
  </div>
</div>
