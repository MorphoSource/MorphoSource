<%# data-target contains profile types that use this metadata field (as required and optional field)
    data-target-require contains profile types that require this metadata field %>
<div class="form-group row" data-group="profile_type" 
  data-target="<%= @presenter.all_metadata_fields[member]&.join(',') %>"
  data-target-require="<%= @presenter.required_metadata_fields[member]&.join(',') %>">
  <%= f.label member, t("morphosource.dashboard.profiles.edit_primary."+member).html_safe, class: 'col-sm-4 control-label' %>
  <div class="col-sm-8">
   <%= f.text_field member, class: "form-control", required: false %>
  </div>
</div>
