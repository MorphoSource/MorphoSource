if ( $('form[id*="edit_user"]').length || $('form[id*="new_user"]').length ) {

  profileTypeConfig = <%= Hyrax.config.user_profile_type_config.to_json.html_safe %>;
  currProfType = mappedProfType($("#user_profile_type").val());
  var selectedProfType;
  var fieldsShown = [];
  var fieldsToWarn = [];
  var fieldsToClear = [];
  var demogToWarn = [];
  var demogToClear = [];
  var dgCheckboxesShown = [];
  isPageLoaded = false;
  currMetadataFields = [];

  function mappedProfType(label) {
    if (label == '') { // e.g. "universal"
      return '';
    } 
    for (var key in profileTypeConfig) {
      if (profileTypeConfig.hasOwnProperty(key) && profileTypeConfig[key].hasOwnProperty("label")) {
        if (profileTypeConfig[key]["label"] === label) {
          return key;
        }
      }
    }
    return null; 
  }

  function fieldLabel(f) {
    if ($('label[for='+ f + ']').length) {
      return $('label[for='+ f + ']').html();
    } else {
      return f;
    }
  }

  $.fn.setFieldRequired = function (isRequired) {
    return this.each(function () {
      if (isRequired) {
        $(this).find('label').addClass('required');
        $(this).find('input').prop('required', true);
      } else {
        $(this).find('label').removeClass('required');
        $(this).find('input').prop('required', false);
      }
    });
  };

  function handleProfileTypeChange() {
    metadataElements = $('.form-group[data-group="profile_type"]');
    demogElements = $('.checkbox-wrapper[data-group="profile_type"]');
    selectedProfType = mappedProfType($("#user_profile_type").val());
    fieldsShown = [];
    fieldsToWarn = [];
    fieldsToClear = [];
    demogToWarn = [];
    demogToClear = [];
    dgCheckboxesShown = [];

    metadataElements.each(function() {
      /* data-target contains profile types that use this metadata field (as required and optional field)
         data-target-require contains profile types that require this metadata field */
      let dataTarget = $(this).data("target").split(",");
      let dataTargetRequire = $(this).data("target-require").split(",");
      // show/hide metadata field
      if (dataTarget.includes(selectedProfType)) {
        $(this).addClass('show').removeClass('hide');
        fieldsShown.push($(this).find('input').attr('id'));
      } else {
        $(this).addClass('hide').removeClass('show');
        fieldsToClear.push($(this).find('input').attr('id'));
      }
      // enable/disable required metadata fields
      if (dataTargetRequire.includes(selectedProfType)) {
        $(this).find('label').addClass('required');
        $(this).find('input').prop('required', true);
      } else {
        $(this).find('label').removeClass('required');
        $(this).find('input').prop('required', false);
      }
    });

    demogElements.each(function() {
      // data-target contains profile types associated with the demographic value 
      let dataTarget = $(this).data("target").split(",");
      // show/hide demographic checkbox
      if (dataTarget.includes(selectedProfType)) {
        $(this).addClass('show').removeClass('hide');
        dgCheckboxesShown.push($(this).find('input[type="checkbox"]'));
      } else {
        $(this).addClass('hide').removeClass('show');
        let demogCheckbox = $(this).find('input[type="checkbox"]');
        if (demogCheckbox.is(':checked') && demogCheckbox.val() != "") {
          demogToWarn.push(demogCheckbox.val());
        }
        demogToClear.push(demogCheckbox.val());
      }
    });

    if (selectedProfType != 'collection_or_facility_organization_group') {
      $('.form-group.first_name, .form-group.last_name').setFieldRequired(true);
      $('.form-group.first_name, .form-group.last_name, .form-group.middle_name').addClass('show').removeClass('hide');
      $('.form-group.display_name').find('input').val('');
      $('.form-group.display_name').setFieldRequired(false).addClass('hide').removeClass('show');
      $('.form-group.display_name label').html('Display Name');
    } else {
      $('.form-group.first_name, .form-group.last_name').setFieldRequired(false);
      $('.form-group.first_name, .form-group.last_name, .form-group.middle_name').find('input').val('');
      $('.form-group.first_name, .form-group.last_name, .form-group.middle_name').addClass('hide').removeClass('show');
      $('.form-group.display_name').setFieldRequired(true).addClass('show').removeClass('hide');
      $('.form-group.display_name label').html('Organization Name');
    }

    if (selectedProfType != '' && selectedProfType != 'collection_or_facility_organization_group') {
      $('.dg-group').addClass('show').removeClass('hide');
      if (dgCheckboxesShown.length == 1) {
        // check the only demog checkbox available
        dgCheckboxesShown[0].prop('checked', true);
      }
    } else {
      $('.dg-group').addClass('hide').removeClass('show');
    }

    if ( $('form[id*="edit_user"]').length && isPageLoaded) {
      msg = '';
      fieldsToWarn = currMetadataFields.filter(item => !fieldsShown.includes(item));
      if (fieldsToWarn.length > 0) {
        let labels = fieldsToWarn.map(f => fieldLabel(f)).join(', ');
        msg += '<li>Any existing values of the following fields not associated with the selected profile type will be cleared: <b>' + labels + '</b></li>';
      }
      if (demogToWarn.length > 0) {
        msg += '<li>The following professions not associated with the selected profile type will be removed: <b>' + demogToWarn.join(', ') + '</b></li>';
      }
      if (msg != '') {
        $.alert({
          title: '',
          content: 'You have changed the profile type. When you click Save:<ul class="align-li">' + msg + '</ul>',
          columnClass: 'medium'
        });
      }
    }
  } // handleProfileTypeChange

  $('form[id*="_user"]').submit(function(event) {
    // clear all fields that are not associated with the selected profile type 
    $.each(fieldsToClear, function(idx, id) {
      $("#"+id).val("");
    });
    // uncheck all demographic categories that are not associated with the selected profile type 
    $.each(demogToClear, function(idx, value) {
      $('[type="checkbox"][value="' + value + '"]').prop("checked", false);;
    });      

    if (selectedProfType != 'collection_or_facility_organization_group') { // group account does not require demographics
      if ($('[name="user[demographics][]"]').filter(':checked').length == 0) {
        $.alert('Please choose one or more professions');
        return false;
      }      
    }
  });

  handleProfileTypeChange();

  $('#user_profile_type').change(function() {
    handleProfileTypeChange();
  });

}

// Change state select options based on country
function updateStates() {
  let country = $('#user_country').val();
  let states = $('#state-select');
  let provinces = $('#province-select');
  let statesSelect = $('#state-select select');
  let provincesSelect = $('#province-select select');
  if (country == "US") {
    // disable provinces
    provinces.hide();
    provincesSelect.prop("disabled",true);
    // enable states
    statesSelect.prop("disabled", false);
    states.show();
  } else if (country == "CA") {
    // disable states
    states.hide();
    statesSelect.prop("disabled",true);
    // enable provinces
    provincesSelect.prop("disabled", false);
    provinces.show();
  } else {
    // disable everything
    statesSelect.prop("disabled",true);
    provincesSelect.prop("disabled",true);
    // hide provinces
    provinces.hide();
    states.show();
    // clear everything
    provincesSelect.val('');
    statesSelect.val('');
  }
}

$(document).ready(function() {

  if ( $('form[class*="edit_profile_type"]').length ) { 
    setTimeout(() => { $('input[type="hidden"]').val(''); window.location.href='/users/sign_in'; }, 3600000); 
  }

  if ( $('form[id*="edit_user"]').length ) {    
    // get the current metadata fields for removal later if user profile type is changed
    $("div.form-group.show[data-group='profile_type'] input").each(function() {
      currMetadataFields.push($(this).attr('id')); 
    });
  }
  isPageLoaded = true;

  updateStates();
  // TBD: consider this more carefully - Devise wraps fields with a special class when validation fails, which so far is only messing up the layout of the elements. Below removes for now. 
  $(".field_with_errors").contents().unwrap();
});