<% content_for :body_css_classes do %>showcase profile<% end %>
<% provide :page_header do %>
  <h1><span class="fa fa-id-card" aria-hidden="true"></span> Edit Profile</h1>
<% end %>
<div class="panel panel-default">
  <div class="panel-body">
    <div class="col-sm-12">
      <div class="block-padding-11 mb-1">
        <%= t("morphosource.dashboard.profiles.edit_form_instructions").html_safe %>
      </div>
    </div>
    <div class="col-sm-12 profile">
      <%= render 'edit_primary' %>
    </div>

    <div class="col-sm-12 profile">
      <%= render 'edit_secondary' %>
    </div>
  </div>
</div>
