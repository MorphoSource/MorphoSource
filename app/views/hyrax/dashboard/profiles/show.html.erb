<% content_for :body_css_classes do %>showcase profile<% end %>

<% provide :page_header do %>
  <div class="col-12 no-horizontal-padding">
    <h1>
      <span class="fa fa-id-card" aria-hidden="true"></span>
      <%= t("hyrax.admin.sidebar.profile") %>
      <% if can? :edit, @user %>
        <div class="float-right">
          <% if @user == current_user || current_user.admin? %>
            <%= link_to hyrax.edit_dashboard_profile_path(@user), class: "btn btn-primary" do %>
              <%= t("hyrax.edit_profile") %>
            <% end %>
          <% end %>
          <% if @user == current_user %>
            <%= link_to main_app.profile_edit_password_path(@user), class: "btn btn-primary" do %>
              <%= t("hyrax.update_password") %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </h1>
  </div>
<% end %>

<div class="col-12 flash-wrapper">
  <%= render "/flash_msg" %>
</div>

<div class="card panel-default">
  <div class="card-body">
    <div class="list-group">
      <div class="list-group-item">
        <%= render partial: 'hyrax/users/user_info', locals: { user: @user, field_list: @presenter.display_fields } %>
      </div>
      <%= render "hyrax/users/vitals", user: @user %>
      <% if @presenter.trophies.any? %>
        <div class="list-group-item">
          <%= render 'hyrax/users/contributions', presenter: @presenter %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<% if can? :edit, @user %>
  <div class="landing card panel-default">
    <div class="card-body">
      <div class="list-group">
        <div class="list-group-item">
          <div><h2>User Settings</h2></div>
            <%= form_for @user, url: hyrax.dashboard_profile_path(@user) do |f| %>
              <div class="row form-group no-horizontal-padding">
                <%= f.label :communication_preference, class: "col-4 col-sm-4 control-label", style: "display: flex; align-items: center" do |l| %>
                  <%= t("morphosource.dashboard.profiles.communication_preference") %>
                  <i class="material-icons md-18 tooltip-icon" data-toggle="tooltip" data-placement="top" title="<%= t("morphosource.dashboard.profiles.communication_preference_hint") %>"></i>
                <% end %>
                <div class="col-8 col-sm-8">
                  <%= f.select :communication_preference, User.communication_preferences.keys.map { |k| [k.humanize, k] }, {}, class: "form-control" %>
                </div>
              </div>
              <div class="d-flex justify-content-end">
                <%= f.submit t("morphosource.dashboard.profiles.save_settings"), class: "btn btn-primary" %>
              </div>
            <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="landing card panel-default">
    <div class="card-body">
      <div class="list-group">
        <div class="list-group-item">
          <div><h2>Advanced User Functions</h2></div>
          <div class="action-section">
            <div class="list-item">
              <%= link_to 'View API Key', main_app.profile_show_path, id: "view-api-key" %>
              <i class="material-icons md-18 tooltip-icon" data-toggle="tooltip" data-placement="top" title="<%= t("morphosource.dashboard.profiles.view_api_key") %>"></i>
            </div>
            <div class="list-item">
              <%= link_to 'Generate New API Key', main_app.profile_generate_new_api_key_path %>
              <i class="material-icons md-18 tooltip-icon" data-toggle="tooltip" data-placement="top" title="<%= t("morphosource.dashboard.profiles.generate_new_api_key")%>"></i>
            </div>
            <div class="list-item">
              <%= link_to 'API Documentation', 'https://morphosource.stoplight.io/docs/morphosource-api', target: :_blank %>
              <i class="fas fa-external-link-alt fa-sm" style="margin-left: 5px;"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  <div>

  <%= render(partial: 'api_key_modal') %>
<% end %>

<script>
  $(document).ready(function() {
    $('a#view-api-key').click(function(event){
      event.preventDefault();
      $('#apiKeyModal').modal();
    });
  });
</script>