<% provide :page_title, 'Dashboard' %>

<% provide :page_header do %>
    <div class="col-xs-12">
      <div class="row landing-header">
        <div>
          <%= image_tag(Hyrax.config.logo_image, size: '60') %>
        </div>
        <div>
          <span>
            Welcome <%= current_user.display_name.present? ? current_user.display_name : "to MorphoSource" %>!
            The dashboard provides many different tools to create and manage records.
          </span>
        </div>
    </div>
  <% end %>

<div class="landing panel">
  <div class="panel-body">
  <div class="col-xs-12 actions">
    <div class="row">
      <% if current_user.contributor? || current_user.admin? %>
        <div class="col-xs-12 col-md-6 action-section">
          <div>
            <h2 style="font-size: large;">Contributor Actions</h2>
          </div>

          <div>
            <div>
              <div class="list-category"><i class="fas fa-folder-plus"></i>Create a new record</div>

              <div class="action-section">
                <div class="list-item">
                  <%= link_to "New project", main_app.new_project_path %>
                  <i class="material-icons md-18 tooltip-icon"><p class="hint hide"><%= t("morphosource.glossary.projects") %></p></i>
                </div>

                <div class="list-item">
                  <%= link_to "New team", main_app.new_team_path %>
                  <i class="material-icons md-18 tooltip-icon"><p class="hint hide"><%= t("morphosource.glossary.teams") %></p></i>
                </div>

                <div class="list-item">
                  <%= link_to "New media", main_app.new_submission_path %>
                  <i class="material-icons md-18 tooltip-icon"><p class="hint hide"><%= t("morphosource.dashboard.landing_page.hints.new_media") %></p></i>
                </div>
              </div>
            </div>

            <div class="action-section">
              <div class="list-category"><i class="fas fa-eye"></i>View my existing records</div>

              <div>
                <div class="list-item">
                  <%= link_to "My projects", main_app.my_projects_path %>
                  <i class="material-icons md-18 tooltip-icon"><p class="hint hide"><%= t("morphosource.dashboard.landing_page.hints.my_projects") %></p></i>
                </div>
                <div class="list-item">
                  <%= link_to "My teams", main_app.my_teams_path %>
                  <i class="material-icons md-18 tooltip-icon"><p class="hint hide"><%= t("morphosource.dashboard.landing_page.hints.my_teams") %></p></i>
                </div>
                <div class="list-item">
                  <%= link_to "My media and physical objects", main_app.my_media_index_path %>
                  <i class="material-icons md-18 tooltip-icon"><p class="hint hide"><%= t("morphosource.dashboard.landing_page.hints.my_media_and_objects") %></p></i>
                </div>
              </div>
            </div>

            <div class="action-section">
              <div class="list-category"><i class="fas fa-tasks"></i>Manage my existing records</div>

              <div>
                <div class="list-item">
                  <%= link_to "Approve or deny download requests from other users", main_app.request_manager_path %>
                  <i class="material-icons md-18 tooltip-icon"><p class="hint hide"><%= t("morphosource.dashboard.landing_page.hints.requests_manager") %></p></i>
                </div>
              </div>
            </div>

          </div>
        </div>
      <% end %>

      <div class="col-xs-12 col-md-6 action-section">
        <div>
          <h2 style="font-size: large;">Standard Actions</h2>
        </div>

        <div>
          <div class="list-item">
            <div><%= link_to "View my media cart", main_app.my_cart_path %></div>
            <i class="material-icons md-18 tooltip-icon"><p class="hint hide"><%= t("morphosource.dashboard.landing_page.hints.my_media_cart") %></p></i>
          </div>
          <div class="list-item">
            <div><%= link_to "View my pending requests to download media", main_app.my_requests_path %></div>
            <i class="material-icons md-18 tooltip-icon"><p class="hint hide"><%= t("morphosource.dashboard.landing_page.hints.my_pending_requests") %></p></i>
          </div>
          <div class="list-item"><%= link_to "Edit my user profile", edit_dashboard_profile_path(id: current_user.user_key) %></div>
          <div class="list-item"><%= link_to "Change my password", main_app.profile_edit_password_path(id: current_user.user_key) %></div>
        </div>
      </div>

      <% if !current_user.contributor? && !current_user.admin? %>
        <div class="col-xs-12 col-md-6 action-section">
          <div>
            <h2 style="font-size: large;">Become A Contributor</h2>
          </div>

          <div>
            <p>
              <%= t("morphosource.dashboard.landing_page.full_text.become_a_contributor").html_safe %>
            </p>
          </div>
        </div>
      <% end %>

      <% if current_user.admin? %>
        <div class="col-xs-12 col-md-6 action-section">
          <div>
            <h2 style="font-size: large;">Administrator Actions</h2>
          </div>

          <div>
            <div class="list-item">
              <%= link_to "Decide contributor applications", main_app.admin_contributor_petitions_path %>
              <% if ( petition_count = ContributorPetition.where(decision_required: true).count ) > 0 %>
                  <span class="count label label-danger" style="vertical-align: text-top; margin-left: 5px; font-size: small;">
                    <%= number_with_delimiter(petition_count, :delimiter => ',') %>
                  </span>
                <% end %>
            </div>
            <div class="list-item"><%= link_to "Create new organization", main_app.new_hyrax_organization_path %></div>
            <div class="list-item"><%= link_to "Create new device", main_app.new_hyrax_device_path %></div>
            <div class="list-item"><%= link_to "View and search users", hyrax.users_path %></div>
            <div class="list-item">
              <%= link_to "Background job dashboard", "/queues", target: '_blank' %>
              <i class="fas fa-external-link-alt" style="margin-left: 5px;"></i> 
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
$(function(){
  setupTooltip();
});
</script>
