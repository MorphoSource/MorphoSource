<% if menu.show_configuration? %>
    <li class="h5 nav-item"><%= t('morphosource.dashboard.sidebar.admin_tools.title') %></li>
    <li class="nav-item">
      <%= menu.collapsable_section t('morphosource.dashboard.sidebar.admin_tools.content.title'),
        icon_class: "fa fa-box",
        id: 'collapseContent',
        open: [
          Rails.application.routes.url_helpers.admin_downloads_path,
          Rails.application.routes.url_helpers.admin_requests_path,
          hyrax.dashboard_works_path,
          hyrax.my_works_path,
          hyrax.admin_stats_path,
          Rails.application.routes.url_helpers.remote_file_health_path
        ].any? { |path| current_page?(path) } do %>

        <%= menu.nav_link(Rails.application.routes.url_helpers.admin_jobs_path, class: "nav-link") do %>
          <span class="fa fa-robot" aria-hidden="true"></span> <span class="sidebar-action-text"><%= t('morphosource.dashboard.sidebar.admin_tools.content.all_background_jobs') %></span>
        <% end %>

        <%= menu.nav_link(Rails.application.routes.url_helpers.admin_downloads_path, class: "nav-link") do %>
          <span class="fa fa-download" aria-hidden="true"></span> <span class="sidebar-action-text"><%= t('morphosource.dashboard.sidebar.admin_tools.content.all_downloads') %></span>
        <% end %>

        <%= menu.nav_link(Rails.application.routes.url_helpers.admin_requests_path, class: "nav-link") do %>
          <span class="fa fa-tasks" aria-hidden="true"></span> <span class="sidebar-action-text"><%= t('morphosource.dashboard.sidebar.admin_tools.content.all_requests') %></span>
        <% end %>

        <%= menu.nav_link(hyrax.dashboard_works_path, class: "nav-link", also_active_for: hyrax.my_works_path) do %>
          <span class="fa fa-file" aria-hidden="true"></span> <span class="sidebar-action-text"><%= t('morphosource.dashboard.sidebar.admin_tools.content.works') %></span>
        <% end %>

        <%= menu.nav_link(hyrax.admin_stats_path, class: "nav-link") do %>
          <span class="fa fa-chart-bar" aria-hidden="true"></span> <span class="sidebar-action-text"><%= t('morphosource.dashboard.sidebar.admin_tools.content.statistics') %></span>
        <% end %>

        <%= menu.nav_link(Rails.application.routes.url_helpers.remote_file_health_path, class: "nav-link") do %>
          <span class="fa fa-heartbeat" aria-hidden="true"></span> <span class="sidebar-action-text"><%= t('morphosource.dashboard.sidebar.admin_tools.content.remote_file_health') %></span>
        <% end %>

      <% end %>
    </li>

    <li class="nav-item">
      <%= menu.collapsable_section t('morphosource.dashboard.sidebar.admin_tools.management.title'),
          icon_class: "fa fa-gavel",
          id: 'collapseManagement',
          open: [
          main_app.admin_contributor_petitions_path,
          main_app.admin_data_curation_path,
          main_app.admin_fund_codes_path,
          main_app.fund_code_charges_path
        ].any? { |path| current_page?(path) } do %>

        <%= menu.nav_link(main_app.admin_contributor_petitions_path, class: "nav-link") do %>
          <span class="fa fa-award" aria-hidden="true"></span> <span class="sidebar-action-text">
            <%= t('morphosource.dashboard.sidebar.admin_tools.management.contributor_applications') %>
            <% if ( petition_count = ContributorPetition.where(decision_required: true).count ) > 0 %>
              <span class="count badge badge-danger" style="vertical-align: text-top;">
                <%= number_with_delimiter(petition_count, :delimiter => ',') %>
              </span>
            <% end %>
          </span>
        <% end %>

        <%= menu.nav_link(main_app.admin_data_curation_path, class: "nav-link") do %>
          <span class="fa fa-database" aria-hidden="true"></span> <span class="sidebar-action-text"><%= t('morphosource.dashboard.sidebar.admin_tools.management.data_curation') %></span>
        <% end %>

        <%= menu.nav_link(main_app.admin_fund_codes_path, class: "nav-link") do %>
          <span class="fa fas fa-file-invoice" aria-hidden="true"></span> <span class="sidebar-action-text"><%= t('morphosource.dashboard.sidebar.admin_tools.management.fund_codes') %></span>
        <% end %>

        <%= menu.nav_link(main_app.fund_code_charges_path, class: "nav-link") do %>
          <span class="fa fas fa-money-check-alt" aria-hidden="true"></span> <span class="sidebar-action-text"><%= t('morphosource.dashboard.sidebar.admin_tools.management.fund_code_charges') %></span>
        <% end %>

        <%= menu.nav_link(main_app.admin_import_slides_path, class: "nav-link") do %>
          <span class="fa fa-upload" aria-hidden="true"></span> <span class="sidebar-action-text"><%= t('morphosource.dashboard.sidebar.admin_tools.management.import_slides') %></span>
        <% end %>
      <% end %>
    </li>

    <li class="nav-item">
      <%= menu.collapsable_section t('hyrax.admin.sidebar.settings'),
        icon_class: "fa fa-cog",
        id: 'collapseSettingsMS',
        open: [
          hyrax.admin_appearance_path,
          hyrax.admin_features_path,
          *(Hyrax.config.enable_identity_provider? ? [main_app.oauth_applications_path] : [])
        ].any? { |path| current_page?(path) } do %>

        <%= menu.nav_link(hyrax.admin_appearance_path) do %>
          <span class="fa fa-paint-brush" aria-hidden="true"></span> <span class="sidebar-action-text"><%= t('hyrax.admin.sidebar.appearance') %></span>
        <% end %>
        <%= menu.nav_link(main_app.admin_homepage_path) do %>
          <span class="fa fa-home" aria-hidden="true"></span> <span class="sidebar-action-text"><%= t('morphosource.admin.sidebar.homepage') %></span>
        <% end %>
        <%= menu.nav_link(main_app.admin_banner_path) do %>
          <span class="fa fa-flag" aria-hidden="true"></span> <span class="sidebar-action-text"><%= t('morphosource.admin.sidebar.banner') %></span>
        <% end %>
        <%= menu.nav_link(main_app.admin_modal_path) do %>
          <span class="fa fa-pager" aria-hidden="true"></span> <span class="sidebar-action-text"><%= t('morphosource.admin.sidebar.modal') %></span>
        <% end %>
        <%= menu.nav_link(main_app.admin_download_modal_path) do %>
          <span class="fa fa-pager" aria-hidden="true"></span> <span class="sidebar-action-text"><%= t('morphosource.admin.sidebar.download_modal') %></span>
        <% end %>
        <%= menu.nav_link(hyrax.admin_features_path) do %>
          <span class="fa fa-wrench" aria-hidden="true"></span> <span class="sidebar-action-text"><%= t('hyrax.admin.sidebar.technical') %></span>
        <% end %>
        <%= menu.nav_link(Rails.application.routes.url_helpers.admin_pages_path) do %>
          <span class="fa fa-newspaper" aria-hidden="true"></span> <span class="sidebar-action-text"><%= t('morphosource.admin.sidebar.simple_pages') %></span>
        <% end %>
        <% if Hyrax.config.enable_identity_provider? %>
          <%= menu.nav_link(main_app.oauth_applications_path) do %>
            <span class="fa fa-key" aria-hidden="true"></span> <span class="sidebar-action-text"><%= t('morphosource.admin.sidebar.oauth_applications') %></span>
          <% end %>
        <% end %>
      <% end %>
    </li>
<% end %>
