<% if Flipflop.proxy_deposit? || current_user.fund_codes.present? %>
  <li class="h5"><%= t('hyrax.admin.sidebar.contributor_tools') %></li>

  <%= menu.nav_link(Rails.application.routes.url_helpers.jobs_path) do %>
      <span class="fa fa-robot" aria-hidden="true"></span> <span class="sidebar-action-text"><%= t('hyrax.admin.sidebar.background_jobs') %></span>
    <% end %>

  <% if current_user.batch_submission_contributor? %>
    <%= menu.nav_link(main_app.batch_submissions_path) do %>
      <span class="fa fa-upload" aria-hidden="true"></span> <span class="sidebar-action-text"><%= t('hyrax.admin.sidebar.batch_submission') %></span>
    <% end %>
  <% end %>

  <% if current_user.fund_codes.present? %>
    <%= menu.nav_link(main_app.my_fund_codes_path) do %>
      <span class="fa fas fa-file-invoice" aria-hidden="true"></span> <span class="sidebar-action-text"><%= t('hyrax.dashboard.fund_codes') %></span>
    <% end %>
  <% end %>

  <% if Flipflop.proxy_deposit? %>
    <%= menu.nav_link(hyrax.depositors_path) do %>
      <span class="fa fa-users" aria-hidden="true"></span> <span class="sidebar-action-text"><%= t('hyrax.dashboard.manage_proxies') %></span>
    <% end %>
  <% end %>
<% end %>