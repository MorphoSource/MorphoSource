<li class="h5 nav-item"><%= t('morphosource.dashboard.sidebar.my_media.title') %></li>

<%= menu.nav_link(Rails.application.routes.url_helpers.my_media_index_path, class: "nav-link") do %>
  <span class="fa fa-cube" aria-hidden="true"></span>
  <span class="sidebar-action-text">
    <%= t('morphosource.dashboard.sidebar.my_media.media_and_objects') %>
  </span>
<% end %>

<% if current_user.contributor? %>
  <%= menu.nav_link(main_app.request_manager_path, class: "nav-link") do %>
    <span class="fa fa-tasks" aria-hidden="true"></span>
    <span class="sidebar-action-text">
      <%= t('morphosource.dashboard.sidebar.my_media.new_requests_for_my_media') %>
    </span>
  <% end %>

  <%= menu.nav_link(main_app.previous_requests_path, class: "nav-link") do %>
    <span class="fa fas fa-stopwatch" aria-hidden="true"></span>
    <span class="sidebar-action-text">
      <%= t('morphosource.dashboard.sidebar.my_media.previous_requests') %>
    </span>
  <% end %>

  <%= menu.nav_link(main_app.transfers_received_path, class: "nav-link") do %>
    <span class="fa fas fa-arrow-down" aria-hidden="true"></span>
    <span class="sidebar-action-text">
      <%= t('morphosource.dashboard.sidebar.my_media.transfers_received') %>
    </span>
  <% end %>

  <%= menu.nav_link(main_app.transfers_sent_path, class: "nav-link") do %>
    <span class="fa fas fa-arrow-up" aria-hidden="true"></span>
    <span class="sidebar-action-text">
      <%= t('morphosource.dashboard.sidebar.my_media.transfers_sent') %>
    </span>
  <% end %>
<% end %>


