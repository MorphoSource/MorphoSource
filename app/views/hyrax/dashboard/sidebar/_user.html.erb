<li class="h5 nav-item"><%= t('morphosource.dashboard.sidebar.user.title') %></li>

<%= menu.nav_link(hyrax.dashboard_profile_path(current_user), also_active_for: hyrax.edit_dashboard_profile_path(current_user), class: "nav-link") do %>
  <span class="fa fa-id-card" aria-hidden="true"></span> <span class="sidebar-action-text"><%= t('morphosource.dashboard.sidebar.user.profile') %></span>
<% end %>

<% if !current_user.contributor? && !current_user.admin? %>
  <%= menu.nav_link(main_app.user_contributor_petition_path, class: "nav-link") do %>
    <span class="fa fa-award" aria-hidden="true"></span> <span class="sidebar-action-text"><%= t('morphosource.dashboard.sidebar.user.become_a_contributor') %></span>
  <% end %>
<% end %>

<%= menu.nav_link(hyrax.notifications_path, class: "nav-link") do %>
  <span class="fa fa-bell" aria-hidden="true"></span> <span class="sidebar-action-text"><%= t('morphosource.dashboard.sidebar.user.notifications') %></span>
<% end %>
