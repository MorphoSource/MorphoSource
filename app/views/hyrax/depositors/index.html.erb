<% end %>

<div class="row no-horizontal-padding">
  <div class="col-md-12">
    <div class="panel">
      <div class="panel-body">
        <%= render 'hyrax/dashboard/_index_partials/proxy_rights', user: @user %>
      </div>
      <div class="panel-body">
        <%= render 'hyrax/dashboard/_index_partials/proxy_for', user: @user %>
      </div>
    </div>
  </div>
</div>