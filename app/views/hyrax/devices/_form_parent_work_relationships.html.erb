<% selected_org_id = f.object.organization_id&.first || @organization&.id %>
<% selected_org_label = @organization&.title&.first %>
<div class="form-group" id="device-organization-selector">
  <%= f.label :find_parent_work, t("hyrax.devices.form_parent_work_relationships.actions.add") %>
  <div class="form-inline">
  <%= f.input_field :find_organization,
                    prompt: :translate,
                    id: 'device_find_organization',
                    autocomplete: 'off',
                    placeholder: 'Enter organization name',
                    data: {
                      autocomplete: 'work',
                      'autocomplete-url' => find_organizations_for_device_autocomplete_url
                    } %>
    <a class="btn btn-primary mt-1" id="btn-select-device-organization">Select</a>
    <a class="btn btn-primary mt-1 ml-1" id="btn-no-device-organization">No organization</a>
  </div>
  <div class="mt-2">
    Selected organization:
    <span id="selected-device-organization-label"><%= selected_org_label || (selected_org_id.present? ? selected_org_id : 'None') %></span>
  </div>
  <%= f.input :organization_id, as: :hidden, input_html: { id: 'device_resource_organization_id', value: selected_org_id, multiple: true } %>
</div>
