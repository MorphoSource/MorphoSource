<div class="row">
  <h1><%= t("hyrax.works.#{controller.action_name}.header", type: curation_concern.human_readable_type) %></h1>
  <div class="showcase w-100">
    <div class="super-title fixedsticky float-left"><%= @organization&.title&.first %></div>
    <div id="savewidget" class="col-sm-4 fixedsticky float-right" role="complementary">
      <%= f.submit class: 'btn btn-primary float-right', onclick: "confirmation_needed = false;", id: "with_files_submit", name: "save_with_files" %>
    </div>
  </div>
</div>
<div class="row">
    <div class="col-12 mt-2 card panel-default tabs" role="main">
      <!-- Tab panes -->
      <div class="tab-content">
        <div class="form-tab-content">
          <div class="base-terms">
            <%# f.object.primary_terms.each do |term| %>
              <%#= render_edit_field_partial(term, f: f) %>
            <%# end %>
            <%= f.input :title, input_html: { multiple: false } %>
            <%= f.input :creator %>
            <%= render_edit_field_partial(:modality, f: f) %>
            <%= render_edit_field_partial(:identifier, f: f) %>
            <%= f.input :description, as: :text,
            input_html: { value: Array(f.object.description).first.to_s } %>

            <% if params[:organization_id] %>
              <%= hidden_field_tag 'from_org_id', params[:organization_id] %>
            <% end %>
            <% if current_user&.admin? %>
              <%= render 'form_admin', f: f %>
            <% else %>
              <%= f.input :organization_id, as: :hidden, input_html: { value: @organization&.id, multiple: true } %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
</div>