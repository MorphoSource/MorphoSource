<h2>GENERAL DETAILS</h2>

<%= presenter.attribute_to_html(:work_id, label: t('simple_form.labels.device.id'), render_as: :showcase_default, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:title, label: t('simple_form.labels.device.title'), render_as: :showcase_default, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:creator, label: t('simple_form.labels.device.creator'), render_as: :showcase_default, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:device_modality, label: t('simple_form.labels.device.modality'), render_as: :showcase_default, include_empty: true, value_per_line: true) %>
<%= presenter.attribute_to_html(:description, label: t('simple_form.labels.device.description'), render_as: :showcase_default, include_empty: false, html_dl: false, css_classes: 'break-all') %>
<%= presenter.attribute_to_html(:ark, render_as: :showcase_ark_link, include_empty: true, text_if_empty: 'Not assigned') %>
<%= presenter.attribute_to_html(
	:device_organization_title,
	label: 'Organizations',
	link: presenter.device_organization_link,
	render_as: :showcase_link, include_empty: false, value_per_line: true) %>
