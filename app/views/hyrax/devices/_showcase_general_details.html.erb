<h2>GENERAL DETAILS</h2>

<%= presenter.attribute_to_html(:work_id, label: "Device ID", render_as: :showcase_default, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:title, label: 'Model', render_as: :showcase_default, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:creator, label: 'Manufacturer', render_as: :showcase_default, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:device_modality, label: 'Modality', render_as: :showcase_default, include_empty: true, value_per_line: true) %>
<%= presenter.attribute_to_html(:description, label: 'Description', render_as: :showcase_default, include_empty: false, html_dl: false, css_classes: 'break-all') %>
<%= presenter.attribute_to_html(:ark, render_as: :showcase_ark_link, include_empty: true, text_if_empty: 'Not assigned') %>
<%= presenter.attribute_to_html(:organization_id, label: 'Organizations', render_as: :showcase_page_link, include_empty: false, value_per_line: true) %>

