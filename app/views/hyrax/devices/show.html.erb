<% content_for :body_css_classes do %>showcase showcase2<% end %>
<% content_for :content_css_classes do %>fixed-width<% end %>

<div class="device-showcase">
  <%= render @presenter.showcase_work_title_partial, presenter: @presenter %>

  <div class="row showcase2-row">
    <div class="col-md-6 order-md-2">
      <div class="content-block">
        <%= render @presenter.showcase_media_items_partial, presenter: @presenter %>
      </div>
    </div>

    <div class="col-md-6 order-md-1">
      <div class="content-block">
        <%= render @presenter.showcase_general_details_partial, presenter: @presenter %>
      </div>
    </div>
  </div>
</div> <!--device-showcase -->
