<h2>GENERAL DETAILS</h2>

<%= presenter.attribute_to_html(:work_id, label: "Specimen ID", render_as: :showcase_default, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:description, label: 'Description', render_as: :showcase_default, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:institution_code, label: t('simple_form.labels.engineering_object.institution_code'), render_as: :showcase_default, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:catalog_number, label: t('simple_form.labels.engineering_object.catalog_number'), render_as: :showcase_default, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:is_pak, label: t('simple_form.labels.engineering_object.is_pak'), render_as: :showcase_default, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:is_built_in_fiducials_present, label: t('simple_form.labels.engineering_object.is_built_in_fiducials_present'), render_as: :showcase_default, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:snl_assembler, label: t('simple_form.labels.engineering_object.snl_assembler'), render_as: :showcase_default, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:assembly_date, label: t('simple_form.labels.engineering_object.assembly_date'), render_as: :showcase_date, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:anonymize_origin, label: t('simple_form.labels.engineering_object.anonymize_origin'), render_as: :showcase_default, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:anonymize_meta_data, label: t('simple_form.labels.engineering_object.anonymize_meta_data'), render_as: :showcase_default, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:date_created, label: presenter.date_created_label, render_as: :showcase_date, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:preparation_notes, label: t('simple_form.labels.engineering_object.preparation_notes'), render_as: :showcase_default, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:date_uploaded, render_as: :showcase_date, include_empty: true, html_dl: false) %>
<% if presenter.parent_organization.present? %>
	<%= presenter.attribute_to_html(
    :parent_organization_title, 
    label: 'Organization', 
    link: Rails.application.routes.url_helpers.hyrax_organization_path(presenter.parent_organization.id), 
    render_as: :showcase_organization_title, 
    html_dl: false) 
  %>
<% else %>
  <%= presenter.attribute_to_html(:parent_organization_title, label: 'Organization', render_as: :showcase_organization_title, html_dl: false) %>
<% end %>
<%= presenter.attribute_to_html(:publisher, render_as: :showcase_default, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:creator, label: presenter.creator_label, render_as: :showcase_default, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:contributor, label: 'Object contributor', render_as: :showcase_default, include_empty: true, html_dl: false) %> 
