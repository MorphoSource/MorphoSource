<div class="row">
  <!-- left column  -->
  <div class="col-sm-6">

    <div class="content-block">
      <h2>OBJECT IDENTIFIERS AND EXTERNAL LINKS</h2>
      <%= @presenter.attribute_to_html(:work_id, label: "Object ID", render_as: :showcase_default, include_empty: true, html_dl: false) %>
      <%= f.input :institution_code, label_wrapper_html: { class: 'recommended-flag' }  %>
      <%= f.input :catalog_number, label_wrapper_html: { class: 'recommended-flag' }  %>
      <%= f.input :identifier, as: :multi_value %>
      <%= f.input :related_url, as: :multi_value %>
    </div>

    <div class="content-block">
      <h2>GENERAL DETAILS</h2>

      <%= f.input :is_pak, as: :select,
          collection: ['Yes','No'],
          include_blank: true,
          input_html: { class: 'form-control' }
      %>

      <%= f.input :is_built_in_fiducials_present, as: :select,
          collection: ['Yes','No'],
          include_blank: true,
          input_html: { class: 'form-control' }
      %>
      
      <%= f.input :snl_assembler, as: :text,
          input_html: { rows: '2' }
      %>

      <div class="form-group">
      	<label class="control-label" for="assembly_date" ><%= t('simple_form.labels.engineering_object.assembly_date') %></label>
      	<%= f.date_field :assembly_date, wrapper: :inline, value: f.object.assembly_date || Date.today, class: 'datepicker form-control' %>
      </div>

      <%= f.input :anonymize_origin, as: :select,
          collection: ["NOT Anonymize Origin", "Anonymize Origin"],
          label: 'Anonymize Origin',
          include_blank: true,
          input_html: { class: 'form-control' }
      %>

      <%= f.input :anonymize_metadata, as: :select,
          collection: ["NOT Anonymize Metadata", "Anonymize Metadata"],
          label: 'Anonymize Metadata',
          include_blank: true,
          input_html: { class: 'form-control' }
      %>
      
      <%= f.input :description, label: 'Description' %>
      <%# todo: render date_field in simple_form_bootstrap %>
      <div class="row">
        <div class="col-xs-6 showcase-label"><%= @presenter.date_created_label %></div>
        <div class="col-xs-6 showcase-value">
        <%= f.date_field :date_created, wrapper: :inline, value: f.object.date_created || Date.today, class: 'datepicker form-control' %>
          </div>
      </div>
      <%= @presenter.attribute_to_html(:date_uploaded, render_as: :showcase_date, include_empty: true, html_dl: false) %>
      <% if @presenter.parent_organization.present? %>
        <%= @presenter.attribute_to_html(
          :parent_organization_title, 
          label: 'Organization', 
          link: Rails.application.routes.url_helpers.hyrax_organization_path(@presenter.parent_organization.id), 
          render_as: :showcase_organization_title, 
          html_dl: false) 
        %>
      <% else %>
        <%= @presenter.attribute_to_html(:parent_organization_title, label: 'Organization', render_as: :showcase_organization_title, html_dl: false) %>
      <% end %>
      <%= f.input :creator, label: @presenter.creator_label, as: :multi_value %>
      <%= f.input :contributor, label: 'Object contributor', as: :multi_value %>
      <%= f.input :publisher %>
    </div>
  
  </div>
  <!-- /left column  -->

  <!-- right column  -->
  <div class="col-sm-6">

    <%= render 'edit_media_items', presenter: @presenter, f: f %>

    <div class="content-block">
      <%= render 'form_member_of_collections', f: f %>
    </div>

  </div>
  <!-- / right column -->

</div>
