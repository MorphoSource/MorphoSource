<div class="col-12 col-md-6 blog">
  <h2>Announcements</h2>
  <% posts = Morphosource::ExternalApi::GithubDiscussions.get_announcements %>
  <% if posts[:status] == :success && posts[:data].present? %>
    <% posts[:data].each do |post| %>
      <div class="row post flex-column">
        <div class="post-title-container">
          <div class="post-title"><%= post[:title] %></div>
        </div>
        <div><i><%= post[:date] %></i></div>
        <div class="post-excerpt">
          <%= sanitize post[:excerpt] %>
        </div>
        <% if post[:url].present? %>
          <%= link_to(post[:url]) do %>
            <span>See more →</span>
          <% end %>
        <% end %>
      </div>
    <% end %>
    <div class="view-all-link">
      <%= link_to "View All Announcements →", "https://github.com/MorphoSource/Community/discussions/categories/announcements" %>
    </div>
  <% else %>
    <div class="row">
      <div class="col-12">No announcements currently available. Check back later!</div>
    </div>
  <% end %>
</div>