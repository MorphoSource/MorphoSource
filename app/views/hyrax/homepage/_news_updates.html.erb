<div class="col-xs-12 col-sm-6 col-left blog">
  <h2>News and Updates</h2>
  <% blog_posts = Morphosource::WordpressBlogApi.get_posts %>
  <% if blog_posts.present? %>
    <% blog_posts.each do |post| %>
      <div class="row post">
        <div class="post-title-container">
          <div class="post-title"><%= post[:title] %></div>
        </div>
        <div><i><%= post[:date] %></i></div>
        <div class="post-excerpt">
          <%= sanitize post[:excerpt] %>
        </div>
      </div>
    <% end %>
    <div class="view-all-link">
      <%= link_to(Morphosource::WordpressBlogApi.blog_url, target: :_blank) do %>
        <span>View all news and updates <i class="fas fa-external-link-alt fa-sm"></i></span>
      <% end %>
    </div>
  <% else %>
    <div class="row">
      <div class="col-xs-12">No news is currently available. Check back later!</div>
    </div>
  <% end %>
</div>