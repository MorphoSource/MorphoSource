<div class="col-xs-12 col-sm-6 stats">
  <h2>Repository Statistics</h2>
  <div class="row">
    <div class="col-xs-6 showcase-label">Media Files</div>
    <div class="col-xs-6 showcase-value">
      <%= number_with_delimiter(Media.count, :delimiter => ',') %>
    </div>
  </div>
  <div class="row">
    <div class="col-xs-6 showcase-label">Physical Objects Represented</div>
    <div class="col-xs-6 showcase-value">
      <%= number_with_delimiter(BiologicalSpecimen.count + CulturalHeritageObject.count, :delimiter => ',') %>
    </div>
  </div>
  <div class="row">
    <div class="col-xs-6 showcase-label">Data Projects</div>
    <div class="col-xs-6 showcase-value">
      <%= number_with_delimiter(


byebug 

# need to replace hardcoded collection type id for project?

        Morphosource::SolrService.new.get_count(
          'has_model_ssim:Collection AND collection_type_gid_ssim:gid://#{GlobalID.app}/Hyrax::CollectionType/2'
        ),
        :delimiter => ','
      ) %>
    </div>
  </div>
  <% taxonomy_not_gbif_count = Taxonomy.where(gbif_key: nil).count %>
  <div class="row">
    <div class="col-xs-6 showcase-label">Taxonomies (GBIF Linked)</div>
    <div class="col-xs-6 showcase-value">
      <%= number_with_delimiter(( Taxonomy.count - taxonomy_not_gbif_count ), :delimiter => ',') %>
    </div>
  </div>
  <div class="row">
    <div class="col-xs-6 showcase-label">Taxonomies (User Created)</div>
    <div class="col-xs-6 showcase-value">
      <%= number_with_delimiter(taxonomy_not_gbif_count, :delimiter => ',') %>
    </div>
  </div>
  <div class="row">
    <div class="col-xs-6 showcase-label">Collections and Facilities</div>
    <div class="col-xs-6 showcase-value">
      <%= number_with_delimiter(Organization.count, :delimiter => ',') %>
    </div>
  </div>
  <div class="row">
    <div class="col-xs-6 showcase-label">Users</div>
    <div class="col-xs-6 showcase-value">
      <%= number_with_delimiter(User.registered.count, :delimiter => ',') %>
    </div>
  </div>
  <div class="row">
    <div class="col-xs-6 showcase-label">Contributors</div>
    <div class="col-xs-6 showcase-value">
      <%= number_with_delimiter(
        Role.find_by(name: 'contributor').users.count,
        :delimiter => ','
      ) %>
    </div>
  </div>
</div>