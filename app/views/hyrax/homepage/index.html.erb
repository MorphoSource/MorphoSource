<% content_for :body_css_classes do %>showcase<% end %>
<% provide :page_title, application_name %>

<% is_core_site = Hyrax.config.site_title == Hyrax.config.default_site_title %>

<div class="front">
  <% if is_core_site %>
    <%= render(partial: 'front_banner') %>
  <% else %>
    <div id="front-banner" class="row" style="text-align: center; background-color: unset; border: none; padding: 20px;">
    <div class="col-12 col-lg-3 col-align no-padding">
      <%= link_to Rails.application.routes.url_helpers.browse_categories_path, class: 'btn' do %>
        <div class="row align-items-center">
            <div class="col-3 col-align col-align--center">
                <div class="row"><i class="fas fa-book-open fa-2x"></i>
                </div>
            </div>
            <div class="col-9 col-align col-align--center">
                <div class="row">Browse Data and Collections</div>
            </div>
        </div>
      <% end %>
    </div>
    <div class="col-12 col-lg-3 col-align no-padding">
      <%= link_to 'https://duke.atlassian.net/wiki/spaces/MD/pages/35422310/Contributor+User+Docs', target: :_blank, class: 'btn' do %>
        <div class="row align-items-center">
            <div class="col-3 col-align col-align--center">
                <div class="row"><i class="fas fa-feather-alt fa-2x"></i>
                </div>
            </div>
            <div class="col-9 col-align col-align--center">
                <div class="row">Contribute or Manage Data</div>
            </div>
        </div>
      <% end %>
    </div>
</div>
  <% end %>

  <% if Hyrax.config.site_announcements %>
    <div class="row showcase">
      <%= render(partial: 'announcements') %>
      <%= render(partial: 'featured_collections') %>
    </div>

    <div class="row showcase">
      <%= render(partial: 'repository_statistics') %>
      <%= render(partial: 'for_educators') if is_core_site %>
    </div>
  <% else %>
    <div class="row showcase">
      <%= render(partial: 'featured_collections') %>
      <%= render(partial: 'repository_statistics') %>
      <%= render(partial: 'for_educators') if is_core_site %>
    </div>
  <% end %>
</div>
