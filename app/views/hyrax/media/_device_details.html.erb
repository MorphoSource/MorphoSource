<div>
  <h2>CURRENT DEVICE</h2>

  <div class="message has-warning hidden"></div>
  <table>
    <tbody></tbody>
  </table>

  <input id="device-id-value" type="hidden" value="<%= presenter.device_id %>" />
  
  <tr>
    <td>
        <div class="row">
            <div class="col-xs-6 showcase-label">Organization</div>
            <div class="col-xs-6 showcase-value" id="device-organization-title-value">
            <%= presenter.device_organization_institution %>
            </div>
        </div>
        <%= presenter.attribute_to_html(:device_id, label: 'Model', css_id: 'device-creator-value', render_as: :showcase_page_link, include_empty: true) %>
        <div class="row">
            <div class="col-xs-6 showcase-label">Manufacturer</div>
            <div class="col-xs-6 showcase-value" id="device-title-value"><%= presenter.device_creator&.first %></div>
        </div>
        <div class="row">
            <div class="col-xs-6 showcase-label">Modality</div>
            <div class="col-xs-6 showcase-value break-all" id="device-modality-value" data-modality-id="<%= presenter.device_modality&.join(", ") %>"><%= presenter.device_modality_labels %></div>
        </div>
        <div class="row">
            <div class="col-xs-6 showcase-label">Description</div>
            <div class="col-xs-6 showcase-value" id="device-description-value"><%= presenter.device_description&.first %></div>
        </div>
    </td>
  </tr>


</div>
