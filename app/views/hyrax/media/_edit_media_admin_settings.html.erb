<% if current_user.admin? %>
  <div class="content-block block admin-block">
    <h2>ADMIN SETTINGS</h2>
    <%= f.input :select_fund_code, collection: @presenter.fund_code_associations - [@presenter.active_fund_code_association], label: "Activate fund code" %>
    <%= f.input :select_new_fund_code, collection: FundCode.all - @presenter.fund_codes, label: "New fund code" %>
    <%= render_edit_field_partial('agreement_uri', f: f) %>

    <div class="row button-container mt-1 mb-1">
      <div class="col-xs-5 col-align">
        <%# todo: remove the @presenter.file_origin == "Remote" condition for characterize and derive when the functionality for remote file is ready %>
        <%= link_to 'Characterize Media', main_app.media_characterize_path, 
          disabled: @presenter.file_set_list.empty?, class: 'btn btn-sm w-100' %>
      </div>
      <div class="col-xs-5 col-align">
        <%= link_to 'Derive Media', main_app.media_create_derivatives_path, 
          disabled: @presenter.file_set_list.empty?, class: 'btn btn-sm w-100' %>
      </div>
      <% if @presenter.file_origin == "Remote" %>
        <div class="col-xs-5 col-align">
          <%= link_to 'Verify Remote File', main_app.remote_file_health_verify_media_path(id: @presenter.id), class: 'btn btn-sm w-100', disabled: @presenter.file_set_original_file_ready == false %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>