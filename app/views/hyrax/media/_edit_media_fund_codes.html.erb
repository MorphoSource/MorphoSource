<div class="content-block">
  <h2>MEDIA FUND CODES</h2>
  <% if @presenter.fund_code_associations.present? %>
    <p>
      Fund codes actively or previously associated with the media.  
    </p>
    <div class="row">
      <ul>
        <% @presenter.fund_code_associations.each do |fc| %>
          <% if fc != @presenter.active_fund_code_association  %>
            <li><%= fc.title %></li>
          <% end %>
        <% end %>
        <% if @presenter.active_fund_code_association.present? %>
          <li><%= @presenter.active_fund_code_association.title %> <span class="label label-info">Active</span></li>
        <% end %>
      </ul>
    </div>
  <% else %>
    <p>
      No fund codes have been associated with this media. The hosting and archiving of this media is currently being supported by MorphoSource.
    </p>
  <% end %>
</div>
