<%= render_edit_field_partial('download_permission', f: f) %>
<%= render_edit_field_partial('download_reviewer', f: f) %>
<%= render_edit_field_partial('rights_holder', f: f) %>
<%= render_edit_field_partial('rights_statement', f: f) %>
<%= render_edit_field_partial('license', f: f) %>
<%= render_edit_field_partial('morphosource_use_agreement_type', f: f) %>
<%= render_edit_field_partial('permits_commercial_use', f: f) %>
<%= render_edit_field_partial('permits_3d_use', f: f) %>
<%= render_edit_field_partial('required_archival_of_published_derivatives', f: f) %>
<%= render_edit_field_partial('funding', f: f) %>
<%= render_edit_field_partial('publisher', f: f) %>
<%= render_edit_field_partial('cite_as', f: f) %>
<%= render_edit_field_partial('preview_mode', f: f) %>

<%= @presenter.attribute_to_html(
  :agreement_uri, 
  label: 'Additional usage agreement', 
  render_as: :showcase_agreement_uri_file, 
  include_empty: true, 
  text_if_empty: 'None',
  attachment_file_url: @presenter.attachment_url,
  show_hint: true) 
%>
<% if @presenter.agreement_uri.present? || @presenter.attachment_url.present? %>
  <div class="form-group row">
    <div class="col-xs-12 showcase-value">
      <%= t("morphosource.media.edit.agreement_present").html_safe %>
    </div>
  </div>
<% else %>
  <div class="form-group row">
    <div class="col-xs-12 showcase-value">
      <%= t("morphosource.media.edit.agreement_absent").html_safe %>
    </div>
  </div>
<% end %>
