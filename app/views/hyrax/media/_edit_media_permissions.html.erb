<!-- These fields are used in Team - linked organization and Media Showcase edit
Labels and hints are in config/locales/media_permissions -->
<%= render_edit_field_partial('download_permission', f: f) %>
<%= render_edit_field_partial('download_reviewer', f: f) %>
<%= render_edit_field_partial('rights_holder', f: f) %>
<%= render_edit_field_partial('rights_statement', f: f) %>
<%= render_edit_field_partial('license', f: f) %>
<%= render_edit_field_partial('morphosource_use_agreement_type', f: f) %>
<%= render_edit_field_partial('permits_commercial_use', f: f) %>
<%= render_edit_field_partial('permits_3d_use', f: f) %>
<%= render_edit_field_partial('required_archival_of_published_derivatives', f: f) %>
<%= render_edit_field_partial('funding', f: f) %>
<%= render_edit_field_partial('publisher', f: f) %>
<%= render_edit_field_partial('cite_as', f: f) %>
<%= render_edit_field_partial('preview_mode', f: f) %>

<% if f.object.model_name.name == 'Organization' # Is this team org settings tab? %> 
  <%= render_edit_field_partial('agreement_uri', f: f) %>
<% elsif f.object.model_name.name == 'Media' %>
  <% if curation_concern.ignore_organization_agreement&.first == "true" %>
    <%= @presenter.attribute_to_html(
      :agreement_uri, 
      label: 'Additional usage agreement', 
      render_as: :showcase_agreement_uri_file, 
      include_empty: true, 
      text_if_empty: 'None',
      attachment_path: curation_concern.attachment('agreement') || '',
      attachment_file_url: main_app.attachment_path(field: 'agreement'),
      html_dl: false) 
    %>
  <% else %>
    <%= @presenter.attribute_to_html(
      :agreement_uri, 
      label: 'Additional usage agreement', 
      render_as: :showcase_agreement_uri_file, 
      include_empty: true, 
      text_if_empty: 'None',
      attachment_path: @presenter.organization_attachment_url || '',
      attachment_file_url: @presenter.organization_attachment_url,
      values: @presenter.organization_agreement_uri,
      html_dl: false) 
    %>

    <div class="form-group row">
      <div class="col-xs-12 showcase-value">
        <%= t("morphosource.media.organization_agreement.help").html_safe %>
      </div>
    </div>
  <% end %>
<% end %>
