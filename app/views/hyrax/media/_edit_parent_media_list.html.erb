<%
if member_counter == 0
  raw_or_derived = @presenter.top_parent_media_raw_or_derived
  class_name = 'circle first'
else
  raw_or_derived = 'Derived'
  class_name = 'circle'
end
%>
<div class="p-0">
  <div class="indicators line solid table-cell">
    <p><span class="<%= class_name %>"></span></p>
  </div>
  <div class="table-cell media-title">
    <p>
     <%= raw_or_derived %> parent
    <%= link_to(@presenter.link_name_long_from_object(member), main_app.media_showcase_path(member)) %>
    </p>
  </div>
</div>
