<div id="remote-file">
  <div class="form-group p-2">
    <% deposit_structure_link = Hyrax.config.docs.find { |d| d["label"] == "hyrax.controls.links.docs.deposit_structure" } %>
    <% if deposit_structure_link %>
      <p><%= link_to t("hyrax.controls.links.docs.deposit_structure"), deposit_structure_link["url"], target: "_blank" %></p>
    <% end %>
    <%= f.input :remote_origin_url, label: 'Remote Origin URL', input_html: { type: '' } %> <%# override type="url" %>
  </div>
</div>

<%# this org id field is being used when making validate_remote_file_ajax call
  For new submission, the org id will be set if user selects an org in a previous step 
  For edit page, the org id will be returned: 
    - from presenter (whether or not org is linked to team)
    - when user selects a different PO (whether or not org is linked to a team)
  %>
<input type="hidden" id="associated_organization_id" name="associated_organization_id" 
  value="<%= @presenter&.media_organization_id&.first || "" %>" />
