<div class='edit_media'>
<%= simple_form_for [main_app, @form],
                    #builder: Hyrax::ShowcaseFormBuilder,
                    wrapper: :showcase_default,
                    html: {
                      data: { behavior: 'work-form',
                              'param-key' => @form.model_name.param_key },
                      multipart: true
                    } do |f| %>
  <% if f.object.errors.any? %>
    <div class="alert alert-danger alert-dismissable" role="alert">
      <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
      <%= f.object.errors.full_messages_for(:base).send(SimpleForm.error_method) %>
      <%= render 'form_in_works_error', f: f %>
      <%= render 'form_ordered_members_error', f: f %>
      <%= render 'form_collections_error', f: f %>
      <%= render 'form_visibility_error', f: f %>
    </div>
  <% end %>

  <%= f.hidden_field :accepted_formats, :value => "" %>
  <%= render 'guts4form', f: f %>
<% end %>


<%# the following forms are placed here so that the forms will not be nested inside the media form %>

<% if @presenter.imaging_event.present? %>
  <% if @presenter.imaging_event_editable? %>
      <%= simple_form_for [main_app, @imaging_event_form],
                          url: Rails.application.routes.url_helpers.media_owner_update_imaging_event_path(id: @imaging_event_form.model.id),
                          wrapper: :showcase_default,
                          html: {
                            id: 'related_form_imaging_event',
                            data: { behavior: 'work-form',
                                    'param-key' => @imaging_event_form.model_name.param_key },
                            multipart: true
                          } do |i| %>
        <%= hidden_field_tag :media_id, @presenter.id %>
        <div class="row related_form imaging-event" style="display:none">
          <%= render 'form_imaging_event', i: i, presenter: @presenter %>
        </div>
        <div class="row related_form device" style="display:none">
          <%= render 'tab_device', i: i %>
        </div>
        <div class="row related_form physical-object-details" style="display:none;">
          <%= render 'tab_physical_object', i: i %>
        </div>
      <% end %>
  <% else %>
    <div class="row related_form imaging-event" style="display:none">
      <%= render 'parent_imaging_event', presenter: @presenter %>
    </div>
    <div class="row related_form device" style="display:none">
      <%= render 'parent_device', presenter: @presenter %>
    </div>
    <div class="row related_form physical-object-details" style="display:none;">
      <% if @presenter.physical_object_type == "Biological Specimen" %>
        <%= render 'parent_biological_specimen', presenter: @presenter %>
      <% elsif @presenter.physical_object_type == "Cultural Heritage Object" %>
        <%= render 'parent_cultural_heritage_object', presenter: @presenter %>
      <% end %>
    </div>
  <% end %>
<% end %>

<% if @presenter.processing_events_data.present? %>
    <%= simple_form_for [main_app, @processing_event_form],
                        url: Rails.application.routes.url_helpers.media_owner_update_processing_event_path(id: @processing_event_form.model.id),
                        wrapper: :showcase_default,
                        html: {
                          id: 'related_form_processing_event',
                          data: { behavior: 'work-form',
                                  'param-key' => @processing_event_form.model_name.param_key },
                          multipart: true
                        } do |p| %>

      <%= hidden_field_tag :media_id, @presenter.id %>
      <div class="row related_form processing-event" id="related_form_processing_event" style="display:none">
        <%= render 'form_processing_event', p: p, presenter: @presenter %>
      </div>
      <div class="row related_form parent-media" style="display:none;">
        <%= render 'tab_parent_media', p: p %>
      </div>

    <% end %>
<% else %>
    <%# display a new PO form, and place the parent media form inside %>
    <div id="embedded_div_new_processing_event" class="embedded_div persist_with_tab related_form parent-media" data-relationship-control="#parent-relationships-processing-events" data-add-button="#btn-add-processing-event">
      <div class="col-sm-12">
        <div class="content-block">
          <%= simple_form_for [main_app, @new_processing_event_form],
                              wrapper: :showcase_default,
                              url: @new_processing_event_submit_submissions_url,
                              html: {
                                data: { behavior: 'work-form' }
                              } do |p| %>
              <%= render 'tab_parent_media_new_processing_event', p: p %>
          <% end %>
        </div>
      </div>
    </div>

<% end %>
<% if can? :transfer, @presenter.id %>
<div class="row related_form share" style="display:none">
  <%= render_async hyrax.new_work_transfer_path(@presenter.id), event_name: "share-tab-loaded" do %>
    <div class="ui-loading-whole-page" style="height:200px"></div>
  <% end %>
</div>
<% end %>

<%= render 'modal_new_physical_object' %>
<%= render 'modal_select_physical_object' %>
<%= render 'modal_select_parent_media' %>
<%= render 'modal_select_parent_media_new_processing_event' %>
</div>

