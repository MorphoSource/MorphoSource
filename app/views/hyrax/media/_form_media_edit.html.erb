<% content_for :content_css_classes do %>showcase-edit<% end %> 

<%= simple_form_for [main_app, @form],
                    #builder: Hyrax::ShowcaseFormBuilder,
                    wrapper: :showcase_default,
                    html: {
                      data: { behavior: 'work-form',
                              'param-key' => @form.model_name.param_key },
                      multipart: true
                    } do |f| %>
  <% if f.object.errors.any? %>
    <div class="alert alert-danger alert-dismissable" role="alert">
      <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
      <%= f.object.errors.full_messages_for(:base).send(SimpleForm.error_method) %>
      <%= render 'form_in_works_error', f: f %>
      <%= render 'form_ordered_members_error', f: f %>
      <%= render 'form_collections_error', f: f %>
      <%= render 'form_visibility_error', f: f %>
    </div>
  <% end %>

  <%= render 'guts4form', f: f %>
<% end %>


<%# the following forms are placed here so that the forms will not be nested inside the media form %>

<% if @presenter.hasImagingEvents? %>
  <div class="row related_form imaging-event" id="related_form_imaging_event" style="display:none">
  <% if @presenter.imaging_event_editable? %>
      <%= simple_form_for [main_app, @imaging_event_form],
                          wrapper: :showcase_default,
                          html: {
                            data: { behavior: 'work-form',
                                    'param-key' => @imaging_event_form.model_name.param_key },
                            multipart: true
                          } do |i| %>

          <%= render 'form_imaging_event', i: i, presenter: @presenter %>
      <% end %>
  <% else %>
    <%= render 'form_imaging_event_parent', presenter: @presenter %>
  <% end %>
  </div>
<% end %>

<% if @presenter.hasProcessingEvents? %>
  <div class="row related_form processing-event" id="related_form_processing_event" style="display:none">
    <%= simple_form_for [main_app, @processing_event_form],
                        wrapper: :showcase_default,
                        html: {
                          data: { behavior: 'work-form',
                                  'param-key' => @processing_event_form.model_name.param_key },
                          multipart: true
                        } do |p| %>

        <%= render 'form_processing_event', p: p, presenter: @presenter %>
    <% end %>
  </div>
<% end %>

<div class="col-sm-12">
  <div class="content-block">
    <div id="embedded_div_new_device" class="embedded_div" data-relationship-control="#parent-relationships-devices" data-add-button="#btn-add-device" style="display: block;">
        <%= simple_form_for @new_device_form, 
                            wrapper: :showcase_default,
                            url: @new_device_submit_submissions_url do |i| %>
            <%= render 'form_new_device', f: i %>
        <% end %>
    </div>
  </div>
</div>

<div class="col-sm-12">
  <div class="content-block">
    <div id="embedded_div_new_organization" class="embedded_div" data-relationship-control="#parent-relationships-organizations" data-add-button="#btn-add-organization" style="display: none;">
        <%= simple_form_for @new_organization_form, 
                            wrapper: :showcase_default,
                            url: @new_organization_submit_submissions_url do |i| %>
            <%= render 'form_new_organization', i: i %>
        <% end %>
    </div>
  </div>
</div>

<script type="text/javascript">
  Blacklight.onLoad(function() {
    <%# This causes the page to switch back to the default template if they've
        previously visited the batch download page in this Turbolinks session %>
    $("#fileupload").fileupload('option', 'downloadTemplateId', 'template-download')
  });
</script>