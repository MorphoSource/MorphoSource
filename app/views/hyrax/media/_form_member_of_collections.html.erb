<h2>COLLECTIONS MEDIA BELONGS TO</h2>

<div class="form-group" data-behavior="collection-relationships" data-param-key="<%= f.object.model_name.param_key %>" data-members="<%= @member_of_collections_json %>" data-work-type="collection">

  <div class="form-inline">
    <div class="col-xs-10 pl-0">
    <%= f.input_field :member_of_collection_ids,
        prompt: :translate,
        data: {
          autocomplete: 'collection',
          'autocomplete-url' => find_collection_to_add_media_autocomplete_url
        } %>
    </div>
    <div class="col-xs-2 pl-0">
      <a class="btn btn-primary" data-behavior="add-relationship">Add</a>
    </div>
  </div>

  <table>
    <tbody></tbody>
  </table>
</div>

<script type="text/x-tmpl" id="tmpl-collection">
<tr>
  <td>
    <div class="row collection-edit-block">
      <div class="col-xs-10 showcase-value">{%= o.title %}</div>
      <div class="col-xs-2">
        <i class="btn-remove {%= o.removable == false ? 'tooltip-icon' : '' %} fa fa-times-circle" aria-hidden="true"
          data-behavior="{%= o.removable == true ? 'remove-relationship' : '' %}" >
          <p class="hint hide">You do not have permission to remove the media from this collection</p>
        </i>
      </div>
    </div>
  </td>
</tr>
</script>
