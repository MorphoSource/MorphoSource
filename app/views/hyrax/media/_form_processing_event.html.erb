<div class="col-sm-6">
  <div class="content-block">
  	<h2>PROCESSING DETAILS</h2>
    <%= p.input :creator, as: :multi_value %>
    <%# todo: render date_field in simple_form_bootstrap %>
    <div class="row">
        <div class="col-xs-6 showcase-label">Date created</div>
        <div class="col-xs-6 showcase-value">
        <%= p.date_field :date_created, wrapper: :inline, value: p.object.date_created, class: 'datepicker form-control' %>
        </div>
    </div>
    <%= p.input :software, as: :multi_value %>
    <%= render_edit_field_partial('description', f: p) %>
    <%= render_edit_field_partial(
      'attachment', 
      f: p, 
      field: 'pe_description', 
      label: 'Description attachment file',
      curation_concern: @processing_event_form.model
    ) %>
	</div>
</div>
<div class="col-sm-6">
  <div class="content-block">
  	<h2>INDIVIDUAL PROCESSING STEPS</h2>

	  <%= render_edit_field_partial('processing_activity', f: p) %>

	</div>
</div>
<%# this save button is for debugging in a standalone form
<a href="javascript:void(0)" id="processing_event" class="btn btn-save debug">save</a>
%>
