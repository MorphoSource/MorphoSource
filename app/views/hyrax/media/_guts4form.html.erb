<%= render "edit_work_title", presenter: @presenter, f: f %>

    <div class="card panel-default tabs" role="main">
      <!-- Nav tabs -->
      <ul class="nav nav-tabs" role="tablist">
        <li role="presentation" id="tab-media-details" class="nav-item">
          <a href="#media-details" aria-controls="media-details" role="tab" data-toggle="tab" aria-expanded="false" class="nav-link active">
            <i class="fa fa-cube"></i> Details
          </a>
        </li>

        <% if ['Mesh', 'CTImageSeries'].include?(@presenter.media_type&.first) %>
          <li role="presentation" id="tab-preview-settings" class="nav-item">
            <a href="#preview-settings" aria-controls="preview-settings" role="tab" data-toggle="tab" aria-expanded="false" class="nav-link" style="display: flex; align-items: center; gap: 5px;">
              <i class="fa fa-tv"></i>
              Preview
              <span class="label label-warning">BETA</span>
            </a>
          </li>
        <% end %>

        <li role="presentation" id="tab-file-upload" class="nav-item">
          <a href="#file-upload" aria-controls="file-upload" role="tab" data-toggle="tab" aria-expanded="false" class="nav-link">
            <i class="fa fa-upload"></i> Upload
          </a>
        </li>

        <li role="presentation" id="tab-share" class="nav-item">
          <a href="#share" aria-controls="share" role="tab" data-toggle="tab" aria-expanded="false" class="nav-link">
            <i class="fa fa-share-alt"></i> Share
          </a>
        </li>

        <% if @presenter.processing_events_data.present? %>
          <li role="presentation" id="tab-processing-event" class="nav-item">
            <a href="#processing-event" aria-controls="processing-event" role="tab" data-toggle="tab" aria-expanded="false" class="nav-link">
              <i class="fa fa-bolt"></i> Processing
            </a>
          </li>
        <% end %>

        <% if @presenter.imaging_event.present? %>
          <li role="presentation" id="tab-imaging-event" class="nav-item">
            <a href="#imaging-event" aria-controls="imaging-event" role="tab" data-toggle="tab" aria-expanded="false" class="nav-link">
              <i class="fa fa-camera"></i> Imaging
            </a>
          </li>
        <% end %>

        <li role="presentation" id="tab-device" class="nav-item">
          <a href="#device" aria-controls="device" role="tab" data-toggle="tab" aria-expanded="false" class="nav-link">
            <i class="fas fa-microscope"></i> Device
          </a>
        </li>

        <li role="presentation" id="tab-parent-media" class="nav-item">
          <a href="#parent-media" aria-controls="parent-media" role="tab" data-toggle="tab" aria-expanded="false" class="nav-link">
            <i class="fa fa-code-branch"></i> Parent Media
          </a>
        </li>

        <li role="presentation" id="tab-physical-object-details" class="nav-item">
          <a href="#physical-object-details" aria-controls="physical-object-details" role="tab" data-toggle="tab" aria-expanded="false" class="nav-link">
            <% if @presenter.physical_object_type == "Biological Specimen" %>
              <i class="fas fa-frog"></i> Object
            <% elsif @presenter.physical_object_type == "Cultural Heritage Object" %>
              <i class="ms2-icon-bowl icon-bowl"></i> Object
            <% end %>
          </a>
        </li>
      </ul>

      <!-- Tab panes -->
      <div class="tab-content">

        <div role="tabpanel" class="tab-pane" id="physical-object-details">
          <div class="form-tab-content">

              <%# the form is in _form_media_edit %>

          </div>
        </div>

        <div role="tabpanel" class="tab-pane" id="parent-media">
          <div class="form-tab-content">

              <%# the form is in _form_media_edit %>

          </div>
        </div>

        <div role="tabpanel" class="tab-pane" id="device">
          <div class="form-tab-content">

              <%# the form is in _form_media_edit %>

          </div>
        </div>

        <% if @presenter.imaging_event.present? %>
          <div role="tabpanel" class="tab-pane" id="imaging-event">
            <div class="form-tab-content">

              <%# the form is in _form_media_edit %>

            </div>
          </div>
        <% end %>

        <% if @presenter.processing_events_data.present? %>
          <div role="tabpanel" class="tab-pane" id="processing-event">
            <div class="form-tab-content">

              <%# the form is in _form_media_edit %>

            </div>
          </div>
        <% end %>

        <div role="tabpanel" class="tab-pane" id="share" data-param-key="media">
          <div class="form-tab-content">

            <%= render 'tab_share', f: f %>

          </div>
        </div>

        <div role="tabpanel" class="tab-pane" id="file-upload">
          <div class="form-tab-content">

            <%= render 'tab_file_upload', f: f %>

          </div>
        </div>

        <% if ['Mesh', 'CTImageSeries'].include?(@presenter.media_type&.first) %>
          <div role="tabpanel" class="tab-pane" id="preview-settings">
            <div class="form-tab-content">

              <%= render 'tab_preview_settings', f: f %>

            </div>
          </div>
        <% end %>

        <div role="tabpanel" class="tab-pane active" id="media-details">
          <div class="form-tab-content">

            <%# Trial new media details page sans preview (with preview tab) for meshes and volumes %>
            <%# Decide if this should be the default for all moving forward %>
            <% if ['Mesh', 'CTImageSeries'].include?(@presenter.media_type&.first) %>
              <%= render 'tab_media_details_no_preview', f: f %>
            <% else %>
              <%= render 'tab_media_details', f: f %>
            <% end %>

          </div>
        </div>
      </div>

    </div><!-- /card panel-default tabs -->
