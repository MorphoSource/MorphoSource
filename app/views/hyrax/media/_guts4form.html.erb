<%= render "edit_work_title", presenter: @presenter, f: f %>

    <div class="panel panel-default tabs" role="main">
      <!-- Nav tabs -->
      <ul class="nav nav-tabs" role="tablist">
        <li role="presentation" id="tab-physical-object-details" class="">
          <a href="#physical-object-details" aria-controls="physical-object-details" role="tab" data-toggle="tab" aria-expanded="false">
            <i class="fas fa-frog"></i> Physical Object
          </a>
        </li>
        <li role="presentation" id="tab-device" class="active">
          <a href="#device" aria-controls="device" role="tab" data-toggle="tab" aria-expanded="false">
            <i class="fas fa-frog"></i> Device
          </a>
        </li>
        <% if @presenter.hasImagingEvents? %>
          <li role="presentation" id="tab-imaging-event" class="">
            <a href="#imaging-event" aria-controls="imaging-event" role="tab" data-toggle="tab" aria-expanded="false">
              <i class="fas fa-frog"></i> Imaging
            </a>
          </li>
        <% end %>
        <% if @presenter.hasProcessingEvents? %>
          <li role="presentation" id="tab-processing-event" class="">
            <a href="#processing-event" aria-controls="processing-event" role="tab" data-toggle="tab" aria-expanded="false">
              <i class="fas fa-frog"></i> Processing
            </a>
          </li>
        <% end %>
        <li role="presentation" id="tab-file-upload" class="">
          <a href="#file-upload" aria-controls="file-upload" role="tab" data-toggle="tab" aria-expanded="false">
            <i class="fas fa-frog"></i> File Upload
          </a>
        </li>
        <li role="presentation" id="tab-media-details" class="">
          <a href="#media-details" aria-controls="media-details" role="tab" data-toggle="tab" aria-expanded="false">
            <i class="fas fa-frog"></i> Media Details
          </a>
        </li>
      </ul>

      <!-- Tab panes -->
      <div class="tab-content">
        <div role="tabpanel" class="tab-pane" id="physical-object-details">
          <div class="form-tab-content">

            <%#= render 'tab_object_details', f: f %>

          </div>
        </div>

        <div role="tabpanel" class="tab-pane active" id="device">
          <div class="form-tab-content">

              <%# the form is in _form_media_edit %>

          </div>
        </div>

        <% if @presenter.hasImagingEvents? %>
          <div role="tabpanel" class="tab-pane" id="imaging-event">
            <div class="form-tab-content">

              <%# the form is in _form_media_edit %>

            </div>
          </div>
        <% end %>

        <% if @presenter.hasProcessingEvents? %>
          <div role="tabpanel" class="tab-pane" id="processing-event">
            <div class="form-tab-content">

              <%# the form is in _form_media_edit %>

            </div>
          </div>
        <% end %>

        <div role="tabpanel" class="tab-pane" id="file-upload">
          <div class="form-tab-content">

            <%= render 'tab_file_upload', f: f %>

          </div>
        </div>

        <div role="tabpanel" class="tab-pane " id="media-details">
          <div class="form-tab-content">

            <%= render 'tab_media_details', f: f %>

          </div>
        </div>
      </div>

    </div><!-- /panel panel-default tabs -->
