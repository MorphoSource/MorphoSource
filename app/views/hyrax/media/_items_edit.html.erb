<% if presenter.file_set_presenters.present? %>
  <table class="table table-striped related-files">
    <tbody>
      <%= render partial: 'member_edit', collection: presenter.file_set_presenters, as: :file_set %>
    </tbody>
  </table>
<% elsif can? :edit, presenter.id %>
    <div class="alert alert-warning" role="alert">No file uploaded.</div>
<% else %>
  <div class="alert alert-warning" role="alert"><%= t('.unauthorized', type: presenter.human_readable_type) %></div>
<% end %>