<!-- Modal for clicking new PO.
https://getbootstrap.com/docs/4.0/components/modal/ -->
<div class="modal fade" id="modal-new-physical-object" tabindex="-1" role="dialog" aria-labelledby="modal-label" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modal-label">Create new physical object
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
        </h5>
      </div>
      <div class="modal-body">
        You will be leaving the current page for the creation of a new physical object that is linked to current media.  Click OK to continue, or Cancel to go back.
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" onClick="window.open('/', '_blank');">OK</button>
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
      </div>
    </div>
  </div>
</div>
