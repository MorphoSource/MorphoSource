<div class="col-sm-12 not-editable">
    <p>Physical object settings can not be edited. These fields are associated with the image parent 
<%= link_to(@presenter.direct_parent_first_member.link_name, contextual_path(@presenter.direct_parent_first_member, @presenter)) %>. <br />
To change these setting, edit parent media</p>
</div>

<div class="col-sm-6">
  <div class="content-block">
  	<h2>CURRENT PHYSICAL OBJECT</h2>

    <%= @presenter.attribute_to_html(:physical_object_type, label: 'Object type', render_as: :showcase_default, include_empty: true, html_dl: false) %>
    <%= @presenter.attribute_to_html(:vouchered, label: 'Vouchered?', render_as: :showcase_default, include_empty: true, html_dl: false) %>
    <%= @presenter.attribute_to_html(:institution_code, label: 'Institution code', render_as: :showcase_default, include_empty: true, html_dl: false) %>
    <%= @presenter.attribute_to_html(:collection_code, label: 'Collection code', render_as: :showcase_default, include_empty: true, html_dl: false) %>
    <%= @presenter.attribute_to_html(:catalog_number, label: 'Catalog number', render_as: :showcase_default, include_empty: true, html_dl: false) %>
    <%= @presenter.attribute_to_html(:cho_type, label: 'CHO type', render_as: :showcase_default, include_empty: true, html_dl: false) %>
    <%= @presenter.attribute_to_html(:material, label: 'Material', render_as: :showcase_default, include_empty: true, html_dl: false) %>
    <%= @presenter.attribute_to_html(:short_title, label: 'Short title', render_as: :showcase_default, include_empty: true, html_dl: false) %>
  </div>
</div>
<div class="col-sm-6">
