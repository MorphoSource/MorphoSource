    <%= @presenter.attribute_to_html(:collection_code, label: 'Collection code', render_as: :showcase_default, include_empty: true, html_dl: false) %>
    <%= @presenter.attribute_to_html(:catalog_number, label: 'Catalog number', render_as: :showcase_default, include_empty: true, html_dl: false) %>
    <%= @presenter.attribute_to_html(:short_title, label: 'Short title', render_as: :showcase_default, include_empty: true, html_dl: false) %>
    <%= @presenter.attribute_to_html(:cho_type, label: 'Object type', render_as: :showcase_default, include_empty: true, html_dl: false) %>
    <%= @presenter.attribute_to_html(:material, label: 'Material', render_as: :showcase_default, include_empty: true, html_dl: false) %>
