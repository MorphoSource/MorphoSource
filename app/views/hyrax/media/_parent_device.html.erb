<div class="col-sm-12 not-editable">
    <p>Device settings can not be edited here. This device was used to image parent 
<%= link_to(@presenter.link_name_long_from_object(@presenter.top_parent_media), main_app.media_showcase_path(@presenter.top_parent_media)) %>. <br />
To change these settings, edit the parent media.</p>
</div>
<div class="col-sm-6">
  <div class="content-block">
  	<h2>CURRENT DEVICE</h2>

      <div class="content-block">
        <%= @presenter.attribute_to_html(:device_organization_institution, label: 'Organization', render_as: :showcase_default, include_empty: true, html_dl: false) %>
        <%= @presenter.attribute_to_html(:device_title, label: 'Model', render_as: :showcase_default, include_empty: true, html_dl: false) %>
        <%= @presenter.attribute_to_html(:device_creator, label: 'Manufacturer', render_as: :showcase_default, include_empty: true, html_dl: false) %>
        <%= @presenter.attribute_to_html(:imaging_event_modality, label: 'Modality', render_as: :showcase_default, css_classes: 'break-all', include_empty: true, html_dl: false) %>
        <%= @presenter.attribute_to_html(:device_description, label: 'Description', render_as: :showcase_default, include_empty: true, html_dl: false) %>
      </div>

  </div>
</div>
<div class="col-sm-6">
  <div class="content-block">


  </div>
</div>
