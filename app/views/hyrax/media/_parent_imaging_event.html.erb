<div class="col-12 not-editable">
    <p>Imaging settings can not be edited here. These fields describe the imaging of parent 
<%= link_to(@presenter.link_name_long_from_object(@presenter.top_parent_media), main_app.media_showcase_path(@presenter.top_parent_media)) %>. <br />
To change these settings, edit the parent media.</p>
</div>
<div class="col-6">
  <div class="content-block">
  	<h2>IMAGING EVENT DETAILS</h2>

    <%= @presenter.attribute_to_html(:imaging_event_modality, label: 'Modality', render_as: :showcase_default, css_classes: 'break-all imaging_event_modality', include_empty: true, html_dl: false) %>
    <%# render the ie-modality-value for setting custom title display holder text in ms_media_form.js %>
    <div class="hide ie_modality_value"><%= @presenter.ie_modality&.first %></div>
    <%= @presenter.attribute_to_html(:device_label, label: 'Device', render_as: :showcase_default, include_empty: true, html_dl: false) %>

    <%= @presenter.attribute_to_html(:device_organization_institution, label: 'Device facility', render_as: :showcase_default, include_empty: true, html_dl: false) %>
    <%= @presenter.attribute_to_html(:imaging_event_creator, label: 'Creator', render_as: :showcase_default, include_empty: true, html_dl: false) %>
    <%= @presenter.attribute_to_html(:imaging_event_date_created, label: 'Date', render_as: :showcase_date, include_empty: true, html_dl: false) %>
    <% if @presenter.imaging_event_modality.presence %>
      <% if @presenter.imaging_event_modality == "Photogrammetry" || 
             @presenter.imaging_event_modality == "Photography" %>
            <%= render "showcase_modality_photogrammetry_attributes", presenter: @presenter %>
      <% elsif @presenter.imaging_event_modality.upcase.include? "XRAY" %>
            <%= render "showcase_modality_xray_attributes", presenter: @presenter %>
      <% end %>
    <% end %>

  </div>
</div>
<div class="col-6">
  <div class="content-block">


  </div>
</div>
