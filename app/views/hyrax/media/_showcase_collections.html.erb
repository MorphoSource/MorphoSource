<h2><%= t("showcase.sections.collections.labels.base") %></h2>
<div class="row">
	<div class="col-xs-12">
    <% if presenter.member_of_collection_presenters.present? %>
      <% presenter.member_of_collection_presenters.each do |collection| %>
        <ul>
          <li class='attribute attribute-title'>
            <%= link_to collection.title.first, main_app.url_for(collection) %>
          </li>
        </ul>
      <% end %>
    <% else %>
      <%= t("showcase.sections.collections.content.none") %>
    <% end %>
	</div>
</div>
