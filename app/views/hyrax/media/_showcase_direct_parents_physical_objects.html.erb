<div style='padding-left: 15px;'>
  Physical object 
  <!-- <%= member_counter %> 
      # todo: later on we will need to handle more than 1 parent
  -->
  <% if @presenter.physical_object_link.present? %>
    <%= link_to(@presenter.physical_object_title, @presenter.physical_object_link) %>
  <% end %>
  was imaged to create
  <% if @presenter.is_absentee_parent == true %>
    undeposited raw media.
  <% else %>
    <% if @presenter.raw_or_derived == "Raw" %>
      this media.
    <% else %>
      <%= @presenter.direct_parent_members_raw_or_derived.downcase %> media
      <%= link_to(member.link_name_long, contextual_path(member, @presenter)) %>
      .
  <% end %>
  <% end %>
  
</div>
