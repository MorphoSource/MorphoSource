<h2 class="header-modal-definitions">
  GENERAL DETAILS
  <a href='#' data-toggle="modal" data-target="#modal-general-details-definitions">Field Definitions</a>
</h2>

<%= presenter.attribute_to_html(:work_id, render_as: :showcase_default, include_empty: true) %>
<%= presenter.attribute_to_html(:human_readable_media_type, render_as: :showcase_default, include_empty: true) %>
<%= presenter.attribute_to_html(:part, render_as: :showcase_default, include_empty: true) %>

<%= presenter.attribute_to_html(
  :physical_object_title,
  value: "#{presenter.physical_object_title} #{presenter.physical_object_link}",
  link: presenter.physical_object_link,
  render_as: :showcase_organization_title, include_empty: true
) %>
<%= presenter.attribute_to_html(
  :taxonomy_title,
  values: presenter.taxonomies_titles&.first,
  css_classes: "italics",
  render_as: :showcase_default, include_empty: false
) %>

<% if presenter.media_organization.present? && presenter.media_organization_id.present? %>
  <%= presenter.attribute_to_html(
    :media_organization,
    link: organization_path(presenter.media_organization_id.first),
    render_as: :showcase_organization_title, include_empty: true
  ) %>
<% end %>

<%= presenter.attribute_to_html(:side, render_as: :showcase_default, include_empty: true) %>
<%= presenter.attribute_to_html(:orientation, render_as: :showcase_default, include_empty: true) %>
<%= presenter.attribute_to_html(:short_description, render_as: :showcase_default, include_empty: true) %>
<%= presenter.attribute_to_html(:description, render_as: :showcase_default, include_empty: true, css_classes: 'break-all') %>

<%= presenter.attribute_to_html(:creator, render_as: :showcase_default, include_empty: true) %>
<%= presenter.attribute_to_html(:date_created, render_as: :showcase_date, include_empty: true) %>
<%= presenter.attribute_to_html(:date_uploaded, render_as: :showcase_date, include_empty: true) %>

<%# Definitions modal %>
<% fields = [
  :work_id, :human_readable_media_type, :part, :physical_object_title, :taxonomy_title,
  :media_organization, :side, :orientation, :short_description, :description, :creator,
  :date_created, :date_uploaded
]%>
<%= render partial: 'modal_field_definitions', locals: { fields: fields, modal_id: 'modal-general-details-definitions' } %>