<h2 class="header-modal-definitions">
  IDENTIFIERS AND EXTERNAL LINKS
  <a href='#' data-toggle="modal" data-target="#modal-identifiers-and-external-links-definitions">Field Definitions</a>
</h2>

<%= presenter.attribute_to_html(:ark, render_as: :showcase_ark_link, include_empty: true, text_if_empty: 'Not assigned') %>
<%= presenter.attribute_to_html(:doi, render_as: :showcase_doi_link, include_empty: true, text_if_empty: 'Not assigned') %>
<% if @current_user && @current_user.admin? && !@presenter.doi.present? %>
  <div class="row">
    <div class="col-6"></div>
    <div class="col-6"><%= button_to "Mint DOI", main_app.media_mint_doi_path(id: @presenter.work_id), method: :put %></div>
  </div>
<% end %>
<%= presenter.attribute_to_html(:identifier, render_as: :showcase_default, include_empty: true) %>
<%= presenter.attribute_to_html(:related_url, render_as: :showcase_default, include_empty: true) %>

<%# Definitions modal %>
<% fields = [
  :ark, :doi, :identifier, :related_url
]%>
<%= render partial: 'modal_field_definitions', locals: { fields: fields, modal_id: 'modal-identifiers-and-external-links-definitions' } %>
