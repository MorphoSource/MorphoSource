<h2>IDENTIFIERS AND EXTERNAL LINKS</h2>

<%= presenter.attribute_to_html(:ark, render_as: :showcase_ark_link, include_empty: true, text_if_empty: 'Not assigned', html_dl: false) %>
<%= presenter.attribute_to_html(:doi, render_as: :showcase_doi_link, include_empty: true, text_if_empty: 'Not assigned', html_dl: false) %>
<% if @current_user.admin? && @presenter.doi.empty? %>
  <div class="col-xs-6"></div>
  <div class="col-xs-6"><%= button_to "Mint DOI", main_app.media_mint_doi_path(id: @presenter.work_id), method: :put %></div>
<% end %>
<%= presenter.attribute_to_html(:identifier, render_as: :showcase_default, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:related_url, render_as: :showcase_default, include_empty: true, html_dl: false) %>

