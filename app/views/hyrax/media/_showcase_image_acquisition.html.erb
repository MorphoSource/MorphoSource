<h2 class="header-modal-definitions">
  IMAGE ACQUISITION AND PROCESSING AT A GLANCE
  <a href='#' data-toggle="modal" data-target="#modal-image-acquisition-definitions">Field Definitions</a>
</h2>

<%= presenter.attribute_to_html(:parent_media_count, render_as: :showcase_default, include_empty: true) %>

<div class="row">
	<div class="col-xs-6 showcase-label">
		<%= t("blacklight.search.fields.show.processing_event_count") %>
	</div>
	<div class="col-xs-6 showcase-value">
		<%= presenter.processing_event_count %>
		<% if presenter.processing_activity_count.present?  %>
			(<%= pluralize(presenter.processing_activity_count, 'step') %>)
	 	<% end %>
		</div>
</div>

<% if presenter.parent_media_count.to_i > 0 %>
  <div class="row">
  	<div class="col-xs-6 showcase-label">
			<%= t("blacklight.search.fields.show.direct_parent") %>
		</div>
  	<div class="col-xs-6 showcase-value">
			<%= link_to(presenter.link_name_long_from_object(presenter.direct_parent), main_app.media_showcase_path(presenter.direct_parent)) %>
  	</div>
  </div>
<% end %>

<%= presenter.attribute_to_html(:imaging_event_modality, render_as: :showcase_default, include_empty: true) %>
<%= presenter.attribute_to_html(:device_and_facility, render_as: :showcase_default, include_empty: false) %>

<%# Definitions modal %>
<% fields = [
  :parent_media_count, :processing_event_count, :direct_parent, :imaging_event_modality, 
	:device_and_facility
]%>
<%= render partial: 'modal_field_definitions', locals: { fields: fields, modal_id: 'modal-image-acquisition-definitions' } %>
