<div class="row showcase2-row media-showcase image-acq-detail">
  <div class="col-sm-12">
    <h2>IMAGE ACQUISITION AND PROCESSING IN DETAIL</h2>
    <div>
      <div>
        <div class="content-block-lg col-12 mb-1">

          <div class="row" style="background-color: #efefef; margin-bottom: 20px">
            <h3 style='font-weight: 500; padding-left: 15px; margin-top: 10px;'><i class="fas fa-camera fa-lg" style="width: 30px; text-align: center;"></i> <span>STEP 1: IMAGE ACQUISITION</span></h3>
          </div>

          <div class="row">
            <%= render partial: "showcase_image_acquisition_details_physical_object" %>
          </div>

          <div class="row" style="margin-bottom: 30px;">
            <div class="col-sm-6">
              <div class="content-block">
                <h2 class="header-modal-definitions">
                  IMAGING DETAILS
                  <a href='#' data-toggle="modal" data-target="#modal-image-acquisition-details-definitions">Field Definitions</a>
                </h2>
                <%= presenter.attribute_to_html(:imaging_event_modality, render_as: :showcase_default, include_empty: true) %>
                <%= presenter.attribute_to_html(
                  :device_label,
                  label: 'Device',
                  link: main_app.hyrax_device_path(presenter.device_id),
                  render_as: :showcase_link, include_empty: false, value_per_line: true) %>
                <%= presenter.attribute_to_html(:device_organization_institution, render_as: :showcase_default, include_empty: true, work_type: "imaging_event") %>
                <%= presenter.attribute_to_html(:imaging_event_creator, render_as: :showcase_default, include_empty: true, work_type: "imaging_event") %>
                <%= presenter.attribute_to_html(:imaging_event_date_created, render_as: :showcase_date, include_empty: true, work_type: "imaging_event") %>
                <%= presenter.attribute_to_html(:imaging_event_software, render_as: :showcase_default, include_empty: true, work_type: "imaging_event") %>
                <%= presenter.attribute_to_html(:imaging_event_description, render_as: :showcase_default, include_empty: true, work_type: "imaging_event") %>
                <%= presenter.attribute_to_html(
                  :imaging_event_description_attachment_url,
                  label: 'Description Attachment',
                  render_as: :showcase_attachment,
                  include_empty: true,
                  text_if_empty: 'None')
                %>
                <%= presenter.attribute_to_html(
                  :imaging_event_reference_attachment_url,
                  label: 'Photographic Reference',
                  render_as: :showcase_attachment,
                  include_empty: true,
                  text_if_empty: 'None')
                %>
                <%= presenter.attribute_to_html(:filter, render_as: :showcase_default, include_empty: true, work_type: "imaging_event") %>
                <% if presenter.imaging_event_modality.presence %>
                  <% if presenter.imaging_event_modality == "Photogrammetry" ||
                       presenter.imaging_event_modality == "Photography" %>
                    <%= render "showcase_modality_photogrammetry_attributes", presenter: @presenter %>
                  <% elsif presenter.imaging_event_modality.upcase.include? "X-RAY COMPUTED TOMOGRAPHY" %>
                    <%= render "showcase_modality_xray_attributes", presenter: @presenter %>
                  <% elsif presenter.imaging_event_modality == "Sequential Section Scan" %>
                    <%= presenter.attribute_to_html(:slide_type, render_as: :showcase_default, include_empty: true, work_type: "imaging_event") %>
                  <% end %>
                <% end %>
              </div>
            </div>

            <div class="col-sm-6">
              <%# Does a raw media exist at the top of the media hierarchy? It could also be this media! %>
              <% if presenter.has_absentee_parent %>
                <%# Leave blank if no raw media parent %>
              <% else %>
                <%# Raw media exists, it's either the top parent or this media %>
                <% raw_media = presenter.top_parent_media || presenter %>
                <div class="content-block">
                  <h2>Media produced by this event on MorphoSource</h2>
                  <% if raw_media.present? %>
                    <div class="row media-block">
                      <div class="thumbnail col-4">
                        <% if raw_media == presenter %>
                          <%= render_thumbnail_tag presenter, {}, { suppress_link: true } %>
                          <%= presenter.link_name_long %> (this media)
                        <% elsif can? :read, raw_media %>
                            <%= render_thumbnail_tag raw_media, class: "d-block text-center mx-auto" %>
                          <%= link_to(presenter.link_name_long_from_object(raw_media), main_app.media_showcase_path(raw_media)) %>
                        <% else %>
                          <%= render_default_thumbnail %>
                          <span class="no-access-media-label">Private media inaccessible with current permissions<span>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>

        </div><!-- /content-block-lg -->

      </div>
      
      <% if @presenter.raw_or_derived == "Derived" %>
        <% @presenter.processing_events_data.each_with_index.map do |pe, i| %>
          <%= render @presenter.showcase_image_acquisition_details_processing_partial,
            presenter: @presenter,
            processing_activity_items: pe[:processing_activity_items],
            child: pe[:child],
            parent: pe[:parent_is_media] ? pe[:parent] : nil,
            creator: pe[:creator]&.join(', '),
            date_created: pe[:date_created]&.first,
            software: pe[:software]&.first,
            description: pe[:description]&.first,
            description_attachment: pe[:description_attachment]&.first,
            step_number: i + 2
          %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<%# Definitions modal %>
<% fields = [
  :imaging_event_modality, :device_label, :device_organization_institution, :imaging_event_creator, 
  :imaging_event_date_created, :imaging_event_software, :imaging_event_description, 
  :imaging_event_reference_attachment, :filter, :lens, 
  :other_details, :exposure_time, :flux_normalization, :pixel_spacing_calibration, 
  :shading_correction, :frame_averaging, :projections, :voltage, :power, :amperage, 
  :surrounding_material, :xray_tube_type, :target_type, :detector_type, :detector_pixels_x,
  :detector_pixel_size_x, :detector_pixels_y, :detector_pixel_size_y, :detector_configuration,
  :source_object_distance, :source_detector_distance, :target_material, :rotation_number,
  :phase_contrast, :optical_magnification, :acquisition_type, :slide_type

]%>
<%= render partial: 'modal_field_definitions', locals: { fields: fields, modal_id: 'modal-image-acquisition-details-definitions', work_type: :imaging_event } %>
