<div class="row image-acq-detail">
  <div class="col-sm-12">

    <h2>IMAGE ACQUISITION AND PROCESSING IN DETAIL 
      <a aria-label="collapse/expand" data-toggle="collapse" href="#collapse-block-image-acquisition-in-detail" class="btn collapse-block-image-acquisition-in-detail"><span class="glyphicon glyphicon-triangle-top collapse-block-image-acquisition-in-detail"></span></a>
    </h2>

    <div id="collapse-block-image-acquisition-in-detail" class="panel-collapse collapse-block glyphicon-only table collapse in" aria-expanded="true">

      <div class="row">
        <div class="content-block-lg col-xs-12">
          
          <div class="row" style="background-color: #efefef; margin-bottom: 20px">
            <h3 style='font-weight: 500; padding-left: 15px; margin-top: 10px;'><i class="fas fa-camera fa-lg" style="width: 30px; text-align: center;"></i> <span>STEP 1: IMAGE ACQUISITION</span></h3>
          </div>

          <div class="row">
            <%= render partial: "showcase_direct_parents_physical_objects", collection: @presenter.direct_parent_members, as: :member %>
          </div>

          <div class="row" style="margin-bottom: 30px;">
            <div class="col-sm-6">
              <div class="content-block">
                <h2>Imaging Details</h2>
                <!--div id="collapse-block-image-acquisition-attributes" class="panel-collapse collapse collapse-block" -->
                <%= presenter.attribute_to_html(:imaging_event_modality, label: 'Modality', render_as: :showcase_default, css_classes: 'break-all', include_empty: true, html_dl: false) %>
                <%= presenter.attribute_to_html(:device, label: 'Device', render_as: :showcase_default, include_empty: true, html_dl: false) %>

                <%= presenter.attribute_to_html(:device_organization_institution, label: 'Device facility', render_as: :showcase_default, include_empty: true, html_dl: false) %>
                <%= presenter.attribute_to_html(:imaging_event_creator, label: 'Creator', render_as: :showcase_default, include_empty: true, html_dl: false) %>
                <%= presenter.attribute_to_html(:imaging_event_date_created, label: 'Date', render_as: :showcase_default, include_empty: true, html_dl: false) %>

                <%= presenter.attribute_to_html(:imaging_event_software, label: 'Software', render_as: :showcase_default, include_empty: true, html_dl: false) %>
                <%= presenter.attribute_to_html(:imaging_event_description, label: 'Description', render_as: :showcase_default, include_empty: true, html_dl: false) %>
                <%= presenter.attribute_to_html(
                  :imaging_event_description_attachment, 
                  label: 'Description attachment', 
                  render_as: :showcase_attachment, 
                  include_empty: true, 
                  text_if_empty: 'None',
                  html_dl: false) 
                %>
                <%= presenter.attribute_to_html(
                  :imaging_event_reference_attachment, 
                  label: 'Photographic reference', 
                  render_as: :showcase_attachment, 
                  include_empty: true, 
                  text_if_empty: 'None',
                  html_dl: false) 
                %>

                <% if presenter.imaging_event_modality.presence %>
                  <% if presenter.imaging_event_modality == "Photogrammetry" || 
                       presenter.imaging_event_modality == "Photography" %>
                    <%= render "showcase_modality_photogrammetry_attributes", presenter: @presenter %>
                  <% elsif presenter.imaging_event_modality.upcase.include? "X-RAY COMPUTED TOMOGRAPHY" %>
                    <%= render "showcase_modality_xray_attributes", presenter: @presenter %>
                  <% end %>
                <% end %>
                <!--/div -->
                <%#= collapse_expand_panel("collapse-block-image-acquisition-attributes") %>
              </div>
            </div>

            <div class="col-sm-6">
              <% if @presenter.is_absentee_parent == false %>
                <div class="content-block">
                  <h2>Media produced by this event on MorphoSource</h2>
                  <% 
                  members = presenter.direct_parent_members
                  parent_member =  members.first
                  %>
                  <% if parent_member.present? %>
                    <div class="row media-block">
                      <div class="thumbnail col-xs-4">
                        <% if parent_member.id == @presenter.id %>
                          <%= render_thumbnail_tag parent_member, {}, { suppress_link: true } %><br>
                          <%= parent_member.link_name_long %> (this media)<br>
                        <% else %>
                          <%= render_thumbnail_tag parent_member %><br>
                          <%= link_to(parent_member.link_name_long, contextual_path(parent_member, @presenter)) %><br>
                        <% end %>
                        <%= parent_member.file_format %><br>
                      </div>
                    </div>              
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>

        </div><!-- /content-block-lg -->

      </div><!-- /row -->

      <% if @presenter.raw_or_derived == "Derived" %>

        <% @presenter.processing_events_data.each_with_index.map do |pe, i| %>
          <%= render @presenter.showcase_image_acquisition_details_processing_partial, 
            presenter: @presenter,
            processing_activity_items: pe[:processing_activity_items],
            processing_member: pe[:child_members].first,
            parent_member: pe[:parent_members].first,
            creator: pe[:creator]&.first,
            date_created: pe[:date_created]&.first,
            software: pe[:software]&.first,
            description: pe[:description]&.first,
            description_attachment: pe[:description_attachment]&.first,
            step_number: i + 2
          %>
        <% end %>

      <% end %>
    
    </div><!-- /collapse-block-image-acquisition-in-detail -->

  </div>
</div>
