<div>
  <div class="content-block-lg col-12 mb-1">
    <div class="row" style="background-color: #efefef; margin-bottom: 20px">
      <h3 style='font-weight: 500; padding-left: 15px; margin-top: 10px;'><i class="fas fa-bolt fa-lg" style="width: 30px; text-align: center;"></i> <span>STEP <%= step_number.to_s %>: IMAGE PROCESSING</span></h3>
    </div>

    <div class="row">
      <div style="padding-left: 15px; padding-right: 15px;">
        <% if !parent.present? %>
          Raw media (undeposited)
        <% else %>
          <% if step_number > 2 || presenter.has_absentee_parent %>
            Derived
          <% else %>
            Raw
          <% end %>
          <% if can? :read, parent %>
            <%= link_to(presenter.link_name_long_from_object(parent), main_app.media_showcase_path(parent)) %>
          <% else %>
            <b>private media</b>
          <% end %>
        <% end %>
        was processed
        <% if processing_activity_items.present?  %>
          with <%= pluralize(processing_activity_items.count, 'activity') %>
        <% end %>
        to create
        <%= presenter.raw_or_derived.downcase %>
        <% if child == presenter %>
          <b><%= presenter.link_name_long %></b> (this media).
        <% else %>
          <% if can? :read, child %>
            <%= link_to(presenter.link_name_long_from_object(child), main_app.media_showcase_path(child)) %>.
          <% else %>
            <b>private media</b> that exists on MorphoSource but is inaccessible with current user permissions.
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="row">
      <div class="col-sm-6">
        <div class="content-block" style="margin-bottom: 30px">
          <h2 class="header-modal-definitions">
            Processing Details
            <a href='#' data-toggle="modal" data-target="#modal-image-acquisition-details-processing-definitions">Field Definitions</a>
          </h2>
            <%= Hyrax::Renderers::ShowcaseDefaultAttributeRenderer.new(
              :creator,
              creator,
              { include_empty: true, work_type: "processing_event" }
            ).render %>
            <%= Hyrax::Renderers::ShowcaseDateAttributeRenderer.new(
              :date_created,
              date_created,
              { include_empty: true, work_type: "processing_event" }
            ).render %>
            <%= Hyrax::Renderers::ShowcaseDefaultAttributeRenderer.new(
              :software,
              software,
              { include_empty: true, work_type: "processing_event" }
            ).render %>
            <%= Hyrax::Renderers::ShowcaseDefaultAttributeRenderer.new(
              :description,
              description,
              { include_empty: true, work_type: "processing_event" }
            ).render %>
            <div class="row">
              <div class="col-6 showcase-label">Description attachment</div>
              <div class="col-6 showcase-value">
                <% if description_attachment.present? %>
                  <span class='showcase-link'><%= link_to('Description Attachment', description_attachment, target: '_blank') %></span>
                <% else %>
                  <%= 'None' %>
                <% end %>
              </div>
            </div>
        </div>
        <div class="content-block" style="margin-bottom: 30px">
          <% if processing_activity_items.present? %>
            <!--div id="collapse-block-image-acquisition-processing-activities" class="panel-collapse collapse collapse-block" -->
            <% processing_activity_items.map do |item| %>
              <h4>Processing Activity <%= item["Step"] %>: </b><%= item["Type"] %> </h4>
              <div class="row indent">
                <div class="col-6 showcase-label">Software</div>
                <div class="col-6 showcase-value"><%= item["Software"] %></div>
              </div>
              <div class="row indent">
                <div class="col-6 showcase-label">Description</div>
                <div class="col-6 showcase-value"><%= item["Description"] %></div>
              </div>
            <% end %>
            <!--/div -->
            <%#= collapse_expand_panel("collapse-block-image-acquisition-processing-activities") %>
          <% end %>
        </div>
      </div>

      <div class="col-sm-6">
        <div class="content-block">
          <h2>Media produced by this event on MorphoSource</h2>
          <% if child.present? %>
            <div class="row media-block">
                <div class="thumbnail col-4">
                  <% if child == presenter %>
                    <%= render_thumbnail_tag presenter, {}, { suppress_link: true } %>
                    <%= presenter.link_name_long %> (this media)
                  <% elsif can? :read, child %>
                    <%= render_thumbnail_tag child %>
                    <%= link_to(presenter.link_name_long_from_object(child), main_app.media_showcase_path(child)) %>
                  <% else %>
                    <%= render_default_thumbnail %>
                    <span class="no-access-media-label">Private media inaccessible with current permissions<span>
                  <% end %>
                </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

  </div><!-- /content-block-lg -->

</div>

<%# Definitions modal %>
<% fields = [
  :creator, :date_created, :software, :description, :description_attachment
]%>
<%= render partial: 'modal_field_definitions', locals: { fields: fields, modal_id: 'modal-image-acquisition-details-processing-definitions', work_type: :processing_event } %>