<div class="row">
  <div class="content-block-lg col-xs-12">
    
    <div class="row" style="background-color: #efefef; margin-bottom: 20px">
      <h3 style='font-weight: 500; padding-left: 15px; margin-top: 10px;'><i class="fas fa-bolt fa-lg" style="width: 30px; text-align: center;"></i> <span>STEP <%= step_number.to_s %>: IMAGE PROCESSING</span></h3>
    </div>

    <div class="row">
      <div style="padding-left: 15px; padding-right: 15px;">       
        <% if !parent_member.present? %>
          Raw media (undeposited)
        <% else %>
          <% if step_number > 2 || presenter.is_absentee_parent %>
            Derived
          <% else %>
            Raw
          <% end %>
          <%= link_to(parent_member.link_name_long, contextual_path(parent_member, @presenter)) %>
        <% end %>
        was processed
        <% if processing_activity_items.present?  %>
          with <%= pluralize(processing_activity_items.count, 'activity') %>
        <% end %>
        to create
        <%= presenter.raw_or_derived.downcase %>
        <% if processing_member.id == @presenter.id %>
          <b><%= processing_member.link_name_long %></b>
          (this media).
        <% else %>
          <%= link_to(processing_member.link_name_long, contextual_path(processing_member, @presenter)) %>
          .
        <% end %>
      </div>
    </div>

    <div class="row">
      <div class="col-sm-6">
        <div class="content-block" style="margin-bottom: 30px">
          <h2>Processing Details</h2>
            <div class="row">
              <div class="col-xs-6 showcase-label">Creator</div>
              <div class="col-xs-6 showcase-value"><%= creator ? creator : '--' %></div>
            </div>
            <div class="row">
              <div class="col-xs-6 showcase-label">Date processed</div>
              <div class="col-xs-6 showcase-value"><%= date_created ? date_created : '--' %></div>
            </div>
            <div class="row">
              <div class="col-xs-6 showcase-label">Software</div>
              <div class="col-xs-6 showcase-value"><%= software ? software : '--' %></div>
            </div>
            <div class="row">
              <div class="col-xs-6 showcase-label">Description</div>
              <div class="col-xs-6 showcase-value"><%= description ? description : '--' %></div>
            </div>
            <div class="row">
              <div class="col-xs-6 showcase-label">Description attachment</div>
              <div class="col-xs-6 showcase-value">
                <% if description_attachment.present? %>
                  <span class='showcase-link'><%= link_to('Description Attachment', description_attachment) %></span>
                <% else %>
                  <%= 'None' %>
                <% end %>
              </div>
            </div>
        </div>
        <div class="content-block" style="margin-bottom: 30px">
          <% if processing_activity_items.present? %>
            <!--div id="collapse-block-image-acquisition-processing-activities" class="panel-collapse collapse collapse-block" -->    
            <% processing_activity_items.map do |item| %>
              <h4>Processing Activity <%= item["Step"] %>: </b><%= item["Type"] %> </h4>
              <div class="row indent">
                <div class="col-xs-6 showcase-label">Software</div>
                <div class="col-xs-6 showcase-value"><%= item["Software"] %></div>
              </div>
              <div class="row indent">
                <div class="col-xs-6 showcase-label">Description</div>
                <div class="col-xs-6 showcase-value"><%= item["Description"] %></div>
              </div>
            <% end %>
            <!--/div -->
            <%#= collapse_expand_panel("collapse-block-image-acquisition-processing-activities") %>
          <% end %>
        </div>
      </div>

      <div class="col-sm-6">
        <div class="content-block">
          <h2>Media produced by this event on MorphoSource</h2>
          <% if processing_member.present? %>
            <div class="row media-block">
                <div class="thumbnail col-xs-4">
                  <% if processing_member.id == @presenter.id %>
                    <%= render_thumbnail_tag processing_member, {}, { suppress_link: true } %><br>
                    <%= processing_member.link_name_long %> (this media)<br>
                  <% else %>
                    <%= render_thumbnail_tag processing_member %><br>
                    <%= link_to(processing_member.link_name_long, contextual_path(processing_member, @presenter)) %><br>
                  <% end %>
                  <%= processing_member.file_format %><br>
                </div>

            </div>              
          <% end %>
        </div>
      </div>
    </div>

  </div><!-- /content-block-lg -->

</div><!-- /row -->