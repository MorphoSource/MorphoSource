<% 
related_media = presenter.viewable_related_media
media_count = related_media.count
items_per_row = 3
items_to_show_initially = 6
@row_div_opened = false
%>
	<h2><%= media_count %> ADDITIONAL MEDIA RELATED TO ACQUISITION EVENT </h2>
	<% if related_media.present? %>
		<div class="media-block">
			<%= render partial: @presenter.showcase_media_items_member_partial, collection: related_media, as: :showcase_media_items_member, :locals => {:media_count => media_count, :items_per_row => items_per_row, :items_to_show_initially => items_to_show_initially} %>
			
			<% if media_count > items_to_show_initially %>
				</div><!-- closing the collapse-block-media-items-member div -->
			<% end %>

		</div>
		
		<% if media_count > items_to_show_initially %>
			<%= collapse_expand_panel("collapse-block-media-items-member") %>
		<% end %>

	<% end %>

	<% if @row_div_opened # most likely media is missing and div is never closed %>
		</div>
	<% end %>