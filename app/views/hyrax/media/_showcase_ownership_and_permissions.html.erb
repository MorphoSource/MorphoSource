<h2>OWNERSHIP AND PERMISSIONS</h2>

<%= presenter.attribute_to_html(:data_managed_by, render_as: :showcase_user_link, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:download_permission, render_as: :showcase_default, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:download_reviewer, render_as: :showcase_user_link, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:rights_statement, render_as: :showcase_default, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:license, label: 'Creative Common licenses', render_as: :showcase_license_link, include_empty: true, html_dl: false) %>

<%= presenter.attribute_to_html(:morphosource_use_agreement_type, render_as: :showcase_default, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:permits_commercial_use, render_as: :showcase_default, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:permits_3d_use, render_as: :showcase_default, include_empty: true, html_dl: false) %>
<%= presenter.attribute_to_html(:required_archival_of_published_derivatives, render_as: :showcase_default, include_empty: true, html_dl: false) %>

<%= presenter.attribute_to_html(:rights_holder, label: 'IP holder(s)', render_as: :showcase_default, include_empty: true, html_dl: false) %>

<%= presenter.attribute_to_html(
	:agreement_uri, 
  label: 'Additional Usage Agreement', 
  render_as: :showcase_agreement_uri_file, 
  include_empty: true, 
  text_if_empty: 'None',
  attachment_path: curation_concern.attachment('agreement') || '',
  attachment_file_url: main_app.attachment_path(field: 'agreement'),
  html_dl: false) 
%>

<%= presenter.attribute_to_html(:preview_mode, label: 'Media preview mode', render_as: :showcase_default, include_empty: true, html_dl: false) %>
