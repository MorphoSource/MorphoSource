<h2 class="header-modal-definitions">
  OWNERSHIP AND PERMISSIONS
  <a href='#' data-toggle="modal" data-target="#modal-ownership-and-permissions-definitions">Field Definitions</a>
</h2>

<%= presenter.attribute_to_html(:user_with_ownership, render_as: :showcase_user_link, include_empty: true) %>
<%= presenter.attribute_to_html(:depositor, render_as: :showcase_user_link, include_empty: false) %>
<%= presenter.attribute_to_html(:publication_status_label, render_as: :showcase_default, include_empty: true) %>
<%= presenter.attribute_to_html(:download_reviewer, render_as: :showcase_user_link, include_empty: true) %>

<%= presenter.attribute_to_html(:rights_holder, render_as: :showcase_default, include_empty: true) %>
<%= presenter.attribute_to_html(:rights_statement, render_as: :showcase_rights_statement_link, include_empty: true) %>
<%= presenter.attribute_to_html(:license, render_as: :showcase_license_link, include_empty: true) %>

<%= presenter.attribute_to_html(:morphosource_use_agreement_type, render_as: :showcase_morphosource_use_agreement_type, include_empty: true) %>
<%= presenter.attribute_to_html(:permits_commercial_use, render_as: :showcase_permits_commercial_use, include_empty: true) %>
<%= presenter.attribute_to_html(:permits_3d_use, render_as: :showcase_permits_three_d_use, include_empty: true) %>
<%= presenter.attribute_to_html(:required_archival_of_published_derivatives, render_as: :showcase_required_archival_of_published_derivatives, include_empty: true) %>

<%= presenter.attribute_to_html(:funding, render_as: :showcase_default, include_empty: true) %>
<%= presenter.attribute_to_html(:publisher, render_as: :showcase_default, include_empty: true) %>
<%= presenter.attribute_to_html(:cite_as, render_as: :showcase_default, include_empty: true, css_classes: 'break-overflow') %>

<%= presenter.attribute_to_html(:preview_mode, render_as: :showcase_default, include_empty: true) %>

<%= presenter.attribute_to_html(
	:agreement_uri,
  render_as: :showcase_agreement_uri_file,
  include_empty: true,
  text_if_empty: 'None',
  attachment_file_url: presenter.attachment_url)
%>

<%# Definitions modal %>
<% fields = [
  :user_with_ownership, :depositor, :publication_status_label, :download_reviewer, :rights_holder,
  :rights_statement, :license, :morphosource_use_agreement_type, :permits_commercial_use,
  :permits_3d_use, :required_archival_of_published_derivatives, :funding, :publisher, :cite_as,
  :preview_mode, :agreement_uri
]%>
<%= render partial: 'modal_field_definitions', locals: { fields: fields, modal_id: 'modal-ownership-and-permissions-definitions' } %>