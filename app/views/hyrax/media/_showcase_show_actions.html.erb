<div class="show-actions">
  <div class="btn-group">
    <% if signed_in? %>
      <% if current_user.can? :download, @curation_concern %>
        <a class="btn-download-item btn btn-default" data-item-id="CURRENT" href="javascript:void(0)">Download</a>
        <%= hidden_download_link(presenter.id) %>
        <%= choose_cart_button(presenter) %>
      <% elsif @curation_concern.restricted? %>
        <%= choose_download_button(presenter.id) %>
        <%= choose_cart_button(presenter) %>
      <% else %>
        <%= unavailable_for_download_button %>
      <% end %>
      <% if presenter.editor? %>
        <%= edit_work_button(presenter) %>
      <% end %>
    <% end %>
  </div>
</div>
