<div>
  <% if presenter.file_set_list.present? && presenter.file_set_original_file_ready %>
    <div class="btn-group">
      <%= choose_download_button %>
      <%= choose_cart_button %>
      <% if presenter.editor? %>
        <%= edit_work_button %>
      <% end %>
    </div>
  <% else %>
    <div class="btn-group">
      <% if presenter.editor? %>
        <%= edit_work_button %>
      <% end %>
    </div>
  <% end %>

  <% unless signed_in? %>
    <div class="btn-group">
      <p style="text-align: center;"><%= login_message %></p>
    </div>
  <% end %>
</div>
