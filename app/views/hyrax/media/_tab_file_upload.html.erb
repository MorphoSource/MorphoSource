<div class="row">

  <% unless @presenter.hasChildMedia? %>
    <div class="col-sm-12 not-editable">
      <p>Media files of this work cannot be replaced (or deleted) because this media work has children media.</p>
    </div>
  <% end %>

  <!-- left column  -->
  <div class="col-sm-6">
    <div class="content-block">
      <h2 class="required-flag">UPLOAD FILE(S)<span class="label label-info"></span></h2>
      <%= render 'form_files_edit', f: f %>
    </div>
  </div>

  <!-- right column  -->
  <div class="col-sm-6">
    <div class="content-block">
      <h2>FILE(S) IN THIS MEDIA</h2>
      <%= render 'items_edit', presenter: @presenter %>
    </div>
  </div>

</div>