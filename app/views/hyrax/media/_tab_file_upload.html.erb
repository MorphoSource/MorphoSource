<div class="row">

  <!-- left column  -->
  <div class="col-sm-6">
    <div class="content-block">
      <h2 class="required-flag">UPLOAD FILE<span class="badge badge-info"></span></h2>
      <% if !@presenter.representative_presenter.present? %>
        <div id="file-upload-wrapper">
          <ul class="nav nav-tabs sub-nav upload-file" role="tablist">
            <li role="presentation" id="tab-local-file-section" class="nav-item active">
              <a href="#local-file-section" aria-controls="local-file-section" role="tab" data-toggle="tab" aria-expanded="false" class="nav-link active">
                Upload From Computer / Cloud
              </a>
            </li>
            <li role="presentation" id="tab-remote-file-section" 
              class="nav-item <%= current_user.can_submit_remote_file?(nil, @presenter.media_organization_id&.first) ? "" : "hide" %>">
              <a href="#remote-file-section" aria-controls="remote-file-section" role="tab" data-toggle="tab" aria-expanded="false" class="nav-link">
                Remote File Location
              </a>
            </li>
          </ul>

          <!-- Tab panes -->
          <div class="tab-content tab-borders mt-0">
            <div role="tabpanel" class="tab-pane active" id="local-file-section">
              <div class="form-tab-content p-3">
                <%= render 'form_files_edit', f: f %>
              </div>
            </div>
            <div role="tabpanel" id="remote-file-section"  
            class="tab-pane <%= current_user.can_submit_remote_file?(nil, @presenter.media_organization_id&.first) ? "" : "hide" %>">
              <div class="form-tab-content p-3">
                <%= render 'form_files_remote', f: f %>
              </div>
            </div>
          </div>
        </div>
      <% else %>
        To replace a file, please delete the existing file first.
      <% end %>
    </div>
    <div class="content-block">
      <h2>THUMBNAIL</h2>
      <%= render 'custom_thumbnail', presenter: @presenter, f: f %>
    </div>
  </div>

  <!-- right column  -->
  <div class="col-sm-6">
    <div class="content-block">
      <h2>FILE IN THIS MEDIA</h2>
      <%= render 'items_edit', presenter: @presenter %>
      <% if @presenter.representative_presenter.present? && !@presenter.file_set_original_file_ready %>
        <div>
          <span style='color:  red;'>Uploaded file has not yet successfully finished processing.</span> If the file was uploaded recently, it may still be processing in the background, especially if the file is very large (3+ GB) and was uploaded from the cloud. If this message persists, either delete and reupload the file or <a href='mailto:morphosource@duke.edu'>contact us</a>.
        </div>
      <% end %>
    </div>
  </div>

</div>
