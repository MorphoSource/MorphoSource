<div class="row">

  <!-- left column  -->
  <div class="col-sm-6">

    <div class="content-block">
      <h2>GENERAL DETAILS</h2>
      <%= render_edit_field_partial('media_type', f: f) %>
      <%= f.input :part, label: 'Element or part of the object', as: :multi_value %>
      <%= render_edit_field_partial('side', f: f) %>
      <%= f.input :orientation, as: :multi_value %>
      <%= f.input :short_description, label: 'Short description' %>
      <%= f.input :description, label: 'Full description', as: :multi_value %>
    </div>



    <div class="content-block">
      <h2>OWNERSHIP AND PERMISSIONS</h2>

      <%= @presenter.attribute_to_html(:data_managed_by, render_as: :showcase_user_link, include_empty: true, html_dl: false) %>
      <%= @presenter.attribute_to_html(:download_permission, render_as: :showcase_default, include_empty: true, html_dl: false) %>
      <%= @presenter.attribute_to_html(:license, label: 'Creative Common licenses', render_as: :showcase_license_link, include_empty: true, html_dl: false) %>

      <div class="row"><div class="col-xs-6 showcase-label">Custom terms of use</div><div class="col-xs-6 showcase-value">Not yet implemented</div></div>
      <div class="row"><div class="col-xs-6 showcase-label">Commercial use permitted</div><div class="col-xs-6 showcase-value">No</div></div>
      <div class="row"><div class="col-xs-6 showcase-label">3D printing permitted</div><div class="col-xs-6 showcase-value">Not yet implemented</div></div>

      <%= @presenter.attribute_to_html(:rights_holder, label: 'IP holder(s)', render_as: :showcase_default, include_empty: true, html_dl: false) %>
    </div>

  
  </div>
  <!-- /left column  -->

  <!-- right column  -->
  <div class="col-sm-6">

    <%#= render 'edit_media_items', presenter: @presenter, f: f %>

    <div class="content-block">
      <%= render 'form_member_of_collections', f: f %>
    </div>

    <div class="content-block">
      <h2>MEDIA TAGS</h2>
      <div class="row">
        <div class="col-xs-6 showcase-label">
      Not yet implemented
        </div>
        <div class="col-xs-6 showcase-value">
      Not yet implemented
        </div>
      </div>
    </div>

    <div class="content-block">
      <h2> CITATION AND DOWNLOAD HISTORY OF PHYSICAL OBJECT MEDIA </h2>
      <div class="row">
        <div class="col-xs-6 showcase-label">
      Number of downloads
        </div>
        <div class="col-xs-6 showcase-value">
      Not yet implemented
        </div>
      </div>
    </div>

  </div>
  <!-- / right column -->

</div>
