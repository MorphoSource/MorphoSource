<div class="row media-showcase">

  <!-- left column  -->
  <div class="col-sm-6">

    <div class="content-block">
      <h2>GENERAL DETAILS</h2>
      <%= @presenter.attribute_to_html(:work_id, label: t("simple_form.labels.media.media_id"), render_as: :showcase_default, include_empty: true, html_dl: false, show_hint: true) %>
      <%= render_edit_field_partial('media_type', f: f) %>
      <%= f.input :part, as: :multi_value %>
      <%= f.input :short_title, label: t("simple_form.labels.media.short_title"), placeholder: '' %>
      <%= render_edit_field_partial('custom_title_case_sensitive', f: f) %>
      <%= render_edit_field_partial('side', f: f) %>
      <%= f.input :orientation, as: :multi_value %>
      <%= f.input :short_description %>
      <%= render_edit_field_partial('description', f: f) %>
      <%= f.input :creator, as: :multi_value %>
      <%# todo: render date_field in simple_form_bootstrap %>
      <div class="row">
        <div class="col-xs-6 showcase-label">
          Date created
          <%= render_hint_tag(t("simple_form.hints.media.date_created")) %>
        </div>
        <div class="col-xs-6 showcase-value">
          <%= f.date_field :date_created, wrapper: :inline, value: f.object.date_created, class: 'datepicker form-control' %>
        </div>
      </div>

      <input class="form-control hidden" type="hidden" value="foobar" name="ie_modality_for_title" id="ie_modality_for_title">
    </div>

    <div class="content-block">
      <%= render 'edit_file_object_details', f: f %>
    </div>

    <div class="content-block">
      <h2>OWNERSHIP AND PERMISSIONS</h2>
      <%= render 'edit_media_organization_transfer', f: f %>
      <%= @presenter.attribute_to_html(:user_with_ownership, label: t("simple_form.labels.media.data_managed_by"), render_as: :showcase_user_link, include_empty: true, show_hint: true) %>
      <%= @presenter.attribute_to_html(:depositor, label: t("simple_form.labels.media.data_uploaded_by"), render_as: :showcase_user_link, include_empty: false, show_hint: true) %>
      <%= render 'edit_media_permissions', f: f %>
    </div>

    <div class="content-block">
      <h2>IDENTIFIERS AND EXTERNAL LINKS</h2>

      <%= @presenter.attribute_to_html(:ark, render_as: :showcase_ark_link, include_empty: true, text_if_empty: 'Not assigned', show_hint: true) %>
      <%= @presenter.attribute_to_html(:doi, render_as: :showcase_doi_link, include_empty: true, text_if_empty: 'Not assigned', show_hint: true) %>
      <%= f.input :identifier %>
      <%= f.input :related_url %>
    </div>

  </div>
  <!-- /left column  -->

  <!-- right column  -->
  <div class="col-sm-6">

    <div class="content-block preview">
      <%= render @presenter.showcase_viewer_partial, presenter: @presenter %>
    </div>
    <div class="content-block">
      <%= render @presenter.showcase_media_items_partial, presenter: @presenter %>
    </div>

    <div class="content-block">
      <%= render 'form_member_of_collections', f: f %>
    </div>

    <%= render 'edit_media_tags', f: f %>

    <%= render 'edit_media_fund_codes', f: f %>

    <% if current_user.admin? %>
      <%= render 'edit_media_admin_settings', f: f %>
    <% end %>

  </div>
  <!-- / right column -->

</div>
