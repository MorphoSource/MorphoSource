<div class="row">

  <!-- left column  -->
  <div class="col-sm-6">

    <div class="content-block">
      <h2>GENERAL DETAILS</h2>
      <%= render_edit_field_partial('media_type', f: f) %>
      <%= f.input :part, label: 'Element or part of the object', as: :multi_value %>
      <%= render_edit_field_partial('side', f: f) %>
      <%= f.input :orientation, as: :multi_value %>
      <%= f.input :short_description, label: 'Short description' %>
      <%= f.input :description, label: 'Full description', as: :multi_value %>
    </div>



    <div class="content-block">
      <h2>OWNERSHIP AND PERMISSIONS</h2>

      <%= @presenter.attribute_to_html(:data_managed_by, render_as: :showcase_user_link, include_empty: true, html_dl: false) %>

      --- permission here ---

      <%= @presenter.attribute_to_html(:download_permission, render_as: :showcase_default, include_empty: true, html_dl: false) %>

      <%= render_edit_field_partial('license', f: f) %>
      <%= render_edit_field_partial('rights_statement', f: f) %>

      <div class="row"><div class="col-xs-6 showcase-label">Custom terms of use</div><div class="col-xs-6 showcase-value">Not yet implemented</div></div>

      <%= render_edit_field_partial('agreement_uri', f: f) %>

      <div class="row"><div class="col-xs-6 showcase-label">Commercial use permitted</div><div class="col-xs-6 showcase-value">No</div></div>
      <div class="row"><div class="col-xs-6 showcase-label">3D printing permitted</div><div class="col-xs-6 showcase-value">Not yet implemented</div></div>

      <%= f.input :rights_holder, as: :multi_value %>
      <div class="row">
        <div class="col-xs-6 showcase-label">IP holder(s)</div>
        <div class="col-xs-6 showcase-value form-group multi_value optional managed ie_xray_ct" id="media_rights_holder_wrapper">
          <ul class="listing rights_holder_listing" aria-live="polite">
            <li class="field-wrapper input-group input-append">
              <input class="string multi_value optional form-control media_rights_holder_name form-control multi-text-field" name="media[rights_holder_name][]" value="" id="media_rights_holder_name" type="text">
              <select class="form-control select optional form-control" name="media[rights_holder_type][]" id="media_rights_holder_type">
                <option value=""></option>
                <option value="Copyright and License">Copyright and License</option>
                <option value="Copyright">Copyright</option>
                <option value="License">License</option>
              </select>
            </li>
          </ul>
        </div>
      </div>
      <%= render_edit_field_partial('funding', f: f) %>
      <%= render_edit_field_partial('publisher', f: f) %>
      <%= render_edit_field_partial('cite_as', f: f) %>
    </div>

    <div class="content-block">
      <h2>IDENTIFIERS AND EXTERNAL LINKS</h2>

      <%= @presenter.attribute_to_html(:ark, label: 'MorphoSource ARK', render_as: :showcase_ark_link, include_empty: true, text_if_empty: 'Not assigned', html_dl: false) %>
      <%= @presenter.attribute_to_html(:doi, label: 'MorphoSource DOI', render_as: :showcase_doi_link, include_empty: true, text_if_empty: 'Not assigned', html_dl: false) %>
      <%= f.input :identifier, label: 'External identifier' %>
      <%= f.input :related_url, label: 'External media URL' %>
    </div>

    <div class="content-block">
      <h2>FILE OBJECT DETAILS</h2>
      <p>Please Note: If uploading a DICOM image stack, fields with the <i class="fa fa-search"></i> icon will be parsed automatically. Otherwise, enter this information. </p>

      <%= render_edit_field_partial('series_type', f: f) %>
      <%= render_edit_field_partial('x_spacing', f: f) %>
      <%= render_edit_field_partial('y_spacing', f: f) %>
      <%= render_edit_field_partial('z_spacing', f: f) %>
      <%= render_edit_field_partial('slice_thickness', f: f) %>
      <%= render_edit_field_partial('unit', f: f) %>


      <% if @presenter.this_media_type == 'Mesh' %>
          <%= @presenter.attribute_to_html(:point_count, label: "Points", render_as: :showcase_default, include_empty: true, html_dl: false) %>
          <%= @presenter.attribute_to_html(:face_count, label: "Polygons", render_as: :showcase_default, include_empty: true, html_dl: false) %>
          <%= @presenter.attribute_to_html(:color_format, label: "Color information format", render_as: :showcase_default, include_empty: true, html_dl: false) %>
          <%= @presenter.attribute_to_html(:normals_format, label: "Normal information format", render_as: :showcase_default, include_empty: true, html_dl: false) %>
          <%= @presenter.attribute_to_html(:has_uv_space, label: "UV coordinates", render_as: :showcase_default, include_empty: true, html_dl: false) %>
          <%= @presenter.attribute_to_html(:vertex_color, render_as: :showcase_default, include_empty: true, html_dl: false) %>
          <%= @presenter.attribute_to_html(:bounding_box_dimensions, render_as: :showcase_default, include_empty: true, html_dl: false) %>
          <%= @presenter.attribute_to_html(:centroid_location, label: "Centroid coordinates", render_as: :showcase_default, include_empty: true, html_dl: false) %>
          <%= @presenter.attribute_to_html(:unit, label: "Units of point coordinates", render_as: :showcase_default, include_empty: true, html_dl: false) %>
      <% elsif @presenter.this_media_type.match(/image/i) %>
        <%= @presenter.attribute_to_html(:image_width, render_as: :showcase_default, include_empty: true, html_dl: false) %>
        <%= @presenter.attribute_to_html(:image_height, render_as: :showcase_default, include_empty: true, html_dl: false) %>
        <%= @presenter.attribute_to_html(:color_space, render_as: :showcase_default, include_empty: true, html_dl: false) %>
        <%= @presenter.attribute_to_html(:color_depth, render_as: :showcase_default, include_empty: true, html_dl: false) %>
        <%= @presenter.attribute_to_html(:compression, render_as: :showcase_default, include_empty: true, html_dl: false) %>

        <% if @presenter.this_media_type == 'CTImageSeries' %>
          <%= @presenter.attribute_to_html(:series_type, render_as: :showcase_default, include_empty: true, html_dl: false) %>
          <%= @presenter.attribute_to_html(:x_spacing, label: "X pixel spacing", render_as: :showcase_default, include_empty: true, html_dl: false) %>
          <%= @presenter.attribute_to_html(:y_spacing, label: "Y pixel spacing", render_as: :showcase_default, include_empty: true, html_dl: false) %>
          <%= @presenter.attribute_to_html(:z_spacing, label: "Z pixel spacing", render_as: :showcase_default, include_empty: true, html_dl: false) %>
          <%= @presenter.attribute_to_html(:unit, label: "Pixel spacing units", render_as: :showcase_default, include_empty: true, html_dl: false) %>
          <%= @presenter.attribute_to_html(:slice_thickness, render_as: :showcase_default, include_empty: true, html_dl: false) %>
          <%= @presenter.attribute_to_html(:number_of_images_in_set, label: "Number of slices", render_as: :showcase_default, include_empty: true, html_dl: false) %>
        <% elsif @presenter.this_media_type == "PhotogrammetryImageSeries" %>
          <%= @presenter.attribute_to_html(:number_of_images_in_set, render_as: :showcase_default, include_empty: true, html_dl: false) %>
          <%= @presenter.attribute_to_html(:scale_bar, render_as: :showcase_default, include_empty: true, html_dl: false) %>
        <% end %>

      <% end %>
    </div>
  
  </div>
  <!-- /left column  -->

  <!-- right column  -->
  <div class="col-sm-6">

    <%#= render 'edit_media_items', presenter: @presenter, f: f %>

    <div class="content-block">
      <%= render 'form_member_of_collections', f: f %>
    </div>

    <div class="content-block">
      <h2>MEDIA TAGS</h2>
      <div class="row">
        <div class="col-xs-6 showcase-label">
      Not yet implemented
        </div>
        <div class="col-xs-6 showcase-value">
      Not yet implemented
        </div>
      </div>
    </div>

    <div class="content-block">
      <h2> CITATION AND DOWNLOAD HISTORY OF PHYSICAL OBJECT MEDIA </h2>
      <div class="row">
        <div class="col-xs-6 showcase-label">
      Number of downloads
        </div>
        <div class="col-xs-6 showcase-value">
      Not yet implemented
        </div>
      </div>
    </div>

  </div>
  <!-- / right column -->

</div>
