<div class="media-thumbnail thumbnail-md">
  <%= render_thumbnail_tag presenter, {}, { suppress_link: true } %>
</div>
<div class="media-title">
  <div>
    <div id="showcase-title">
      <div><%= presenter.generated_title %></div>
      <%= presenter.permission_badge %>
    </div>
    <div class="text-muted" style="margin-bottom: 0;">
      <div class="text-muted-item mr-1" style="margin-bottom: 8px;">
        Type
        <span class="text-muted-value"><%= presenter.human_readable_media_type || "Unknown Type" %></span>
      </div> 
      <div class="text-muted-item mr-1" style="margin-bottom: 8px;">
        Modality
        <span class="text-muted-value"><%= presenter.imaging_event_modality %></span>
      </div> 
      
    </div>
    <% if presenter.physical_object_type.present? %>
      <div class="text-muted">
        <div class="text-muted-item">
          Media represents <%= presenter.physical_object_type.downcase %>
        </div>
        <div class="text-muted-item"> 
          <%= link_to presenter.physical_object_link do  %>
            <%= presenter.physical_object_title&.first %> <i><%= presenter.taxonomies_titles&.first || "" %></i>
          <% end %>
        </div>
      </div>
    <% end %>
    <div class="text-muted">
      <div class="text-muted-item">
        Managed by
      </div> 
      <div class="text-muted-item">
        <%= presenter.attribute_to_html(:user_with_ownership, render_as: :showcase_user_link_simple, include_empty: true, html_dl: false) %>
      </div> 
    </div>
  </div>
</div>