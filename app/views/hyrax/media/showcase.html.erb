<% content_for :body_css_classes do %>showcase<% end %> 
<% content_for :content_css_classes do %>fixed-width<% end %> 

<%= render @presenter.showcase_work_title_partial, presenter: @presenter %>

  
  <div class="download-agreements">
    <a class="btn-download-item btn btn-info btn-xs" data-item-id="CURRENT" href="javascript:void(0)">Download Item</a>
    <%#= link_to item.id, main_app.download_items_path(item_id: item.id), class: "hide", id: 'link-to-download-item-'+item.id.to_s, method: :get %>

    <div class="agreements" data-item-id="CURRENT">
      <div data-field="media_doc_id" data-value="<%= curation_concern.id %>"></div>
      <div data-field="agreement_description" data-value="<%= @presenter.agreement_description %>"><%= link_to @presenter.agreement_description, asset_path(@presenter.aup_path) %></div>
      <div data-field="agreement_uri">
      <%= @presenter.attribute_to_html(
        :agreement_uri, 
        label: 'Additional Usage Agreement', 
        render_as: :showcase_agreement_uri_file, 
        include_empty: true, 
        text_if_empty: 'None',
        attachment_path: @presenter.agreement_attachment,
        attachment_file_url: main_app.attachment_path(id: curation_concern.id, field: 'agreement'),
        html_dl: false) 
      %>
      </div>
    </div>
  </div>

<div class="row media-showcase">

  <div class="col-sm-6 col-sm-push-6">
    <div class="content-block preview">
      <%= render @presenter.showcase_viewer_partial, presenter: @presenter %>
    </div>
    <div class="content-block">
      <%= render @presenter.showcase_media_items_partial, presenter: @presenter %>
    </div>

    <div class="content-block">
      <%= render @presenter.showcase_collections_partial, presenter: @presenter %>
    </div>
    <div class="content-block">
      <%= render @presenter.showcase_tags_partial, presenter: @presenter %>
    </div>
  </div>

  <div class="col-sm-6 col-sm-pull-6">
    <div class="content-block">
      <%= render @presenter.showcase_file_object_details_partial, presenter: @presenter %>
    </div>
    <div class="content-block">
      <%= render @presenter.showcase_image_acquisition_partial, presenter: @presenter %>
    </div>
    <div class="content-block">
      <%= render @presenter.showcase_ownership_and_permissions_partial, presenter: @presenter %>
    </div>


    <div class="content-block">
      <%= render @presenter.showcase_identifiers_and_external_links_partial, presenter: @presenter %>
    </div>
  </div>

</div>

<%= render @presenter.showcase_image_acquisition_details_partial, presenter: @presenter %>

<%= render partial: '/morphosource/my/modals/page_modal' %>
<script>
  <%= render partial: '/morphosource/my/scripts/modal_scripts', formats: [:js] %>
</script>
