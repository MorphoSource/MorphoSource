<% content_for :body_css_classes do %>showcase showcase2<% end %>
<% content_for :content_css_classes do %>fixed-width<% end %>

<%= render @presenter.showcase_work_title_partial, presenter: @presenter %>

<div class="row showcase2-row media-showcase">

  <div class="col-md-6 order-md-1 order-2">
    <div class="content-block">
      <%= render @presenter.showcase_general_details_partial, presenter: @presenter %>
    </div>
    <div class="content-block">
      <%= render @presenter.showcase_file_object_details_partial, presenter: @presenter %>
    </div>
    <div class="content-block">
      <%= render @presenter.showcase_image_acquisition_partial, presenter: @presenter %>
    </div>
    <div class="content-block">
      <%= render @presenter.showcase_ownership_and_permissions_partial, presenter: @presenter %>
    </div>
    <div class="content-block">
      <%= render @presenter.showcase_identifiers_and_external_links_partial, presenter: @presenter %>
    </div>
  </div>

  <div class="col-md-6 order-md-2 order-1">
    <div class="content-block preview">
      <%= render @presenter.showcase_viewer_partial, presenter: @presenter %>
    </div>
    <div class="content-block">
      <%= render @presenter.showcase_media_items_partial, presenter: @presenter %>
    </div>
    <div class="content-block">
      <%= render @presenter.showcase_collections_partial, presenter: @presenter %>
    </div>
    <div class="content-block">
      <%= render @presenter.showcase_tags_partial, presenter: @presenter %>
    </div>
  </div>

</div>

<%= render @presenter.showcase_image_acquisition_details_partial, presenter: @presenter %>

<%= render partial: '/morphosource/my/modals/page_modal' %>
<%= render partial: 'application/modals/download/wrapper' %>

<script>
  <%= render partial: '/morphosource/my/scripts/modal_scripts', formats: [:js] %>
</script>

<%# hidden div and modal for download agreement %>
<% if current_user.present? %>
  <%= render 'download_agreements_container', presenter: @presenter %>
  <%= render 'morphosource/my/modals/download_agreements' %>
<% end %>
