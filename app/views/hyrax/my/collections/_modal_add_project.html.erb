<div class="modal fade disable-unless-selected <%= id %>" id="add-subcollection-modal-<%= id %>" tabindex="-1" role="dialog" aria-labelledby="add-subcollection-label">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="<%= t('hyrax.dashboard.heading_actions.close') %>"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="add-subcollection-label"><%= t("hyrax.dashboard.collections.actions.add_project_to_#{@collection.collection_type.machine_id}.label") %></h4>
      </div>
      <div class="modal-body">
        <%= form_tag(hyrax.dashboard_create_nest_collection_under_path(id), method: :post, id: 'modal-form', :class => "form-horizontal") do %>
          <select name="child_id" style="width: 60%">
            <option value="none"><%= t("hyrax.dashboard.my.action.select") %></option>
            <%# list of projects the user can edit and that don't have a parent already %>
            <% eligible_child_projects.each {|project| %>
              <option value="<%= project["id"] %>"><%= project["title_tesim"].first %></option>
            <% } %>
          </select>
      </div>
      <div class="modal-footer">
        <button type="button" id="modal-cancel" class="btn btn-danger" data-dismiss="modal">Cancel</button>
          <%= submit_tag "Submit", name: nil, class: "btn btn-success" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
