<div class="facet_pagination top">
  <%= render partial: 'facet_pagination' %>
</div>

<div class="modal-header">
  <button type="button" class="ajax-modal-close close" data-dismiss="modal" aria-hidden="true">×</button>

  <h3 class="modal-title"><%= facet_field_label(@facet.key) %></h3>
  <%= render partial: 'facet_index_navigation' if @facet.index_range && @display_facet.index? %>

</div>
<div class="modal-body">
  <%= form_tag url_for, method: :get, class: "form-horizontal search-form ms-catalog-search mb-1", data: { ajax_modal: "preserve" } do %>
  <%= render_hash_as_hidden_fields(search_state.params_for_search.except(:q, :search_field, :qt, :page, :utf8, :"facet.page", :"facet.contains")) %>
  <%= hidden_field_tag :search_field, 'all_fields' %>

    <div class="input-group">
      <%= text_field_tag :"facet.contains", params["facet.contains"] , class: "q form-control", placeholder: t("morphosource.search.form.facet.placeholder") %>

      <div class="input-group-btn">
        <% if params["facet.contains"] %>
          <%= link_to "Clear", url_for(:"facet.sort" => params["facet.sort"]), class: "btn btn-danger", data: { ajax_modal: "preserve" } %>
        <% end %>
        <button type="submit" class="btn btn-primary">
          <%= t('hyrax.search.button.html') %>
        </button>        
      </div><!-- /.input-group-btn -->
    </div><!-- /.input-group -->
  <% end %>
  <div class="facet_extended_list">
  <%= render_facet_limit(@display_facet, layout: false) %>
  </div>
</div>

<div class="modal-footer">

  <div class="facet_pagination bottom">
    <%= render partial: 'facet_pagination' %>
  </div>
</div>
