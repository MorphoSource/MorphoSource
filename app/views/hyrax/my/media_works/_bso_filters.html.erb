<% show_filter_by = false %>
<%= form_tag media_works_url("biological_specimens"), method: :get, class: "filters", id: "bso-filters", name: "bso-filters" do %>
  <%= hidden_params_for_filters('b_') %>
  <div class="filters row">

    <div class="col-sm-2 col-lg-1 filter-label">Filter:</div>
    <div class="col-sm-10 col-lg-11">

      <% if params['b_source'].present? 
        show_filter_by = true %>
        <input type="hidden" name="b_source" value="<%= params['b_source'] %>" class="filter-param" />
      <% else %>
        <select name="b_source" data-form="bso-filters" style='width: 150px;'>
          <option value="">Source</option>
          <% Array(@collection_bso_groups['source']).each do |v, n| %>
            <option value="<%= v %>"><%= "#{source_label(v)} (#{n})" %></option>
          <% end %>
        </select>
      <% end %>

      <% if params['b_organization'].present? 
        show_filter_by = true %>
        <input type="hidden" name="b_organization" value="<%= params['b_organization'] %>" class="filter-param" />
      <% else %>
        <select name="b_organization" data-form="bso-filters" style='width: 150px;'>
          <option value="">Organization</option>
          <% Array(@collection_bso_groups['organization']).each do |v, n| %>
            <option value="<%= v %>"><%= "#{v} (#{n})" %></option>
          <% end %>
        </select>
      <% end %>

      <% if params['b_project'].present? 
        show_filter_by = true %>
        <input type="hidden" name="b_project" value="<%= params['b_project'] %>" class="filter-param" />
        <input type="hidden" name="m_project" data-sync="b_project" value="<%= params['b_project'] %>" class="filter-param" />
        <input type="hidden" name="c_project" data-sync="b_project" value="<%= params['b_project'] %>" class="filter-param" />
      <% else %>
        <select name="b_project" data-form="bso-filters" style='width: 150px;'>
          <option value="">Project</option>
          <% Array(@collection_media_groups['project']).each do |v, n| %>
            <option value="<%= v %>"><%= "#{v} (#{n})" %></option>
          <% end %>
        </select>
        <input type="hidden" name="m_project" data-sync="b_project" value="" class="filter-param" />
        <input type="hidden" name="c_project" data-sync="b_project" value="" class="filter-param" />
      <% end %>

      <% if params['b_team'].present? 
        show_filter_by = true %>
        <input type="hidden" name="b_team" value="<%= params['b_team'] %>" class="filter-param" />
        <input type="hidden" name="m_team" data-sync="b_team" value="<%= params['b_team'] %>" class="filter-param" />
        <input type="hidden" name="c_team" data-sync="b_team" value="<%= params['b_team'] %>" class="filter-param" />
      <% else %>
        <select name="b_team" data-form="bso-filters" style='width: 150px;'>
          <option value="">Team</option>
          <% Array(@collection_media_groups['team']).each do |v, n| %>
            <option value="<%= v %>"><%= "#{v} (#{n})" %></option>
          <% end %>
        </select>
        <input type="hidden" name="m_team" data-sync="b_team" value="" class="filter-param" />
        <input type="hidden" name="c_team" data-sync="b_team" value="" class="filter-param" />
      <% end %>

      <% if params['q'].present? 
        show_filter_by = true %>
        <input type="hidden" name="q" value="<%= params['q'] %>" class="filter-param" />
      <% end %>

    </div>

  </div>

  <% if show_filter_by == true %>
    <div class="filter-by row">

      <div class="col-sm-2 col-lg-1 filter-label">Filtering by:</div>
      <div class="col-sm-8 col-lg-9">
        <% if params['b_source'].present? %>
          <p id="b_source" class="filter-param">Source > <%= source_label(params['b_source']) %> <i class="fa fa-times-circle" aria-hidden="true" data-behavior="remove-filter" data-form="bso-filters" data-param="b_source"></i></p>
        <% end %>
        <% if params['b_organization'].present? %>
          <p id="b_organization" class="filter-param">Organization > <%= params['b_organization'] %> <i class="fa fa-times-circle" aria-hidden="true" data-behavior="remove-filter" data-form="bso-filters" data-param="b_organization"></i></p>
        <% end %>
        <% if params['b_project'].present? %>
          <p id="b_project" class="filter-param">Project > <%= params['b_project'] %> <i class="fa fa-times-circle" aria-hidden="true" data-behavior="remove-filter" data-form="bso-filters" data-param="b_project"></i></p>
        <% end %>
        <% if params['b_team'].present? %>
          <p id="b_team" class="filter-param">Team > <%= params['b_team'] %> <i class="fa fa-times-circle" aria-hidden="true" data-behavior="remove-filter" data-form="bso-filters" data-param="b_team"></i></p>
        <% end %>

        <% if params['q'].present? %>
          <p id="search_param" class="filter-param">Search > <%= params['q'] %> <i class="fa fa-times-circle" aria-hidden="true" data-behavior="remove-filter" data-form="media-filters" data-param="q"></i></p>
        <% end %>
      </div>
      <div class="col-sm-2 col-lg-2 text-right"><a href="javascript:void(0)" class="remove-filter-all" aria-hidden="true" data-behavior="remove-filter" data-form="bso-filters" data-param="all">Remove all <i class="fa fa-times-circle"></i></a></div>
    </div>
  <% end %>

<% end %>
