<% 
id = document.id 
cho = CulturalHeritageObject.find(id)
cho_extra = extra(@cho_extras, id)
%>
<tr id="document_<%= id %>">
  <td class="break-all"><%= cho.title&.first %></td>
  <td><%= cho.material&.first %></td>
  <td><%= cho.cho_type&.first %></td>
  <td><%= cho.vouchered&.first %></td>
  <td><%= cho_extra['media_count'] %></td>  
  <td><%= document.date_uploaded %> </td> 
  <%# todo: might need to format the date later, e.g. using MS helper display_date 
      Make sure it can be sorted in datatables
       display_date(document.date_uploaded&.to_s) %>
  <td><%= cho_extra["origin"] %></td>
</tr>
