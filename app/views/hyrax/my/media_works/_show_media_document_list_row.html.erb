<% 
id = document.id 
media_extra = extra(@media_extras, id)
po_title = media_extra['po_title']
po_taxonomy = media_extra['po_taxonomy']
%>
<tr id="document_<%= id %>">
  <td class="checkbox">
    <%= check_box_tag "batch_work_ids[]", id, false, class:"batch_add_selector", id: "batch_work_#{id}" %>
  </td>
  <td>
    <div class="media">
      <%= link_to [main_app, document], target: :_blank, class: "media-left" do %>
        <%= render_thumbnail_tag document, { class: "file_listing_thumbnail" }, { suppress_link: true } %>
      <% end %>
      <%# div class="media-body">
        <p class="media-heading">
          <strong><%= link_to document.title_or_label, [main_app, document], id: "src_copy_link#{id}", class: "#{'document-title' if document.title_or_label == document.label}" % ></strong>
        </p>
        <%= render_collection_links(document) % >
      </div %>
    </div>
  </td>
  <td><%= document.id %></td>  
  <td><%= document.part&.first %></td>  
  <td class="break-all"><%= po_title %></td>
  <% if @po_type == 'bso' %>
    <td><%= po_taxonomy %></td>
  <% else %>
    <td></td>
  <% end %>
  <td><%= document.media_type&.first.underscore.humanize %></td> 
  <td><%= document.date_uploaded %></td>
  <td class='long-badge'><%= render_publication_status_badge(document) %></td>
  <td class="text-center">
      &nbsp; 
  </td>

</tr>