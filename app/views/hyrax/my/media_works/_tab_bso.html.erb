<%#= render 'hyrax/dashboard/collections/bso_filters' %>
<div class="row">
  <!-- Search bar -->
  <div class="col-xs-6">
    <%#= render 'hyrax/teams/search_form', presenter: @presenter, url: @presenter.search_form_url %>
  </div>
  <div class="col-xs-6">
    <%= render 'sort_and_per_page_bso', collection: @presenter %>
  </div>
</div>
<div class="hyc-blacklight hyc-bl-results">
  <%= render_document_index @paged_bso_member_docs, work_type: 'biological_specimen' %> 
</div>
<div class="hyc-blacklight hyc-bl-pager">
  <%= render 'paginate_bso' %>
</div>

<input type="hidden" name="bso-count" value="<%= @bso_member_count %>" />
