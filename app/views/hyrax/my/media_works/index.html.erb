<% content_for :body_css_classes do %>showcase showcase-edit media-works<% end %>
<% provide :page_title, "Media and Objects" %>

<% provide :page_header do %>
  <div class="col-xs-9 title">
    <h1><span class="fa fa-cube %>" aria-hidden="true"></span> Media and Objects</h1>
  </div>
  <div class="col-xs-3 show-actions text-right">
    <% if can?(:create, Media) %>
      <%= link_to 'New media', main_app.new_submission_path(restart: true), class: 'btn btn-primary' %>
    <% end %>
  </div>
  <% puts Benchmark.measure { %>
  <div class="row collection-count">
      <%= render 'membership_count' %>
  </div>
  <% } %>
<% end %>

<div class="col-md-12">

  <div class="panel panel-default tabs" role="main">
    <!-- Nav tabs -->
    <ul class="nav nav-tabs" role="tablist">
      <li role="presentation" class="active">
        <a href="#media" aria-controls="media" role="tab" data-toggle="tab" aria-expanded="false">
        <i class="fa fa-cube" aria-hidden="true"></i> MEDIA
        </a>
      </li>
      <li role="presentation">
        <a href="#biological_specimens" aria-controls="biological_specimens" role="tab" data-toggle="tab" aria-expanded="true">
          <i class="fas fa-frog" aria-hidden="true"></i> SPECIMENS
        </a>
      </li>
      <li role="presentation">
        <a href="#cultural_heritage_objects" aria-controls="cultural_heritage_objects" role="tab" data-toggle="tab" aria-expanded="true">
          <i class="ms2-icon-bowl icon-bowl" aria-hidden="true"></i> CULTURAL HERITAGE OBJECTS
        </a>
      </li>
    </ul>

    <!-- Tab panes -->
    <div class="tab-content">

      <div role="tabpanel" class="tab-pane active" id="media">
        <div class="form-tab-content">
          <% if @collection_media_groups.present? %>
          <% puts Benchmark.measure { %>
          <%= render 'media_filters' %>
          <% } %>

          <% puts Benchmark.measure { %>
          <%= render 'tab_media', presenter: @presenter %>
          <% } %>
          <% end %>
        </div>
      </div>

        <div role="tabpanel" class="tab-pane" id="biological_specimens">
          <div class="form-tab-content">
          <% if @collection_bso_groups.present? %>
          <% puts Benchmark.measure { %>
            <%= render 'bso_filters' %>
          <% } %>
            <div class="row">
              <!-- Search bar -->
              <div class="col-xs-6">
                <%= render 'search_form', tab: "biological_specimens" %>
              </div>
              <div class="col-xs-6">
                <% puts Benchmark.measure { %>

                <%= render 'sort_and_per_page_bso' %>
                <% } %>
              </div>
            </div>
            <%#= render 'tab_bso' %>
            <%= render_async bso_tab_url, event_name: "bso-loaded" do %>
              <div class="ui-loading-whole-page" style="height:200px"></div>
            <% end %>
          <% end %>
          </div>
        </div>

        <div role="tabpanel" class="tab-pane" id="cultural_heritage_objects">
          <div class="form-tab-content">
          <% if @collection_cho_groups.present? %>
            <%= render 'cho_filters' %>
            <div class="row">
              <!-- Search bar -->
              <div class="col-xs-6">
                <%= render 'search_form', tab: "cultural_heritage_objects" %>
              </div>
              <div class="col-xs-6">
                <%= render 'sort_and_per_page_cho' %>
              </div>
            </div>
            <%#= render 'tab_cho' %>
            <%= render_async cho_tab_url, event_name: "cho-loaded" do %>
              <div class="ui-loading-whole-page" style="height:200px"></div>
            <% end %>
          <% end %>
          </div>
        </div>

    </div><!-- /tab-content -->

  </div><!-- /panel panel-default tabs -->

</div><!-- div hyc-container -->
