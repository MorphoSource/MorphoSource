<% content_for :body_css_classes do %>showcase showcase-edit media-works<% end %>
<% provide :page_title, @media_works_page_title %>

<% provide :page_header do %>
  <div class="col-xs-12 title add-media-to-collection">
    <h1><i class="fa fa-arrow-circle-right"></i> <%= @media_works_page_title %></h1>
    <p>Use the checkboxes to select, then click "<%= @add_to_collection_button_label %>". </p>
  </div>
<% end %>

<div class="col-md-12">

  <div role="tabpanel" class="tab-pane active" id="media">
    <div class="form-tab-content">
      <% if @collection_media_groups.present? %>
      <%= render 'media_filters' %>
      <%= render 'tab_media', presenter: @presenter %>
      <% end %>
    </div>
  </div>

</div><!-- div hyc-container -->
