<% show_filter_by = false %>
<form action="<%= ms_dashboard_my_collection_link %>" class='filters' id="collection-filters" name="collection-filters" method="get">
	<%= hidden_params_for_filters('k_') %>
	<div class="filters row">

		<div class="col-sm-2 col-lg-1 filter-label">Filter:</div>
		<div class="col-sm-10 col-lg-11">

			<% if params['k_visibility'].present? 
					 show_filter_by = true %>
				<input type="hidden" name="k_visibility" value="<%= params['k_visibility'] %>" class="filter-param" />
			<% else %>
		  	<select name="k_visibility" data-form="collection-filters">
		  		<option value="">Visibility</option>
          <% Array(@collection_groups['visibility']).each do |v, n| %>
            <option value="<%= v %>"><%= "#{visibility_label(v)} (#{n})" %></option>
          <% end %>
		  	</select>
		  <% end %>

		 	<% if params['k_organization'].present? 
					 show_filter_by = true %>
				<input type="hidden" name="k_organization" value="<%= params['k_organization'] %>" class="filter-param" />
			<% else %>
		  	<select name="k_organization" data-form="collection-filters">
		  		<option value="">Organization</option>
          <% Array(@collection_groups['organization']).each do |v, n| %>
            <option value="<%= v %>"><%= "#{v} (#{n})" %></option>
		  		<% end %>
		  	</select>
		  <% end %>

      <% if params['q'].present? 
        show_filter_by = true %>
        <input type="hidden" name="q" value="<%= params['q'] %>" class="filter-param" />
      <% end %>

		</div>

	</div>

	<% if show_filter_by == true %>
		<div class="filter-by row">

			<div class="col-sm-2 col-lg-1 filter-label">Filtering by:</div>
			<div class="col-sm-8 col-lg-9">
				<% if params['k_visibility'].present? %>
					<p id="k_visibility" class="filter-param">Visibility > <%= visibility_label(params['k_visibility']) %> <i class="fa fa-times-circle" aria-hidden="true" data-behavior="remove-filter" data-form="collection-filters" data-param="k_visibility"></i></p>
				<% end %>
				<% if params['k_organization'].present? %>
					<p id="k_organization" class="filter-param">Organization > <%= params['k_organization'] %> <i class="fa fa-times-circle" aria-hidden="true" data-behavior="remove-filter" data-form="collection-filters" data-param="k_organization"></i></p>
				<% end %>

        <% if params['q'].present? %>
          <p id="search_param" class="filter-param">Search > <%= params['q'] %> <i class="fa fa-times-circle" aria-hidden="true" data-behavior="remove-filter" data-form="collection-filters" data-param="q"></i></p>
        <% end %>
			</div>
			<div class="col-sm-2 col-lg-2 text-right"><a href="javascript:void(0)" class="remove-filter-all" aria-hidden="true" data-behavior="remove-filter" data-form="collection-filters" data-param="all">Remove all <i class="fa fa-times-circle"></i></a></div>

		</div>
	<% end %>


</form>