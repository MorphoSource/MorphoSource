	<div class="row record-padding paginate-wrapper">

		<div class="col-md-12 col-lg-2">
		  <%= form_tag '', method: :get, :id => 'rows_per_page' do %>
		    <div class="select-tag">
		      Rows per page <%= select_tag :trows, options_for_select(Hyrax.config.teams_rows_per_page_range, selected: params[:trows] || Hyrax.config.teams_show_work_item_rows), onchange: "$('#rows_per_page').submit();" %> 
		    </div>
		  <% end %>
		</div>

		<div class="col-md-12 col-lg-2">
			<div>Showing <%= page_entries_info @paged_collection_docs_by_type %></div>
		</div>

		<div class="col-md-12 col-lg-8">
		  <%= paginate @paged_collection_docs_by_type, outer_window: 2, theme: 'blacklight', param_name: :page, route_set: main_app %>
		</div>

	</div><!-- /row -->
