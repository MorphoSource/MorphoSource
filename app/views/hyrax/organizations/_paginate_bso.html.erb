	<div class="row record-padding paginate-wrapper">

		<div class="col-md-12 col-lg-2">
		  <%= form_tag '', method: :get, :id => 'bso_rows_per_page' do %>
			<%= hidden_params_for_pagination('b_') %>
		    <div class="select-tag">
		      Rows per page <%= select_tag :brows, options_for_select(Hyrax.config.teams_rows_per_page_range, selected: params[:brows] || Hyrax.config.teams_show_work_item_rows), onchange: "$('#bso_rows_per_page').submit();" %> 
		    </div>
		  <% end %>
		</div>

		<div class="col-md-12 col-lg-2">
			<div>Showing <%= page_entries_info @paged_bso_member_docs %></div>
		</div>

		<div class="col-md-12 col-lg-8">
		  <%= paginate @paged_bso_member_docs, outer_window: 2, theme: 'blacklight', param_name: :page, route_set: main_app, :params => { script_name: "/organization_paging", :anchor => 'biological_specimens' } %>
		</div>

	</div><!-- /row -->

