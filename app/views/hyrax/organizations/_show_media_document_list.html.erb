<table id="datatable-media-list" class="table table-striped teams-projects" style="width:100%;">
  <caption class="sr-only">List of media items in this team</caption>
  <thead>
  <tr>
    <th class="checkbox no-sort"><input type="checkbox" id="select-all-for-download" /></th>
    <th>&nbsp;<!-- thumbnail column --></th>
    <th>ID</th>
    <th>Part</th>
    <th>Object</th>
    <th>Taxonomy</th>
    <th>Type</th>
    <th>Date Added</th>
    <th>Publication Status</th>
  </tr>
  </thead>
  <tbody>
    <%= render partial: 'hyrax/organizations/show_media_document_list_row', collection: documents, as: :document %>
  </tbody>
</table>
