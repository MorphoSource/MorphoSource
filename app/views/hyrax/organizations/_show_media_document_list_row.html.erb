<% 
id = document.id 
media_extra = extra(@media_extras, id)
po_title = media_extra['po_title']
po_taxonomy = media_extra['po_taxonomy']
%>
<tr id="document_<%= id %>">
  <td class="checkbox">
    <%= check_box_tag "batch_work_ids[]", id, false, class:"batch_add_selector", id: "batch_work_#{id}" %>
  </td>
  <td>
    <div class="media">
      <%= link_to [main_app, document], target: :_blank, class: "media-left" do %>
        <%= render_thumbnail_tag document, { class: "file_listing_thumbnail" }, { suppress_link: true } %>
      <% end %>
      <%# div class="media-body">
        <p class="media-heading">
          <strong><%= link_to document.title_or_label, [main_app, document], id: "src_copy_link#{id}", class: "#{'document-title' if document.title_or_label == document.label}" % ></strong>
        </p>
        <%= render_collection_links(document) % >
      </div %>
    </div>
  </td>
  <td><%= document.id %></td>  
  <td><%= document.part&.first %></td>  
  <td class="break-all"><%= po_title %></td>
  <% if @po_type == 'bso' %>
    <td><%= po_taxonomy %></td>
  <% else %>
    <td></td>
  <% end %>
  <td><%= document.media_type&.first.underscore.humanize %></td> 
  <% if @is_team %>
    <td><%= media_extra["team_project_title"] %></td>
    <td><%= media_extra["origin"] %></td>
  <% end %>
  <td><%= document.date_uploaded %></td>
  <td class='long-badge'><%= render_publication_status_badge(document) %></td>
  <td class="text-center">
    <% 
      # todo: below code does not work since source_of_result is no longer available 
      # need to figure out how to determine when the user can remove a media on each row.
      # for now, show remove button if user can edit collection
      if current_user and can? :edit, @collection 
      %>
        <form></form>
        <%= button_for_remove_from_collection @collection, document, label: "Remove", btn_class: "btn-remove-media btn-danger btn-xs" %>

      <%# if media_extra["source_of_result"] == 'team' || 
        media_extra["source_of_result"] == 'project' %>
        <%#form></form>
        <%#= button_for_remove_from_collection @collection, document, label: "Remove", btn_class: "btn-remove-media btn-danger btn-xs" %>
      <%#else %>
        <%# show info instead of remove button if the media is not in the team bucket %>
        <%#i class="material-icons tooltip-icon" data-original-title="" title="">
          <p class="hint hide">
            <%# if media_extra["source_of_result"] == 'team_project' %> 
            <%#  This media belongs to a team project.
            <%# elsif media_extra["source_of_result"] == 'linked_org' %> 
            <%#  This media belongs to a linked organization.  
            <%# else %>
            <%#  You do not have permission to remove this media
            <%# end %>
          <%#/p>
        </i>
      <% end %>

    <% else %>
      &nbsp; 
    <% end %>
  </td>

</tr>