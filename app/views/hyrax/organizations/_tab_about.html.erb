          <div class="row">
            <div class="col-sm-6">

              <h2>ORGANIZATION</h2>
              <%= @presenter.attribute_to_html(:institution_name, label: 'Institution', render_as: :showcase_default, include_empty: false, html_dl: false) %>
              <%= @presenter.attribute_to_html(:title, label: 'Organization Name', render_as: :showcase_default, include_empty: true, html_dl: false) %>
              <%= @presenter.attribute_to_html(:organization_type, label: 'Organization Type', render_as: :showcase_default, include_empty: false, html_dl: false) %>
              <%= @presenter.attribute_to_html(:institution_code, label: 'Institution code', render_as: :showcase_default, include_empty: false, html_dl: false) %>
              <%= @presenter.attribute_to_html(:collection_code, label: 'Collection code', render_as: :showcase_default, include_empty: false, html_dl: false) %>
              <%= @presenter.attribute_to_html(:description, label: 'Description', render_as: :showcase_default, include_empty: false, html_dl: false) %>
              <%= @presenter.attribute_to_html(:address, label: 'Address', render_as: :showcase_default, include_empty: false, html_dl: false) %>
              <%= @presenter.attribute_to_html(:city, label: 'City', render_as: :showcase_default, include_empty: false, html_dl: false) %>
              <%= @presenter.attribute_to_html(:state_province, label: 'State/Province', render_as: :showcase_default, include_empty: false, html_dl: false) %>
              <%= @presenter.attribute_to_html(:postal_code, label: 'Postal Code', render_as: :showcase_default, include_empty: false, html_dl: false) %>
              <%= @presenter.attribute_to_html(:country, label: 'Country', render_as: :showcase_default, include_empty: false, html_dl: false) %>
              <%= @presenter.attribute_to_html(:contact_person, label: 'Contact Person', render_as: :showcase_default, include_empty: false, html_dl: false) %>
              <%= @presenter.attribute_to_html(:creator, render_as: :showcase_default, include_empty: false, html_dl: false) %>
              <%= @presenter.attribute_to_html(:contributor, render_as: :showcase_default, include_empty: false, html_dl: false) %>
              <%= @presenter.attribute_to_html(:based_near, label: 'Location', render_as: :showcase_default, include_empty: false, html_dl: false) %>
              <%= @presenter.attribute_to_html(:related_url, label: 'Related URL', render_as: :showcase_external_link, include_empty: false, html_dl: false) %>

            </div>

            <div class="col-sm-6">
              <h2>STATISTICS</h2>
              <div class="row">
                <div class="col-6 showcase-label">Number of media</div>
                <div class="col-6 showcase-value "><%= @media_member_count %></div>
              </div>
              <div class="row">
                <div class="col-6 showcase-label">Number of represented specimens</div>
                <div class="col-6 showcase-value tab-bso-count"></div>
              </div>
              <div class="row">
                <div class="col-6 showcase-label">Number of represented cultural heritage objects</div>
                <div class="col-6 showcase-value "><%= @cho_member_count %></div>
              </div>
              <div class="row">
                <div class="col-6 showcase-label">Project views</div>
                <div class="col-6 showcase-value ">(Not yet implemented)</div>
              </div>
              <div class="row">
                <div class="col-6 showcase-label">Number of media downloads</div>
                <div class="col-6 showcase-value ">(Not yet implemented)</div>
              </div>
            </div>
          </div>
