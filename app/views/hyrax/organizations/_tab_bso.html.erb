<% if @bso_member_count > 0 %>
	<div class="hyc-blacklight hyc-bl-results">
    <%= render_document_index @paged_bso_member_docs, work_type: 'biological_specimen' %>
	</div>
	<div class="hyc-blacklight hyc-bl-pager">
	  <%= render 'hyrax/organizations/paginate_bso' %>
	</div>
<% else %>
  <div class="row">
    <div class="no-result">
      No specimen found.
    </div>
  </div>
<% end %>
