<div class="row">
  <div class="col-12 col-sm-5 col-md-4 batch-action-buttons">
      <a id="add-selected-to-cart" class="btn btn-sm btn-default col-12 col-sm-8 disabled" href="javascript:void(0)">Add <i class="material-icons">check_box</i> to download</a>
  </div>
  <!-- Search bar -->
  <div class="col-12 col-sm-4 col-md-5">
    <%= render 'hyrax/organizations/search_form', tab: "media" %>
  </div>
  <div class="col-12 col-sm-3 col-md-3">
    <%= render 'hyrax/organizations/sort_and_per_page_media' %>
  </div>
</div>

<% if document_index_view_type == :gallery %>
<div class="col-12 text-muted">
  <input type="checkbox" id="select-all-for-download" /> Select all
</div>
<% end %>

<!-- Works -->
<div class="hyc-blacklight hyc-bl-results">
  <%= form_tag(main_app.batch_add_to_cart_path, method: :post) do -%>
    <%= submit_tag("cart submit", class: 'hidden', id:'add-selected-to-cart-hidden') %>

    <%= render_document_index @paged_media_member_docs, work_type: 'media' %>

  <% end # / form_tag %>
</div>
<div class="hyc-blacklight hyc-bl-pager">
  <%= render 'hyrax/organizations/paginate_media' %>
</div>

