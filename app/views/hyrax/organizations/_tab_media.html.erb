<div class="row tab-wrapper" >
  <% unless params[:view] == 'gallery' %>
    <div class="col-sm-12 col-md-5 col-lg-4 batch-action-buttons">
        <a id="add-selected-to-cart" class="btn btn-sm btn-secondary col-12 col-sm-8 disabled" href="javascript:void(0)">Add <i class="material-icons">check_box</i> to download</a>
    </div>
  <% end %>
  <!-- Search bar -->
  <div class="col-12 col-md-4 col-lg-5">
    <%= render 'hyrax/organizations/search_form', tab: "media" %>
  </div>
  <div class="col-12 col-md-3 col-lg-3">
    <%= render 'hyrax/organizations/sort_and_per_page_media' %>
  </div>
</div>

<!-- Works -->
<div class="hyc-blacklight hyc-bl-results">
  <%= form_tag(main_app.batch_add_to_cart_path, method: :post) do -%>
    <%= submit_tag("cart submit", class: 'hidden', id:'add-selected-to-cart-hidden') %>
    <% byebug %>
    <%= render_document_index @paged_media_member_docs, work_type: 'media' %>
  <% end # / form_tag %>
</div>
<div class="hyc-blacklight hyc-bl-pager">
  <%= render 'hyrax/organizations/paginate_media' %>
</div>

