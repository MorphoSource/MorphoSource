<% content_for :body_css_classes do %>showcase organizations<% end %>
<% provide :page_title, construct_page_title(@presenter.title.first) %>
<div class="hyc-container" itemscope itemtype="http://schema.org/CollectionPage">
  <div class="hyc-header">
    <header class="hyc-generic"></header>
  </div>

  <div class="row collection-header">

    <div class="col-9 flex">
      <div class="team-title">
         <h1>
            <div id="showcase-title">
              <div class="super-title"><%= @presenter.institution_name&.first %></div>
              <%= @presenter.title.first %>
            </div>
            <div class="text-muted">
              <%= pluralize(@media_member_count, ' Media') %> · 
              <%= pluralize(@bso_member_count, ' Specimen') %> · 
              <%= pluralize(@cho_member_count, ' Cultural Heritage Object') %>
            </div>
        </h1>
      </div>
    </div>
    <div class="col-3 show-actions text-right">
      <% if current_user&.admin? %>
        <%= link_to 'Edit', main_app.edit_hyrax_organization_path(@presenter.id), class: 'btn w-50 btn-primary' %>
      <% end %>
    </div>

  </div><!-- /row -->

  <div class="card panel-default tabs" role="main">
    <!-- Nav tabs -->
    <ul class="nav nav-tabs" role="tablist">
      <li role="presentation" class="active">
        <a href="#media" aria-controls="media" role="tab" data-toggle="tab" aria-expanded="false">
        <i class="fa fa-cube" aria-hidden="true"></i> MEDIA
        </a>
      </li>
      <li role="presentation">
        <a href="#biological_specimens" aria-controls="biological_specimens" role="tab" data-toggle="tab" aria-expanded="true">
          <i class="fas fa-frog" aria-hidden="true"></i> SPECIMENS
        </a>
      </li>
      <li role="presentation">
        <a href="#cultural_heritage_objects" aria-controls="cultural_heritage_objects" role="tab" data-toggle="tab" aria-expanded="true">
          <i class="ms2-icon-bowl icon-bowl" aria-hidden="true"></i> CULTURAL HERITAGE OBJECTS
        </a>
      </li>
      <li role="presentation">
        <a href="#about" aria-controls="about" role="tab" data-toggle="tab" aria-expanded="true">
          <i class="fa fa-newspaper" aria-hidden="true"></i> ABOUT
        </a>
      </li>
    </ul>

    <!-- Tab panes -->
    <div class="tab-content">

      <div role="tabpanel" class="tab-pane active" id="media">
        <div class="form-tab-content">
          <% if @media_member_count > 0 %>
            <%= render 'hyrax/organizations/media_filters' %>
            <%= render 'hyrax/organizations/tab_media' %>
          <% else %>
            <div class="row">
              <div class="no-result">
                No media found.
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div role="tabpanel" class="tab-pane" id="biological_specimens">
        <div class="form-tab-content">
          <% if @bso_member_count > 0 %>
            <%= render 'hyrax/organizations/bso_filters' %>
            <div class="row">
              <!-- Search bar -->
              <div class="col-6">
                <%= render 'hyrax/organizations/search_form', tab: "biological_specimens" %>
              </div>
              <div class="col-6">
                <%= render 'hyrax/organizations/sort_and_per_page_bso' %>
              </div>
            </div>
            <%= render 'hyrax/organizations/tab_bso' %>
          <% else %>
            <div class="row">
              <div class="no-result">
                No specimens found.
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div role="tabpanel" class="tab-pane" id="cultural_heritage_objects">
        <div class="form-tab-content">
          <% if @cho_member_count > 0 %>
            <%= render 'hyrax/organizations/cho_filters' %>
            <div class="row">
              <!-- Search bar -->
              <div class="col-6">
                <%= render 'hyrax/organizations/search_form', tab: "cultural_heritage_objects" %>
              </div>
              <div class="col-6">
                <%= render 'hyrax/organizations/sort_and_per_page_cho' %>
              </div>
            </div>
            <%= render 'hyrax/organizations/tab_cho' %>
          <% else %>
            <div class="row">
              <div class="no-result">
                No objects found.
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div role="tabpanel" class="tab-pane" id="about">
        <div class="form-tab-content">
          <%= render 'hyrax/organizations/tab_about', presenter: @presenter %>
        </div>
      </div>

    </div><!-- /tab-content -->

  </div><!-- /card panel-default tabs -->

</div><!-- div hyc-container -->
