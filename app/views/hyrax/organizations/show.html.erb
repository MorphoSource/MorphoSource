<% content_for :body_css_classes do %>showcase teams<% end %>

<%
provide :page_title, construct_page_title(@presenter.title)
%>
<div class="hyc-container" itemscope itemtype="http://schema.org/CollectionPage">
  <div class="hyc-header">
    <header class="hyc-generic"></header>
  </div>

  <div class="row team-header">

    <div class="col-sm-12 col-md-6 flex">
      <div class="team-title">
         <h1>
            <div id="showcase-title">
              <%= @presenter.title.first %>
              <%= @presenter.permission_badge %>
            </div>
            <div class="text-muted">
              <%= @media_member_count %> Media ·
              <span class="bso-count"></span>
            </div>
        </h1>
      </div>
    </div>

    <div class="col-xs-12 col-sm-3 col-md-2 flex text-right">
      <div class="show-actions col-xs-12">
        <% if can?(:edit, @presenter.solr_document) || can?(:deposit, @presenter.solr_document) %>
          <button type="button" class="btn btn-sm btn-primary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            Actions <span class="caret"></span>
          </button>
        <% end %>
      </div>
    </div>

  </div><!-- /row -->

  <div class="panel panel-default tabs" role="main">
    <!-- Nav tabs -->
    <ul class="nav nav-tabs" role="tablist">
      <li role="presentation" class="active">
        <a href="#media" aria-controls="media" role="tab" data-toggle="tab" aria-expanded="false">
        <i class="fa fa-cube" aria-hidden="true"></i> MEDIA
        </a>
      </li>
      <% if @po_type == 'bso' %>
        <li role="presentation">
          <a href="#biological_specimens" aria-controls="biological_specimens" role="tab" data-toggle="tab" aria-expanded="true">
            <i class="fas fa-frog" aria-hidden="true"></i> SPECIMENS
          </a>
        </li>
      <% elsif @po_type == 'cho' %>
        <li role="presentation">
          <a href="#cultural_heritage_objects" aria-controls="cultural_heritage_objects" role="tab" data-toggle="tab" aria-expanded="true">
            <i class="fas fa-frog" aria-hidden="true"></i> CULTURAL HERITAGE OBJECTS
          </a>
        </li>
      <% end %>
      <li role="presentation">
        <a href="#about" aria-controls="about" role="tab" data-toggle="tab" aria-expanded="true">
          <i class="fa fa-newspaper" aria-hidden="true"></i> ABOUT
        </a>
      </li>
    </ul>

    <!-- Tab panes -->
    <div class="tab-content">

        <div role="tabpanel" class="tab-pane active" id="media">
          <div class="form-tab-content">
            <%#= render 'hyrax/teams/media_filters' %>
            <%#= render 'hyrax/teams/tab_media' %>
          </div>
        </div>

      <% if @po_type == 'bso' %>
        <div role="tabpanel" class="tab-pane" id="biological_specimens">
          <div class="form-tab-content">
            <%= render 'hyrax/teams/bso_filters' %>
            <div class="row">
              <!-- Search bar -->
              <div class="col-xs-6">
                <%= render 'hyrax/teams/search_form', presenter: @presenter, url: @presenter.search_form_url %>
              </div>
            </div>
            <%= render 'hyrax/teams/tab_bso' %>
          </div>
        </div>
      <% elsif @po_type == 'cho' %>
        <div role="tabpanel" class="tab-pane" id="cultural_heritage_objects">
          <div class="form-tab-content">
            <%= render 'hyrax/teams/tab_cho' %>
          </div>
        </div>
      <% end %>

      <div role="tabpanel" class="tab-pane" id="about">
        <div class="form-tab-content">
          <%#= render 'hyrax/teams/tab_about', presenter: @presenter %>
        </div>
      </div>

    </div><!-- /tab-content -->

  </div><!-- /panel panel-default tabs -->

</div><!-- div hyc-container -->
