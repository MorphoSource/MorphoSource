<div>
  <% if presenter.editor? %>
    <div class="btn-group">
      <%= f.input Hyrax::Actors::OptimisticLockValidator.version_field, as: :hidden if f.object.persisted? %>
      <a href="/submissions/new" target="_blank" class="btn btn-sm btn-primary">Add Media</a>
      <% if presenter.model.model_name == "BiologicalSpecimen" %>
        <%= button_tag "Save", type: "button", class: "btn btn-primary btn-wide btn-save btn-save-bso", id: "btn-save-bso" %>
      <% else %>
        <%= f.submit class: 'btn btn-primary btn-wide btn-save', onclick: "confirmation_needed = false;", id: "with_files_submit", name: "save_with_files", value: "Save", data: { :disable_with => 'Saving...' } %>
      <% end %>
    </div>
  <% end %>
</div>
