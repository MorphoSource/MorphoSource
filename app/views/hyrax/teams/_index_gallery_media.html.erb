<% 
id = document.id 
media_extra = extra(@media_extras, id)
po_title = media_extra['po_title']
if @bso_member_count > 0 
  po_taxonomy = media_extra['po_taxonomy']
end
doc_presenter = index_presenter(document) 
%>
<dl class="document-metadata dl-horizontal dl-invert">
  <dd><%= document.id %></dd>
    <dd class="text-truncate"><%= po_title %>&nbsp;</dd>
    <% if @bso_member_count > 0 %>
      <dd class="text-truncate"><%= po_taxonomy %>&nbsp;</dd>
    <% end %>
		<dd>&nbsp;</dd>  
		<dd>&nbsp;</dd>  
  <dd class='long-badge'><%= render_publication_status_badge(document) %></dd>
</dl>
