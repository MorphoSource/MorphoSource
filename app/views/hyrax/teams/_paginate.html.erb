<% if @media_total_pages > 1 %>
	<div class="row record-padding paginate-wrapper">

		<div class="col-md-4 text-left">
		  <%= form_tag '', method: :get, :id => 'rows_per_page' do %>
		    <div class="select-tag">
		      Rows per page <%= select_tag :rows, options_for_select([5, 10, 15, 20], selected: params[:rows] || 10), onchange: "$('#rows_per_page').submit();" %> 
		    </div>
		  <% end %>
		</div>

		<div class="col-md-4 text-center">
		 <%= page_entries_info @paged_media_member_docs %>
		</div>

		<div class="col-md-4 text-right">
		  <%= paginate @paged_media_member_docs, outer_window: 2, theme: 'blacklight', param_name: :page, route_set: main_app %>
		</div>

	</div><!-- /row -->
<% end %>

