	<div class="row record-padding paginate-wrapper">

		<div class="col-md-12 col-lg-2">
			<form></form>
		  <%= form_tag '', method: :get, :id => 'cho_rows_per_page' do %>
			<%= hidden_params_for_pagination('c_') %>
		    <div class="select-tag">
		      Rows per page <%= select_tag :crows, options_for_select(Hyrax.config.teams_rows_per_page_range, selected: params[:crows] || Hyrax.config.teams_show_work_item_rows), onchange: "$('#cho_rows_per_page').submit();" %> 
		    </div>
		  <% end %>
		</div>

		<div class="col-md-12 col-lg-2">
			<div>Showing <%= page_entries_info @paged_cho_member_docs %></div>
		</div>

		<div class="col-md-12 col-lg-8">
		  <%= paginate @paged_cho_member_docs, outer_window: 2, theme: 'blacklight', param_name: :page, route_set: main_app, :params => { script_name: "/" + @presenter.collection_type.machine_id + "_paging", :anchor => 'cultural_heritage_objects' } %>
		</div>

	</div><!-- /row -->

