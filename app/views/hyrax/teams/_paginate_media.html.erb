	<div class="row record-padding paginate-wrapper">

		<div class="col-md-12 col-lg-2">
		  <%= form_tag '', method: :get, :id => 'mda_rows_per_page' do %>
			<%= hidden_params_for_pagination('m_') %>
		    <div class="select-tag">
		      Rows per page <%= select_tag :rows, options_for_select(Hyrax.config.teams_rows_per_page_range, selected: params[:rows] || Hyrax.config.teams_show_work_item_rows), onchange: "$('#mda_rows_per_page').submit();" %> 
		    </div>
		  <% end %>
		</div>

		<div class="col-md-12 col-lg-2">
			<div>Showing <%= page_entries_info @paged_media_member_docs %></div>
		</div>

		<div class="col-md-12 col-lg-8">
		  <%= paginate @paged_media_member_docs, outer_window: 2, theme: 'blacklight', param_name: :page, route_set: main_app, :params => { script_name: "/" + @presenter.collection_type.machine_id + "_paging", :anchor => 'media' } %>
		</div>

	</div><!-- /row -->

