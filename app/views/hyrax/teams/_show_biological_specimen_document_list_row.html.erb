<% 
id = document.id 
bso = BiologicalSpecimen.find(id)
bso_extra = extra(@bso_extras, id)
%>
<tr id="document_<%= id %>">
  <td>
    <div class="media">
      <%= link_to [main_app, document], class: "media-left" do %>
        <%= render_thumbnail_tag document, { class: "hidden-xs file_listing_thumbnail" }, { suppress_link: true } %>
      <% end %>
    </div>
  </td>
  <td class="break-all"><%= bso&.title&.first %></td>
  <td><%= bso&.taxonomies&.first&.taxonomy_genus&.first %></td>

  <td><%= bso_extra['media_count'] %></td>  
  <td><%= document.date_uploaded %> </td> 
  <%# todo: might need to format the date later, e.g. using MS helper display_date 
      Make sure it can be sorted in datatables
       display_date(document.date_uploaded&.to_s) %>
  <td><%= bso_extra["origin"] %></td>
  <td><%= render_source_of_record(bso) %></td>
</tr>
