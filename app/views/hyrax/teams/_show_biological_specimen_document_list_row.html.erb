<% 
id = document.id 
bso = BiologicalSpecimen.find(id)
%>
<tr id="document_<%= id %>">
  <td>&nbsp;
    <% if current_user and document.depositor != current_user.user_key %>
      <i class="glyphicon glyphicon-share-alt" />
    <% end %>
  </td>
  <td>
    <div class="media">
      <%= link_to [main_app, document], class: "media-left" do %>
        <%= render_thumbnail_tag document, { class: "hidden-xs file_listing_thumbnail" }, { suppress_link: true } %>
      <% end %>
    </div>
  </td>
  <td><%= bso&.title&.first %></td>
  <td><%= bso&.taxonomies&.first&.title&.first %></td>

  <td> totalmedia</td>  
  <td><%= document.date_uploaded %> </td>
  <td><%= render_source_of_record(bso) %></td>
</tr>
