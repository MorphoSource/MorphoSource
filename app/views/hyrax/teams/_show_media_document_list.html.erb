<div class="btn-group choose-columns">
  <button type="button" class="btn dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
    Toggle columns <span class="caret"></span>
  </button>
  <ul class="dropdown-menu">
    <li><input type="checkbox" class="toggle-vis" data-column="2" checked="checked" /> ID</li>
    <li><input type="checkbox" class="toggle-vis" data-column="3" checked="checked" /> Part</li>
    <li><input type="checkbox" class="toggle-vis" data-column="4" checked="checked" /> Object</li>
  </ul>
</div>


<table id="teams-projects-listing" class="datatable table table-striped teams-projects">
  <caption class="sr-only">List of items in this team</caption>
  <thead>
  <tr>
    <th>&nbsp;</th>
    <th>&nbsp;</th>
    <th>ID</th>
    <th>Part</th>
    <th>Object</th>
    <th>Taxonomy</th>
    <th>Type</th>
    <th><%= t("hyrax.dashboard.my.heading.date_uploaded") %></th>
    <th><%= t("hyrax.dashboard.my.heading.visibility") %></th>
  </tr>
  </thead>
  <tbody>
    <%= render partial: 'show_media_document_list_row', collection: documents, as: :document %>
  </tbody>
</table>
