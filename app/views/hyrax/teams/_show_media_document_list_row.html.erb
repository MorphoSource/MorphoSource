<% 
id = document.id 
bso, bso_media_count, cho, cho_media_count = physical_object_from_media(id)
%>
<tr id="document_<%= id %>">
  <td><!-- add to cart checkbox here --></td>
  <td>
    <div class="media">
      <%= link_to [main_app, document], class: "media-left" do %>
        <%= render_thumbnail_tag document, { class: "hidden-xs file_listing_thumbnail" }, { suppress_link: true } %>
      <% end %>
      <%# div class="media-body">
        <p class="media-heading">
          <strong><%= link_to document.title_or_label, [main_app, document], id: "src_copy_link#{id}", class: "#{'document-title' if document.title_or_label == document.label}" % ></strong>
        </p>
        <%= render_collection_links(document) % >
      </div %>
    </div>
  </td>
  <td><%= document.id %></td>  
  <td><%= document.part&.first %></td>  
  <td><%= bso&.title&.first %><%= cho&.title&.first %></td>
  <td><%= bso&.taxonomies&.first&.title&.first %></td>
  <td><%= document.media_type&.first %></td>  
  <td><%= document.date_uploaded %> </td>
  <td><%= render_visibility_link(document) %></td>
</tr>
