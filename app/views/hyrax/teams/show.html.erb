<% provide :page_title, construct_page_title(@presenter.title) %>
<div class="hyc-container showcase teams" itemscope itemtype="http://schema.org/CollectionPage">
  <div class="row hyc-header">
    <div class="col-md-12">
      <% unless @presenter.banner_file.blank? %>
          <header class="hyc-banner" style="background-image:url(<%= @presenter.banner_file %>)"></header>
      <% else %>
          <header class="hyc-generic"></header>
      <% end %>
    </div>
  </div>

  <div class="row">
    <div class="col-xs-1 col-sm-5 team-logo">
      <%# todo: display only 1 logo %>
      <% unless @presenter.logo_record.blank? %>
        <% lr = @presenter.logo_record.first %>
        <% if lr[:linkurl].blank? %>
            <img alt="<%= lr[:alttext] %>" src="<%= lr[:file_location] %>" border="0" />
        <% else %>
            <a href="<%= lr[:linkurl] %>">
              <img alt="<%= lr[:alttext] %>" src="<%= lr[:file_location] %>" border="0" />
            </a>
        <% end %>
      <% end %>
    </div>
    <div class="col-xs-7 col-sm-7 team-title">
       <h1>
          <div id="showcase-title">
            <%= @presenter.title.first %> 
            <%= @presenter.collection_type_badge %>
            <%= @presenter.permission_badge %>
          </div>
          <div class="text-muted">
            <%= @presenter.total_viewable_items %> 
            <%= 'Item'.pluralize(@presenter.total_viewable_items) %> . 
            <% unless @presenter.creator.blank? %>
              Managed by: <%= @presenter.creator.first %>
            <% end %>
          </div>
      </h1>

    </div>
    <div class="col-xs-3 col-sm-12">
      REPRESENTS ORGANIZATION
    </div>

  </div><!-- /row -->

      <%# unless @presenter.total_viewable_items.blank? % >
          <div class="hyc-bugs" style="border:1px solid green">

            <% unless @presenter.modified_date.blank? % >
                <div class="hyc-last-updated">Last Updated: <%= @presenter.modified_date % ></div>
            <% end % >
          </div>
      <% end %>


  <!-- Subcollections -->
  <% if @presenter.collection_type_is_nestable? && @subcollection_count > 0 %>
      <div class="hyc-blacklight hyc-bl-title">
        <h4>TEAM PROJECTS</h4>
      </div>
      <div class="hyc-blacklight hyc-bl-results">
        <%= render 'subcollection_list', collection: @subcollection_docs %>
      </div>
  <% end %>




  <div class="panel panel-default tabs" role="main">
    <!-- Nav tabs -->
    <ul class="nav nav-tabs" role="tablist">
      <li role="presentation" class="active">
        <a href="#media" aria-controls="media" role="tab" data-toggle="tab" aria-expanded="false">
        <i class="fa fa-cube" aria-hidden="true"></i> MEDIA
        </a>
      </li>
      <li role="presentation">
        <a href="#objects" aria-controls="objects" role="tab" data-toggle="tab" aria-expanded="true">
          <i class="fas fa-frog" aria-hidden="true"></i> OBJECTS
        </a>
      </li>
      <li role="presentation">
        <a href="#about" aria-controls="about" role="tab" data-toggle="tab" aria-expanded="true">
          <i class="fa fa-newspaper" aria-hidden="true"></i> ABOUT
        </a>
      </li>
    </ul>

    <!-- Tab panes -->
    <div class="tab-content">

      <div role="tabpanel" class="tab-pane active" id="media">
        <div class="form-tab-content">

          <!-- Search results label -->
          <%# if @members_count > 0 || @presenter.subcollection_count > 0 % >
            <div class="hyc-blacklight hyc-bl-title">
              <h2>www 
                <% if has_collection_search_parameters? % >
                    < %= t('hyrax.dashboard.collections.show.search_results') % >
                < % end % >
              </h2>
            </div>
          < % end %>

          <!-- Search bar -->
          <div class="hyc-blacklight hyc-bl-search hyc-body row">
            <div class="col-sm-8">
              <%= render 'search_form', presenter: @presenter, url: @presenter.search_form_url %>
            </div>
          </div>

          <!-- Works -->
          <% if @members_count > 0 %>
              <div class="hyc-blacklight hyc-bl-title">
                <h4><%= t('.works_in_collection') %> (<%= @members_count %>)</h4>
              </div>

              <div class="hyc-blacklight hyc-bl-sort">
                <%= render 'sort_and_per_page', collection: @presenter %>
              </div>

              <div class="hyc-blacklight hyc-bl-results">
                <%= render_document_index @member_docs %>
              </div>

              <div class="hyc-blacklight hyc-bl-pager">
                <%= render 'paginate' %>
              </div>
          <% end # if @members_count > 0 %>

        </div>
      </div>

      <div role="tabpanel" class="tab-pane" id="objects">
        <div class="form-tab-content">

  bbb

        </div>
      </div>

      <div role="tabpanel" class="tab-pane" id="about">
        <div class="form-tab-content">

          <div class="row hyc-body" style="border:1px solid red">
            <div class="col-md-8 hyc-description">
              <%= render 'collection_description', presenter: @presenter %>

              <% if @presenter.collection_type_is_nestable? && @presenter.total_parent_collections > 0 %>
                  <div class="hyc-blacklight hyc-bl-title">
                    <h2>
                      <%= t('.parent_collection_header') %> (<%= @presenter.total_parent_collections %>)
                    </h2>
                  </div>
                  <div class="hyc-blacklight hyc-bl-results">
                    <%= render 'show_parent_collections', presenter: @presenter %>
                  </div>
              <% end %>

            </div>
            <div class="col-md-4 hyc-metadata">
              <% unless has_collection_search_parameters? %>
                  <h2><%= t('hyrax.dashboard.collections.show.metadata_header') %></h2>
                  <%= render 'show_descriptions' %>
              <% end %>
            </div>
          </div>

        </div>
      </div>

    </div><!-- /tab-content -->

  </div><!-- /panel panel-default tabs -->



</div><!-- div hyc-container -->
