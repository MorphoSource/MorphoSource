<% 
provide :page_title, construct_page_title(@presenter.title) 
%>
<div class="hyc-container showcase teams" itemscope itemtype="http://schema.org/CollectionPage">
  <div class="hyc-header">
    <% unless @presenter.banner_file.blank? %>
        <header class="hyc-banner" style="background-image:url(<%= @presenter.banner_file %>)"></header>
    <% else %>
        <header class="hyc-generic"></header>
    <% end %>
  </div>

  <div class="row team-header">

    <div class="col-md-8 flex">
        <div class="team-logo">
          <% unless @presenter.logo_record.blank? %>
            <% lr = @presenter.logo_record.first %>
            <% if lr[:linkurl].blank? %>
                <img alt="<%= lr[:alttext] %>" src="<%= lr[:file_location] %>" border="0" />
            <% else %>
                <a href="<%= lr[:linkurl] %>">
                  <img alt="<%= lr[:alttext] %>" src="<%= lr[:file_location] %>" border="0" />
                </a>
            <% end %>
          <% end %>
        </div>
        <div class="team-title">
           <h1>
              <div id="showcase-title">
                <%= @presenter.title.first %> 
                <%= @presenter.collection_type_badge %>
                <%= @presenter.permission_badge %>
              </div>
              <div class="text-muted">
                <% if @media_member_count > 0 %>
                  <%= @media_member_count %> <%= 'Media'.pluralize(@media_member_count) %> · 
                <% end %>
                <% if @bso_member_count > 0 %>
                  <%= @bso_member_count %> <%= 'Specimen'.pluralize(@bso_member_count) %> · 
                <% end %>
                <% if @cho_member_count > 0 %>
                  <%= @cho_member_count %> <%= 'Cultural heritage object'.pluralize(@cho_member_count) %> · 
                <% end %>
                Managed by: <%= @presenter.collection_managers %>

                 <%# todo: display user link 
                 = @presenter.attribute_to_html(:collection_managers, label: 'Managed by', render_as: :showcase_user_link, include_empty: false, html_dl: false) %>
              </div>
          </h1>
        </div>
    </div>
    <div class="col-md-4 flex">
      <% if @presenter.collection_type.machine_id == 'team' %>  
        <div class="row represents-organization">
          <div class="col-xs-3 flex">
            <i class="fa fa-university"></i>
            <sup><i class="fa fa-check-circle"></i></sup>
          </div>
          <div class="col-xs-8 flex">
            <div class="clearfix">
              <b>REPRESENTS ORGANIZATION</b><br />
              <%= @presenter.organization_title.first %><br />
              140Media · 123Specimens 
            </div>
          </div>
        </div>
      <% elsif @presenter.collection_type.machine_id == 'project' %>
      
        <div class="show-actions">
          <% if can? :edit, @presenter.solr_document %>
            <div class="btn-group">
              <button type="button" class="btn btn-primary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                Actions <span class="caret"></span>
              </button>
              <ul class="dropdown-menu">
                <li>
                  <%= link_to t('hyrax.collection.actions.edit.label'),
                              hyrax.edit_dashboard_collection_path(@presenter),
                              title: t('hyrax.collection.actions.edit.desc'),
                              class: 'btn btn-primary' %>
                </li>
              </ul>
            </div>
          <% end %>
        </div>

      <% end %>

    </div>

  </div><!-- /row -->

      <%# unless @presenter.total_viewable_items.blank? % >
          <div class="hyc-bugs" style="border:1px solid green">

            <% unless @presenter.modified_date.blank? % >
                <div class="hyc-last-updated">Last Updated: <%= @presenter.modified_date % ></div>
            <% end % >
          </div>
      <% end %>


  <!-- Subcollections -->
  <% if @presenter.collection_type_is_nestable? && @subcollection_count > 0 %>
      <div class="hyc-blacklight hyc-bl-title">
        <h4>TEAM PROJECTS</h4>
      </div>
      <div class="hyc-blacklight hyc-bl-results">
        <%= render 'subcollection_list', collection: @subcollection_docs %>
      </div>
  <% end %>


  <div class="panel panel-default tabs" role="main">
    <!-- Nav tabs -->
    <ul class="nav nav-tabs" role="tablist">
      <% if @media_member_count > 0 %>
        <li role="presentation" class="active">
          <a href="#media" aria-controls="media" role="tab" data-toggle="tab" aria-expanded="false">
          <i class="fa fa-cube" aria-hidden="true"></i> MEDIA
          </a>
        </li>
      <% end %>
      <% if @bso_member_count > 0 %>
        <li role="presentation">
          <a href="#biological_specimens" aria-controls="biological_specimens" role="tab" data-toggle="tab" aria-expanded="true">
            <i class="fas fa-frog" aria-hidden="true"></i> SPECIMENS
          </a>
        </li>
      <% end %>
      <% if @cho_member_count > 0 %>
        <li role="presentation">
          <a href="#cultural_heritage_objects" aria-controls="cultural_heritage_objects" role="tab" data-toggle="tab" aria-expanded="true">
            <i class="fas fa-frog" aria-hidden="true"></i> CULTURAL HERITAGE OBJECTS
          </a>
        </li>
      <% end %>
      <li role="presentation">
        <a href="#about" aria-controls="about" role="tab" data-toggle="tab" aria-expanded="true">
          <i class="fa fa-newspaper" aria-hidden="true"></i> ABOUT
        </a>
      </li>
    </ul>

    <!-- Tab panes -->
    <div class="tab-content">

      <% if @media_member_count > 0 %>
        <div role="tabpanel" class="tab-pane active" id="media">
          <div class="form-tab-content">

            <div class="row">
              <!-- Search bar -->
              <div class="col-xs-6">
                <%= render 'search_form', presenter: @presenter, url: @presenter.search_form_url %>
              </div>
              <div class="col-xs-6">
                <%= render 'sort_and_per_page_media', collection: @presenter %>
              </div>
            </div>
            <!-- Works -->
            <div class="hyc-blacklight hyc-bl-results">
              <%= render_document_index @media_member_docs, work_type: 'media' %>
            </div>
            <%# div class="hyc-blacklight hyc-bl-pager">
              <%= render 'paginate' % >
            </div %>

          </div>
        </div>
      <% end # if @media_member_count > 0 %>

      <% if @bso_member_count > 0 %>
        <div role="tabpanel" class="tab-pane" id="biological_specimens">
          <div class="form-tab-content">

            <div class="row">
              <!-- Search bar -->
              <div class="col-xs-6">
                <%= render 'search_form', presenter: @presenter, url: @presenter.search_form_url %>
              </div>
              <div class="col-xs-6">
                <%= render 'sort_and_per_page_bso', collection: @presenter %>
              </div>
            </div>
            <div class="hyc-blacklight hyc-bl-results">
              <%= render_document_index @bso_member_docs, work_type: 'biological_specimen' %> 
            </div>
    
          </div>
        </div>
      <% end # if @bso_member_count > 0 %>

      <% if @cho_member_count > 0 %>
        <div role="tabpanel" class="tab-pane" id="cultural_heritage_objects">
          <div class="form-tab-content">

            <div class="row">
              <!-- Search bar -->
              <div class="col-xs-6">
                <%= render 'search_form', presenter: @presenter, url: @presenter.search_form_url %>
              </div>
              <div class="col-xs-6">
                <%= render 'sort_and_per_page_cho', collection: @presenter %>
              </div>
            </div>
            <div class="hyc-blacklight hyc-bl-results">
              <%= render_document_index @cho_member_docs, work_type: 'cultural_heritage_object' %> 
            </div>
    
          </div>
        </div>
      <% end # if @cho_member_count > 0 %>

      <div role="tabpanel" class="tab-pane" id="about">
        <div class="form-tab-content">

          <div class="row">
            <div class="col-sm-6">

              <h2>DESCRIPTION</h2>
              <%= render 'collection_description', presenter: @presenter %>

              <h2>DETAILS</h2>
              <%= @presenter.attribute_to_html(:collection_managers, label: 'Managed by', render_as: :showcase_default, include_empty: false, html_dl: false) %>
              <%= @presenter.attribute_to_html(:creator, render_as: :showcase_default, include_empty: false, html_dl: false) %>
              <%= @presenter.attribute_to_html(:contributor, render_as: :showcase_default, include_empty: false, html_dl: false) %>
              <%= @presenter.attribute_to_html(:based_near, label: 'Location', render_as: :showcase_default, include_empty: false, html_dl: false) %>
            
              <h2>RELATED LINKS</h2>
              <%= @presenter.attribute_to_html(:related_url, label: 'Related links', render_as: :showcase_external_link, include_empty: false, html_dl: false) %>

            </div>

            <div class="col-sm-6">
              <h2>STATISTICS</h2>
              <div class="row">
                <div class="col-xs-6 showcase-label">Number of media</div>
                <div class="col-xs-6 showcase-value "><%= @media_member_count %></div>
              </div>
              <div class="row">
                <div class="col-xs-6 showcase-label">Number of represented specimens</div>
                <div class="col-xs-6 showcase-value "><%= @bso_member_count %></div>
              </div>
              <div class="row">
                <div class="col-xs-6 showcase-label">Number of represented cultural heritage objects</div>
                <div class="col-xs-6 showcase-value "><%= @cho_member_count %></div>
              </div>
              <div class="row">
                <div class="col-xs-6 showcase-label">Project views</div>
                <div class="col-xs-6 showcase-value ">(Not yet implemented)</div>
              </div>
              <div class="row">
                <div class="col-xs-6 showcase-label">Number of media downloads</div>
                <div class="col-xs-6 showcase-value ">(Not yet implemented)</div>
              </div>

              <% if @presenter.collection_type.machine_id == 'team' %>  
                <h2>ORGANIZATION</h2>
                <%= @presenter.attribute_to_html(:organization_title, label: 'Name', render_as: :showcase_default, include_empty: true, html_dl: false) %>
                <%= @presenter.attribute_to_html(:organization_institution_name, label: 'Institution', render_as: :showcase_default, include_empty: false, html_dl: false) %>
                <%= @presenter.attribute_to_html(:organization_institution_code, label: 'Institution code', render_as: :showcase_default, include_empty: false, html_dl: false) %>
                <%= @presenter.attribute_to_html(:organization_collection_code, label: 'Collection code', render_as: :showcase_default, include_empty: false, html_dl: false) %>
                <%= @presenter.attribute_to_html(:organization_description, label: 'Description', render_as: :showcase_default, include_empty: false, html_dl: false) %>
                <%= @presenter.attribute_to_html(:organization_address, label: 'Address', render_as: :showcase_default, include_empty: false, html_dl: false) %>
                <%= @presenter.attribute_to_html(:organization_city, label: 'City', render_as: :showcase_default, include_empty: false, html_dl: false) %>
                <%= @presenter.attribute_to_html(:organization_state_province, label: 'State/Province', render_as: :showcase_default, include_empty: false, html_dl: false) %>
                <%= @presenter.attribute_to_html(:organization_country, label: 'Country', render_as: :showcase_default, include_empty: false, html_dl: false) %>
              <% elsif @presenter.collection_type.machine_id == 'project' %>
                <h2>PROJECT TAGS</h2>
                <div class="row">
                  <div class="col-xs-6 showcase-label">(Not yet implemented)</div>
                  <div class="col-xs-6 showcase-value "></div>
                </div>
              <% end %>  
            </div>
          </div>

        </div>
      </div>

    </div><!-- /tab-content -->

  </div><!-- /panel panel-default tabs -->



</div><!-- div hyc-container -->



              <%# unless has_collection_search_parameters? %>
                  <%#= render 'show_descriptions' %>
              <%# end %>


              <%# if @presenter.collection_type_is_nestable? && @presenter.total_parent_collections > 0 % >
                  <div class="hyc-blacklight hyc-bl-title">
                    <h2>
                      <% = t('.parent_collection_header') % > (<% = @presenter.total_parent_collections % >)
                    </h2>
                  </div>
                  <div class="hyc-blacklight hyc-bl-results">
  show_parent_collections
                    <%= render 'show_parent_collections', presenter: @presenter % >
                  </div>
              <% end %>
