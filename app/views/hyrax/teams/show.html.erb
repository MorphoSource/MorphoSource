<% content_for :body_css_classes do %>showcase teams<% end %>

<%
provide :page_title, construct_page_title(@presenter.title)
%>
<div class="hyc-container" itemscope itemtype="http://schema.org/CollectionPage">
  <div class="hyc-header">
    <% unless @presenter.banner_file.blank? %>
        <header class="hyc-banner" style="background-image:url(<%= @presenter.banner_file %>)"></header>
    <% else %>
        <header class="hyc-generic"></header>
    <% end %>
  </div>

  <div class="row team-header">

    <div class="col-sm-12 col-md-6 flex">
      <div class="team-logo">
        <% unless @presenter.logo_record.blank? %>
          <% lr = @presenter.logo_record.first %>
          <% if lr[:linkurl].blank? %>
              <img alt="<%= lr[:alttext] %>" src="<%= lr[:file_location] %>" border="0" />
          <% else %>
              <a href="<%= lr[:linkurl] %>">
                <img alt="<%= lr[:alttext] %>" src="<%= lr[:file_location] %>" border="0" />
              </a>
          <% end %>
        <% end %>
      </div>
      <div class="team-title">
         <h1>
            <div id="showcase-title">
              <%= @presenter.title.first %>
              <%= @presenter.collection_type_badge %>
              <%= @presenter.permission_badge %>
            </div>
            <div class="text-muted">
              <%= @media_member_count %> Media ·
              <span class="bso-count"></span> 
              Managed by: <%= @presenter.collection_managers %>
            </div>
        </h1>
      </div>
    </div>
    <div class="col-sm-9 col-md-4 flex">
      <% if @presenter.collection_type.machine_id == 'team' %>
        <% if @presenter.collection.organization %>
          <div class="represents-organization">

            <div class="col-xs-2 flex icon">
              <i class="fa fa-university"></i>
              <sup><i class="fa fa-check-circle"></i></sup>
            </div>

            <div class="col-xs-7 flex title">
              <div class="clearfix">
                <b>REPRESENTS ORGANIZATION</b><br />
                <%= @presenter.organization_title.first %><br />
                <% if @presenter.organization_media_count > 0 %>
                  <%= @presenter.organization_media_count %> <%= 'Media'.pluralize(@presenter.organization_media_count) %>
                <% end %>
                <% if @presenter.organization_bso_count > 0 %>
                · <%= @presenter.organization_bso_count %> <%= 'Specimen'.pluralize(@presenter.organization_bso_count) %>
                <% end %>
                <% if @presenter.organization_cho_count > 0 %>
                · <%= @presenter.organization_cho_count %> CHO
                <% end %>
              </div>
            </div>

          </div><!-- /represents-organization -->
        <% end %>
      <% end %>

    </div>

    <div class="col-xs-12 col-sm-3 col-md-2 flex text-right">
      <div class="show-actions col-xs-12">
        <% if can?(:edit, @presenter.solr_document) || can?(:deposit, @presenter.solr_document) %>
          <button type="button" class="btn btn-sm btn-primary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            Actions <span class="caret"></span>
          </button>
          <ul class="dropdown-menu">
            <% if can?(:edit, @presenter.solr_document) %>
              <li>
                <%= link_to t('hyrax.collection.actions.edit.label'), hyrax.edit_dashboard_collection_path(@presenter), title: t('hyrax.collection.actions.edit.desc'), class: 'btn btn-primary' %>
              </li>
            <% end %>
            <% if can?(:deposit, @presenter.solr_document) %>
              <li>
                <%= render 'hyrax/dashboard/collections/buttons/create_through_collection', presenter: @presenter %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </div>

  </div><!-- /row -->

  <!-- Subcollections -->
  <% if @presenter.collection_type_is_nestable? && @subcollection_count > 0 %>
      <div class="hyc-blacklight hyc-bl-title">
        <h4>TEAM PROJECTS</h4>
      </div>
      <div class="hyc-blacklight hyc-bl-results">
        <%= render 'subcollection_list', collection: @subcollection_docs %>
      </div>
  <% end %>

  <div class="panel panel-default tabs" role="main">
    <!-- Nav tabs -->
    <ul class="nav nav-tabs" role="tablist">
      <li role="presentation" class="active">
        <a href="#media" aria-controls="media" role="tab" data-toggle="tab" aria-expanded="false">
        <i class="fa fa-cube" aria-hidden="true"></i> MEDIA
        </a>
      </li>
      <% if @po_type == 'bso' %>
        <li role="presentation">
          <a href="#biological_specimens" aria-controls="biological_specimens" role="tab" data-toggle="tab" aria-expanded="true">
            <i class="fas fa-frog" aria-hidden="true"></i> SPECIMENS
          </a>
        </li>
      <% elsif @po_type == 'cho' %>
        <li role="presentation">
          <a href="#cultural_heritage_objects" aria-controls="cultural_heritage_objects" role="tab" data-toggle="tab" aria-expanded="true">
            <i class="fas fa-frog" aria-hidden="true"></i> CULTURAL HERITAGE OBJECTS
          </a>
        </li>
      <% end %>
      <li role="presentation">
        <a href="#about" aria-controls="about" role="tab" data-toggle="tab" aria-expanded="true">
          <i class="fa fa-newspaper" aria-hidden="true"></i> ABOUT
        </a>
      </li>
    </ul>

    <!-- Tab panes -->
    <div class="tab-content">

        <div role="tabpanel" class="tab-pane active" id="media">
          <div class="form-tab-content">
            <%= render 'tab_media' %>
          </div>
        </div>

      <% if @po_type == 'bso' %>
        <div role="tabpanel" class="tab-pane" id="biological_specimens">
          <div class="form-tab-content">
            <%#= render 'tab_bso' %>
            <%= render_async bso_tab_url_for_collections(@presenter.id), event_name: "bso-loaded" do %>
              <div class="ui-loading-whole-page" style="height:200px"></div>
            <% end %>
          </div>
        </div>
      <% elsif @po_type == 'cho' %>
        <div role="tabpanel" class="tab-pane" id="cultural_heritage_objects">
          <div class="form-tab-content">
            <%#= render 'tab_cho' %>
            <%= render_async cho_tab_url_for_collections(@presenter.id), event_name: "cho-loaded" do %>
              <div class="ui-loading-whole-page" style="height:200px"></div>
            <% end %>
          </div>
        </div>
      <% end %>

      <div role="tabpanel" class="tab-pane" id="about">
        <div class="form-tab-content">
          <%= render 'tab_about', presenter: @presenter %>
        </div>
      </div>

    </div><!-- /tab-content -->

  </div><!-- /panel panel-default tabs -->

</div><!-- div hyc-container -->
