<div class="row record-padding paginate-wrapper">

  <div class="col-md-12 col-lg-3">
    <%= form_tag '', method: :get, :id => 'rows_per_page' do %>
      <%= hidden_field_tag "days", params[:days] %>
      <div class="select-tag pl-0 text-lg-left">
        Rows per page <%= select_tag :rows, options_for_select(Hyrax.config.default_rows_per_page_range, selected: params[:rows] || Hyrax.config.default_show_work_item_rows), onchange: "$('#rows_per_page').submit();" %>
      </div>
    <% end %>
  </div>

  <div class="col-md-12 col-lg-3">
    <div>Showing <%= page_entries_info incoming_proxy_deposits %></div>
  </div>

  <div class="col-md-12 col-lg-6">
    <%= paginate incoming_proxy_deposits, outer_window: 2, theme: 'blacklight', param_name: :page %>
  </div>

</div><!-- /row -->
