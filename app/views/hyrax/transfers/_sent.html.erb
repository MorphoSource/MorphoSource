<table class="table table-striped" id="outgoing-transfers">
  <thead>
    <tr>
      <th>Media</th>
      <th>Date</th>
      <th>To</th>
      <th class="comment">Comments</th>
      <th style="text-align: center;">Status</th>
    </tr>
  </thead>
  <tbody>
    <% outgoing_proxy_deposits.each do |req| %>
      <% unless req.receiving_user.blank? %>
        <tr>
          <td> <%= show_transfer_request_title(req) %> </td>
          <td data-sort="<%= req.created_at.getutc.iso8601(5) %>">
            <relative-time datetime="<%= req.created_at.getutc.iso8601 %>" title="<%= req.created_at.to_formatted_s(:standard) %>">
              <%= req.created_at.to_formatted_s(:long_ordinal) %>
            </relative-time>
          </td>
          <% if req.receiving_organization %>
            <td><%= link_to req.receiving_organization&.display_name, main_app.organization_path(req.receiving_organization&.id) %></td>
          <% else %>
            <td><%= link_to req.receiving_user.name, hyrax.user_path(req.receiving_user) %></td>
          <% end %>
          <td><%= req.organization_transfer ? req.sender_comment.html_safe : req.sender_comment %></td>
          <td>
            <% if req.pending? && !req.organization_transfer %>
              <%= button_to "Cancel", hyrax.transfer_path(req), method: :delete, class:'btn btn-sm btn-danger', data: {confirm: "Are you sure you want to cancel this request?"}, style: "width: 100%" %>
            <% else %>
              <%= req.status.capitalize %>
            <% end %>
          </td>
        </tr>
      <% else %>
          <% Rails.logger.error "A proxy request has no receiver: #{req.inspect}" %>
      <% end %>
    <% end %>
  </tbody>
</table>

<%= render 'hyrax/transfers/sent_results_pagination', outgoing_proxy_deposits: outgoing_proxy_deposits %>
