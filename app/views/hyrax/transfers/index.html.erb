<% content_for :body_css_classes do %>showcase transfer<% end %>
<% provide :page_header do %>
  <h1><span class="fa fa-exchange-alt" aria-hidden="true"></span>  <%= t("hyrax.dashboard.transfer_of_ownership") %></h1>
<% end %>

<div class="container">
  <div class="row">
    <div class="col-md-12">
      <div class="panel panel-default">
        <h2><%= t("hyrax.dashboard.transfers_received") %></h2>
        <div class="pull-right">
          <%= form_tag '', method: :get, :id => 'number_of_days' do %>
              Days to Show: <%= select_tag :days, options_for_select(Hyrax.config.select_number_of_days, selected: params[:days] || 30), onchange: "$('#number_of_days').submit();" %> 
          <% end %>
        </div>
        <div class="panel-body">
          <%= @presenter.render_received_transfers %>
        </div>
      </div>
    </div>
  </div>
  <div class="row">
    <div class="col-md-12">
      <div class="panel panel-default">
        <h2><%= t("hyrax.dashboard.transfers_sent") %></h2>
        <div class="pull-right">
          <%= form_tag '', method: :get, :id => 's_number_of_days' do %>
              Days to Show: <%= select_tag :sdays, options_for_select(Hyrax.config.select_number_of_days, selected: params[:sdays] || 30), onchange: "$('#s_number_of_days').submit();" %> 
          <% end %>
        </div>
        <div class="panel-body">
          <%= @presenter.render_sent_transfers %>
        </div>
      </div>
    </div>
  </div>
</div>