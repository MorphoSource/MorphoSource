<% content_for :page_title do %>Transfers of Ownership // MorphoSource<% end %>
<% content_for :body_css_classes do %>dashboard showcase showcase-edit transfer<% end %>
<% provide :page_header do %>
  <h1><%= t("hyrax.dashboard.transfer_of_ownership") %></h1>
<% end %>

<div class="col-md-12 ownership-transfer">
  <div class="card panel-default panel-borders tabs" role="main">
    <!-- Nav tabs -->
    <ul class="nav nav-tabs" role="tablist">
      <li role="presentation" id="tab-received" class="nav-item active">
        <a href="#received" aria-controls="received" role="tab" data-toggle="tab" aria-expanded="false" class="nav-link active">
          <i class="fa fa-arrow-down"></i> Transfer Received
        </a>
      </li>
      <li role="presentation" id="tab-sent" class="nav-item">
        <a href="#sent" aria-controls="sent" role="tab" data-toggle="tab" aria-expanded="false" class="nav-link">
          <i class="fa fa-arrow-up"></i> Transfer Sent
        </a>
      </li>
    </ul>

    <!-- Tab panes -->
    <div class="tab-content">

      <div role="tabpanel" class="tab-pane active" id="received">
        <div class="form-tab-content" style="margin: 15px;">
          <div class="row">
            <div class="col-12">
              <div class="card panel-default">
                <div class="col-12 d-flex p-1">
                  <div>
                    <button type="button" class="btn btn-sm btn-primary dropdown-toggle" id="batch-decision-button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" disabled="disabled" style="max-width: unset;">
                      Decide selected transfers <span class="caret"></span>
                    </button>
                    <ul class="dropdown-menu" style="right: unset; top: 35px; left: 45px;">
                      <li>
                        <%= link_to 'Accept and allow depositor to retain edit access', main_app.transfers_batch_decide_path, method: :put, class: 'batch-decide accept accept-retain', title: 'Accept the file and allow the original depositor to retain access to edit the file and metadata' %>
                      </li>
                      <li>
                        <%= link_to 'Accept and remove depositor access', main_app.transfers_batch_decide_path, method: :put, class: 'batch-decide accept accept-reset', title: 'Accept the file remove access from the original depositor' %>
                      </li>
                      <li>
                        <%= link_to 'Accept and authorize depositor as proxy', main_app.transfers_batch_decide_path, method: :put, class: 'batch-decide accept accept-stick', title: 'Accept the file and allow the original depositor to retain access and authorize the original depositor as a proxy to deposit file on your behalf' %>
                      </li>
                      <li>
                        <%= link_to 'Reject', main_app.transfers_batch_decide_path, method: :put, id: 'reject', class: 'batch-decide reject', data: {confirm: "Are you sure you want to reject one or more selected requests?"}, title: 'Reject the transfer, the original depositor will remain the data manager', style: 'color: red; opacity: 60%;' %>
                      </li>
                    </ul>
                  </div>
                  <div class="ml-auto">
                  <%= form_tag '', method: :get, :id => 'number_of_days' do %>
                    <span style="font-size: 12px">Show transfers for <%= select_tag :days, options_for_select(Hyrax.config.select_number_of_days, selected: params[:days] || 30), onchange: "$('#number_of_days').submit();" %> days</span>
                  <% end %>
                  </div>
                </div>
                <div class="mt-1">
                  <%= form_tag main_app.transfers_batch_decide_path, method: :put, id: 'batch-transfer-decide', style: 'max-width: unset;' do %>
                    <%= @presenter.render_received_transfers %>
                  <% end %>
                  <%= render 'hyrax/transfers/received_results_pagination', incoming_proxy_deposits: @presenter.paginated_incoming_proxy_deposits %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div role="tabpanel" class="tab-pane" id="sent">
        <div class="form-tab-content">
          <div class="row">
            <div class="col-12">
              <div class="card panel-default">
                <div class="col-12 d-flex p-1">
                  <div class="ml-auto">
                    <%= form_tag '', method: :get, :id => 's_number_of_days' do %>
                        <span style="font-size: 12px">Show transfers for <%= select_tag :sdays, options_for_select(Hyrax.config.select_number_of_days, selected: params[:sdays] || 30), onchange: "$('#s_number_of_days').submit();" %> days</span>
                    <% end %>
                  </div>
                </div>
                <div class="card-body">
                  <%= @presenter.render_sent_transfers %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

  </div>
</div>