<ul class="nav nav-tabs" id="myTab">
        <% if current_user.admin? %>
          <li class="nav-item active"><a href="#administration" class="nav-link active"><i class="fa fa-users-cog"></i> <%= I18n.t('hyrax.user_profile.tab_administration') %></a></li>
        <% end %>
        <li class="nav-item <% unless current_user.admin? %>active<% end %>"><a href="#contributions" class="nav-link <% unless current_user.admin? %>active<% end %>"><i class="fa fa-star"></i> <%= I18n.t('hyrax.user_profile.tab_highlighted') %></a></li>
        <li class="nav-item"><a href="#activity_log" class="nav-link"><i class="fa fa-calendar"></i> <%= I18n.t('hyrax.user_profile.tab_activity') %></a></li>
      </ul>

      <div class="tab-content block-tab-content">
        <%= render 'contributions', presenter: presenter %>
        <%= render 'activity', presenter: presenter %>
        <% if current_user.admin? %>
          <%= render 'tab_admin' %>
        <% end %>
      </div> <!-- /tab-content -->
