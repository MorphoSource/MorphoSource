<div class="panel panel-default panel-user">
  <div class="panel-heading">
    <% if user.avatar.present? %>
      <%= image_tag user.avatar.url(:thumb), width: 120, class: "float-left block-padding" %>
      <h1><%= user.name %></h1>
    <% else %>
      <h1>
        <span class="fa fa-id-card"></span> <%= user.name %>
      </h1>
    <% end %>
    <div class="clearfix"></div>
  </div>

  <div class="list-group">
    <%= render "hyrax/users/vitals", user: user %>

    <div class="list-group-item">
      <%= render partial: 'hyrax/users/user_info', locals: { user: user, field_list: @presenter.display_fields_for_public } %>
    </div>
  </div>
</div>
