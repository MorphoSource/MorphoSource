<div class="row">
  <div class="col-md-6">
  <!--- If a user is viewing their own profile in the dashboard, show address, state, postal code, and telephone --->
    <% @dashboard = @_request.fullpath.include?("/dashboard/profiles/") %>

    <%= render partial: 'display_field', 
      collection: [
        :display_name,
        :first_name,
        :middle_name, 
        :last_name,
        :email,
        :affiliation
      ], 
      as: :field_name, :locals => { user: user } %>

    <% if @dashboard %>
      <%= render partial: 'display_field', 
        collection: [:address], 
        as: :field_name, :locals => { user: user } %>

      <% if user.state %>
      <div class="row">
        <div class="col-xs-3 showcase-label">State/Province</div>
          <% if Morphosource::UserProfile::LocationHelper::STATE[user.country]&.key(user.state) %>
            <div class="col-xs-9 showcase-value"><%= Morphosource::UserProfile::LocationHelper::STATE[user.country].key(user.state) %></div>
          <% else %>
            <div class="col-xs-9 showcase-value"><%= user.state %></div>
          <% end %>
      </div>
      <% end %>
    <% end %>

    <% if user.country %>
    <div class="row">
      <div class="col-xs-3 showcase-label">Country</div>
      <div class="col-xs-9 showcase-value"><%= Morphosource::UserProfile::LocationHelper::COUNTRY.key(user.country) %></div>
    </div>
    <% end %>

    <% if user.orcid.present? %>
    <div class="row">
      <div class="col-xs-3 showcase-label"><%= orcid_label('profile') %></div>
      <div class="col-xs-9 showcase-value break-all"><%= link_to user.orcid, user.orcid, { target: '_blank' } %></div>
    </div>
    <% end %>

    <% if user.twitter_handle.present? %>
    <div class="row">
      <div class="col-xs-3 showcase-label"><i class="fab fa-twitter" aria-hidden="true"></i> Twitter Handle</div>
      <div class="col-xs-9 showcase-value break-all"><%= link_to user.twitter_handle, "http://twitter.com/#{user.twitter_handle}", {target:'_blank'} %></div>
    </div>
    <% end %>

    <% if user.facebook_handle.present? %>
    <div class="row">
      <div class="col-xs-3 showcase-label"><i class="fab fa-facebook"></i> Facebook Handle</div>
      <div class="col-xs-9 showcase-value break-all"><%= link_to user.facebook_handle, "http://facebook.com/#{user.facebook_handle}", {target:'_blank'} %></div>
    </div>
    <% end %>

    <% if user.website %>
    <div class="row">
      <div class="col-xs-3 showcase-label"><i class="glyphicon glyphicon-globe"></i> Website(s)</div>
      <div class="col-xs-9 showcase-value break-all"><%= iconify_auto_link(user.website) %></div>
    </div>
    <% end %>

  </div>

  <div class="col-md-6">
    <!-- profile type section here -->
    <%= render partial: 'display_field', 
      collection: [:profile_type], 
      as: :field_name, :locals => { user: user } %>



  </div>
</div>

<% if current_user.present? && ( (user == current_user) || current_user.admin? ) %>
  <% if user.sftp_share %>
  <div class="row">
    <div class="col-xs-3 showcase-label">SFTP Share</div>
    <div class="col-xs-9 showcase-value break-all"><%= user.sftp_share %> <%= sftp_share_status user.sftp_share %></div>
  </div>
  <% end %>
  <% if user.remote_file_submitter? %>
  <div class="row">
    <div class="col-xs-3 showcase-label">Allowed Remote File Domains</div>
    <div class="col-xs-9 showcase-value break-all">
      <%= render partial: 'user_allowed_domains', collection: user.allowed_domains, as: :item %>
    </div>
  </div>
  <% end %>
<% end %>
