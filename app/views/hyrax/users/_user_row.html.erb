<tr>
  <td><%= link_to hyrax.user_path(user) do %>
        <%= image_tag(user.avatar.url(:thumb), width: 30) if user.avatar.file %>
      <% end %>
  </td>
   <td><%= link_to (user.display_name || ''), hyrax.user_path(user) %></td>
   <td><%= user.id %></td>
   <td><%= user.user_key %></td>
   <td><%= link_to user.email, hyrax.user_path(user) if user.email.present? %></td>
   <td><%= user.academic_institution_or_school %></td>
   <td><%= user.department %></td>
   <td><%= user.created_at.to_date %></td>
   <td><%= link_to presenter.managed_collection_count, main_app.managed_collections_search_path(user) %></td>
   <td><%= link_to presenter.deposited_media_count, main_app.media_search_path({"f"=>{"depositor"=>["#{user.ms_id}"]}}) %></td>
   <td><%= link_to presenter.managed_media_count, main_app.media_search_path({"f"=>{"owner"=>["#{user.ms_id}"]}}) %></td>
</tr>
