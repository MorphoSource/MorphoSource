<% if current_user.admin? %>
  <div class="row profile">
    <div class="col-md-6 col-lg-7">
      <%= render 'left_sidebar' %>
    </div>
    <!-- right col -->
    <div class="col-md-6 col-lg-5">
        <%= render 'profile_tabs', presenter: @presenter %>
    </div>
  </div>
<% else %>
  <div class="row profile">
    <div class="col-xs-12">
      <%= render 'left_sidebar' %>
    </div>
  </div>
<% end %>
