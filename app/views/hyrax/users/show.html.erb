<% if current_user.admin? %>
  <div class="row profile">
    <div class="col-xs-3">
      <%= render 'left_sidebar' %>
    </div>
    <!-- right col -->
    <div class="col-xs-9">
        <%= render 'profile_tabs', presenter: @presenter %>
        <%= render 'contributor_buttons', presenter: @presenter %>
        <%= render 'sftp_share' %>
    </div>
  </div>
<% else %>
  <div class="row profile">
    <div class="col-xs-12">
      <%= render 'left_sidebar' %>
    </div>
  </div>
<% end %>
