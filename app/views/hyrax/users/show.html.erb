<% if current_user.admin? %>
  <div class="row profile">
    <div class="col-lg-6 col-xlg-7">
      <%= render 'left_sidebar' %>
    </div>
    <!-- right col -->
    <div class="col-lg-6 col-xlg-5">
        <%= render 'profile_tabs', presenter: @presenter %>
    </div>
  </div>
<% else %>
  <div class="row profile">
    <div class="col-12">
      <%= render 'left_sidebar' %>
    </div>
  </div>
<% end %>
