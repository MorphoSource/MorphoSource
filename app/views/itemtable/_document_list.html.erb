<div class="table-responsive" id="documents">
  <table class="table table-striped works-list itemtable">
  <caption class="sr-only"><%= t("hyrax.dashboard.my.sr.listing") %> <%= application_name %></caption>
  <thead>
    <tr>
      <%= render 'list_headers' %>
    </tr>
  </thead>
  <tbody>
    <% @items.each_with_index do |item, counter| %>
      <%= render 'list_item', item: item, counter: counter %>
    <% end %>
  </tbody>
</table>
</div>
