<div class="panel panel-default">
  <div class="panel-heading">
    <h2 class="panel-title h2"><%= "Search #{page_title.pluralize}" %></h2>
  </div>
  <div class="panel-body">
    <%= simple_form_for :filter_items, url: url_for, method: "GET" do |f| %>
      <%= render partial: 'search_form_fields', locals: {f: f} %>

      <%= f.submit 'Search', class: 'btn btn-primary' %>
      <%= link_to 'Export CSV', url_for(request.params.merge(format: :csv)), class: 'btn btn-primary', style: 'margin-left: 20px;' %>

      <%= link_to 'Close', url_for, class: 'btn btn-danger pull-right' %>
      <%= link_to 'Start Over', url_for(search: true), class: 'btn btn-primary pull-right', style: 'margin-right: 20px;' %>
    <% end %>
  </div>
</div>
