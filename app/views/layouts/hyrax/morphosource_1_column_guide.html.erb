<!DOCTYPE html>
<html lang="<%= I18n.locale.to_s %>" prefix="og:http://ogp.me/ns#">
  <head>
    <%= render partial: 'layouts/head_tag_content' %>
    <%= content_for(:head) %>
  </head>

  <body class="showcase docs <%= content_for(:body_css_classes) %>">
    <div class="skip-to-content">
      <%= link_to "Skip to Content", "#skip-to-content" %>
    </div>
    <%= render '/masthead' %>
    <nav class="navbar navbar-inverse-dark secondary-nav navbar-static-top" role="navigation">
      <%= render '/controls' %>
    </nav>
    <%= content_for(:precontainer_content) %>
    <div id="content-wrapper" class="container" role="main">
      <%= render '/flash_msg' %>
      <nav class="breadcrumb" role="region" aria-label="Breadcrumb">
        <ol>
          <li><a href="/docs/guide">Guide</a></li>
          <li class="active"><%= @view_flow.content[:page_title] %></li>
        </ol>
      </nav>
      <% if content_for?(:page_header) %>
        <div class="row">
          <div class="col-xs-12 main-header">
            <%= yield(:page_header) %>
          </div>
        </div>
      <% end %>

        <a name="skip-to-content" id="skip-to-content"></a>
        <%= content_for?(:content) ? yield(:content) : yield %>

    </div><!-- /#content-wrapper -->
    <%= render 'shared/footer' %>
    <%= render 'shared/ajax_modal' %>
  </body>
</html>
