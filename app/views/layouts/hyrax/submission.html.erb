<!DOCTYPE html>
<html lang="<%= t("hyrax.document_language", default: '') %>" prefix="og:http://ogp.me/ns#">
  <head>
    <%= render partial: 'layouts/head_tag_content' %>
    <%= content_for(:head) %>
    <!-- todo: if no ion icons needed, remove the css link later 
      link href="https://unpkg.com/ionicons@4.5.10-0/dist/css/ionicons.min.css" rel="stylesheet" -->
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  </head>

  <body>
    <div class="skip-to-content">
      <%= link_to "Skip to Content", "#skip-to-content", data: { turbolinks: false } %>
    </div>
    <%= render '/masthead' %>
    <%= content_for(:navbar) %>
    <%= content_for(:precontainer_content) %>
    <div id="content-wrapper" class="submission_flow" role="main">
      <div class="sidebar maximized submission_sidebar">
        <%= render 'submissions/sidebar/sidebar' %>
      </div>
      <div class="main-content maximized">
        <%= render '/flash_msg' %>
        <%= render_breadcrumbs builder: Hyrax::BootstrapBreadcrumbsBuilder %>
        <% if content_for?(:page_header) %>
          <div class="row">
            <div class="col-xs-12 main-header">
              <%= yield(:page_header) %>
            </div>
          </div>
        <% end %>

          <a name="skip-to-content" id="skip-to-content"></a>
          <%= content_for?(:content) ? yield(:content) : yield %>
      </div>

    </div><!-- /#content-wrapper -->
    <%= render 'shared/ajax_modal' %>
  </body>
</html>