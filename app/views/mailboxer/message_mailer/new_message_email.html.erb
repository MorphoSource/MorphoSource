<%# From https://github.com/mailboxer/mailboxer/blob/master/app/views/mailboxer/message_mailer/new_message_email.html.erb %>
<!DOCTYPE html>
<html>
<head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type" /></head>
<body><%#= @subject %>
<p><%= raw @message.body %></p>
<p style="font-size:11px; padding-top:12px; border-top:1px dotted #666">This is an automated email generated by <%= link_to "MorphoSource", root_url %>.  Please do not reply to this message, as any replies will not reach an actual person. If you need further assistance, please contact us at <a href="mailto:morphosource@duke.edu">morphosource@duke.edu</a>. </p>
</body>
</html>
