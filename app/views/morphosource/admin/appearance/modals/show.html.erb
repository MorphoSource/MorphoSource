<% provide :page_header do %>
  <h1><span class="fas fa-pager" aria-hidden="true"></span> Sitewide Modals </h1>
<% end %>
<% provide :page_title, "Modal Configuration" %>

<% content_for :body_css_classes do %>modal-config<% end %>

<%= simple_form_for @form, html: { id: "modal-form" }, url: admin_modal_path do |f| %>
  <div class="form-group" style="display: flex; flex-direction: row-reverse;">

    <%= f.submit class: 'btn btn-primary', style: "margin-left:10px;"%>

    <%= submit_tag "Test Modal", :type => 'button', class: "btn btn-primary", data: { toggle: "modal", target: "#test-modal" } %>
  </div>
  <div class="card">
    <div class="card-body">
      <%= f.input :sitewide_modal_frequency, collection: @form.modal_frequencies, include_blank: false, required: false %>
      <%= f.input :sitewide_modal_template, collection: @form.modal_templates, include_blank: false, required: false %>
      <%= f.input :sitewide_modal_title, required: false %>
      <%= f.input :sitewide_modal_body, as: :rich_text_area, required: false %>
    </div>
  </div>
  <% @form.modal_templates.each do |filename| %>
    <div class= "<%= "modal-example card configured-modal-example #{filename}" %>" style="display: none;">
      <div class="card-body">
        <%= render partial: "application/modals/templates/#{filename}", locals: { modal: @form, modal_title: @form.modal_title, modal_body: modal_body(@form) } %>
      </div>
    </div>
  <% end %>
  <div class="card">
    <div class="card-body">
      <%= f.input :guilt_trip_template, collection: @form.modal_templates, include_blank: true, required: false %>
      <%= f.input :guilt_trip_title, required: false %>
      <%= f.input :guilt_trip_body, as: :rich_text_area, required: false %>
    </div>
  </div>
<% end %>

<% @form.modal_templates.each do |filename| %>
    <div class= "<%= "guilt-trip-example card configured-modal-example #{filename}2" %>" style="display: none;">
      <div class="card-body">
       <%= render partial: "application/modals/templates/#{filename}", locals: { modal: @form, modal_title: @form.guilt_trip_title, modal_body: guilt_trip_body(@form) } %>
      </div>
    </div>
<% end %>

<div id="test-modal" class="modal fade"></div>
<div id="test-guilt-trip-modal" class="modal fade"></div>