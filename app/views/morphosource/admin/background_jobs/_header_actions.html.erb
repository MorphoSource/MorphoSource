<% unless @search %>
  <%= link_to "Search #{page_title}", url_for(search: true), class: 'btn btn-primary' %>
  <% if get_resque_data? %>
    <%= link_to 'Exclude Resque Tools', url_for(request.params.merge(resque: nil)), class: 'btn btn-primary' %>
  <% else %>
    <%= link_to 'Include Resque Tools (May Be Slow)', url_for(request.params.merge(resque: true)), class: 'btn btn-primary' %>
  <% end %>
<% end %>
<%= link_to 'Export CSV', url_for(format: :csv), class: 'btn btn-primary' %>
