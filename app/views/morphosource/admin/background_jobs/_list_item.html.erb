<% if get_resque_data? %>
  <% jobs = (@all_resque_jobs || []).select { |job| job["job_id"] == item.job_id } %>
  <% if jobs.present? && jobs.count == 1 %>
    <%= @job = jobs.first %>
  <% end %>
<% end %>

<tr id="item_<%= item.id %>">
  <td><%= item.job_id %></td>
  <td><%= link_to item.user.name_and_email, Hyrax::Engine.routes.url_helpers.user_path(item.user) %></td>
  <td><%= job_classes[item.job_class] %> (<%= item.job_class.split('::').join(':: ') %>)</td>
  <td><%= t("status.#{item.status}") %></td>
  <td><%= (item.exceptions || "").truncate(100) %></td>
  <td><%= (item.created_objects.to_s || "").truncate(100) %></td>
  <td class="date"><%= item.created_at %></td>
  <td class="date"><%= item.updated_at %></td> 
  <% if get_resque_data? %>
    <td>
      <% if jobs.count == 1 %>
        Yes
      <% elsif jobs.count > 1 %>
        <span style="color: red;">Multiple (<%= jobs.count %>), error?</span>
      <% else %>
        No
      <% end %>
    </td>
    <td>
      <% if @job %>
        <% if @job["run_at"].present? %>
          Working, started <%= @job["run_at"] %>
        <% elsif @job["failed_at"].present? %>
          Failure, failed <%= @job["failed_at"] %>
        <% else %>
          Queued
        <% end %>
      <% end %>
    </td>
  <% end %>
</tr>
