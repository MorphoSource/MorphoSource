<% provide :page_title, 'Fund Code Control Panel' %>

<div class="fund-codes">
  <div class="row">
    <div class="col-md-12">
      <div class="panel panel-default">
        <div class="panel-heading">
          <h2 class="panel-title h2"><%= "#{@form_type} Fund Code" %></h2>
        </div>
        <div class="card-body">
          <%= simple_form_for @current_fund_code, url: @form_url do |f| %>
            <%= f.input :title, required: true %>
            <%= f.input :description, required: true %>
            <%= f.input :identifier, required: true %>
            <%= f.input :invoice_number %>
            
            <%= f.input :managers, input_html: { data: { managers: @managers_select2 } } %>
            <%= f.input :standard_members, input_html: { data: { standard_members: @standard_members_select2 } } %>

            <div class="form-group fund_code_expires_at">
              <label class="col-form-label" for="fund_code_expires_at">
                <%= t('simple_form.labels.fund_code.expires_at') %>
              </label>
              <p class="form-text text-muted">
                <%= t('simple_form.hints.fund_code.expires_at') %>
              </p>
              <%= f.date_field :expires_at, class: 'datepicker form-control' %>
            </div>

            <%= f.input :storage_total_gb %>
            <%= f.input :storage_remaining_gb, disabled: true, :input_html => {value: number_with_precision(f.object.storage_remaining_gb, precision: 3) } %>
            <%= f.input :total, :input_html => {value: number_with_precision(f.object.total, precision: 2) } %>
            <%= f.input :remaining, disabled: true, :input_html => {value: number_with_precision(f.object.remaining, precision: 2) }  %>
            <%= f.input :external_user, as: :select, include_blank: false %>
            <%= f.input :external_user_additional_rate_percent %>
            <%= f.input :chargeable, as: :select, include_blank: false %>
            <%= f.input :can_add_media, as: :select, include_blank: false %>

            <div class="form-group">
              <label>Fund Code File Attachments</label>
              <div>
                <p class="form-text text-muted">Files associated with this fund code.</p>
                <ul>
                <% f.object.attachments.each_with_index do |attachment, idx| %>
                  <li><%= link_to File.basename(attachment.url), attachment.url %> (<%= link_to 'delete', admin_fund_codes_delete_attachment_path(id: f.object.id, index: idx), method: :delete %>)</li>
                <% end %>
                </ul>
              </div>
              <div>
                <p class="form-text text-muted">Upload new attachments:</p>
                <%= f.file_field :attachments, multiple: true %>
              </div>
            </div>

            <%= f.submit class: 'btn btn-sm btn-primary' %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="row fund-codes-table-container">
    <div class="col-md-12">
      <div class="panel panel-default">
        <div class="panel-heading">
          <h2 class="panel-title h2"><%= t('.current_fund_codes') %></h3>
        </div>
        <div class="card-body">
          <table class="table table-striped datatable" style="font-size: smaller;">
            <thead>
              <th><%= t('.header.fund_code') %></th>
              <th><%= t('.header.description') %></th>
              <th><%= t('.header.identifier') %></th>
              <th><%= t('simple_form.abbreviated_labels.fund_code.invoice_number') %></th>
              <th><%= t('.header.managers') %></th>
              <th><%= t('.header.standard_members') %></th>
              <th><%= t('simple_form.abbreviated_labels.fund_code.expires_at') %></th>
              <th><%= t('simple_form.abbreviated_labels.fund_code.storage_total_gb') %></th>
              <th><%= t('simple_form.abbreviated_labels.fund_code.storage_remaining_gb') %></th>
              <th><%= t('simple_form.abbreviated_labels.fund_code.total') %></th>
              <th><%= t('simple_form.abbreviated_labels.fund_code.remaining') %></th>
              <th><%= t('simple_form.abbreviated_labels.fund_code.external_user') %></th>
              <th><%= t('simple_form.abbreviated_labels.fund_code.external_user_additional_rate_percent') %></th>
              <th><%= t('simple_form.abbreviated_labels.fund_code.chargeable') %></th>
              <th><%= t('simple_form.abbreviated_labels.fund_code.can_add_media') %></th>
              <th><%= t('simple_form.abbreviated_labels.fund_code.media') %></th>
              <th><%= t('.header.actions') %></th>
            </thead>
            <tbody>
            <% @fund_codes.each do |fc| %>
              <tr>
                <td data-sort="<%= fc.title %>"><%= fc.title %></td>
                <td data-sort="<%= fc.description %>"><%= fc.description %></td> 
                <td data-sort="<%= fc.identifier %>"><%= fc.identifier %></td> 
                <td data-sort="<%= fc.invoice_number %>"><%= fc.invoice_number %></td> 
                <% if fc.managers.present? %>
                  <td>
                    <div class="fc-managers">
                      <% fc.managers.each do |u| %>
                        <div>
                            <%= link_to((u.display_name || u.email), Hyrax::Engine.routes.url_helpers.user_path(u)) %>
                        </div>
                      <% end %>
                    </div>
                  </td>
                <% else %>
                  <td><%= t('.no_users') %></td>
                <% end %>
                <% if fc.standard_members.present? %>
                  <td>
                    <div class="fc-managers">
                      <% fc.standard_members.each do |u| %>
                        <div>
                            <%= link_to((u.display_name || u.email), Hyrax::Engine.routes.url_helpers.user_path(u)) %>
                        </div>
                      <% end %>
                    </div>
                  </td>
                <% else %>
                  <td><%= t('.no_users') %></td>
                <% end %>
                <td data-sort="<%= fc.expires_at %>"><%= fc.expires_at.present? ? fc.expires_at.strftime("%m-%d-%Y") : "" %></td>
                <td data-sort="<%= fc.storage_total_gb %>"><%= fc.storage_total_gb %></td>
                <td data-sort="<%= number_with_precision(fc.storage_remaining_gb, precision: 3) %>"><%= number_with_precision(fc.storage_remaining_gb, precision: 3) %></td> 
                <td data-sort="<%= number_with_precision(fc.total, precision: 2) %>"><%= number_with_precision(fc.total, precision: 2) %></td> 
                <td data-sort="<%= number_with_precision(fc.remaining, precision: 2) %>"><%= number_with_precision(fc.remaining, precision: 2) %></td> 
                <td data-sort="<%= fc.external_user %>"><%= fc.external_user ? "Yes" : "No" %></td>
                <td data-sort="<%= fc.external_user_additional_rate_percent %>"><%= fc.external_user_additional_rate_percent %></td> 
                <td data-sort="<%= fc.chargeable %>"><%= fc.chargeable ? "Yes" : "No" %></td>
                <td data-sort="<%= fc.can_add_media %>"><%= fc.can_add_media ? "Yes" : "No" %></td>
                <% media_ids_count = fc.media_ids.count %>
                <td data-sort="<%= media_ids_count %>">
                  <% if fc.title.present? && (media_ids_count > 0) %>
                    <%= link_to media_ids_count, main_app.media_search_path(params: { "f[active_fund_code_title_ssim][]" => fc.title}), target: "_blank" %>
                  <% else %>
                    <%= media_ids_count %>
                  <% end %>
                </td>
                <td>
                  <%= link_to 'Edit', main_app.admin_fund_codes_path(:id => fc.id), class: 'btn btn-sm btn-primary' %>
                  <%= link_to 'Delete', main_app.admin_fund_codes_delete_path(:id => fc.id), class: "btn btn-sm btn-danger #{fc.fund_code_media_associations.present? ? 'disabled' : ''}", method: :delete, :data => {:confirm => 'Are you sure you want to delete this fund code?'} %>
                  <% if fc.fund_code_media_associations.present? %>
                    <div><i>Can't delete, has media.</i></div>
                  <% end %>
                </td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  $( document ).ready(function() {
    $('#fund_code_managers').userSearchMultiple($('#fund_code_managers').data('managers'));
    $('#fund_code_standard_members').userSearchMultiple($('#fund_code_standard_members').data('standard-members'));
  });
</script>