<h1>Import Sequential Section Scans</h1>

<%= form_with url: import_slides_path, method: :post, local: true do |form| %>
  <div>
    <%= form.label :occurrence_id, 'GBIF Occurrence ID' %>
    <%= form.text_field :occurrence_id %>
  </div>
  <div>
    <%= form.submit "Import Slides" %>
  </div>
<% end %>
