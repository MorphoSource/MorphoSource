<% provide :page_title, page_title %>

<nav class="breadcrumb" role="region" aria-label="Breadcrumb">
  <ol>
    <li><a href="/?locale=en">Home</a></li>
    <li><a href="/dashboard?locale=en">Dashboard</a></li>
    <li class="active"><%= page_title %></li>
  </ol>
</nav>

<%= render 'search_container' %>

<div class="panel panel-default itemtable <%= controller.controller_name %>">
  <%= render 'heading' %>
  <div class="panel-body showcase">
    <% if page_description && !@search %>
      <div class="panel panel-heading">
        <%= page_description %>
        <p>Last system-wide verification completed: <%= @last_checked %></p>
        <%= link_to 'Start system-wide verification', main_app.remote_file_health_verify_all_path, class: 'btn btn-sm', data: { confirm: "This will clear the existing issue report and start another verification.  Click OK to continue, or Cancel to return to the page." }, disabled: @disable_verify_button %>
      </div>
    <% end %>
    <%= render 'document_list' %>
    <div class="showcase">
      <%= render 'results_pagination' %>
    </div>
  </div>
</div>
