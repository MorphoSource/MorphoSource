<% if item.sending_user.present? && item.receiving_user_id.present? %>
  <tr id="item_<%= item.id %>">
    <td>
      <% if item.pending? %>
        <%= render 'morphosource/batch_select/add_button', item: item %>
      <% end %>
    </td>
    <td><%= show_transfer_request_title(item) %></td>
    <td><%= link_to_transfer_participant(item.sending_user_id) %></td>
    <td><%= link_to_transfer_participant(item.receiving_user_id) %></td>
    <td class="date">
      <relative-time datetime="<%= item.created_at.getutc.iso8601 %>" title="<%= item.created_at.to_formatted_s(:standard) %>">
        <%= item.created_at.to_formatted_s(:long_ordinal) %>
      </relative-time>
    </td>
    <td><%= item.organization_transfer ? item.sender_comment.html_safe : item.sender_comment %></td>
    <td>
      <% if item.pending? %>
        <div class="row">
          <div class="col-12">
            <button type="button" class="btn btn-sm btn-primary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="width: 100%; max-width: 100%">
              Accept <span class="caret"></span>
            </button>
            <ul class="dropdown-menu">
              <li>
                <%= link_to 'Allow depositor to retain edit access', hyrax.accept_transfer_path(item), method: :put, class: 'accept-retain', title: 'Accept the transfer and allow the original depositor to retain access to edit the file and metadata' %>
              </li>
              <li>
                <%= link_to 'Remove depositor access', hyrax.accept_transfer_path(item, reset: true), method: :put, class: 'accept-reset', title: 'Accept the transfer and remove access from the original depositor.' %>
              </li>
            </ul>
          </div>
          <div class="col-12">
            <%= link_to "Reject", hyrax.reject_transfer_path(item), method: :put, class: 'btn btn-sm btn-danger', data: { confirm: "Are you sure you want to reject this request?" }, style: "width: 100%" %>
          </div>
          <div class="col-12">
            <%= button_to "Cancel", hyrax.transfer_path(item), method: :delete, class: 'btn btn-sm btn-danger', data: { confirm: "Are you sure you want to cancel this request?" }, style: "width: 100%" %>
          </div>
        </div>
      <% else %>
        <%= item.status.capitalize %>
      <% end %>
    </td>
  </tr>
<% else %>
  <% Rails.logger.error "A proxy request is missing a sender or receiver: #{item.inspect}" %>
<% end %>
