<div class="modal fade" id="transferDecideModal" tabindex="-1" role="dialog" aria-labelledby="transferDecideModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header d-block border-bottom-0">
        <h2>
          Decide Selected Transfers
          <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
        </h2>
      </div>
      <div class="modal-body">
        <p>Choose a decision to apply to all selected transfers:</p>
        <div class="list-group mb-3">
          <%= link_to '#', class: 'list-group-item list-group-item-action list-group-item-success batch-decide', data: { url: main_app.admin_transfers_batch_accept_path(return_to: request.original_fullpath) } do %>
            <strong>Accept and retain depositor's edit access</strong>
            <div class="small text-muted">Allow the original depositors to keep access to edit the file and metadata.</div>
          <% end %>
          <%= link_to '#', class: 'list-group-item list-group-item-action list-group-item-success batch-decide', data: { url: main_app.admin_transfers_batch_accept_path(return_to: request.original_fullpath), reset: true } do %>
            <strong>Accept and remove depositor access</strong>
            <div class="small text-muted">Accept the transfers and remove the original depositors' access entirely.</div>
          <% end %>
        </div>
        <div class="list-group">
          <%= link_to '#', class: 'list-group-item list-group-item-action list-group-item-danger batch-decide', data: { url: main_app.admin_transfers_batch_reject_path(return_to: request.original_fullpath), confirm: "Are you sure you want to reject the selected transfers?" } do %>
            <strong>Reject</strong>
            <div class="small text-muted">Decline the selected transfer requests.</div>
          <% end %>
          <%= link_to '#', class: 'list-group-item list-group-item-action list-group-item-danger batch-decide', data: { url: main_app.admin_transfers_batch_cancel_path(return_to: request.original_fullpath), confirm: "Are you sure you want to cancel the selected transfers? Organization transfers will be force-canceled." } do %>
            <strong>Cancel</strong>
            <div class="small text-muted">Withdraw the selected transfers. Organization transfers will be force-canceled.</div>
          <% end %>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>
