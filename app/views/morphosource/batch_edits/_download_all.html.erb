<div class="float-right">

  <%= form_tag(main_app.remove_items_path, method: :delete, class: "button_to-inline") do -%>
    <%= submit_tag("Clear Cart", class: 'btn btn-danger', id: 'clear-cart') %>
  <% end %>

  <%# JS opens the shared agreement modal/form (#download-form, rendered by
      morphosource/my/modals/download_agreements_for_cart) with .download-items-wrapper
      cleared, so submitting it downloads every downloadable item in the cart regardless
      of pagination - see download_agreements.js %>
  <button type="button" class="btn btn-info" id="download-all">Download All</button>

</div>
