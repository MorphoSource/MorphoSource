<div class="float-right">

  <%= form_tag(main_app.remove_items_path, method: :delete, class: "button_to-inline") do -%>
    <%= submit_tag("Clear Cart", class: 'btn btn-danger', id: 'clear-cart') %>
  <% end %>

  <%# JS clears .download-items-wrapper so submitting downloads the whole cart - see download_agreements.js %>
  <button type="button" class="btn btn-info" id="download-all">Download All</button>

</div>
