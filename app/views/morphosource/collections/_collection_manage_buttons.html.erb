<div class="row collection-manage-buttons float-right">
  <% if @can_edit %>
    <div class="collection-manage-button-wrapper">
      <%= link_to "Edit", hyrax.edit_dashboard_collection_path(@presenter), title: "t('hyrax.collection.actions.edit.desc')", class: 'btn btn-primary' %>
    </div>
    <div class="collection-manage-button-wrapper">
      <button type="button" class="btn btn-primary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
        Export <span class="caret"></span>
      </button>
      <ul class="dropdown-menu shadow">
        <li>
          <% if @tab == :specimens %>
            <% query_link_title = 'Specimen metadata with facets CSV' %>
            <% query_link_url = specimens_export_csv_url(@collection) %>
          <% elsif @tab == :chos %>
            <% query_link_title = 'Object metadata with facets CSV' %>
            <% query_link_url = chos_export_csv_url(@collection) %>
          <% else %>
            <% query_link_title = 'Media metadata with facets CSV' %>
            <% query_link_url = media_export_csv_url(@collection) %>
          <% end %>
          <%= link_to query_link_title,
            query_link_url,
            class: 'btn btn-dropdown-item'
          %>
        </li>

        <% if @tab == :media %>
          <li>
            <%= link_to 'Media metadata with download counts CSV',
              media_download_counts_csv_url(@collection),
              class: 'btn btn-dropdown-item'
            %>
          </li>
          <% # Unless current_user.admin? don't show user download information for media lists %>
          <% if current_user&.admin? || !@collection.media_list? %>
            <li>
              <%= link_to 'Individual media downloads CSV',
                media_downloads_csv_url(@collection),
                class: 'btn btn-dropdown-item'
              %>
            </li>

            <li>
              <%= link_to 'Individual media download requests CSV',
                media_requests_csv_url(@collection),
                class: 'btn btn-dropdown-item'
              %>
            </li>
          <% end %>

          <% if @presenter.team? && @presenter.organization.present? %>
            <li>
              <%= link_to 'Projects with media not managed by team CSV',
                main_app.team_media_projects_path(id: @presenter.id, :format => :csv, :per_page => 1000000, 'f[intersections][]' => 'organization_not_team' ),
                class: 'btn btn-dropdown-item'
              %>
            </li>

            <% if @presenter.organization.data_manager.present? %>
              <li>
                <%= link_to 'Organization transfer status per media CSV',
                  main_app.team_media_organization_transfer_status_path(request.parameters.merge(id: @presenter.id, :format => :csv, :per_page => 1000000)),
                  class: 'btn btn-dropdown-item'
                %>
              </li>
            <% end %>
          <% end %>
        <% end %>
      </ul>
    </div>
  <% end %>
  <% if @can_deposit %>
    <%# Do not show add media button if the media list has a DOI and user is not admin %>
    <% if @collection.media_list? &&
          @collection.doi.present? &&
          !current_user.admin? %>
      <div title="<%= t('morphosource.dashboard.collections.media_list.edit.doi_warning') %>" style="display: inline-block;">
        <button type="button" class="btn btn-primary dropdown-toggle" disabled>
          Add <span class="caret"></span>
        </button>
      </div>
    </div>
    <% else %>
      <div class="collection-manage-button-wrapper">
        <button type="button" class="btn btn-primary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"> Add <span class="caret"></span>
        </button>
        <ul class="dropdown-menu shadow">
          <li> <%= link_to "Select existing media", Rails.application.routes.url_helpers.my_add_media_index_path(@presenter.id), class: 'btn btn-sm btn-dropdown-item' %> </li>
          <% if current_ability.can? :create, Media %>
            <li> <%= link_to "Upload new media", main_app.new_submission_path(collection: @presenter.id), class: 'btn btn-sm btn-dropdown-item' %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  <% end %>
</div>
