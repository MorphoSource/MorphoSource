  <div class="document media">
    <div class="thumbnail text-center">
      <div class="media text-center flex-wrap justify-content-center">
        <span class='gallery-badge'><%= render_publication_status_badge(document) %></span>
        <div class="media">
          <%= link_to [main_app, document], target: :_blank, class: "media-left" do %>
            <%= render_thumbnail_tag document, { class: "file_listing_thumbnail" }, { suppress_link: true } %>
          <% end %>
        </div>
      </div>
      <div class="caption text-center">
        <dl class="document-metadata dl-horizontal dl-invert">
          <dd>
<a target="_blank" href="/concern/media/000748890?locale=en">
              <div><%= document.id %></div>
  </a>
          </dd>
          <dd class="text-truncate"><%= document.part&.first %></dd>
          <dd class="text-truncate-lines two-lines"><%= document["physical_object_title_ssim"]&.first %></dd>
          <% if response_includes_specimens?(@response) %>
            <dd class="text-truncate"><i><%= document["taxonomy_ssim"]&.first %></i></dd>
          <% else %>
            <dd class="text-truncate"><%= document["short_description_ssim"]&.first %></dd>
          <% end %>
        </dl>
      </div>
    </div>
  </div>