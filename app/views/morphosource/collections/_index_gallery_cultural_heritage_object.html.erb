<% 
id = document.id 
cho = CulturalHeritageObject.find(id)
%>
<% doc_presenter = index_presenter(document) %>
<%# default partial to display solr document fields in catalog index view -%>

<dl class="document-metadata dl-horizontal dl-invert">
  <dd class="text-truncate"><%= cho.material&.first %></dd>
  <dd>Total media: <%= render_extra(@cho_extras, id, 'media_count') %></dd>  
  <dd class="text-truncate"><%= cho.cho_type&.first %></dd>
</dl>
