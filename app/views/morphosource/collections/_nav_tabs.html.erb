<!-- keep -->
<ul class="nav nav-tabs" role="tablist">
  <li role="presentation" class="nav-item <%= active_tab?(:media) %>">
    <a class="nav-link <%= active_tab?(:media) == 'active' ? 'active' : '' %>" href=<%= media_tab_url(@collection) %> aria-controls="media" role="tab">
      <i class="fa fa-cube" aria-hidden="true"></i> MEDIA
    </a>
  </li>
  <% if @specimen_count > 0 %>
    <li role="presentation" class="nav-item <%= active_tab?(:specimens) %>">
      <a class="nav-link <%= active_tab?(:specimens) == 'active' ? 'active' : '' %>" href=<%= specimens_tab_url(@collection) %> aria-controls="biological_specimens" role="tab">
        <i class="fas fa-frog" aria-hidden="true"></i> SPECIMENS
      </a>
    </li>
  <% end %>
  <% if @cho_count > 0 %>
    <li role="presentation" class="nav-item <%= active_tab?(:chos) %>">
      <a class="nav-link <%= active_tab?(:chos) == 'active' ? 'active' : '' %>" href=<%= chos_tab_url(@collection) %> aria-controls="biological_specimens" role="tab">
        <i class="ms2-icon-bowl icon-bowl" aria-hidden="true"></i> CULTURAL HERITAGE OBJECTS
      </a>
    </li>
  <% end %>
  <li role="presentation" class="nav-item <%= active_tab?(:about) %>">
    <a class="nav-link <%= active_tab?(:about) == 'active' ? 'active' : '' %>" href=<%= about_tab_url(@collection) %> aria-controls="biological_specimens" role="tab">
      <i class="fa fa-newspaper" aria-hidden="true"></i> ABOUT
    </a>
  </li>
</ul>
