<%= render 'did_you_mean' %>
<%= render 'facets' %>
<%= render 'constraints' %>
<div class="row" style="display: flex; flex-direction: row; justify-content: flex-end; flex-wrap: wrap;">

  <% if morphosource_physical_objects_controller? %>
    <div class="col-xs-12 col-sm-5 col-md-4 batch-action-buttons">
    </div>
  <% elsif @document_list.count > 0 %>
    <div class="col-xs-12 col-sm-5 col-md-4 batch-action-buttons">
      <div class="row">
          <%= render 'batch_actions' %>
      </div>
    </div>
  <% else %>
    <div class="col-xs-12 col-sm-5 col-md-4 batch-action-buttons">
    </div>
  <% end %>

  <div class="col-xs-12 col-sm-4 col-md-5">
    <%= render 'search_form' %>
  </div>

  <div class="col-xs-12 col-sm-3 col-md-3" style="display: flex; flex-direction: row; justify-content: flex-end;">
    <%= render 'view_type_group' %>
  </div>
</div>
