<%= render 'did_you_mean' %>
<%= render 'facets' %>
<%= render 'constraints' %>

<div class="row">
  <% if @document_list.count > 0 %>
    <div class="col-xs-12 col-sm-5 col-md-4 batch-action-buttons">
      <div class="row">
        <%= render 'batch_actions' %>
      </div>
    </div>
  <% else %>
    <div class="col-xs-12 col-sm-5 col-md-4 batch-action-buttons">
    </div>
  <% end %>

  <div class="col-xs-12 col-sm-4 col-md-5">
    <%= render 'search_form' %>
  </div>

  <div class="col-xs-12 col-sm-3 col-md-3">
    <%= render 'view_type_group' %>
  </div>
</div>
