<div style="margin-left: 22px; margin-right: 22px; margin-bottom: 15px;">
  <%= render 'did_you_mean' %>
  <%= render 'facets' %>
  <%= render 'constraints' %>
</div>
<div class="row mb-2" style="display: flex; flex-direction: row; align-items: center; justify-content: flex-end; flex-wrap: wrap;">
  <div class="col-12 col-sm-12 col-md-12 col-lg-5 batch-action-buttons mb-0">
  <% if !morphosource_physical_objects_controller? && @document_list.count > 0 && params[:view] != "gallery" %>
    <div class="row">
      <% if document_index_view_type == :list %>
        <%= render 'batch_actions' %>
      <% end %>
    </div>
  <% end %>
  </div>
  <div class="col-12 col-sm-12 col-md-9 col-lg-5">
    <%= render 'search_form' %>
  </div>
  <div class="col-12 col-sm-12 col-md-3 col-lg-2" style="display: flex; flex-direction: row; justify-content: flex-end;">
    <%= render 'view_type_group' %>
  </div>
</div>