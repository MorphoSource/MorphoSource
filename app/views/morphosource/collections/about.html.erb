<% content_for :body_css_classes do %>showcase teams<% end %>

<%
provide :page_title, construct_page_title(@presenter.title)
%>
<div class="hyc-container" itemscope itemtype="http://schema.org/CollectionPage">
  <div class="hyc-header">
    <% unless @presenter.banner_file.blank? %>
        <header class="hyc-banner" style="background-image:url(<%= @presenter.banner_file %>)"></header>
    <% else %>
        <header class="hyc-generic"></header>
    <% end %>
  </div>

  <div class="row team-header">
    <div class="col-xs-12 col-sm-8 col-md-8">
      <div class="col-sm-12 col-md-12 flex">
        <div class="team-logo">
          <% unless @presenter.logo_record.blank? %>
            <% lr = @presenter.logo_record.first %>
            <% if lr[:linkurl].blank? %>
                <img alt="<%= lr[:alttext] %>" src="<%= lr[:file_location] %>" border="0" />
            <% else %>
                <a href="<%= lr[:linkurl] %>">
                  <img alt="<%= lr[:alttext] %>" src="<%= lr[:file_location] %>" border="0" />
                </a>
            <% end %>
          <% end %>
        </div>
        <div class="team-title">
           <h1>
              <div id="showcase-title">
                <% if @presenter.team? && @presenter.organization %>
                  <div class="super-title"><%= @presenter.organization.institution_name&.first %></div>
                  <%= @presenter.organization.title.first %>
                  <%= @presenter.organization_badge %>
                  <%= @presenter.team_managed_badge %>
                <% else %>
                  <%= @presenter.title.first %>
                  <%= @presenter.collection_type_badge %>
                  <%= @presenter.id_badge %>
                  <%= @presenter.permission_badge %>
                <% end %>
                
              </div>
              <%= render 'collection_counts' %>
          </h1>
        </div>
      </div>
    </div>

    <div class="col-xs-12 col-sm-4 col-md-4 btn-wrapper">
      <% if can?(:edit, @presenter.solr_document) %>
        <div class="row collection-manage-buttons">
            <button type="button" class="btn btn-primary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="max-width: unset;">
              CSV export <span class="caret"></span>
            </button>
            <ul class="dropdown-menu">
              <% if @presenter.team? && @presenter.organization.present? %>
                <li>
                  <%= link_to 'Projects with media not managed by team',
                    main_app.team_media_projects_path(id: @presenter.id, :format => :csv, :per_page => 1000000, 'f[intersections][]' => 'organization_not_team' ),
                    class: 'btn btn-primary' 
                  %>
                </li>
              <% end %>

              <li>
                <%= link_to 'Media downloads',
                  media_downloads_csv_url(@collection),
                  class: 'btn btn-primary' 
                %>
              </li>

              <li>
                <%= link_to 'Media metadata with download counts',
                  media_download_counts_csv_url(@collection),
                  class: 'btn btn-primary' 
                %>
              </li>

              <li>
                <%= link_to 'Media download requests',
                  media_requests_csv_url(@collection),
                  class: 'btn btn-primary' 
                %>
              </li>
            </ul>

          <%= link_to t('hyrax.collection.actions.edit.' + @presenter.collection_type.machine_id), hyrax.edit_dashboard_collection_path(@presenter), title: t('hyrax.collection.actions.edit.desc'), class: 'btn btn-primary' %>
        </div>
      <% end %>
    </div>

  </div><!-- /row -->

  <!-- Subcollections -->
  <% if @presenter.collection_type_is_nestable? && @subcollection_count > 0 %>
      <div class="hyc-blacklight hyc-bl-title">
        <h4>TEAM PROJECTS</h4>
      </div>
      <div class="hyc-blacklight hyc-bl-results">
        <%= render 'subcollection_list', collection: @subcollection_docs %>
      </div>
  <% end %>

  <div class="panel panel-default tabs" role="main">
    <!-- Nav tabs -->
    <%= render 'nav_tabs' %>
    <!-- Tab panes -->
    <!-- <div class="tab-content"> -->

      <div class="panel-body">

        <%= render 'morphosource/collections/about/tab_about' %>

      </div>


    <!-- </div><!-- /tab-content -->

  </div><!-- /panel panel-default tabs -->

</div><!-- div hyc-container -->
