<div class="about">
  <div class="row">
    <div class="col-sm-6 about-column">
      <%= render 'morphosource/collections/about/collection_description'%>
      <%= render 'morphosource/collections/about/details' %>
      <%= render 'morphosource/collections/about/identifiers_and_external_links' %>
    </div>
    <div class="col-sm-6 about-column">
      <%= render 'morphosource/collections/about/statistics' %>
      <!-- For projects, displays project tags.
      For teams, displays linked organization info -->
      <%= render 'collection_type_about' %>
    </div>
  </div>
</div>
