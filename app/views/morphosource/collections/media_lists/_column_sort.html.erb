<div class="btn-group choose-columns-media">
  <button type="button" class="btn btn-primary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
    <i class="fa fa-columns"></i> <span class="caret"></span>
  </button>
  <ul class="dropdown-menu">
    <li><input type="checkbox" class="toggle-vis" data-column="3" checked="checked" /> ID</li>
    <li><input type="checkbox" class="toggle-vis" data-column="4" checked="checked" /> Part</li>
    <li><input type="checkbox" class="toggle-vis" data-column="5" checked="checked" /> Object</li>
    <li><input type="checkbox" class="toggle-vis" data-column="6" checked="checked" />
    <% if @document_list.first["taxonomy_ssim"].present? %>
      Taxonomy</li>
    <% else %>
      Description</li>
    <% end %>
    <li><input type="checkbox" class="toggle-vis" data-column="7" checked="checked" /> Type</li>
    <li><input type="checkbox" class="toggle-vis" data-column="8" checked="" /> Date Added</li>
    <li><input type="checkbox" class="toggle-vis" data-column="9" checked="checked" /> Publication Status</li>
  </ul>
</div>