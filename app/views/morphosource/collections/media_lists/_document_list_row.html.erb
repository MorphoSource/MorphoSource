<tr 
  id="document_<%= document.id %>" 
  class="
    <%= @hide_viewer ? "" : "previewable" %> 
    <%= (@preview_document_id && @preview_document_id == document.id) ? "view-active" : "" %>
  " 
  data-document-id="<%= document.id %>" 
  data-collection-id="<%= @collection.id %>"
>
  <td class="checkbox" data-behavior="batch-add-button">
    <div class="document-row-interact-panel">
      <span class="interact-item"><%= document["position"] || (document_counter + 1) %>.</span>
      <%= check_box_tag "batch_work_ids[]", document.id, false, class: "batch_add_selector interact-item", id: "batch_work_#{document.id}" %>
      <%= check_box_tag "batch_document_ids[]", document.id, false, class: "batch_document_selector hidden", id: "batch_document_#{document.id}" %>
      <% if @can_edit %>
        <i class="fa fa-solid fa-bars sort-handle interact-item"></i>
        <%= form_for @collection, url: update_team_path(@collection), method: :put, as: 'collection' do |f| %>
          <%= single_item_action_remove_form_fields(f, document) %>
          <%= hidden_field_tag(:showcase, 'true') %>
          <%= button_tag(class: "collection-remove btn-remove-media #{@collection.collection_type.title.downcase}-remove-media interact-item") do %>
              <i class="fa fa-solid fa-trash"></i>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </td>
  <td>
    <div class="media">
      <%= link_to [main_app, document], target: :_blank do %>
        <%= render_thumbnail_tag document, { class: "file_listing_thumbnail" }, { suppress_link: true } %>
        <div><%= document.id %></div>
      <% end %>
      <div>
        <%= document["human_readable_media_type_tesim"]&.first %>
      </div>
    </div>
  </td>
  <td><%= document.part&.first %></td>
  <td class="break-all"><%= document["physical_object_title_ssim"]&.first %></td>
  <td><i><%= document["taxonomy_ssim"]&.first %></i></td>
  <td><%= document["human_readable_media_type_tesim"]&.first %></td>
  <td><%= document.date_uploaded %></td>
  <td class='long-badge'><%= render_publication_status_badge(document) %></td>
  <td class="view-column">
    <div class="view-label">
      <% if @hide_viewer %>
        <%= 
          link_to "View", 
            url_for(request.params.merge(view: document.id)),
            class: "view-media btn btn-sm btn-default"
        %>
      <% else %>
        <div class="view-media dynamic btn btn-sm btn-default">View</div>
        <div class="currently-viewing hide">
          Currently Viewing
        </div>
      <% end %>
    </div>
  </td>
</tr>