<tr
  id="document_<%= document.id %>"
  class="
    <%= @hide_viewer ? "" : "previewable" %>
    <%= (@preview_document_id && @preview_document_id == document.id) ? "view-active" : "" %>
  "
  data-document-id="<%= document.id %>"
  data-collection-id="<%= @collection.id %>"
>
  <td>
    <div class="document-row-interact-panel">
      <span class="interact-item"><%= ( i = ordered_media&.index(document.id) ).nil? ? "" : "#{i + 1}." %></span>
      <div class="checkbox" data-behavior="batch-add-button">
        <%= check_box_tag "batch_work_ids[]", document.id, false, class: "batch_add_selector interact-item", id: "batch_work_#{document.id}" %>
        <%= check_box_tag "batch_document_ids[]", document.id, false, class: "batch_document_selector hidden", id: "batch_document_#{document.id}" %>
      </div>
      <% if @can_edit && ( @collection.doi.blank? || current_user.admin? ) %>
        <i
          class="fa fa-solid fa-bars sort-handle interact-item"
          title="<%= t("morphosource.collection.actions.order_member.handle.title") %>"
        ></i>
        <%=
          link_to main_app.collection_remove_member_path(@collection, member_id: document.id),
          method: :post,
          class: "interact-item media-list-remove-member",
          title: t("morphosource.collection.actions.remove_member.title", collection_type: "media list"),
          data: {
            confirm_text: t("morphosource.collection.actions.remove_member.confirm", collection_type: "media list")
          } do
        %>
          <i class="fa fa-solid fa-trash"></i>
        <% end %>
      <% end %>
    </div>
  </td>
  <td>
    <div class="media">
      <%= link_to [main_app, document], target: :_blank do %>
        <%= render_thumbnail_tag document, { class: "file_listing_thumbnail" }, { suppress_link: true } %>
        <div><%= document.id %></div>
      <% end %>
      <div>
        <%= document["human_readable_media_type_tesim"]&.first %>
      </div>
    </div>
  </td>
  <td><%= document.part&.first %></td>
  <td class="break-all">
    <div><%= document["physical_object_title_ssim"]&.first %></div>
    <div class="object-col-taxonomy"><i><%= document["taxonomy_ssim"]&.first %></i></div>
  </td>
  <td><i><%= document["taxonomy_ssim"]&.first %></i></td>
  <% if @hide_viewer %>
    <td><%= document["human_readable_media_type_tesim"]&.first %></td>
    <td><%= document.date_uploaded %></td>
    <td class='long-badge'><%= render_publication_status_badge(document) %></td>
  <% end %>
  <td class="view-column">
    <div class="view-label">
      <% if @hide_viewer %>
        <%=
          link_to "View",
            url_for(request.params.merge(preview: document.id)),
            class: "view-media btn btn-sm btn-secondary"
        %>
      <% else %>
        <div class="view-media dynamic btn btn-sm btn-secondary">View</div>
        <div class="currently-viewing hide">
          Currently Viewing
        </div>
      <% end %>
    </div>
  </td>
</tr>