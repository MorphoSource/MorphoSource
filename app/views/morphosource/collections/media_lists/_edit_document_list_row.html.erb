<tr id="document_<%= document.id %>" class="<%= document.id == '000200016' ? 'highlight' : '' %>">
  <td class="checkbox" data-behavior="batch-add-button">
    <span><%= document["position"] %>.</span>
    <%= check_box_tag "batch_work_ids[]", document.id, false, class:"batch_add_selector", id: "batch_work_#{document.id}" %>
    <%= check_box_tag "batch_document_ids[]", document.id, false, class:"batch_document_selector hidden", id: "batch_document_#{document.id}" %>
    <i class="fa fa-solid fa-bars"></i>
    <i class="fa fa-solid fa-trash"></i>
  </td>
  <td>
    <div class="media">
      <%= link_to [main_app, document], target: :_blank, class: "" do %>
        <%= render_thumbnail_tag document, { class: "file_listing_thumbnail" }, { suppress_link: true } %>
        <%= document.id %>
      <% end %>
    </div>
  </td>
  <td><%= document.id %></td>
  <td><%= document.part&.first %></td>
  <td class="break-all"><%= document["physical_object_title_ssim"]&.first %></td>
  <td><i><%= document["taxonomy_ssim"]&.first %></i></td>
  <td><%= document["human_readable_media_type_tesim"]&.first %></td>
  <td><%= document.date_uploaded %></td>
  <td class='long-badge'><%= render_publication_status_badge(document) %></td>
</tr>