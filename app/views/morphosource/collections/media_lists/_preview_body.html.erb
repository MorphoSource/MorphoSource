<div class="preview-body">
  <div class="preview-disabled-wrap hide"></div>

  <div class="preview-wrapper-and-controls">
    <div id="preview-wrapper">
      <%= render "preview" %> <!-- <div class="preview-container"> -->
    </div>

    <div class="preview-controls">
      <a class="previous disabled"><i class="fa fa-backward"></i><span>Prev</span></a>
      <a class="next disabled"><span>Next</span><i class="fa fa-forward"></i></a>
    </div>
  </div>

  <div class="name-container">
    <div class="name <%= @media_presenter ? "" : "hide" %>">
      <% if @media_presenter %>
        <a class="preview-name-link" href="#">
          Media <%= @media_presenter&.id %>: <%= @media_presenter&.title&.first %>
        </a>
      <% else %>
        <a class="preview-name-link" target="_blank"></a>
      <% end %>
    </div>
  </div>
</div>

