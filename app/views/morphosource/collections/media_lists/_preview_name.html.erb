<div class="name <%= @media_presenter ? "" : "hide" %>">
  <% if @media_presenter %>
    <%= link_to @media_presenter, target: :_blank, class: "preview-name-link" do %>
      Media <%= @media_presenter&.id %>: <%= @media_presenter&.title&.first %>
    <% end %>
    <div><%= @media_presenter.physical_object_title %></div>
    <div><i><%= @media_presenter.physical_object_taxonomy_title %></i></div>

  <% else %>
    <a class="preview-name-link" target="_blank"></a>
  <% end %>
</div>