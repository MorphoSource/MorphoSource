<div class="text-muted">
  <%= @media_count.to_s + ' Media' %>
  <% if @presenter.creator.present? %>
    · Creator: <%= @presenter.creator.join(', ') %>
  <% end %>
  <%= render 'shared/collections/managed_by', manager_links: @presenter.manager_links_for_display %>
</div>
<div class="text-muted" style="margin-top: 5px;">
  <% unless @object_ids.blank? %>
    All media represent physical object: <%= link_to_specimen(@object_ids.first) %>
  <% end %>
</div>