<div class="row collection-manage-buttons pull-right">
  <% if @can_edit %>
    <div class="collection-manage-button-wrapper">
      <%= link_to "Edit", hyrax.edit_dashboard_collection_path(@presenter), title: "t('hyrax.collection.actions.edit.desc')", class: 'btn btn-primary' %>
    </div>
    <div class="collection-manage-button-wrapper">
      <button type="button" class="btn btn-primary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
        Export <span class="caret"></span>
      </button>
      <ul class="dropdown-menu">
        <li>
          <%= link_to t("morphosource.collections.organization.exports.#{@tab.to_s}.media_export.label"), self.send("#{@tab}_export_csv_url", @collection), class: 'btn btn-primary' %>
        </li>
        <li>
          <%= link_to t("morphosource.collections.organization.exports.#{@tab.to_s}.media_download_counts.label"),
          self.send("#{@tab}_download_counts_csv_url",@collection), class: 'btn btn-primary'
          %>
        </li>
        <li>
          <%= link_to t("morphosource.collections.organization.exports.#{@tab.to_s}.media_downloads.label"),
            self.send("#{@tab}_downloads_csv_url", @collection), class: 'btn btn-primary'
          %>
        </li>
        <li>
          <%= link_to t("morphosource.collections.organization.exports.#{@tab.to_s}.media_requests.label"), self.send("#{@tab}_requests_csv_url", @collection),
            class: 'btn btn-primary'
          %>
        </li>
      </ul>
    </div>
  <% end %>
  <% if @collection.can_manage_devices? %>
    <% if @can_edit || @collection.editors&.include?(current_user) %>
      <div class="collection-manage-button-wrapper">
        <button type="button" class="btn btn-primary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"> Add <span class="caret"></span>
        </button>
        <ul class="dropdown-menu">
          <li>
            <a class="btn btn-sm btn-primary" href=<%= main_app.new_hyrax_device_path(:organization_id => @presenter) %>><%= t('hyrax.organization.show.manage_buttons.new_device') %></a>
          </li>
        </ul>
      </div>
    <% end %>
  <% end %>
</div>
