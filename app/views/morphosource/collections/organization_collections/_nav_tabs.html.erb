<!-- morphosource/collections/organization_collections/nav_tabs -->
<%
# For object organizations:
# - always display object media tab
# - never display the device media tab
# - never display the devices tab

# For device organizations:
# - never display object media tab
# - always display the device media tab
# - always display the devices tab

# For object and device organizations:
# - always display object media tab
# - always display the device media tab
# - always display the devices tab

# For ALL organization types:
# - if no objects OR both object types are present, display both object tabs
# - if only one object type is present, do not display the other object tab
%>

<ul class="nav nav-tabs" role="tablist">
  <% if @collection.organization_type == ['Museum, Department, or Lab Collection'] %>
    <%= render 'morphosource/collections/organization_collections/nav_tabs/object_tabs' %>
  <% elsif @collection.organization_type == ['Scanning Facility'] %>
    <%= render 'morphosource/collections/organization_collections/nav_tabs/device_tabs' %>
  <% else %>
    <% # if organization_type is ['Collection and Scanning Facility'] or blank %>
    <%= render 'morphosource/collections/organization_collections/nav_tabs/object_and_device_tabs' %>
  <% end %>
</ul>
