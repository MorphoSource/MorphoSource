<%# postal code %>
<%= @presenter.attribute_to_html(:postal_code, label: t('morphosource.collections.view.about.contact.postal_code'), render_as: :showcase_default, include_empty: true, html_dl: false) %>
<%# country %>
<%= @presenter.attribute_to_html(:country, label: t('morphosource.collections.view.about.contact.country'), render_as: :showcase_default, include_empty: true, html_dl: false) %>
<%# contact_person %>
<%= @presenter.attribute_to_html(:contact_person, label: t('morphosource.collections.view.about.contact.contact_person'), render_as: :showcase_default, include_empty: true, html_dl: false) %>