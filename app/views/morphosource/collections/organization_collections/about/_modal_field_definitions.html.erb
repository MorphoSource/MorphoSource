<% work_type = :media if local_assigns[:work_type].nil? %>

<div class="modal fade modal-definitions" id="<%= modal_id %>" tabindex="-1" role="dialog" aria-labelledby="modal-label" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
        <h2>Field Definitions</h2>
      </div>
      <div class="modal-body">
        <div><%= t('morphosource.collections.view.about.permissions.modal.text') %></div>
        <hr />
        <% (fields || []).each do |field| %>
          <div class="term-container">
            <div class="term-name">
              <%= translate(
                :"blacklight.search.fields.#{work_type}.show.#{field}",
                default: [:"blacklight.search.fields.show.#{field}", :"blacklight.search.fields.#{field}", field.to_s.humanize]
              ) %>
            </div>
            <div>
              <%= translate(
                :"simple_form.hints.#{work_type}.#{field}",
                default: [:"simple_form.hints.defaults.#{field}"]
              ) %>
            </div>
            <hr />
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>