<div class="row collection-manage-buttons float-right">
  <% if @can_edit %>
    <div class="collection-manage-button-wrapper">
      <%= link_to "Edit", hyrax.edit_dashboard_collection_path(@presenter), title: "t('hyrax.collection.actions.edit.desc')", class: 'btn btn-primary' %>
    </div>
    <div class="collection-manage-button-wrapper">
      <button type="button" class="btn btn-primary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
        Export <span class="caret"></span>
      </button>
      <ul class="dropdown-menu shadow">
        <li>
          <%= link_to 'Specimen metadata with facets CSV', specimens_export_csv_url(@collection), class: 'btn btn-dropdown-item' %>
        </li>
      </ul>
    </div>
  <% end %>
  <% if @collection.can_manage_devices? %>
    <% if @can_edit || ( current_user.present? && @collection.editors&.include?(current_user) ) %>
      <div class="collection-manage-button-wrapper">
        <button type="button" class="btn btn-primary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"> Add <span class="caret"></span>
        </button>
        <ul class="dropdown-menu shadow">
          <li>
            <a class="btn btn-sm btn-dropdown-item" href=<%= main_app.new_hyrax_device_path(:organization_id => @presenter) %>><%= t('hyrax.organization.show.manage_buttons.new_device') %></a>
          </li>
        </ul>
      </div>
    <% end %>
  <% end %>
</div>
