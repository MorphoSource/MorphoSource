<div id="team_projects" role="tabpanel" class="tab-pane active">
  <div class="form-tab-content">
    <div class="tab-action-buttons sub-collections-wrapper d-flex flex-row-reverse" style="gap: 5px;">
      <%= button_tag t("hyrax.dashboard.collections.actions.add_project_to_#{@collection.collection_type.machine_id}.label"),type: 'button',
               class: 'btn btn-primary add-subcollection',
               title: t("hyrax.dashboard.collections.actions.add_project_to_#{@collection.collection_type.machine_id}.label"),
               data: { nestable: true,
                       hasaccess: true,
                       presenter_id: @presenter.id } %>
      <%= link_to t("hyrax.dashboard.collections.actions.create_new_project_in_#{@collection.collection_type.machine_id}.label"),
        main_app.create_subcollection_under_path(parent_id: @presenter.id),
        title: t("hyrax.dashboard.collections.actions.create_new_project_in_#{@collection.collection_type.machine_id}.label"),
        class: 'btn btn-primary' %>
    </div>
    <%= render 'morphosource/dashboard/collections/child_projects/tab_project_list', id: @presenter.id, collection: @projects %>
  </div>
</div>

<%= render 'morphosource/my/collections/modal_add_project', id: @presenter.id, source: 'show' %>
<%= render 'morphosource/my/collections/modal_remove_project' %>
