<%# taken from
https://github.com/samvera/hyrax/blob/v2.7.0/app/views/hyrax/dashboard/collections/_form_branding.html.erb
%>

<div class="set-access-controls">
  <h2><%= t('hyrax.dashboard.collections.form_branding.logo.label') %></h2>
  <p><%= t('morphosource.dashboard.collections.form_branding.logo.description', collection_type: @collection.collection_type.title.downcase) %></p>

  <div id="fileuploadlogo" class="fileuploadlogo">
    <!-- Redirect browsers with JavaScript disabled to the origin page -->
    <noscript><input type="hidden" name="redirect" value="<%= main_app.root_path %>" /></noscript>
    <!-- The table listing the files available for upload/download -->

    <!-- The fileupload-buttonbar contains buttons to add/delete files and start/cancel the upload -->
    <div class="row fileupload-buttonbar">
      <div class="col-xs-4">
        <!-- The fileinput-button span is used to style the file input field as button -->
        <span class="btn btn-success fileinput-button">
          <span class="glyphicon glyphicon-plus"></span>
          <span>Choose File</span>
          <input type="file" name="files[]" single />
        </span>
      </div> <!-- end col-xs-4 -->

      <!-- The global progress state -->
      <div class="col-xs-8 fileupload-progress branding-logo-progress fade">
        <!-- The global progress bar -->
        <div class="progress progress-striped active" role="progressbar" aria-valuemin="0" aria-valuemax="100">
          <div class="progress-bar progress-bar-success" style="width:0%;"></div>
        </div>
        <!-- The extended global progress state -->
        <div class="progress-extended">&nbsp;</div>
      </div> <!-- end col-xs-8 fileupload-progress branding-logo-progress fade -->
    </div> <!-- end row fileupload-buttonbar -->

    <div class="row branding-logo-list">
      <div class="col-xs-12">

          <% i = 0 %>
          <% f.object.logo_info.each_with_index do |linfo, i| %>
            <div class="row branding-logo-row" id="logorow_<%= i %>">
              <div class="col-sm-3">
                <span class="name break-all">
                  <span><%= linfo[:file] %></span>
                <input type="hidden" name="logo_files[]" value="<%= linfo[:full_path] %>" />
                </span>
              </div>

              <div class="col-sm-8 branding-logo-input">
                <label for="linkurl_<%= i %>">
                  <span class="col-xs-4">Link URL:</span>
                  <span class="col-xs-8"><input id="linkurl_<%= i %>" class="branding-logo-input" type="text" name="linkurl[]" value="<%= linfo[:linkurl] %>" /></span>
                </label>
                <label for="alttext_<%= i %>">
                  <span class="col-xs-3">Alt Text:</span>
                  <span class="col-xs-9"><input id="alttext_<%= i %>" class="branding-logo-input" type="text" name="alttext[]" value="<%= linfo[:alttext] %>" /></span>
                </label>
              </div>

              <div class="col-sm-1">
                <button class="btn delete branding-logo-remove" data-type="DELETE" data-url="/" onclick='$("#logorow_<%= i %>").remove();enableUpload("fileuploadlogo");'>
                  <span class="fa fa-times-circle"></span>
                  <span class="controls-remove-text">Remove</span>
                   <span class="sr-only">
                    previous
                    <span class="controls-field-name-text">Remove Logo <%= i + 1 %></span>
                  </span>
                </button>
              </div> <!-- end col-sm-2 -->
            </div> <!-- row logorow -->
          <% end %>
          <span class="files"></span>

        <!-- The global file processing state -->
        <span class="fileupload-process"></span>
      </div> <!-- end col-xs-12 -->
    </div> <!-- end row branding-logo-list -->
  </div> <!-- end fileuploadlogo -->


  <h2><%= t('hyrax.dashboard.collections.form_branding.banner.label') %></h2>
  <p><%= t('morphosource.dashboard.collections.form_branding.banner.description', collection_type: @collection.collection_type.title.downcase) %></p>


  <div id="fileuploadbanner" class="fileuploadbanner">
    <!-- Redirect browsers with JavaScript disabled to the origin page -->
    <noscript><input type="hidden" name="redirect" value="<%= main_app.root_path %>" /></noscript>
    <!-- The table listing the files available for upload/download -->

    <!-- The fileupload-buttonbar contains buttons to add/delete files and start/cancel the upload -->
    <div class="row fileupload-buttonbar">
      <div class="col-xs-4">
        <!-- The fileinput-button span is used to style the file input field as button -->
        <span class="btn btn-success fileinput-button">
          <span class="glyphicon glyphicon-plus"></span>
          <span>Choose File</span>
          <input type="file" name="files[]" single />
        </span>
      </div> <!-- end col-xs-4 -->

      <!-- The global progress state -->
      <div class="col-xs-8 fileupload-progress branding-banner-progress fade">
        <!-- The global progress bar -->
        <div class="progress progress-striped active" role="progressbar" aria-valuemin="0" aria-valuemax="100">
          <div class="progress-bar progress-bar-success" style="width:0%;"></div>
        </div>
        <!-- The extended global progress state -->
        <div class="progress-extended">&nbsp;</div>
      </div> <!-- end col-xs-5 fileupload-progress fade -->
    </div> <!-- end row fileupload-buttonbar -->

    <div class="row branding-banner-list">
      <div class="col-xs-12">

        <% if f.object.banner_info[:file] %>
          <div id="banner">
            <div class="row branding-banner-row">
              <div class="col-sm-5">
                <span class="name break-all">
                  <span><%= f.object.banner_info[:file] %></span>
                  <input type="hidden" name="banner_unchanged" value="true" />
                </span>
              </div>

              <div class="col-sm-7">
                <button class="btn delete branding-banner-remove" data-type="DELETE" data-url="/" onclick='$("#banner").remove(); enableUpload("fileuploadbanner")';>
                  <span class="fa fa-times-circle"></span>
                  <span class="controls-remove-text">Remove</span>
                  <span class="sr-only">
                    previous
                    <span class="controls-field-name-text">Remove Current Banner</span>
                  </span>
                </button>
              </div> <!-- end col-sm-2 -->
            </div> <!-- row branding-banner-row -->

            <% if f.object.banner_info[:relative_path] %>
            <div class="banner-image">
              <i><%= image_tag(f.object.banner_info[:relative_path],
                               alt: "Unable to display banner: #{f.object.banner_info[:file]}") %></i>
            </div>
            <% end %>
          </div> <!-- end banner -->
          <div role="presentation" class="table table-striped"><span class="files"></span></div>
        <% else %>
          <div role="presentation" class="table table-striped"><span class="files"></span></div>
        <% end %>

          <!-- The global file processing state -->
          <span class="fileupload-process"></span>

      </div> <!-- end row branding-banner-list -->
    </div> <!-- end row branding-banner-list -->
  </div> <!-- fileupload -->

  <%= render 'hyrax/uploads/js_templates_branding' %>



</div> <!-- end set-access-controls -->
