<div id="details" class="tab-pane active">
  <div class="panel panel-default labels">
    <div class="panel-body">
      <%= simple_form_for @form, url: collection_form_url(@form), wrapper: :showcase_default, html: { class: 'editor' } do |f| %>
      <div class="row">
        <%= render 'morphosource/dashboard/collections/details/action_buttons', f: f %>
        <div class="col-sm-6">
          <div class="content-block">

            <h2>GENERAL DETAILS</h2>
            <%= render_edit_field_partial('title', f: f) %>
            <%= render_edit_field_partial('description', f: f) %>
            <%= render_edit_field_partial('creator', f: f) %>
            <%= render_edit_field_partial('contributor', f: f) %>
            <%= render_edit_field_partial('based_near', f: f) %>
            <%= render_edit_field_partial('related_url', f: f) %>

            <div class="row">
              <div class="col-xs-6 showcase-label">
                Visibility
              </div>
              <div class="col-xs-6 showcase-value">

                <div class="m-0 p-0 text-nowrap">
                <a aria-label="collapse/expand" data-toggle="collapse" href="#collapse-block-visibility" class="btn collapse-block-visibility pl-0">
                  <span class="label" id="current_visibility_value_for_collection">
                    <%= @presenter.visibility %>
                  </span>

                  <span class="glyphicon glyphicon-triangle-bottom collapse-block-visibility"></span></a></div>
                <div id="collapse-block-visibility" class="panel-collapse collapse-block glyphicon-only table collapse out m-0 p-0" aria-expanded="false">
                  <%= render 'hyrax/base/ms_form_visibility_component_for_collection', f: f %>
                </div>
              </div>
            </div>

            <h2>THUMBNAIL</h2>
            <p>Select a media managed by this team to serve as the project thumbnail in lists and search results.</p>
            <% if f.object.persisted? %>
              <%# we're loading these values dynamically to speed page load %>
              <%= f.input :representative_id, label: 'Media ID for Thumbnail', hint: 'Media IDs can be viewed in the Media tab', input_html: { data: { text: f.object.representative_id } } %>
            <% end %>
          </div>
        </div>

        <div class="col-sm-6">
          <div class="content-block">
            <% if @form.persisted? %>
              <% if @collection.brandable? %>
                <%= render 'morphosource/dashboard/collections/details/branding', f: f %>
              <% end %>
            <% end %>
          </div>
        </div>

        <div class="col-sm-12">
          <div>
            <h2><%= t('.temporary_access_links') %></h2>

            <div>
              <% if can? :generate_temporary_link, @presenter.id %>
                <div style="margin-bottom: 2em;">
                  <p>You can use this section to generate a temporary link to share this <%= @presenter.collection_type_title %> and the media contained in it with someone, even if they don't have a MorphoSource account. This link will allow that user to view this <%= @presenter.collection_type_title %> and the media in the <%= @presenter.collection_type_title %>, but not download any media file(s) associated with the media records. You can set how long until this link expires.</p>
                  <div class="row" style="margin-left: unset; padding-left: 10px;">
                    <span style="margin-right: 10px;"><b>Create Temporary Link Valid Until: </b></span>
                    <%= f.date_field :temporary_link_expires_at, value: Date.today + 3.months, class: 'datepicker form-control', style: 'width: 150px; display: inline; margin-right: 10px;', max: '9999-12-31' %>
                    <%= link_to "Generate", main_app.temporary_collection_access_link_create_url(f.object, expires_at: Date.today + 3.months), method: :post, id: 'generate-temporary-collection-access-link', class: 'btn btn-primary' %>
                  </div>
                </div>
              <% end %>

              <% if f.object.model.active_temporary_links.present? %>
                <div>
                  <div class="row" style="margin-left: unset; padding-left: 10px;">
                    <div style="margin-right: 10px;"><b>Active Temporary Access Links:</b></div>
                    <table class="table">
                      <% f.object.model.active_temporary_links.each do |link| %>
                        <tr>
                          <td style="padding-left: 0;">
                            <% link_url = main_app.media_showcase_temporary_link_url(media_id: f.object, token: link.token) %>
                            <%= link_to link_url, link_url, style: 'overflow-wrap: anywhere;' %>
                            <button type="button" class="btn btn-link copy-temporary-collection-link" style="color: black;"
                                    data-clipboard-text="<%= link_url %>"
                                    data-toggle="tooltip" data-placement="bottom"
                                    title="<%= t('hyrax.single_use_links.copy.tooltip') %>">
                              <i class="far fa-copy fa-lg"></i>
                            </button>
                          </td>
                          <td>
                            <div>Expires on <%= link.expires_at.to_date %></div>
                          </td>
                          <td>
                            <% if can? :generate_temporary_link, @presenter.id %>
                              <div><%= link_to "Revoke", main_app.temporary_collection_access_link_destroy_path(link), method: :delete, class: 'btn btn-sm btn-danger' %></div>
                            <% end %>
                          </td>
                        </tr> 
                      <% end %>
                    </table>
                  </div>
                </div>

                <% if can? :generate_temporary_link, @presenter.id %>
                  <div style="margin-bottom: 2em;">
                    <p>You can also revoke all temporary links previously generated by you, which will cause the links to stop working. Others will not be able to use them to access this <%= @presenter.collection_type_title %> any longer.</p>
                    <%= link_to 'Revoke all temporary links', main_app.temporary_collection_access_link_destroy_all_path(f.object), method: :delete, class: 'btn btn-danger', style: "margin-left: 10px;" %>
                  </div>
                <% end %>
              <% else %>
                <p>No active temporary access links exist. <%= @presenter.collection_type_title %> data managers can generate time-limited access links for this <%= @presenter.collection_type_title %> and the media associated with it.
              <% end %>
            </div>
          </div>
        </div>

      </div>

      <%# The following form fields might be needed.  Move them outside of the partial,
       or remove them if not needed %>
      <%= hidden_field_tag :type, params[:type] %>
      <%= hidden_field_tag :stay_on_edit, true %>
      <%= hidden_field_tag :collection_type_gid, @collection.collection_type_gid %>
      <!-- parent_id may be passed from the nested collections controller to allow a subcollection relationship to be added as collection is created -->
      <% if params[:parent_id].present? %>
        <%= hidden_field_tag :parent_id, params[:parent_id] %>
      <% end %>
      <% if params[:batch_document_ids].present? %>
        <% params[:batch_document_ids].each do |batch_item| %>
          <input type="hidden" name="batch_document_ids[]" value="<%= batch_item %>" />
        <% end %>
      <% end %>

      <% end %>
    </div>
  </div>
</div>
