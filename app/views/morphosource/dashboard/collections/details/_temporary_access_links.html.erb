<%# Only for projects, partial for temporary access link management %>
<div class="col-sm-12">
  <div class="content-block">
    <h2><%= t('.temporary_access_links') %></h2>

    <div>
      <div>
        <p><%= t('morphosource.collections.view.temporary_access', collection_type: @presenter.collection_type_title.downcase) %></p>
        <div class="row" style="margin-left: unset; padding-left: 10px;">
          <span style="margin-right: 10px;"><b>Create Temporary Link Valid Until: </b></span>
          <%= f.date_field :temporary_link_expires_at, value: Date.today + 3.months, class: 'datepicker form-control', style: 'width: 150px; display: inline; margin-right: 10px;', max: '9999-12-31' %>
          <%= link_to "Generate", main_app.temporary_collection_access_link_create_url(f.object, expires_at: Date.today + 3.months), method: :post, id: 'generate-temporary-collection-access-link', class: 'btn btn-primary' %>
        </div>
      </div>

      <% if f.object.model.active_temporary_links.present? %>
        <div>
          <div class="row" style="margin-left: unset; padding-left: 10px;">
            <section class="section-collection-sharing">
              <table class="table">
                <thead>
                  <tr>
                    <th style="padding-left: 0">Active Temporary Access Links</th>
                    <th>Generated by</th>
                    <th>Expires on</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                <% f.object.model.active_temporary_links.each do |link| %>
                  <tr>
                    <td style="padding-left: 0;">
                      <% if @collection.team? %>
                        <% link_url = main_app.team_show_temporary_link_url(f.object, token: link.token) %>
                      <% else %>
                        <% link_url = main_app.project_show_temporary_link_url(f.object, token: link.token) %>
                      <% end %>
                      
                      <%= link_to link_url, link_url, style: 'overflow-wrap: anywhere;' %>
                      <button type="button" class="btn btn-link copy-temporary-collection-link" style="color: black; padding: 0;"
                              data-clipboard-text="<%= link_url %>"
                              data-toggle="tooltip" data-placement="bottom"
                              title="<%= t('hyrax.single_use_links.copy.tooltip') %>">
                        <i class="far fa-copy fa-lg"></i>
                      </button>
                    </td>
                    <td><%= link.user.name_or_email %></td>
                    <td><%= link.expires_at.to_date %></td>
                    <td>
                      <% if can? :destroy, link %>
                        <%= link_to "Revoke", main_app.temporary_collection_access_link_destroy_path(link), method: :delete, class: 'btn btn-sm btn-danger' %>
                      <% end %>
                    </td>
                  </tr> 
                <% end %>
                </tbody>
              </table>
            </section>
          </div>
        </div>
      <% else %>
        <p>There are no active temporary access links for this <%= @presenter.collection_type_title.downcase %>.</p>
      <% end %>
    </div>
  </div>
</div>