<%#
  Disable action buttons if the collection has a DOI and the user is not an admin.
%>

<div class="col-12 tab-action-buttons pt-0 d-flex flex-row-reverse" style="gap: 5px;">
  <% if @collection.doi.empty? || current_user.admin? %>
    <%= f.submit t(:'hyrax.collection.select_form.update'), class: 'btn btn-primary', onclick: "confirmation_needed = false;", id: "update_submit", name: "update_collection" %>
    <%= link_to t('hyrax.dashboard.collections.actions.delete_' + @presenter.collection_type_title + '.label'),
              hyrax.dashboard_collection_path(@presenter),
              title: t('hyrax.dashboard.collections.actions.delete_' + @presenter.collection_type_title + '.label'),
              class: 'btn btn-primary btn-delete-collection',
              data: { confirm: t('hyrax.dashboard.collections.actions.delete_' + @presenter.collection_type_title + '.confirmation'),
              method: :delete } %>
  <% else %>
    <div title="<%= t('morphosource.dashboard.collections.media_list.edit.doi_warning') %>" style="display: inline-block;">
      <%= button_tag t(:'hyrax.collection.select_form.update'), class: "btn btn-primary", disabled: true %>
    </div>
    <div title="<%= t('morphosource.dashboard.collections.media_list.edit.doi_warning') %>" style="display: inline-block;">
      <%= button_tag t('hyrax.dashboard.collections.actions.delete_' + @presenter.collection_type_title + '.label'), class: "btn btn-primary", disabled: true %>
    </div>
  <% end %>
</div>