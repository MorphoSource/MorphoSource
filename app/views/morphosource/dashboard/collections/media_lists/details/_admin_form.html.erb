<% if current_user.admin? %>
  <div class="form-group xadmin-preview-mode-container" style="margin-bottom:15px; margin-top: 30px;">
    <h2>Admin Settings</h2>
    <div style="padding: 2px 10px;">
      <%= button_to "Mint DOI",
        media_list_mint_doi_path(@collection),
        method: :post,
        data: { confirm: "Are you sure you want to mint a DOI for this media list?" },
        class: "btn btn-primary" %>
    </div>
  </div>
<% end %>