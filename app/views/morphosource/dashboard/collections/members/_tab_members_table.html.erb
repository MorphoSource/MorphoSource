<%# taken from form_share_table.html.erb %>
<% group_name = access.dup.concat("_group") %>
<% group = @collection.send(group_name) %>

<h3><%= t("hyrax.dashboard.collections.form_members_table.#{access}.title") %></h3>
<p><%= t("hyrax.dashboard.collections.form_members_table.#{access}.help") %></p>

<% if group.users.count > 0 %>
  <table class="table table-striped share-status">
    <thead>
      <tr>
        <th></th>
        <th>Name</th>
        <th>Email</th>
        <th>Edit or Remove Access</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% group.users.each do |user| %>
        <tr>
          <td class="icon"><i class="material-icons">account_circle</i></td>
          <td style="width:30%;"><%= user.display_name %></td>
          <td style="width:30%;"><%= user.email %></td>
          <% if @collection.parent? && @collection.first_parent.group_members.include?(user) %>
           <td style="width:20%;">Update Access From Parent</td>
           <td style="width:20%;"></td>
          <% else %>
          <%= form_with(method: :post, url: main_app.update_collection_groups_path(@collection), html: { id: 'user-participants-form' }) do |f| %>
            <% if access == 'managers' && group.users.count < 2 %>
              <td style="width:20%;">
                <%= f.select 'collection_roles[new_access]', {}, { prompt: t('.select_a_role') }, disabled: true, class: 'form-control' %>
              </td>
              <td style="width:10%;">
                <%= submit_tag 'Update', class: 'btn btn-info edit-collection-add-user-sharing-button', disabled: true %>
              </td>
            <% else %>
              <td style="width:20%;">
                <%= f.select 'collection_roles[new_access]', ms_edit_access_options(access), { prompt: t('.select_a_role') }, class: 'form-control select-edit-access' %>
                <%= f.hidden_field_tag('collection_roles[agent_type]', 'user') %>
                <%= f.hidden_field_tag('collection_roles[agent_id]', user.ms_id) %>
                <%= f.hidden_field_tag('collection_roles[access]', access) %>
              </td>
              <td style="width:20%;">
                <%= submit_tag 'Update', class: 'btn btn-info edit-collection-add-user-sharing-button', disabled: true %>
              </td>
            <% end %>
          <% end %>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p><em><%= t("hyrax.dashboard.collections.form_members_table.#{access}.empty") %></em></p>
<% end %>
