<% provide :page_title, construct_page_title( t('hyrax.dashboard.collections.edit.header', type_title: @collection.collection_type.title, title: @collection.title.first) ) %>

<!-- create simple_form here to include update button above nav tabs -->
<%= simple_form_for @form, url: collection_form_url(@form), wrapper: :showcase_default, html: { class: 'editor' } do |f| %>
  <div style="margin-top:30px;">
    <div>
      <%= render 'hyrax/base/flash_msg' %>
      <% content_for :body_css_classes do %>showcase showcase-edit teams ms-collection-edit<% end %>

      <div class="col-xs-9 no-horizontal-padding title team-title">
        <div>
          <span class="fa fa-edit" aria-hidden="true"></span>
          <h1 style="margin-bottom:20px;"><%= @collection.title.first %>
            <%= @presenter.collection_type_badge %>
            <%= @presenter.id_badge %>
            <%= @presenter.permission_badge %>
          </h1>
        </div>
        <div>
          <%= f.submit t(:'hyrax.collection.select_form.update'), class: 'btn btn-primary', onclick: "confirmation_needed = false;", id: "update_submit", name: "update_collection" %>
          <%= link_to "Public View", collection_media_path(@collection), class: 'btn btn-primary' %>
        </div>
      </div>

      <div class="panel panel-default panel-borders tabs teams" id="collection-edit-controls">
        <%= render 'nav_tabs' %>
        
        <%# Instead of panel-body div, use container-fluid to support row with cols %>
        <div class="container-fluid mb-1">
          <div class="row no-horizontal-padding">
            <div class="col-sm-12">
              <h2 style="margin-top: 15px;">ORGANIZATION PERMISSION DEFAULTS</h2>
            </div>

            <!-- left column -->
            <div class="col-sm-6">
              <%= render 'morphosource/dashboard/collections/permissions/organization_permission_defaults', f: f %>
            </div>

            <!-- right column -->
            <div class="col-sm-6">
              <%= render 'morphosource/dashboard/collections/permissions/organization_permission_admin_settings', f: f %>

              <% end %> <!-- end simple_form_for before creating new form in remote_file_permissions -->

              <% if current_user.admin? %>
                <div class="form-group">
                  <div class="block-fill block-padding">
                    <h2 class="mt-0">Remote File Submission Settings</h2>
                    <%= render 'morphosource/dashboard/collections/permissions/remote_file_permissions' %>
                  </div>
                </div>
              <% end %>
            </div><!-- /right column -->
          </div>
        </div>
      </div>    
    </div>
  </div>
</div>

