<div id="organization-permissions">
  <% if @collection.team? %>
    <div class="form-group row">
      <div class="col-xs-6 showcase-label">
        <label class="control-label" for="">Organization</label>
      </div>
      <div class="col-xs-6 showcase-value">
        <%= link_to(@organization.title.first, collection_about_path(@collection)) %>
      </div>
    </div>
  <% end %>
  <div class="form-group row">
    <div class="col-xs-6 showcase-label">
      <label class="control-label" for="">Institution</label>
    </div>
    <div class="col-xs-6 showcase-value">
      <%= @organization.institution_name.first %>
    </div>
  </div>
  <div class="mb-2" style="padding-left: 8px;">
    <span>
      <%= t('morphosource.dashboard.collections.permissions.info').html_safe %>
    </span>
  </div>
  <!-- These fields are used in Team - linked organization
  Labels and hints are in config/locales/media_permissions -->

  <!-- Data manager non-interactive -->
  <% if @collection.team? %>
    <div class="form-group row mb-2">
      <div class="col-xs-6 showcase-label">
        <label class="control-label select optional" for="data_manager">Data manager</label>
        <i class="material-icons tooltip-icon" data-original-title="" title="">
          <p class="hint hide">
            <%= t('simple_form.hints.defaults.data_manager') %>
          </p>
        </i>
      </div>
      <div class="col-xs-6 showcase-value">
        <%= @collection.organization.data_manager&.first.present? ?
          User.find_by_user_key(@collection.organization.data_manager&.first).name_and_email :
          'None selected. <a href="mailto:morphosource@duke.edu">Contact us</a> to change.'.html_safe
        %>
      </div>
    </div>
  <% end %>

  <div class="mb-2 mt-2">
    <%= render_edit_field_partial('download_permission', f: f, org_permissions: true, placeholder: 'No preference') %>
    <%= render_edit_field_partial('download_reviewer', f: f, placeholder: 'No preference') %>
  </div>

  <div class="mb-2">
    <span id="placeholder-text" style="display: none;">No preference</span>
    <%= render_edit_field_partial('rights_holder_with_blank', f: f, placeholder: 'No preference') %>
    <%= render_edit_field_partial('rights_statement_with_blank', f: f, placeholder: 'No preference') %>
    <%= render_edit_field_partial('license_with_blank', f: f, placeholder: 'No preference') %>
  </div>

  <div class="mb-2">
    <%= render_edit_field_partial('morphosource_use_agreement_type', f: f, placeholder: 'No preference') %>
    <%= render_edit_field_partial('permits_commercial_use', f: f, placeholder: 'No preference') %>
    <%= render_edit_field_partial('permits_3d_use', f: f, placeholder: 'No preference') %>
    <%= render_edit_field_partial('required_archival_of_published_derivatives', f: f, placeholder: 'No preference') %>
  </div>

  <div class="mb-2">
    <%= render_edit_field_partial('agreement_uri', f: f, placeholder: 'No preference') %>
  </div>
</div><!-- /organization-permissions -->