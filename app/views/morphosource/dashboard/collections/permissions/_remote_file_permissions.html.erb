<% if current_user.admin? %>
  <%= simple_form_for @form,
      url: collection_form_url(@form),
      wrapper: :showcase_default,
      html: { id: 'remote-file-permissions', class: 'remote-file-permissions' } do |k| %>

    <%= render_edit_field_partial('can_submit_remote_files', f: k) %>

    <div class="form-group">
      <div class="row allowed-remote-source-wrapper <%= @form.can_submit_remote_files == "Yes" ? "" : "hide" %>">
        <div class="col-6 showcase-label">
        <%= k.label :allowed_remote_source, t("morphosource.dashboard.profiles.edit_primary.allowed_remote_source").html_safe %>
        </div>
        <div class="col-6 showcase-value">
          <%= k.text_area :allowed_remote_source,
          cols: 30,
          rows: 4,
          class: "form-control",
            placeholder: 'wwww.example1.com
  www.example2.com' %>
        </div>
      </div>
    </div>
    <div class="text-center mt-2">
      <% if @form.can_submit_remote_files == "Yes" %>
        <%= k.submit 'Update Remote Settings', class: 'btn btn-sm btn-save-remote-file-settings' %>
      <% else %>
        <%= k.submit 'Update Remote Settings', class: 'btn btn-sm btn-save-remote-file-settings', disabled: !current_user.admin? %>
      <% end %>
    </div>
    <%= hidden_field_tag :update_remote_file_submission_settings, true %>

  <% end %>
<% end %>