<%# taken from _ms_linked_organization.html %>

<!-- TODO: removing form tags below makes add group form hit the collections controller - needs more investigation -->
<form></form>

<% if @current_user.admin? %>
  <div class="form-add-organization-wrapper col-sm-6" style="width:100%;">
    <div class="form-inline add-sharing-form sharing-row-form" style="display:flex;">
      <% if @collection.organization %>
        <%= simple_form_for @collection,
            url: main_app.dashboard_collection_unlink_organization_path,
            method: 'post',
            html: { id: 'remove-organization-form' } do |f| %>
          <%= submit_tag 'Remove organization', class: 'btn btn-sm btn-default' %>
        <% end %>
      <% else %>
        <%= simple_form_for @collection,
            url: main_app.dashboard_collection_link_organization_path,
            method: 'post',
            html: { id: 'add-organization-form' } do |f| %>
            <%= render_edit_field_partial('organization', f: f) %>
            <%= submit_tag 'Link to organization', class: 'btn btn-sm btn-default', style: 'margin-left:10px;' %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

<div class="col-sm-6">
<% if @presenter.collection_type.machine_id == 'team' %>
  <h2>ORGANIZATION</h2>
  <% if @organization_presenter %>
    <%= @organization_presenter.attribute_to_html(:title, label: 'Name', render_as: :showcase_default, include_empty: true, html_dl: false) %>
    <%= @organization_presenter.attribute_to_html(:institution_name, label: 'Institution', render_as: :showcase_default, include_empty: false, html_dl: false) %>
    <%= @organization_presenter.attribute_to_html(:institution_code, label: 'Institution code', render_as: :showcase_default, include_empty: false, html_dl: false) %>
    <%= @organization_presenter.attribute_to_html(:collection_code, label: 'Collection code', render_as: :showcase_default, include_empty: false, html_dl: false) %>
    <%= @organization_presenter.attribute_to_html(:description, label: 'Description', render_as: :showcase_default, include_empty: false, html_dl: false) %>
    <%= @organization_presenter.attribute_to_html(:related_url, label: 'Related URL', render_as: :showcase_default, include_empty: false, html_dl: false) %>
    <%= @organization_presenter.attribute_to_html(:address, label: 'Address', render_as: :showcase_default, include_empty: false, html_dl: false) %>
    <%= @organization_presenter.attribute_to_html(:city, label: 'City', render_as: :showcase_default, include_empty: false, html_dl: false) %>
    <%= @organization_presenter.attribute_to_html(:state_province, label: 'State/Province', render_as: :showcase_default, include_empty: false, html_dl: false) %>
    <%= @organization_presenter.attribute_to_html(:postal_code, label: 'Postal Code', render_as: :showcase_default, include_empty: false, html_dl: false) %>
    <%= @organization_presenter.attribute_to_html(:country, label: 'Country', render_as: :showcase_default, include_empty: false, html_dl: false) %>
  <% else %>
    <p>No organization linked</p>
  <% end %>

  <% if @collection.organization %>
    <h2>ORGANIZATION PERMISSION DEFAULTS</h2>
    <%= render 'ms_form_organization' %>
  <% end %>
<% end %>
</div>

<div class="col-sm-6">
  <h2>TEAM STATISTICS</h2>
  <div class="row">
    <div class="col-xs-6 showcase-label">Number of media in team</div>
    <div class="col-xs-6 showcase-value "><%= @media_count %></div>
  </div>
  <div class="row">
    <div class="col-xs-6 showcase-label">Number of media in organization</div>
    <div class="col-xs-6 showcase-value "><%= @org_media_count %></div>
  </div>
  <div class="row">
    <div class="col-xs-6 showcase-label">Number of represented specimens</div>
    <div class="col-xs-6 showcase-value "><%= @specimen_count %></div>
  </div>
  <div class="row">
    <div class="col-xs-6 showcase-label">Number of represented cultural heritage objects</div>
    <div class="col-xs-6 showcase-value "><%= @cho_count %></div>
  </div>
  <div class="row">
    <div class="col-xs-6 showcase-label">Organization views</div>
    <div class="col-xs-6 showcase-value ">(Not yet implemented)</div>
  </div>
  <div class="row">
    <div class="col-xs-6 showcase-label">Number of media downloads</div>
    <div class="col-xs-6 showcase-value ">(Not yet implemented)</div>
  </div>
</div>
