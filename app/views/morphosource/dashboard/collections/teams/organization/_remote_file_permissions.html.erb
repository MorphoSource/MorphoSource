<%= simple_form_for @form, 
    url: collection_form_url(@form),  
    wrapper: :showcase_default, 
    html: { id: 'remote-file-permissions', class: 'remote-file-permissions' } do |k| %>

  <%= render_edit_field_partial('can_submit_remote_files', f: k) %>

  <div class="form-group row">
    <div class="allowed-remote-source-wrapper <%= @form.can_submit_remote_files == "Yes" ? "" : "hide" %>">
      <div class="col-xs-6 showcase-label">
      <%= k.label :allowed_remote_source, t("morphosource.dashboard.profiles.edit_primary.allowed_remote_source").html_safe %>
      </div>
      <div class="col-xs-6 showcase-value">
        <%= k.text_area :allowed_remote_source, 
        cols: 30, 
        rows: 4, 
        class: "form-control", 
          placeholder: 'wwww.example1.com
www.example2.com' %>
      </div>
    </div>
  </div>
  <div class="text-center mt-1">
  <% if @form.can_submit_remote_files == "Yes" %>
    <%= button_tag 'Update Remote File Submission Settings', type: 'button', class: 'btn btn-sm btn-save-remote-file-settings' %>
  <% else %>
    <%= button_tag 'Update Remote File Submission Settings', type: 'button', class: 'btn btn-sm btn-save-remote-file-settings', disabled: !current_user.admin? %>
  <% end %>
  </div>
  <%= hidden_field_tag :update_remote_file_submission_settings, true %>

  <%# The following form fields might be needed.  Move them outside of the partial,
   or remove them if not needed %>
  <%= hidden_field_tag :type, params[:type] %>
  <%= hidden_field_tag :stay_on_edit, true %>
  <%= hidden_field_tag :collection_type_gid, @collection.collection_type_gid %>
  <!-- parent_id may be passed from the nested collections controller to allow a subcollection relationship to be added as collection is created -->
  <% if params[:parent_id].present? %>
    <%= hidden_field_tag :parent_id, params[:parent_id] %>
  <% end %>

<% end %>