<!-- keep -->
<ul class="nav nav-tabs" role="tablist">
  <li role="presentation" class=<%= active_tab?(:media) %> >
    <a href=<%= dashboard_media_tab_url(@collection) %> aria-controls="media" role="tab">
    <i class="fa fa-cube" aria-hidden="true"></i> MEDIA
    </a>
  </li>
  <% if @specimen_count > 0 %>
    <li role="presentation" class=<%= active_tab?(:specimens) %>>
      <a href=<%= dashboard_specimens_tab_url(@collection) %> aria-controls="biological_specimens" role="tab">
        <i class="fas fa-frog" aria-hidden="true"></i> SPECIMENS
      </a>
    </li>
  <% end %>
  <% if @cho_count > 0 %>
    <li role="presentation" class=<%= active_tab?(:chos) %>>
      <a href=<%= dashboard_chos_tab_url(@collection) %> aria-controls="biological_specimens" role="tab">
        <i class="ms2-icon-bowl icon-bowl" aria-hidden="true"></i> CULTURAL HERITAGE OBJECTS
      </a>
    </li>
  <% end %>
  <li role="presentation" class=<%= active_tab?(:details) %>>
    <a href=<%= dashboard_about_tab_url(@collection) %> aria-controls="biological_specimens" role="tab">
      <i class="fa fa-newspaper" aria-hidden="true"></i> DETAILS
    </a>
  </li>
  <li role="presentation" class=<%= active_tab?(:members) %>>
    <a href=<%= dashboard_members_tab_url(@collection) %> aria-controls="members" role="tab">
      <i class="fas fa-users-cog" aria-hidden="true"></i> MEMBERS
    </a>
  </li>
</ul>
