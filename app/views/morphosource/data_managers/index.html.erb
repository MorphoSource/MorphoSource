<div id="search">
  <%= render 'search_form' %>
  <h1>Data Managers - Users and Organizations</h1>
</div>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Avatar</th>
            <th>Name</th>
            <th>Department/Institution</th>
            <th>Organization Managers</th>
            <th>Account Created</th>
            <th>Media Managed</th>
        </tr>
    </thead>
    <tbody>
    <%= render partial: 'user_row', collection: @users, as: :user %>
    </tbody>
</table>
<div class="pager">
  <%= paginate @users, theme: 'blacklight', route_set: main_app %>
</div>