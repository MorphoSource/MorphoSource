<div class="table-responsive" id="documents">
  <table class="table table-striped works-list itemtable teams-projects">
  <thead>
    <tr>
      <%= render 'list_headers' %>
    </tr>
  </thead>
  <tbody>
    <% @items.each_with_index do |item, counter| %>
      <%= render 'list_item', item: item, counter: counter %>
    <% end %>
  </tbody>
</table>
<% if @items.blank? %>
  <div class="itemtable-empty-state text-center text-muted">
    <i class="fas fa-folder-open" aria-hidden="true"></i>
    <p><%= empty_state_message || "No #{(entry_name || @items.entry_name(count: 0)).pluralize} found." %></p>
  </div>
<% end %>
</div>
