<div class="row record-padding paginate-wrapper itemtable float-left">
	<div class="col-12">
		<% if @items.present? %>
			<div id="per_page-dropdown" class="btn-group">
				<button type="button" class="btn-sm dropdown-toggle" data-toggle="dropdown" aria-expanded="false">
					<%= selected = params[:rows] || Hyrax.config.teams_show_work_item_rows %> per page <span class="caret"></span>
				</button>
				<ul class="dropdown-menu" role="menu">
					<% Hyrax.config.teams_rows_per_page_range.each do |rows| %>
						<li role="menuitem">
							<%= link_to(url_for(request.params.merge(rows: rows))) do %>
								<%= rows %><span class="sr-only"> per page</span>
							<% end %>
						</li>
					<% end  %>
				</ul>
			</div>
		<% end %>
		<% if @items.present? %>
			<div class="paginate-info">Showing <%= page_entries_info @items, entry_name: entry_name %></div>
			<%= paginate @items, outer_window: 2, theme: 'blacklight', param_name: :page, class: 'btn-group' %>
		<% end %>
	</div>
</div><!-- /row -->
