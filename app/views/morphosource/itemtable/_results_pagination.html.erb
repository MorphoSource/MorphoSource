<div class="row record-padding paginate-wrapper">

	<div class="col-md-12 col-lg-2">
	  <%= form_tag '', method: :get, :id => 'rows_per_page' do %>
	    <div class="select-tag">
	      Rows per page <%= select_tag :rows, options_for_select(Hyrax.config.teams_rows_per_page_range, selected: params[:rows] || Hyrax.config.teams_show_work_item_rows), onchange: "$('#rows_per_page').submit();" %> 
	    </div>
		<%= hidden_field_tag(:page, params[:page]) if params[:page].present? %>
		<%= hidden_field_tag(:sort, params[:sort]) if params[:sort].present? %>
	  <% end %>
	</div>

	<div class="col-md-12 col-lg-2">
		<div>Showing <%= page_entries_info @items %></div>
	</div>

	<div class="col-md-12 col-lg-8">
		<%= paginate @items, outer_window: 2, theme: 'blacklight', param_name: :page %>
	</div>

</div><!-- /row -->
