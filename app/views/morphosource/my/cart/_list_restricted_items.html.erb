<tr id="document_<%= document.id %>">

  <td>
    <label for="batch_document_<%= document.id %>" class="sr-only"><%= t("hyrax.dashboard.my.sr.batch_checkbox") %></label>
    <%= render 'morphosource/batch_select/cart_restricted_add_button', item: item %>&nbsp;
  </td>

  <td>
    <%= link_to [main_app, document], class: 'media-left', 'aria-hidden' => true do %>
      <%= render_thumbnail_tag document, { class: 'hidden-xs file_listing_thumbnail' }, { suppress_link: true } %>
    <% end %>
  </td>
  <td>
    <%= link_to [main_app, document], class: 'media-left', 'aria-hidden' => true do %>
      <%= document.id %>
    <% end %>
  </td>
  <td>
    <div class='media'>
      <div class='media-body'>
        <div class='media-heading'>

          <%= link_to [main_app, document], id: "src_copy_link#{document.id}", class: 'document-title' do %>
            <span class="sr-only">
              <%= t("hyrax.dashboard.my.sr.show_label") %>
            </span>
            <%= document.title_or_label %>
          <% end %>
          <br />
        </div>
      </div>
    </div>
  </td>
<% if document["media_physical_object_type_ssim"]&.first == "Biological Specimen" %>  
 <td class="break-all"><%= link_to document["physical_object_title_ssim"]&.first, main_app.hyrax_biological_specimen_path(document["physical_object_id_ssim"]&.first) %></td>
 <td><%= document["taxonomy_tesim"]&.first %></td>
<% elsif document["media_physical_object_type_ssim"] == ["Cultural Heritage Object"] %>  
 <td class="break-all"><%= link_to document["physical_object_title_ssim"]&.first, main_app.hyrax_cultural_heritage_object_path(document["physical_object_id_ssim"]&.first) %></td>
 <td><%= document["short_description_tesim"]&.first %></td>
<% end %> 
  <td class="date"><%= item.created_at.strftime("%Y-%m-%d") %></td>
  <td><%= item_status_label(item) %></td>
  <td><%= item.use %></td>
  <td><%= item.reviewer_names %></td>
  <td><%= item_action_button(item) %></td>
  <%= render 'morphosource/my/cart/download_agreements_container', presenter: presenter, item_id: item.id %>
</tr>
