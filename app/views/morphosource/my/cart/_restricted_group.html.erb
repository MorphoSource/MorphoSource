<table class="table table-striped works-list restricted">
  <caption class="sr-only"><%= t("hyrax.dashboard.my.sr.listing") %> <%= application_name %></caption>
  <thead>
  <tr>
    <th class="check-all"><label for="check_all" class="sr-only"><%= t("hyrax.dashboard.my.sr.check_all_label") %></label><%= render 'morphosource/batch_edits/check_all_restricted' %></th>
    <th></th>
    <th class="text-uppercase"><%= t("hyrax.dashboard.my.heading.id") %></th>
    <th><%= t("hyrax.dashboard.my.heading.title") %></th>
    <th><%= t("hyrax.dashboard.my.heading.object") %></th>
    <th><%= t("hyrax.dashboard.my.heading.taxonomy_or_description") %></th>
    <th><%= t("hyrax.dashboard.my.heading.date_uploaded") %></th>
    <th><%= t("hyrax.dashboard.my.heading.status") %></th>
    <th><%= t("hyrax.dashboard.my.heading.intended_use") %></th>
    <th><%= t("hyrax.dashboard.my.heading.reviewers") %></th>
    <th><%= t("hyrax.dashboard.my.heading.Action") %></th>
  </tr>
  </thead>
  <tbody>
    <% @paginated_restricted_items.each_with_index do |item, counter| %>
      <% document = solr_doc_find(item.work_id) %>
      <% if document.present? %>
        <%= render 'morphosource/my/cart/list_restricted_items', document: document, counter: counter, item: item, presenter: Hyrax::MediaPresenter.new(document, current_ability) %>
      <% end %>
    <% end %>
  </tbody>
</table>
