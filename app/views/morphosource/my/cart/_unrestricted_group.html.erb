<table class="table table-striped works-list">
  <caption class="sr-only"><%= t("hyrax.dashboard.my.sr.listing") %> <%= application_name %></caption>
  <thead>
  <tr>
    <th class="check-all"><label for="check_all" class="sr-only"><%= t("hyrax.dashboard.my.sr.check_all_label") %></label><%= render 'morphosource/batch_edits/check_all_unrestricted' %></th>
    <th style="width: 20%;"><%= t("hyrax.dashboard.my.heading.title") %></th>
    <th><%= t("hyrax.dashboard.my.heading.date_uploaded") %></th>
    <th>Approved</th>
    <th>Expires</th>
    <th>Action</th>
  </tr>
  </thead>
  <tbody>
    <% @paginated_unrestricted_items.each_with_index do |item, counter| %>
      <% document = SolrDocument.find(item.work_id) %>
      <%= render 'morphosource/my/cart/list_works', document: document, counter: counter, item: item, presenter: Hyrax::MediaPresenter.new(document, current_ability) %>
    <% end %>
  </tbody>
</table>
