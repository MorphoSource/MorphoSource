<table id="collections-list-table" class="table table-striped collections-list-table">
  <caption class="sr-only"><%= t("hyrax.dashboard.my.sr.listing") %> <%= application_name %></caption>
  <thead>
  <tr>
    <!-- data-orderable='false' prevents jquery ordering of dataTable -->
    <th class="no-sort" data-orderable="false">&nbsp;<!-- thumbnail column --></th>
    <th data-orderable="false"><%= sortable_table_header(t("hyrax.dashboard.my.heading.title"), 'title_si')  %></th>
    <th data-orderable="false"><%= t("morphosource.collections.my.organizations.headings.media") %></th>
    <th data-orderable="false"><%= t("morphosource.collections.my.organizations.headings.device_media") %></th>
    <th data-orderable="false"><%= sortable_table_header(t("hyrax.dashboard.my.heading.last_modified"), 'date_modified_dtsi') %></th>
    <th data-orderable="false"><%= t("hyrax.dashboard.my.heading.membership") %></th>
    <th data-orderable="false">&nbsp;<!-- actions --></th>
  </tr>
  </thead>
  <tbody>
    <% docs.each_with_index do |document, counter| %>
      <% collection_presenter = Morphosource::Collections::OrganizationPresenter.new(document, current_ability, nil) %>
      <%= render 'morphosource/my/collections/organizations/list_collections', collection_presenter: collection_presenter, counter: counter, document: document %>
    <% end %>
  </tbody>
</table>
