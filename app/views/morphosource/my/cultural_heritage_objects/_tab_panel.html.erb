<div role="tabpanel" class="tab-pane" id="cultural_heritage_objects">
  <div class="form-tab-content">
  <% if @collection_cho_groups.present? %>
    <%= render 'cho_filters' %>
    <div class="row">
      <!-- Search bar -->
      <div class="col-xs-6">
        <%= render 'search_form', tab: "cultural_heritage_objects" %>
      </div>
      <div class="col-xs-6">
        <%= render 'sort_and_per_page_cho' %>
      </div>
    </div>
    <%#= render 'tab_cho' %>
    <%= render_async cho_tab_url, event_name: "cho-loaded" do %>
      <div class="ui-loading-whole-page" style="height:200px"></div>
    <% end %>
  <% end %>
  </div>
</div>
