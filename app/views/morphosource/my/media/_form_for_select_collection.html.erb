<% 
# For Media & Objects page, check if user has any collections (user_collection) that the user can add media to
# For add media to collection page, collection (@collection) is already selected in previous page, therefore no need to check
if controller.controller_name == "media" && user_collections.blank?
  no_collections_can_be_added = true
else
  no_collections_can_be_added = false
end
%>
<div role="dialog" class="modal collection-list-modal fade" id="collection-list-container" tabindex="-1" aria-labelledby="col_add_title">
  <div class="modal-dialog text-left">
      <div class="modal-content">
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
          <span class="modal-title" id="col_add_title"><%= t("hyrax.collection.select_form.title") %></span>
        </div>
        <div class="modal-body">
          <% if no_collections_can_be_added %>
            <em> <%= t("hyrax.collection.select_form.no_collections") %></em><br /><br /><br /><br />
          <% else %>
            <div class="collection-list">
              <fieldset>
              <ul>
                <% if @collection.present? %>
                  <div class="add-works">
                    The selected media will be added to:
                    <%= text_field_tag 'member_of_collection_label', @collection.title.first, disabled: true %>
                    <%= hidden_field_tag 'member_of_collection_ids', @collection.id %>
                  </div>
                <% else %>
                  <legend><%= t("hyrax.collection.select_form.select_heading") %></legend>
                  <%= text_field_tag 'member_of_collection_ids', nil,
                              prompt: :translate,
                              data: {
                                placeholder: t('simple_form.placeholders.defaults.member_of_collection_ids'),
                                autocomplete: 'collection',
                                'autocomplete-url' => find_collection_autocomplete_url
                              } %>
                <% end %>
              </ul>
              </fieldset>
            </div><!-- collection-list -->
          <% end %> <!-- else -->
        </div>
        <div class="modal-footer-center">
          <% unless no_collections_can_be_added %>
            <%= render 'hyrax/dashboard/collections/button_for_update_collection', label: t("hyrax.collection.select_form.update"), collection_id: 'collection_replace_id' %>
          <% end %>
          <button type="button" class="btn btn-default" data-dismiss="modal"><%= t("hyrax.collection.select_form.close") %></button>
        </div>
      </div><!-- /.modal-content -->
  </div><!-- /.modal-dialog -->
</div><!-- /.modal -->
