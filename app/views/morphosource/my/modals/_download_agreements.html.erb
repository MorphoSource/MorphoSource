<div class="modal fade" id="downloadAgreementsModal" tabindex="-1" role="dialog" aria-labelledby="requestModalLabel" aria-hidden="true">

  <div class="modal-dialog modal-wide">
    <div class="modal-content">

      <% 
      key = media.present? ? media.access_control_id : "" 
      %>
      <%= form_for current_user,
                 url: main_app.media_download_path,
                 method: :get,
                 html: { id: 'download-form', class: 'download-single', multipart: true } do |f| %>
      <%= hidden_field_tag 'key[]', key %>
      <%= hidden_field_tag 'token[]', current_user.token %>
      <%= hidden_field_tag 'usage', "" %>
      <%= hidden_field_tag 'usage_list', "" %>

      <%= render 'morphosource/my/modals/download_agreements_body', f: f %>

      <% end # /form %>

    </div><!-- /.modal-content -->
  </div><!-- /.modal-dialog -->
</div><!-- /.modal -->
