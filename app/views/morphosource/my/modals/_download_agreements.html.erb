            </label>
          </div>
        </div>
      </div>
      <div class="modal-footer">
          <input type="button" name="download" value="Download" class="btn btn-info" id="modal-download" disabled="disabled" />
      </div>
    </div><!-- /.modal-content -->
  </div><!-- /.modal-dialog -->
</div><!-- /.modal -->
