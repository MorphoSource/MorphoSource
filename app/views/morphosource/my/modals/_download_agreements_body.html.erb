      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal"><span id="close-modal" aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
        <h2>Download Usage</h2>
      </div>
      <div class="modal-body">

        <label id="describe-usage">Please describe your intended usage:</label>
        <textarea id="custom-usage" rows="3" class="w-100"></textarea>
        <i id="char-alert">50 characters minimum: <span id="rchars">0</span></i>

        <p style="margin-top:20px"><label id="select-categories">Please select one or more categories that match your intended usage:</label></p>
        <div class="row">
          <div class="col-xs-12">
            <% if current_user.intent.present? %>
              <label class="switch">
                <input id="get-profile-intent" type="checkbox" /> 
                <span class="slider round"></span>
              </label>
              <label class="switch-label">Use the information from my user profile to fill in the intended use categories.</label>
            <% else %>
              <p><i>In the future, if you complete the Intended Use section of your User Profile, you can finish this section with one easy click.</i></p>
            <% end %>
          </div>
        </div>
        <div class="checkbox-form-group row">


              <div class="profile-checkbox-list">
                <% intended_use = Morphosource::UserProfile::CheckboxValues::INTENT %>
                <% intended_use.each do |use| %>
                  <div class="col-xs-12 col-sm-6">
                  <%= f.check_box 'intent', { multiple: true, checked: (current_user.intent.include? use) }, use, false %>
                  <%= f.label :intent, use, :class => 'cb' %>
                  </div>
                <% end %>
                <div class="col-xs-12 col-sm-6">
                  Other: <%= f.text_field 'intent', { multiple: true, value: current_user.other_intent } %>
                </div>
              </div>


        </div>


        <div class="agreement-content">
          <p>To download the selected media, you must agree to the following download agreements. Please review these agreements and familiarize yourself with any restrictions on media use included in them. Other restrictions or provisions may apply to media use, reuse, citation, or other factors. Please see specific media pages for all permission details.</p>
          <div class="agreement-items-wrapper">
            <!-- items filled by js -->
          </div>
          <div class="checkbox">
            <label>
              <input type="checkbox" id="modal-agree" name="modal-agree" />
              <b>I agree to all terms and conditions of use for this data as specified in the agreement(s) above and in any licenses associated with the data.</b>
            </label>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <div class="col-sm-6">
          <%= recaptcha_tags %>
        </div>
        <div class="col-sm-6">
          <input data-download-item-id="" type="submit" name="download" value="Download Media" class="btn btn-info" id="modal-download" disabled="disabled" />
        </div>
      </div>
