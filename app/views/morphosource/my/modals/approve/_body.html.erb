<div class="modal-body exp-date-wrapper">
  <%= bootstrap_form_tag url: main_app.approve_download_path, method: :put, id: 'modal-form', :class => "form-horizontal" do  |f| %>
    <%= f.date_field :expiration_date, label: "Expiration Date", value: Date.today.next_year, class: "datepicker form-control", max: "9999-12-31" %>
</div>
<div class="modal-footer">
  <button type="button" id="modal-cancel" class="btn btn-danger" data-dismiss="modal">Cancel</button>
    <%= f.submit_tag "Submit", name: 'exp-date-submit', class: "btn btn-success" %>
  <% end %>
</div>
