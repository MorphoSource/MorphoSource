<%# modal partial for cart / request page %>
<div class="modal-body">
  <%= form_tag(main_app.request_item_path, method: :put, id: 'request-download-form', "data-behavior" => 'batch-select-all', :class => "form-horizontal") do %>

  <div class="download-items-wrapper hide">
    <%# this div is a container for storing the user selected download items 
        (see sendSelectedRestrictedItemsToModal js method) %>
  </div>

  <%= render 'morphosource/my/modals/request/form_fields' %>
</div>
<div class="modal-footer">
  <input type="submit" name="request-download" value="Request Download" class="btn btn-lg btn-info" id="modal-request-download" disabled="disabled" />
  <% end %>
</div>
