<%# modal partial for media show page %>
<div class="modal-body">
  <%= form_tag(main_app.request_work_path, method: :post, id: 'request-download-form', "data-behavior" => 'batch-select-all', :class => "form-horizontal") do %>
  <%= hidden_field :work_id, params[:work_id], value: @curation_concern.id %>
  <%= render 'morphosource/my/modals/request/form_fields' %>
</div>
<div class="modal-footer">
  <input type="submit" name="request-download" value="Request Download" class="btn btn-lg btn-info" id="modal-request-download" disabled="disabled" />
  <% end %>
</div>
