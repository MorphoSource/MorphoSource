<div class="user-wrapper">
  <% get_requester_items(@items,requester) %>
  <div class="user-title">

    <h3><%= requester_title(requester) %> ( <%= @requester_items.count %> items )
      <a aria-label="collapse/expand" data-toggle="collapse" href="#collapse-block" class="btn collapse-block"><span class="glyphicon glyphicon-triangle-bottom collapse-block"></span></a>
    </h3>
    <div id="collapse-block" class="panel-collapse collapse-block glyphicon-only table collapse" aria-expanded="false">
      <div class="text-left">
        <div class="col-xs-3 showcase-label">Organization</div><div class="col-xs-9 showcase-value"><%= requester.affiliation %></div><br />
        <div class="col-xs-3 showcase-label">Department:</div><div class="col-xs-9 showcase-value"><%= requester.department %></div><br />
        <div class="col-xs-3 showcase-label">Profession</div>
        <div class="col-xs-9 showcase-value">
        <%= render partial: 'morphosource/my/request_manager/list_requester_demographics', collection: requester.demographics, as: :dem %>
        </div>
      </div>
    </div>
  </div>

  <div class="requests-wrapper">
    <% if @tab == 'new' %>
      <div class="check-all-div">
        <%= check_box_tag 'check_all_div', 'no', false, class: 'check_all_user' %>
        <span>Select All Media for This User</span>
      </div>
    <% elsif @tab == 'previous' %>
      <div class="check-all-div">
        <% if editable_items(@requester_items).count > 0 %>
          <%= check_box_tag 'check_all_div', 'no', false, class: 'check_all_user' %>
          <span>Select All Editable Requests for This User</span>
        <% end %>
      </div>
    <% end %>
    <% requester_uses.each_with_index do |use, counter| %>
      <% if @tab == 'new' %>
        <%= render 'morphosource/my/request_manager/new/list_requests', requester: requester, counter: counter, use: use, items: @requester_items %>
      <% elsif @tab == 'previous' %>
        <%= render 'morphosource/my/request_manager/previous/list_requests', requester: requester, counter: counter, use: use, items: @requester_items %>
      <% end %>
    <% end %>
  </div>
</div>
