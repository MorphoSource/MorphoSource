<% get_requester_items(@items,requester) %>
<div class="user-wrapper">

  <div class="requests-wrapper">
    <% if @tab == 'new' %>
      <div class="check-all-div user-div">
        <%= check_box_tag 'check_all_div', 'no', false, class: 'check_all_user' %>
        <span>Select All Media ( <%= @requester_items.count %> items ) for This User</span>
      </div>
    <% elsif @tab == 'previous' %>
      <div class="check-all-div user-div">
        <% if editable_items(@requester_items).count > 0 %>
          <%= check_box_tag 'check_all_div', 'no', false, class: 'check_all_user' %>
          <span>Select All Editable Requests for This User</span>
        <% end %>
      </div>
    <% end %>

    <div class="user-details">      
      <div class="row">
        <div class="col-6 col-sm-3 col-md-2 showcase-label">User:</div><div class="col-6 col-sm-9 col-md-10 showcase-value"><%= link_to requester.display_name, hyrax.user_path(requester) %></div>
      </div>
      <div class="row">
        <div class="col-6 col-sm-3 col-md-2 showcase-label">Email:</div><div class="col-6 col-sm-9 col-md-10 showcase-value"><%= requester.email %></div>
      </div>
      <div class="row">
        <div class="col-6 col-sm-3 col-md-2 showcase-label">Profile Type:</div><div class="col-6 col-sm-9 col-md-10 showcase-value"><%= requester.profile_type %></div>
      </div>
      <% if requester.affiliation.present? %>
      <div class="row">
        <div class="col-6 col-sm-3 col-md-2 showcase-label">Organization:</div><div class="col-6 col-sm-9 col-md-10 showcase-value"><%= requester.affiliation %></div>
      </div>
      <% end %>
      <% if requester.department.present? %>
      <div class="row">
        <div class="col-6 col-sm-3 col-md-2 showcase-label">Department:</div><div class="col-6 col-sm-9 col-md-10 showcase-value"><%= requester.department %></div>
      </div>
      <% end %>
      <% if requester.academic_field.present? %>
      <div class="row">
        <div class="col-6 col-sm-3 col-md-2 showcase-label">Academic Field:</div><div class="col-6 col-sm-9 col-md-10 showcase-value"><%= requester.academic_field %></div>
      </div>
      <% end %>
      <% if requester.academic_subfield.present? %>
      <div class="row">
        <div class="col-6 col-sm-3 col-md-2 showcase-label">Academic Subfield:</div><div class="col-6 col-sm-9 col-md-10 showcase-value"><%= requester.academic_subfield %></div>
      </div>
      <% end %>
      <% if requester.mentor_or_advisor.present? %>
      <div class="row">
        <div class="col-6 col-sm-3 col-md-2 showcase-label">Mentor or Advisor:</div><div class="col-6 col-sm-9 col-md-10 showcase-value"><%= requester.mentor_or_advisor %></div>
      </div>
      <% end %>
      <% if requester.instructor.present? %>
      <div class="row">
        <div class="col-6 col-sm-3 col-md-2 showcase-label">Instructor:</div><div class="col-6 col-sm-9 col-md-10 showcase-value"><%= requester.instructor %></div>
      </div>
      <% end %>
      <div class="row">
        <div class="col-6 col-sm-3 col-md-2 showcase-label">Profession:</div>
        <div class="col-6 col-sm-9 col-md-10 showcase-value">
        <%= render partial: 'morphosource/my/request_manager/list_requester_demographics', collection: requester.demographics, as: :profession %>
        </div>
      </div>
      <br clear="all" />
    </div>

    <% requester_uses.each_with_index do |use, counter| %>
      <% if @tab == 'new' %>
        <%= render 'morphosource/my/request_manager/new/list_requests', requester: requester, counter: counter, use: use, items: @requester_items, agreed: @requester_agreed_to_terms %>
      <% elsif @tab == 'previous' %>
        <%= render 'morphosource/my/request_manager/previous/list_requests', requester: requester, counter: counter, use: use, items: @requester_items %>
      <% end %>
    <% end %>
  </div>
</div>
