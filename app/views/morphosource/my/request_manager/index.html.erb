<% content_for :body_css_classes do %>dl-request<% end %>
<% provide :page_title, "New Requests For My Media" %>

<div class="panel panel-default">
  <div class="card-header">
    <h2 class="panel-title h2">New Requests For My Media (<%= @item_count %>)</h2>
  </div>
  <div class="card-body">
    <h2 class="sr-only">Works listing</h2>
    <%= render 'morphosource/my/request_manager/batch_actions' %>
    <% if @item_count.to_i > 0 %>
      <%= render 'morphosource/my/request_manager/document_list' %>
      <%= render 'morphosource/my/request_manager/results_pagination' %>
    <% else %>
      <div class="mt-1">There are currently no download requests for media where you are an active download reviewer.<div>
    <% end %>
  </div>
</div>

<%= render 'morphosource/my/modals/page_modal' %>

<script>
  <%= render partial: 'morphosource/my/scripts/scripts', formats: [:js] %>
  <%= render partial: 'morphosource/my/request_manager_scripts', formats: [:js] %>
  <%= render partial: 'morphosource/my/scripts/modal_scripts', formats: [:js] %>
</script>
