<div class="request-wrapper">

  <div class="check-all-div select-all-use">
    <% if editable_use_requests(items,use).count > 0 %>
      <%= check_box_tag 'check_all_div', 'no', false, class: 'check_all_use' %>
      <span>Select All Editable Requests for This Intended Use</span>
    <% end %>
  </div>
  <div class="intended-use-wrapper">
    <h4><%= use %></h4>
  </div>

  <div class="requested-items-wrapper">
    <table class="table table-striped works-list">
      <thead>
        <tr>
          <th></th>
          <th>Media</th>
          <th>Status</th>
          <th>Approver</th>
          <th>Requested</th>
          <th>Approved</th>
          <th>Denied</th>
          <th>Canceled</th>
          <th>Expiration</th>
          <th>Cleared</th>
          <th>Downloaded</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% use_requests(items,use).each_with_index do |item, counter| %>
          <% document = @solr_docs.select{|doc| doc.id == item.work_id}[0] %>
          <%= render 'morphosource/my/request_manager/previous/list_works' , document: document, counter: counter, item: item, presenter: Hyrax::WorkShowPresenter.new(document, current_ability)%>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
