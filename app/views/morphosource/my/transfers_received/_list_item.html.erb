<% if item.sending_user.present? %>
  <tr id="item_<%= item.id %>">
    <td>
      <% if item.pending? && can?(:accept, item) %>
        <%= render 'morphosource/batch_select/add_button', item: item %>
      <% end %>
    </td>
    <td><%= show_transfer_request_title(item) %></td>
    <td><%= item.organization_transfer? ? 'Organization' : 'Standard' %></td>
    <td><%= link_to_transfer_participant(item.sending_user_id) %></td>
    <td class="date">
      <relative-time datetime="<%= item.created_at.getutc.iso8601 %>" title="<%= item.created_at.to_formatted_s(:standard) %>">
        <%= item.created_at.to_formatted_s(:long_ordinal) %>
      </relative-time>
    </td>
    <td><%= item.organization_transfer ? item.sender_comment.html_safe : item.sender_comment %></td>
    <td><%= item.status.capitalize %></td>
    <td>
      <% if item.pending? && can?(:accept, item) %>
        <div class="btn-group mr-2 mb-1" role="group">
          <button type="button" class="btn btn-sm btn-primary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            Accept <span class="caret"></span>
          </button>
          <ul class="dropdown-menu dropdown-menu-right">
            <li>
              <%= link_to 'Allow depositor to retain edit access', hyrax.accept_transfer_path(item, return_to: request.original_fullpath), method: :put, class: 'accept-retain', title: 'Accept the file and allow the original depositor to retain access to edit the file and metadata' %>
            </li>
            <li>
              <%= link_to 'Remove depositor access', hyrax.accept_transfer_path(item, reset: true, return_to: request.original_fullpath), method: :put, class: 'accept-reset', title: 'Accept the file and remove access from the original depositor.' %>
            </li>
            <li>
              <%= link_to 'Authorize depositor as proxy', hyrax.accept_transfer_path(item, sticky: true, return_to: request.original_fullpath), method: :put, class: 'accept-stick', title: 'Accept the file and allow the original depositor to retain access and authorize the original depositor as a proxy to deposit files on your behalf.' %>
            </li>
          </ul>
        </div>
        <%= link_to "Reject", hyrax.reject_transfer_path(item, return_to: request.original_fullpath), method: :put, class: 'btn btn-sm btn-danger mb-1', data: { confirm: "Are you sure you want to reject this request?" } %>
      <% end %>
    </td>
  </tr>
<% else %>
  <% Rails.logger.error "A proxy request has no sender: #{item.inspect}" %>
<% end %>
