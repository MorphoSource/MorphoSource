<% if query_has_constraints? %>
  <div id="appliedParams" class="clearfix constraints-container ms-constraints-container showcase pb-4">
    <span class="constraints-label"><%= t('blacklight.search.filters.title') %></span>
    <%= render_constraints(params.merge(route_set: hyrax)) %>
    <div class="flex-grow-1 text-right">
      <%= link_to start_over_path,
          class: "remove-filter-all", id: "startOverLink" do %>
          Remove all <i class="fa fa-times-circle"></i>
      <% end %>
    </div>
  </div>
<% end %>
