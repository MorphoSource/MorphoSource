<div class="hyc-blacklight hyc-bl-pager">
  <div class="row record-padding paginate-wrapper">
    <div class="col-md-12 col-lg-2">
      <%= render 'rows_per_page' %>
    </div>
    <div class="col-md-12 col-lg-2">
      <div>Showing <%= page_entries_info @response %></div>
    </div>

    <% if @response.total_pages > 1 %>
      <div class="col-md-12 col-lg-8">
        <%= paginate @response, outer_window: 2, theme: 'blacklight', route_set: main_app %>
      </div>
    <% end %>
  </div>
</div>
