<% content_for :body_css_classes do %>showcase showcase-edit media-works<% end %>
<% provide :page_title, "Media and Objects" %>

<% provide :page_header do %>
  <div class="col-xs-9 title">
    <h1><span class="fa fa-cube %>" aria-hidden="true"></span> Media and Objects</h1>
  </div>
  <div class="col-xs-3 show-actions text-right">
    <% if can?(:create, Media) %>
      <%= link_to 'New media', main_app.new_submission_path(restart: true), class: 'btn btn-primary' %>
    <% end %>
  </div>

  <div class="row collection-count">
      <%= render 'morphosource/my/works/membership_count' %>
  </div>
<% end %>

<div class="col-md-12">

  <div class="panel panel-default tabs" role="main">

    <%= render 'nav_tabs' %>
    <!-- Nav tabs -->

    <!-- Tab panes -->
    <div class="tab-content">
      <% if @tab == :media %>
        <%= render 'morphosource/my/media/tab_panel' %>
      <% elsif @tab == :specimens %>
        <%= render 'morphosource/my/specimens/tab_panel' %>
      <% elsif @tab == :chos %>
        <%= render 'morphosource/my/cultural_heritage_objects/tab_panel' %>
      <% end %>
    </div><!-- /tab-content -->

  </div><!-- /panel panel-default tabs -->

</div><!-- div hyc-container -->
