<tr id="document_<%= document.id %>">

  <td style='width: 35%;'>
    <div class='media'>
      <%= link_to [main_app, document], class: 'media-left', 'aria-hidden' => true do %>
        <%= render_thumbnail_tag document, { class: 'd-none d-sm-block file_listing_thumbnail' }, { suppress_link: true } %>
      <% end %>

      <div class='media-body ml-2'>
        <div class='media-heading'>

          <%= link_to [main_app, document], id: "src_copy_link#{document.id}", class: 'document-title' do %>
            <span class="sr-only">
              <%= t("hyrax.dashboard.my.sr.show_label") %>
            </span>
            <%= document.title_or_label %>
          <% end %>

          <br />

        </div>
      </div>
    </div>
  </td>
  <% if @object %>
    <td style="width: 10%;"><%= link_to(@object.title.first, hyrax_biological_specimen_path(@object.id)) %></td>
  <% else %>
    <td style="width: 10%;"></td>
  <% end %>
  <% if @taxonomy %>
    <td style="width: 20%;"><%= link_to(@taxonomy.title.first, hyrax_taxonomy_path(@taxonomy.id)) %></td>
  <% else %>
    <td style="width: 20%;"></td>
  <% end %>
  <td style="width: 5%;"><%= @type %></td>
  <td style="width: 20%;"><%= tag_links(document) %></td>
  <td style="width: 20%;"><%= publication_badge(@publication_status) %></td>
</tr>
