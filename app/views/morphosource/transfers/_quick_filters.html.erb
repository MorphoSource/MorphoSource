<% current_status = params[:all_statuses] == 'true' ? 'all' : (params.dig(:filter_items, 'status') || 'pending') %>
<% current_org_transfer = params.dig(:filter_items, 'organization_transfer') %>

<div class="itemtable-quick-filters mb-2">
  <div class="btn-group mr-2 mb-1" role="group" aria-label="Filter transfers by status">
    <% [['Pending', 'pending'], ['Accepted', 'accepted'], ['Rejected', 'rejected'], ['Canceled', 'canceled']].each do |label, status| %>
      <%= link_to label, quick_filter_status_url(status), class: "btn btn-sm #{current_status == status ? 'btn-primary' : 'btn-outline-primary'}" %>
    <% end %>
    <%= link_to 'All', quick_filter_all_statuses_url, class: "btn btn-sm #{current_status == 'all' ? 'btn-primary' : 'btn-outline-primary'}" %>
  </div>

  <% if @has_organization_transfers %>
    <div class="btn-group mb-1" role="group" aria-label="Filter transfers by type">
      <%= link_to 'All Types', quick_filter_organization_transfer_url(nil), class: "btn btn-sm #{current_org_transfer.blank? ? 'btn-primary' : 'btn-outline-primary'}" %>
      <%= link_to 'Standard', quick_filter_organization_transfer_url('false'), class: "btn btn-sm #{current_org_transfer == 'false' ? 'btn-primary' : 'btn-outline-primary'}" %>
      <%= link_to 'Organization', quick_filter_organization_transfer_url('true'), class: "btn btn-sm #{current_org_transfer == 'true' ? 'btn-primary' : 'btn-outline-primary'}" %>
    </div>
  <% end %>
</div>
