<% current_status = current_transfer_status %>
<% current_org_transfer = params.dig(:filter_items, 'organization_transfer') %>

<% status_options = [
     ['Pending', quick_filter_status_url('pending')],
     ['Accepted', quick_filter_status_url('accepted')],
     ['Rejected', quick_filter_status_url('rejected')],
     ['Canceled', quick_filter_status_url('canceled')],
     ['All', quick_filter_all_statuses_url]
   ] %>
<% status_url_map = { 'pending' => status_options[0][1], 'accepted' => status_options[1][1], 'rejected' => status_options[2][1], 'canceled' => status_options[3][1], 'all' => status_options[4][1] } %>

<% org_options = [
     ['All Types', quick_filter_organization_transfer_url(nil)],
     ['Standard', quick_filter_organization_transfer_url('false')],
     ['Organization', quick_filter_organization_transfer_url('true')]
   ] %>
<% org_url_map = { '' => org_options[0][1], 'false' => org_options[1][1], 'true' => org_options[2][1] } %>

<div class="d-flex justify-content-between align-items-center flex-wrap mb-2">
  <div class="mb-1">
    <button class="select-all-transfers btn btn-outline-secondary btn-sm" type="button" title="Select all pending transfers on page">Select All</button>
    <button class="select-no-transfers btn btn-outline-secondary btn-sm" type="button" title="Deselect all transfers on page">Select None</button>
    <%= local_assigns[:decide_button] %>
  </div>

  <div class="mb-1 d-flex align-items-center flex-wrap">
    <% if @has_organization_transfers %>
      <label class="mr-1 mb-0" for="quick_filter_organization_transfer">Type</label>
      <%= select_tag :quick_filter_organization_transfer,
                     options_for_select(org_options, org_url_map[current_org_transfer.presence || '']),
                     onchange: 'window.location.href = this.value;',
                     class: 'form-control form-control-sm d-inline-block w-auto mr-3',
                     'aria-label': 'Filter transfers by type' %>
    <% end %>

    <label class="mr-1 mb-0" for="quick_filter_status">Status</label>
    <%= select_tag :quick_filter_status,
                   options_for_select(status_options, status_url_map[current_status]),
                   onchange: 'window.location.href = this.value;',
                   class: 'form-control form-control-sm d-inline-block w-auto',
                   'aria-label': 'Filter transfers by status' %>
  </div>
</div>
