<div class="row">
  <div class="col-xs-12">
    <div class="panel panel-default">
      <div class="panel-body"> 
        <%= simple_form_for @page do |f| %>
          <%= f.input :title %>
          <%= f.input :page_type,
            collection: Page.page_types.keys.map { |key| [key.humanize, key] },
            include_blank: false
          %>
          <%= f.input :slug %>
          <%= f.input :visibility, 
            collection: Page.visibilities.keys.map { |key| [key.humanize, key] }, 
            include_blank: false 
          %>
          <%= f.input :content, as: :rich_text_area, required: true %>

          <%= f.submit class: 'btn btn-sm btn-primary' %>

          <% if @page.persisted? %>
            <%= link_to t('page.delete.button'), page_path(@page), 
                  method: :delete, 
                  data: { confirm: t('page.delete.confirm') }, 
                  class: 'btn btn-sm btn-danger pull-right' %>
          <% end %>
        <% end%>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const slugInput = document.getElementById('page_slug');
    const titleInput = document.getElementById('page_title');

    titleInput.addEventListener('input', function() {
      const title = titleInput.value;
      const sanitizedSlug = title.trim().toLowerCase().replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-');
      slugInput.value = sanitizedSlug;
    });
  });
</script>