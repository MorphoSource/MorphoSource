<%# key is 'aat_type' %>
<%= f.input key,
            as: :controlled_vocabulary,
            label: 'Getty Type',
            placeholder: 'Search for a type or genre',
            input_html: {
              class: 'form-control',
              data: { 'autocomplete-url' => "/authorities/search/getty/aat/types",
                      'autocomplete' => key }
            },
            label_wrapper_html: { class: 'indent' },
            ### Required for the ControlledVocabulary javascript:
            wrapper_html: { data: { 'autocomplete-url' => "/authorities/search/getty/aat/types",
                                    'field-name' => key }} %>
