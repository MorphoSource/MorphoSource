<% if defined?(curation_concern) && (curation_concern!= '') %>
  <% object = curation_concern %>
<% elsif @collection.organization %>
  <% object = @collection.organization %>
<% end %>

<div class="form-group row string optional media_agreement_uri attachment-container">
  <div class="col-xs-6 showcase-label">
    <label class="control-label string optional" for="media_agreement_uri">Additional usage agreement</label>
    <i class="material-icons tooltip-icon" data-original-title="" title="" style='margin-left: -1px;'></i>
  </div>

  <div class="col-xs-6 showcase-value">
    <%= f.input_field :agreement_uri,
      as: :string,
      placeholder: 'Enter Agreement File URL',
      id: 'media_agreement_uri',
      disabled: object.present? && object.attachment('agreement') ? true : false,
      class: 'form-control string optional'
    %>

    <div style='text-align: center;'><b>- OR -</b></div>

    <div class='attachment'>
      <% if object.present? && object.attachment('agreement').present? %>
        <div class='attachment-link'>
          <%= link_to main_app.attachment_path(id: object.id, field: 'agreement') do %>
            <span>Agreement File</span>
          <% end %>
          <span class='input-group-btn field-controls' style='display: inline;'>
            <button type='button' class='btn btn-link btn-remove-attachment' style='float: right;'>
              <i class="fa fa-times-circle" style='font-size: 15px;' aria-hidden="true"></i>
            </button>
          </span>
        </div>
      <% end %>
      <div class='attachment-input <%= object.present? && object.attachment('agreement').present? ? 'hide' : '' %>'>
        <%= file_field_tag :agreement, accept: 'text/plain,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document', class: 'file-field-input agreement-attachment' %>
        <span style='font-size:small; color: gray;'>Accepted Formats: .txt, .pdf, .docx</span>
        <input name='media_attachment_delete' class='attachment_delete hide'></input>
      </div>
    </div>
  </div>
</div>
