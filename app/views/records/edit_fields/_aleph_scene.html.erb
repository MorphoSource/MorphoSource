<div class="form-group row">
  <div class="col-6 showcase-label">
    <label class="control-label string optional " for="media_aleph_scene" data-toggle="collapse" href="#media_aleph_scene">
      Aleph Scene JSON
      <span class="fas fa-caret-down media_aleph_scene"></span>
    </label>
    <%= render_hint_tag(t('simple_form.hints.defaults.aleph_scene')) %>
  </div>
</div>

<div class="form-group row">
  <div class="col-12 showcase-value">
    <%= text_area_tag 'media[aleph_scene]', (JSON.pretty_generate(@presenter.aleph_scene) if @presenter.aleph_scene.present?), rows: 15, id: 'media_aleph_scene', class: 'form-control string optional collapse collapse-accordion', placeholder: "Paste some JSON here", style: "font-family: monospace;" %>
  </div>
</div>
