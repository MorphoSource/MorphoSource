<div class="form-group row string optional attachment-container">
  <div class="col-xs-6 showcase-label">
    <label class="control-label string optional" for="attachment-container">
      <%= label.present? ? label : 'Attachment File' %>
    </label>
    <i class="material-icons tooltip-icon" data-original-title="" title="" style='margin-left: -1px;'></i>
  </div>
  <div class="col-xs-6 showcase-value">
    <div class='attachment'>
      <% if curation_concern.present? && curation_concern.attachment(field).present? %>
        <div class='attachment-link'>
          <%= link_to main_app.attachment_path(id: curation_concern.id, field: field) do %>
            <span>Attachment File</span>
          <% end %>
          <span class='input-group-btn field-controls' style='display: inline;'>
            <button type='button' class='btn btn-link btn-remove-attachment' style='float: right;'>
              <i class="fa fa-times-circle" style='font-size: 15px;' aria-hidden="true"></i>
            </button>
          </span>
        </div>
      <% end %>
      <div class='attachment-input <%= curation_concern.present? && curation_concern.attachment(field).present? ? 'hide' : '' %>'>
        <%= file_field_tag field.to_sym, accept: 'text/plain,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document', class: 'file-field-input' %>
        <span style='font-size:small; color: gray;'>Accepted Formats: .txt, .pdf, .docx</span>
        <input name='<%= "#{field.downcase}_attachment_delete" %>' class='attachment_delete hide'></input>
      </div>
    </div>
  </div>
</div>