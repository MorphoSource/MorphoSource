<% org_collection_form = form_model_name(f) == 'organization_collection' && f.object.model.id.present? %>
<div class="form-group row string optional media_download_reviewer">
  <div class="col-6 showcase-label">
    <label class="col-form-label string optional" for="media_download_reviewer"><%= t('simple_form.labels.media.download_reviewer') %></label>
    <i class="material-icons tooltip-icon" data-toggle="tooltip" title="<%= t('simple_form.hints.defaults.download_reviewer') %>"></i>
  </div>
  <div class="col-6 showcase-value">
    <%= f.text_field :download_reviewer,
      id: 'media_download_reviewer',
      name: "#{f.object_name}[download_reviewer][]",
      placeholder: local_assigns[:placeholder],
      'data-reviewers' => reviewer_data(f),
      class: 'form-control string optional multi-search-field'
    %>
    <% if org_collection_form %>
      <div class="checkbox org-managers-reviewer">
        <label class="boolean optional" for="org_managers_reviewer">
          <input type="checkbox" id="org_managers_reviewer"
            data-org-name="<%= f.object.model.name %>"
            data-org-value="<%= org_managers_reviewer_value(f) %>"
            data-input-name="<%= "#{f.object_name}[download_reviewer][]" %>"
            <%= 'checked' if org_managers_reviewer_selected?(f) %> />
          <span>Current Organization Managers</span>
          <i class="material-icons tooltip-icon" data-toggle="tooltip" title="<%= t('simple_form.hints.organization.download_reviewer_managers') %>"></i>
        </label>
      </div>
    <% end %>
  </div>
</div>

<script>
  $( document ).ready(function() {
    var reviewerSelect = $('#media_download_reviewer');
    var managersCheckbox = $('#org_managers_reviewer');

    // org collection forms may only search users; orgs select themselves via the checkbox
    reviewerSelect.reviewerSearchMultiple(reviewerSelect.data('reviewers'), { usersOnly: managersCheckbox.length > 0 });

    if (managersCheckbox.length > 0) {
      var applyManagersMode = function(selected) {
        if (selected) {
          // show the org name read-only and submit the org itself as the reviewer,
          // matching how the stored value renders after save
          reviewerSelect.select2('data', [{
            id: managersCheckbox.data('org-value'),
            user_key: managersCheckbox.data('org-value'),
            text: managersCheckbox.data('org-name')
          }]);
          reviewerSelect.select2('enable', false);
          $('<input>', {
            type: 'hidden',
            class: 'org-managers-reviewer-value',
            name: managersCheckbox.data('input-name'),
            value: managersCheckbox.data('org-value')
          }).insertAfter(reviewerSelect);
        } else {
          $('.org-managers-reviewer-value').remove();
          reviewerSelect.select2('enable', true);
          reviewerSelect.select2('data', []);
          reviewerSelect.val('');
        }
      };

      managersCheckbox.on('change', function() { applyManagersMode(this.checked); });
      if (managersCheckbox.is(':checked')) { applyManagersMode(true); }
    }
  });
</script>
