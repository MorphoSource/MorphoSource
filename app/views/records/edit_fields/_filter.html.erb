<%= f.input :filter, as: :multi_value
%>

<div class="form-group row multi_value optional managed ie_xray_ct">

  <div class="col-xs-6 showcase-label">
    <label class="control-label multi_value optional" for="imaging_event_filter">Filter</label>
  </div>

  <div class="col-xs-6 showcase-value form-group multi_value optional managed ie_xray_ct wrapper_for_2" id="imaging_event_filter_wrapper">
    <ul class="listing" aria-live="polite">
      
      <li class="field-wrapper input-group input-append">
        <select class="form-control select optional form-control" name="imaging_event[filter_material][]" id="imaging_event_filter_material">
          <option value="">Material</option>
          <option value="Molybdenum">Molybdenum</option>
          <option value="Aluminum">Aluminum</option>
          <option value="Copper">Copper</option>
          <option value="Rhodium">Rhodium</option>
          <option value="Niobium">Niobium</option>
          <option value="Europium">Europium</option>
          <option value="Lead">Lead</option>
        </select>
        <input class="string multi_value optional form-control imaging_event_filter_thickness form-control multi-text-field" name="imaging_event[filter_thickness][]" value="" id="imaging_event_filter_thickness" placeholder="Thickness" type="text">
      </li>
    </ul>
  </div>

</div>
