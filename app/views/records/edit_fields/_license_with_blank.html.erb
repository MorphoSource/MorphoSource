<% license_service = Hyrax.config.license_service_class.new %>
<div class="form-group row multi_value optional organization_license value-blank-container">
  <div class="col-xs-6 showcase-label">
    <label class="control-label multi_value optional" for="organization_license">
      License
    </label>
    <i class="material-icons tooltip-icon" data-original-title="" title="" style="margin-left: -1px;">
      <p class="hint hide"><%= t('simple_form.hints.defaults.license') %></p>
    </i>
  </div>
  <div class="col-xs-6 showcase-value">
    <%= f.input_field :license, as: :multi_value_select,
      collection: license_service.select_active_options,
      include_blank: local_assigns[:placeholder],
      item_helper: license_service.method(:include_current_value),
      class: 'form-control' 
    %>
    <div class="form-group boolean optional organization_license_blank value-blank-check">
      <div class="checkbox">
        <label class="boolean optional" for="organization_license_blank">
          <%= f.input_field :license_blank, as: :boolean, boolean_style: :inline %>
          <span>Value intentionally blank</span>
          <i class="material-icons tooltip-icon" data-original-title="" title="" style="margin-left: -1px;">
            <p class="hint hide"><%= t('simple_form.hints.organization.value_blank_check') %></p>
          </i>
        </label>
      </div>
    </div>    
  </div>
</div>