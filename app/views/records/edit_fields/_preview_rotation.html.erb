<div class="form-group row">
  <div class="col-xs-6 showcase-label">
    <label class="control-label string optional" for="media_preview_rotation">Initial Rotation</label>
    <i class="material-icons tooltip-icon" data-original-title="" title="">
      <p class="hint hide"><%= t('simple_form.hints.defaults.preview_rotation') %></p>
    </i>
  </div>
</div>

<div class="form-group row">
  <div class="col-xs-6 showcase-label" style="justify-content: flex-end;">
    <label class="control-label string optional" for="media_preview_rotation_x">X°</label>
  </div>
  <div class="col-xs-6 showcase-value">
    <input type="text" id="media_preview_rotation_x" name="media[preview_rotation_x]" class="form-control string optional" placeholder="0">
  </div>
</div>

<div class="form-group row">
  <div class="col-xs-6 showcase-label" style="justify-content: flex-end;">
    <label class="control-label string optional" for="media_preview_rotation_y">Y°</label>
  </div>
  <div class="col-xs-6 showcase-value">
    <input type="text" id="media_preview_rotation_y" name="media[preview_rotation_y]" class="form-control string optional" placeholder="0">
  </div>
</div>

<div class="form-group row">
  <div class="col-xs-6 showcase-label" style="justify-content: flex-end;">
    <label class="control-label string optional" for="media_preview_rotation_z">Z°</label>
  </div>
  <div class="col-xs-6 showcase-value">
    <input type="text" id="media_preview_rotation_z" name="media[preview_rotation_z]" class="form-control string optional" placeholder="0">
  </div>
</div>

