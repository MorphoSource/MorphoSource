<div class="form-group row string optional media_record_download_reviewer_users">
  <div class="col-6 showcase-label">
    <label class="col-form-label string optional" for="media_record_download_reviewer_users"><%= t('simple_form.labels.media.download_reviewer') %></label>
    <i class="material-icons tooltip-icon" data-toggle="tooltip" title="<%= t('simple_form.hints.defaults.download_reviewer') %>"></i>
  </div>
  <div class="col-6 showcase-value">
    <%= f.text_field :record_download_reviewer_users,
      id: 'media_record_download_reviewer_users',
      name: "#{f.object_name}[record_download_reviewer_users][]",
      placeholder: local_assigns[:placeholder],
      'data-reviewers' => reviewer_data(f),
      class: 'form-control string optional multi-search-field'
    %>
  </div>
</div>

<script>
  $( document ).ready(function() {
    reviewerSelect = $('#media_record_download_reviewer_users');

    // add search to download reviewer
    reviewerSelect.userSearchMultiple(reviewerSelect.data('reviewers'));
  });
</script>
