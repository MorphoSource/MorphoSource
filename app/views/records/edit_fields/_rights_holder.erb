<%= f.input :rights_holder, as: :multi_value %>
<div class="row">
  <div class="col-xs-6 showcase-label">IP holder(s) (Name, Type)</div>
  <div class="col-xs-6 showcase-value form-group multi_value optional managed ie_xray_ct wrapper_for_2" id="<%= "#{form_model_name(f)}_rights_holder_wrapper" %>">
    <ul class="listing rights_holder_listing" aria-live="polite">
      <li class="field-wrapper input-group input-append">
        <input class="string multi_value optional form-control <%= "#{form_model_name(f)}_rights_holder_name"%> form-control multi-text-field" name="<%= "#{form_model_name(f)}[rights_holder_name][]"%>" value="" id="<%= "#{form_model_name(f)}_rights_holder_name" %>" type="text">
        <select class="form-control select optional form-control" name="<%= "#{form_model_name(f)}[rights_holder_type][]"%>" id="<%= "#{form_model_name(f)}_rights_holder_type"%>">
          <option value=""></option>
          <option value="Copyright and License">Copyright and License</option>
          <option value="Copyright">Copyright</option>
          <option value="License">License</option>
        </select>
      </li>
    </ul>
  </div>
</div>
