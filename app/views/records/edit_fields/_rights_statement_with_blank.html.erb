<% rights_statements = Hyrax.config.rights_statement_service_class.new %>
<div class="form-group row select optional organization_rights_statement value-blank-container">
  <div class="col-6 showcase-label">
    <label class="col-form-label select optional" for="organization_rights_statement">
      Copyright statement
    </label>
    <i class="material-icons tooltip-icon" data-original-title="" title="" style="margin-left: -1px;">
      <p class="hint hide"><%= t('simple_form.hints.defaults.rights_statement') %></p>
    </i>
  </div>
  <div class="col-6 showcase-value"> 
    <%= f.input_field :rights_statement,
      collection: rights_statements.select_active_options,
      include_blank: local_assigns[:placeholder],
      item_helper: rights_statements.method(:include_current_value),
      class: 'form-control' 
    %>
    <div class="form-group boolean optional organization_rights_statement_blank value-blank-check">
      <div class="checkbox">
        <label class="boolean optional" for="organization_rights_statement_blank">
          <%= f.input_field :rights_statement_blank, as: :boolean, boolean_style: :inline %>
          <span>Value intentionally blank</span>
          <i class="material-icons tooltip-icon" data-original-title="" title="" style="margin-left: -1px;">
            <p class="hint hide"><%= t('simple_form.hints.organization.value_blank_check') %></p>
          </i>
        </label>
      </div>
    </div> 
  </div>
</div>