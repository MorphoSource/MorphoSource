<% rights_statements = Hyrax.config.rights_statement_service_class.new %>
<div class="form-group row select optional organization_rights_statement">
  <div class="col-xs-6 showcase-label">
    <label class="control-label select optional" for="organization_rights_statement">
      Copyright statement
    </label>
    <i class="material-icons tooltip-icon" data-original-title="" title=""></i>
  </div>
  <div class="col-xs-6 showcase-value"> 
    <%= f.input_field :rights_statement,
      collection: rights_statements.select_active_options,
      include_blank: true,
      item_helper: rights_statements.method(:include_current_value),
      class: 'form-control' 
    %>
    <%= f.input :rights_statement_blank, as: :boolean, label: "Value intentionally blank" %>    
  </div>
</div>