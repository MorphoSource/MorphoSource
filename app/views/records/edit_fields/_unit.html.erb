<% # app/views/records/edit_fields/_units.html.erb %>

<% units_service = Morphosource::UnitsService.new %>


<%= f.input :unit, as: :select,
    collection: units_service.select_all_options(f.object.unit),
    include_blank: true,
    input_html: { class: 'form-control' },
    wrapper_html: { class: 'Mesh CTImageSeries SequentialSectionImageSeries' },
    label: 'Pixel spacing units',
    prompt: 'Select Units (Millimeter Default)'
%>
