<% # app/views/records/edit_fields/_y_spacing.html.erb %>
<% # validates numbers only while user types %>
<%= f.input :y_spacing, as: :string,
    wrapper_html: { class: 'SequentialSectionImageSeries' },
    label: 'Y pixel spacing',
    input_html: { type: "text", onkeyup: "reportValidity('');", pattern: "[0-9]+(\.[0-9]+)?", oninvalid: "this.setCustomValidity('Only valid numbers allowed');", oninput: "this.setCustomValidity('');" }
%>
