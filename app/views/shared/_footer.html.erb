<footer class="navbar navbar-dark bg-dark site-footer no-horizontal-padding navbar-expand-md align-items-start" style="border: none">
  <div class="container-fluid">
    <div class="row align-items-center no-horizontal-padding w-100" style="margin-left: 0; margin-right: 0;">
      <div class="col-lg-2 col-md-6 col-12 col-align col-align--top footer-section copyright">
        <div style="display: flex; flex-direction: column; align-items: center;">
          <div style="margin-bottom: 20px; display: flex;"><%= render 'donate_button' %></div>
          <%= link_to t('hyrax.footer.copyright_html', current_year: Time.now.year), 'https://www.morphosource.org' %>
        </div>
      </div>
      <div class="col-lg-6 col-md-6 col-12 col-align col-align--center footer-section footer-links">
          <div class="row">
            <%= render partial: "footer_section", locals: { links_yml: Hyrax.config.footer_community, label: "community" } %>
            <%= render partial: "footer_section", locals: { links_yml: Hyrax.config.footer_docs, label: "docs" } %>
            <%= render partial: "footer_section", locals: { links_yml: Hyrax.config.footer_resources, label: "resources" } %>
            <div class="col-3 no-horizontal-padding">
              <div class="row" style="padding-top: 0;"><span class="footer-label"><%= t(:'hyrax.controls.terms_of_use') %></span>
              </div>
              <div class="row footer-sublink"><%= link_to t("morphosource.docs.terms.label"), Rails.application.routes.url_helpers.terms_path %></div>
              <div class="row footer-sublink"><%= link_to t("morphosource.docs.contributor_terms.label"), Rails.application.routes.url_helpers.contributor_terms_path %></div>
            </div>
          </div>
      </div>
      <div class="col-lg-2 col-md-6 col-12 col-align col-align--center footer-section support">
        <div class="row align-items-center">
          <div class="col-lg-12 col-6">
            <div class="row align-items-center justify-content-end justify-content-md-start justify-content-lg-center">
              <span>Support From: </span>
            </div>
          </div>
          <div class="col-lg-12 col-6">
            <div class="row align-items-center justify-content-start justify-content-lg-center">
              <span id="duke-logo" style="margin-left: 10px;"><a href="https://www.duke.edu/"><%= image_tag('duke_logo.png') %></a></span>
              <span id="nsf-logo" style="margin-left: 10px;"><a href="https://www.nsf.gov/"><%= image_tag('nsf_logo.png') %></a></span>
            </div>
          </div>
        </div>
      </div>
      <div class="col-lg-2 col-md-6 col-12 col-align col-align--center footer-section icons">
        <a href="https://github.com/MorphoSource"><i class="fab fa-github fa-lg"></i></a>
        <a href="https://twitter.com/MorphoSource"><i class="fab fa-twitter fa-lg"></i></a>
        <a href="mailto:morphosource@duke.edu"><i class="fas fa-envelope fa-lg"></i></a>
      </div>
    </div>
  </div>
</footer>
