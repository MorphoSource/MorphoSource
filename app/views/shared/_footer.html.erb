<footer class="navbar navbar-inverse site-footer" style='border: none; height: unset'>
  <div class="container-fluid">
    <div class="row no-horizontal-padding">
      <div class="col-md-2 col-sm-6 col-xs-12 col-align col-align--center footer-section copyright">
        <span><%= t('hyrax.footer.copyright_html') %></span>
      </div>
      <div class="col-md-4 col-sm-6 col-xs-12 col-align col-align--center footer-section footer-links">
        <div class="row">
          <div class="col-xs-3 no-horizontal-padding">
            <%= link_to t(:'hyrax.controls.about'), hyrax.about_path, aria: current_page?(hyrax.about_path) ? {current: 'page'} : nil %>
          </div>
          <div class="col-xs-3 no-horizontal-padding">
            <%= link_to t(:'hyrax.controls.docs'), hyrax.about_path, aria: current_page?(hyrax.about_path) ? {current: 'page'} : nil %>
          </div>
          <div class="col-xs-3 no-horizontal-padding">
            <%= link_to t(:'hyrax.controls.resources'), hyrax.about_path, aria: current_page?(hyrax.about_path) ? {current: 'page'} : nil %>
          </div>
          <div class="col-xs-3 no-horizontal-padding">
            <%= link_to t(:'hyrax.controls.terms'), hyrax.about_path, aria: current_page?(hyrax.about_path) ? {current: 'page'} : nil %>
          </div>
        </div>
      </div>
      <div class="col-md-4 col-sm-6 col-xs-12 col-align col-align--center footer-section support">
        <span>Support From: </span>
        <span id='duke-logo' style='margin-left: 10px;'><a href='https://www.duke.edu/'><%= image_tag('duke_logo.png') %></a></span>
        <span id='nsf-logo' style='margin-left: 10px;'><a href='https://www.nsf.gov/'><%= image_tag('nsf_logo.png') %></a></span>
      </div>
      <div class="col-md-2 col-sm-6 col-xs-12 col-align col-align--center footer-section icons">   
        <a href="https://github.com/MorphoSource"><i class="fab fa-github fa-lg"></i></a>
        <a href="https://twitter.com/MorphoSource"><i class="fab fa-twitter fa-lg"></i></a>
        <a href="mailto:info@morphosource.org"><i class="fas fa-envelope fa-lg"></i></a>
      </div>
    </div>
  </div>
</footer>
