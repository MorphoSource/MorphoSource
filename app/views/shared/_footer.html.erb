<footer class="navbar navbar-inverse site-footer no-horizontal-padding" style='border: none'>
  <div class="container-fluid">
    <div class="row no-horizontal-padding">
      <div class="col-md-2 col-sm-6 col-xs-12 col-align col-align--top footer-section copyright">
        <%= link_to t('hyrax.footer.copyright_html', current_year: Time.now.year), 'https://www.morphosource.org' %>
      </div>
      <div class="col-md-4 col-sm-6 col-xs-12 col-align col-align--center footer-section footer-links">
        <div class="row">
          <%= render partial: "footer_section", locals: { links_yml: Hyrax.config.footer_community, label: "community" } %>
          <%= render partial: "footer_section", locals: { links_yml: Hyrax.config.footer_docs, label: "docs" } %>
          <%= render partial: "footer_section", locals: { links_yml: Hyrax.config.footer_resources, label: "resources" } %>
          <div class="col-xs-3 no-horizontal-padding">
            <div class="row" style='padding-top: 0;'><span class='footer-label'><%= t(:'hyrax.controls.terms_of_use') %></span></div>
            <div class="row footer-sublink"><%= link_to t("morphosource.docs.terms.label"), Rails.application.routes.url_helpers.terms_path %></div>
            <div class="row footer-sublink"><%= link_to t("morphosource.docs.contributor_terms.label"), Rails.application.routes.url_helpers.contributor_terms_path %></div>
          </div>
        </div>
      </div>
      <div class="col-md-4 col-sm-6 col-xs-12 col-align col-align--center footer-section support">
        <span>Support From: </span>
        <span id='duke-logo' style='margin-left: 10px;'><a href='https://www.duke.edu/'><%= image_tag('duke_logo.png') %></a></span>
        <span id='nsf-logo' style='margin-left: 10px;'><a href='https://www.nsf.gov/'><%= image_tag('nsf_logo.png') %></a></span>
      </div>
      <div class="col-md-2 col-sm-6 col-xs-12 col-align col-align--center footer-section icons">
        <a href="https://github.com/MorphoSource"><i class="fab fa-github fa-lg"></i></a>
        <a href="https://twitter.com/MorphoSource"><i class="fab fa-twitter fa-lg"></i></a>
        <a href="mailto:morphosource@duke.edu"><i class="fas fa-envelope fa-lg"></i></a>
      </div>
    </div>
  </div>
</footer>
