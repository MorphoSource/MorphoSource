<%
if ["device", "team", "project", "media_list", "seq_section_list", "rights_statement", "license"].include? params[:id]
  # For certain facets, use a different param containsTitle to lookup the value
  containsField = "facet.containsTitle"
else
  containsField = "facet.contains"
end
%>

<%= form_tag url_for, method: :get, class: "form-horizontal search-form ms-catalog-search mb-1", data: { blacklight_modal: "trigger" } do %>
  <%= render_hash_as_hidden_fields(search_state.params_for_search.except(:q, :search_field, :qt, :page, :utf8, :"facet.page", containsField)) %>
  <%= hidden_field_tag :search_field, 'all_fields' %>

    <div class="input-group">
      <%= text_field_tag containsField, params[containsField] , class: "q form-control", placeholder: t("morphosource.search.form.facet.placeholder") %>

      <div class="input-group-btn">
        <% if params[containsField] %>
          <%= link_to "Clear", url_for(:"facet.sort" => params["facet.sort"]), class: "btn btn-danger", data: { blacklight_modal: "trigger" } %>
        <% end %>
        <button type="submit" class="btn btn-primary">
          <%= t('hyrax.search.button.html') %>
        </button>
      </div><!-- /.input-group-btn -->
    </div><!-- /.input-group -->
  <% end %>