<div class="view-type pull-right">
  <span class="sr-only"><%= t('blacklight.search.view_title') %></span>
  <div class="view-type-group btn-group">
      <div class="btn-group choose-columns-bso">
        <button type="button" class="btn btn-primary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
          <i class="fa fa-columns"></i> <span class="caret"></span>
        </button>
        <ul class="dropdown-menu">
          <li><input type="checkbox" class="toggle-vis" data-column="0" checked="checked" /> ID</li>
          <li><input type="checkbox" class="toggle-vis" data-column="1" checked="checked" /> Manufacturer</li>
          <li><input type="checkbox" class="toggle-vis" data-column="2" checked="checked" /> Model</li>
          <li><input type="checkbox" class="toggle-vis" data-column="3" checked="checked" /> Modality</li>
          <li><input type="checkbox" class="toggle-vis" data-column="4" checked="checked" /> Description</li>
          <li><input type="checkbox" class="toggle-vis" data-column="4" checked="checked" /> Media</li>
          <li><input type="checkbox" class="toggle-vis" data-column="4" checked="checked" /> ARK</li>
        </ul>
      </div>
  </div>
</div>
