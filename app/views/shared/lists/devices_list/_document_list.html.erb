<table id="datatable-bso-list" class="table table-striped teams-projects">
  <caption class="sr-only">List of items in this team</caption>
  <thead>
  <tr>
    <th>ID</th>
    <th>Manufacturer</th>
    <th>Model</th>
    <th>Modality</th>
    <th>Description</th>
    <th>Imaging Events</th>
    <th>Media</th>
    <th>ARK</th>
    <% if @current_user&.can? :edit, @collection %>
      <th></th>
    <% end %>
  </tr>
  </thead>
  <tbody>
    <% if @current_user&.can? :edit, @collection %>
      <%= render partial: 'shared/lists/devices_list/edit_document_list_row', collection: @document_list, as: :document %>
    <% else %>
      <%= render partial: 'shared/lists/devices_list/document_list_row', collection: @document_list, as: :document %>
    <% end %>
  </tbody>
</table>
