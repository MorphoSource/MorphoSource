<tr id="document_<%= document.id %>">
  <td><%= link_to document.id, hyrax_device_path(document.id) %></td>
  <td><%= document['creator_tesim']&.first %></td>
  <td class="break-all"><%= document['title_ssi'] %></td>
  <td><%= device_modalities(document['modality_tesim']) %></td>
  <td><%= document['description_tesim']&.first %></td>
  <% device_media_count, device_imaging_event_count = device_media_and_imaging_event_counts(document.id) %>
  <td>
    <%= device_imaging_event_count %>
  </td>
  <td>
    <%= link_to(device_media_count, main_app.media_search_path({"f"=>{"media_device_id_ssim"=>["#{document.id}"]}})) %>
  </td>
  <td><%= document.date_uploaded %></td>
  <td class="text-center">
  <a title="Edit Device" class="btn btn-primary" href="<%= edit_hyrax_device_path(document.id) %>">Edit</a>
  </td>
</tr>
