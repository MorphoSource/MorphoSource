<% if @document_list.count > 0 %>
  <!-- Works -->
  <div class="hyc-blacklight hyc-bl-results">
    <%= form_tag(main_app.batch_add_to_cart_path, method: :post) do -%>
      <%= submit_tag("cart submit", class: 'hidden', id:'add-selected-to-cart-hidden') %>

      <table id="datatable-media-list" class="table table-striped teams-projects">
        <caption class="sr-only">List of media items in this team</caption>
        <thead>
        <tr>
          <th class="checkbox no-sort"><input type="checkbox" id="select-all-for-download" /></th>
          <th>&nbsp;<!-- thumbnail column --></th>
          <th>ID</th>
          <th><%= sortable_table_header('Part', 'part_ssi') %></th>
          <th><%= sortable_table_header('Object', 'physical_object_title_ssi') %></th>
          <% if response_includes_specimens?(@response) %>
            <th><%= sortable_table_header('Taxonomy', 'taxonomy_ssi') %></th>
          <% else %>
            <th><%= sortable_table_header('Description', 'short_description_ssi') %></th>
          <% end %>
          <th><%= sortable_table_header('Type', 'human_readable_media_type_ssi') %></th>
          <th><%= sortable_table_header('Date Added', 'date_uploaded_dtsi') %></th>
          <th><%= sortable_table_header('Publication Status', 'publication_status_ssi') %></th>
          <th class="remove-column">&nbsp;</th>
        </tr>
        </thead>
        <tbody>
          <% if @can_edit %>
            <%= render partial: 'shared/lists/media_list/edit_document_list_row', collection: @document_list, as: :document, locals: { collection_type: @collection.collection_type.title.downcase, member_ids: Morphosource::SolrService.new.get_docs("member_of_collection_ids_ssim:#{@collection.id}").map{|d| d["id"]} } %>
          <% else %>
            <%= render partial: 'shared/lists/media_list/document_list_row', collection: @document_list, as: :document %>
          <% end %>
        </tbody>
      </table>
    <% end # / form_tag %>
  </div>
<% end %>
