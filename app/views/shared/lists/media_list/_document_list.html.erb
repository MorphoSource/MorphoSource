<% if @document_list.count > 0 %>
  <!-- Works -->
  <div class="hyc-blacklight hyc-bl-results">
    <%= form_tag(main_app.batch_add_to_cart_path, method: :post) do -%>
      <%= submit_tag("cart submit", class: 'hidden', id:'add-selected-to-cart-hidden') %>

      <table id="datatable-media-list" class="table table-striped teams-projects">
        <caption class="sr-only">List of media items in this team</caption>
        <thead>
        <tr>
          <th class="checkbox no-sort"><input type="checkbox" id="select-all-for-download" /></th>
          <th>&nbsp;<!-- thumbnail column --></th>
          <th>ID</th>
          <th>Part</th>
          <th>Object</th>
          <th>Taxonomy</th>
          <th>Type</th>
          <th>Date Added</th>
          <th>Publication Status</th>
          <th class="remove-column">&nbsp;</th>
        </tr>
        </thead>
        <tbody>
          <%= render partial: 'morphosource/my/media/document_list_row', collection: @document_list, as: :document %>
        </tbody>
      </table>
    <% end # / form_tag %>
  </div>
<% end %>
