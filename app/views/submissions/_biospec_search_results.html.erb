<div id="submission_biospec_search_results">
  <div class="h4">
    <%= "Search Results" %>
  </div>
  <% if (@docs.nil? || @docs.empty?) && (@idigbio.nil? || @idigbio.empty?) %>
    <div id="empty_search_results">
      No Biological Specimens found in MorphoSource or IDigBio that match the search criteria.  Search again or create a new Biological Specimen.
    </div>
  <% else %>
    <% if (@docs.nil? || @docs.empty?) %>
      <div id="empty_search_results">
        No Biological Specimens found in MorphoSource that match the search criteria.
      </div>
    <% else %>
      <div id="submission_select_biospec">
        <%= f.input :biospec_id,
                    as: :radio_buttons,
                    collection: @docs.map{ |doc| [ doc.sortable_title, doc.id ]} %>
      </div>
    <% end %>
    <% if (@idigbio.nil? || @idigbio.empty?) %>
      <div id="empty_search_results">
        No Biological Specimens found in IDigBio that match the search criteria.
      </div>
    <% else %>
      <div id="submission_select_idigbio">
        <%= f.input :idigbio_id,
                    as: :radio_buttons,
                    collection: @idigbio.map{ |idb| [ idb['data']['dwc:scientificName'], idb['uuid'] ]} %>
      </div>
    <% end %>
    <div>
      <%= f.submit 'Continue with selected Biological Specimen', name: 'biospec_select', class: 'btn btn-primary', onclick: 'return isRadioSelected("submission[biospec_id]")' %>
      <%= f.submit 'Start Search Over', onclick: "gotoStep('new', '#submission_raw_or_derived_media_raw,#submission_choose_raw_or_derived_media_continue,#submission_biospec_or_cho_biospec,#submission_choose_biospec_or_cho_continue')", class: 'btn btn-primary' %>
    </div>
  <% end %>
</div>
