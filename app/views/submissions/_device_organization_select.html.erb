<div id="submission_device_organization_select">
  <h5><%= t('morphosource.submission.organization_select') %></h5>
  <div>
    <%= f.submit 'No organization', name: 'no_organization', class: 'btn btn-primary', role: 'button' %>
  </div>

  <h5>Select an existing organization</h5>
  <div class="form-group">
    <div class="form-inline">
      <% # if a new organization has been added previously, add it to the select dropdown manually (since the work has not been created yet)
      if session[:submission_organization_create_params].present? 
        new_organization_title = session[:submission_organization_create_params][:title].first
        organization_selector_new = organization_selector.unshift([new_organization_title, "new_organization_id_to_be_created"])
      else
        organization_selector_new = organization_selector
      end
      %>
      <%= f.input :device_organization_id, collection: organization_selector_new, prompt: 'Select organization', label: false %>
    </div>
    <div>
      <%= f.submit 'Continue with selected organization', name: 'organization_select', class: 'btn btn-primary', role: 'button', onclick: 'return isDropdownSelected("submission[device_organization_id]")' %>
    </div>
  </div>

  <div id="submission_choose_create_device_insititution">
    <a href="#" id="submission_show_create_device_organization" class="btn btn-primary">Create New Organization</a>
  </div>
</div>
