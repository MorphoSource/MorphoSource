<div id="submission_organization_select">
  <h5><%= t('morphosource.submission.organization_select') %></h5>
  <div>
    <%= f.submit 'No organization', name: 'no_organization', class: 'btn btn-primary', role: 'button' %>
  </div>
  <% if organizations.present? %>
    <h5>Select an existing organization</h5>
    <div class="form-group">
      <div class="form-inline">
        <%# TODO: Width set to an arbitrary pixel value for now.  This is probably not appropriate for accessibility. %>
        <%= f.input :organization_id, collection: organization_selector, prompt: 'Select organization', label: false %>
      </div>
      <div>
        <%= f.submit 'Continue with selected organization', name: 'organization_select', class: 'btn btn-primary', role: 'button', onclick: 'return isDropdownSelected("submission[organization_id]")' %>
      </div>
    </div>
  <% end %>
  <div id="submission_choose_create_insititution">
    <a href="#" id="submission_show_create_organization" class="btn btn-primary">Create New Organization</a>
  </div>
</div>
