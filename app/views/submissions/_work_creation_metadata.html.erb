<div class="base-terms">
  <% f.object.primary_terms.each do |term| %>
    <% if term == :date_created %>
      <div class="row">
        <div class="col-xs-6 showcase-label">Date created</div>
        <div class="col-xs-6 showcase-value">
          <%= f.date_field :date_created, wrapper: :inline, value: f.object.date_created, class: 'datepicker form-control' %>
        </div>
      </div>
    <% elsif term == :description && f.object.model.class == ImagingEvent %>
      <%= render_edit_field_partial(term, f: f) %>
      <%= render_edit_field_partial(
        'attachment', 
        f: f, 
        field: 'ie_description', 
        label: 'Description attachment file',
        curation_concern: nil
      ) %>
    <% else %>
      <%= render_edit_field_partial(term, f: f) %>
    <% end %>
  <% end %>
</div>
<% if f.object.display_additional_fields? %>
  <div class="additional-terms">
    <% f.object.secondary_terms.each do |term| %>
      <%= render_edit_field_partial(term, f: f) %>
    <% end %>
  </div>
<% end %>
