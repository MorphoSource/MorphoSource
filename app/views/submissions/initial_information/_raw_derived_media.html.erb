<div id="submission_choose_raw_or_derived_media" class="submission_section submission-v2">	
  <%= simple_form_for @submission, html: {id: :raw_or_derived_form } do |f| %>
    <div class="container">
      <div class="row justify-content-center text-center">
        <div class="col-md-9">
          <span class="h5"><%= t('morphosource.submission.header_text.initial_information') %></span>
        </div>
      </div>

        <% if Flipflop.proxy_deposit? && current_user.can_make_deposits_for.any? 
            my_name = current_user.display_name.present? ? "(#{current_user.display_name})" : ""
          %>
          <div class="row justify-content-center">
            <div class="col-md-9 col-lg-6">
              <%= f.input :on_behalf_of, label: 'Which user are you depositing this media for?', 
                collection: current_user.can_make_deposits_for.map{ |u| [u.display_name, u.user_key] }, prompt: "Myself #{my_name}" %>
            </div>
          </div>
        <% end %>

        <% if current_user.fund_codes.present? %>
          <div class="row justify-content-center">
            <div class="col-md-9 col-lg-6">
              <%= f.input :fund_code, label: 'What fund code supports this deposit?', 
                collection: current_user.fund_codes.where(can_add_media: true), prompt: "None (Data Supported By MorphoSource)" %>
            </div>
          </div>
          
        <% end %>

      	<div class="row justify-content-center mt-2">
          <div class="col-md-9 col-lg-6">
      		  <%= render_edit_field_partial('submission_media_type', f: f) %>
          </div>
      	</div>
      	<div class="row justify-content-center">
          <div class="col-md-9 col-lg-6">
      		  <%= render_edit_field_partial('submission_modality', f: f) %>
      	  </div>
        </div>
      
      <div id="submission-suggestions-container" class="row justify-content-center mt-2 hide">
    		<div class="col-md-9 col-lg-6">
          <div class="block p-3">
            <div>
              <b><%= t('morphosource.submission.raw_or_derived_suggestions') %></b>
            </div>
            <div class="mt-1">
              <span id="submission-suggestions"></span>
            </div>
            <div id="submission-suggestions-examples" class="row mt-2 text-left hide raw-derived-list">
              <div class="col-md-6">
                <div><b>Raw</b></div>
                <div><ul id="submission-suggestions-examples-raw"></ul></div>
              </div>
              <div class="col-md-6">
                <div><b>Derived</b></div>
                <div><ul id="submission-suggestions-examples-derived"></ul></div>
              </div>
            </div>
          </div>
    		</div>
    	</div>

      <div id="submission-raw-or-derived-section" class="row justify-content-center text-center hide">
        <div class="col-md-4 raw-or-derived-form-group">
          <div>
            <label class="col-form-label" for="raw-or-derived-btn-group">
              <%= t('morphosource.submission.raw_or_derived') %>
            </label>
          </div>
          <div id="raw-or-derived-btn-group" class="btn-group btn-group-toggle" data-toggle="buttons">
            <label class="btn btn-primary" id="radio_raw">
              <input type="radio" name="radio_raw_option" id="radio_raw_option" autocomplete="off" checked> 
              <%= t('morphosource.submission.raw') %>
            </label>
            <label class="btn btn-primary" id="radio_derived">
              <input type="radio" name="radio_derived_option" id="radio_derived_option" autocomplete="off"> 
              <%= t('morphosource.submission.derived') %>
            </label>
          </div>
        </div>
      </div>

      <div class="row  justify-content-center mt-3">
        <%= f.submit t('morphosource.submission.continue'), class: "btn btn-primary btn-continue" %>
      </div>
  	</div class="container">
  <% end %>
</div>
