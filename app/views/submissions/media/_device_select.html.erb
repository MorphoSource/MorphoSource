<%= simple_form_for @submission, html: { id: :submission_device_select_form } do |f| %>
  <div class="row justify-content-center text-center mt-3">
    <div class="col-md-9 col-lg-6">

      <div class="submission-select2-container">
        <%= f.input :organization_search,
          label: 'First, find the organization that manages the device.',
          input_html: {
            id: :submission_device_select_organization_search
          }
        %>
      </div>

      <% if Hyrax.config.null_organization_id.present? && ( Organization.exists?(Hyrax.config.null_organization_id) || OrganizationCollection.exists?(Hyrax.config.null_organization_id) ) %>
        <div class='mt-3'>
          <b><%= t('morphosource.submission.or') %></b>
        </div>

        <div class="mt-3">
          <a href="#" id="submission_select_device_no_organization" class="btn btn-primary btn-continue">
            <%= t('morphosource.submission.no_organization') %>
          </a>
        </div>
      <% end %>

      <div class="submission-select2-container mt-4">
        <%= f.input :device_id,
          collection: [],
          label: 'Then select from devices associated with the organization.',
          required: true,
          wrapper_html: { class: 'required-flag-hidden' },
          disabled: true
        %>
      </div>
    </div>
  </div>
<% end %>

<div class="row justify-content-center mt-5">
  <a href="#" id="submission_select_device_continue" class="btn btn-primary btn-continue" disabled="disabled">
    <%= t('morphosource.submission.continue') %>
  </a>
</div>