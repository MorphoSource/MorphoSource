<div id="submission_device_select_display" class="mt-2 <%= device_attrs.empty? ? 'hide' : '' %>">
<div class="block p-3">
  <h2 class="d-flex justify-content-between align-items-center">
    Selected Organization 
    <i id="device-select-close" class="float-right fa-lg fas fa-times clickable" style="margin-top: 2px;"></i>
  </h2>

  <div class="row">
    <div class="col-6 showcase-label">Model</div>
    <div class="col-6 showcase-value" id='device-display-title'><%= device_attrs['title'] %></div>
  </div>
  <div class="row">
    <div class="col-6 showcase-label">Manufacturer</div>
    <div class="col-6 showcase-value" id='device-display-creator'><%= device_attrs['creator'] %></div>
  </div>
  <div class="row">
    <div class="col-6 showcase-label">Modality</div>
    <div class="col-6 showcase-value break-all" id='device-display-modality'><%= device_attrs['modality'] %></div>
  </div>
  <div class="row">
    <div class="col-6 showcase-label">Description</div>
    <div class="col-6 showcase-value" id='device-display-description'><%= device_attrs['description'] %></div>
  </div>
</div>
</div>