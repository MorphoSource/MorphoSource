<div id="submission_image_capture" class="submission_flow submission_section submission-v2 hide">
  <%= simple_form_for @imaging_event_form, wrapper: :showcase_default do |f| %>
    <% if Flipflop.proxy_deposit? && current_user.can_make_deposits_for.any? %>
      <div class="hide">
      <%= f.input :on_behalf_of, 
        collection: current_user.can_make_deposits_for.map{ |u| [u.display_name, u.user_key] }, 
        prompt: "Myself" %>
      </div>
    <% end %>
  	<div class="container">
      <div class="row justify-content-center text-center">
        <div class="col-md-9">
          <span class="h5"><%= t('morphosource.submission.header_text.media_imaging') %></span>
        </div>
      </div>

      <div class="row">
        <!-- left column  -->
        <div class="col-lg-6">
          <div class="showcase showcase-edit showcase-section mt-2">
            <h2 class="d-flex justify-content-between align-items-center">
              Imaging General Details
            </h2>
            <div class="content-block">
              <%= render partial: 'work_creation_metadata_terms', locals: { f: f, terms: f.object.universal_terms, term_group: 'base-terms' } %>
            </div>
          </div>
        </div>

          <!-- right column  -->
        <div class="col-lg-6">
          <div class="showcase showcase-edit showcase-section mt-2">
            <h2 class="d-flex justify-content-between align-items-center">
              Modality Specific Details
            </h2>
            <div class="content-block">
              <%= render partial: 'work_creation_metadata_terms', locals: { f: f, terms: f.object.modality_specific_terms, term_group: 'base-terms' } %>
            </div>
          </div>
        </div>
      </div>

      <div class="row justify-content-center mt-3">
        <%= f.submit t('morphosource.submission.continue'), 
            class: "btn btn-primary btn-continue", 
            id: 'submission_create_imaging_event_submit' 
        %>
      </div>
    </div>
  <% end %>
</div>