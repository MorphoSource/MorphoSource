<div id="submission_media" class="submission_flow submission_section submission-v2 hide">
  <div class="hide">
    <span id="organization-alert-message"></span>
  </div>
  <div class="container">
    <div class="row justify-content-center text-center">
      <div class="col-md-9">
        <span class="h5"><%= t('morphosource.submission.header_text.media_details') %></span>
      </div>
    </div>

    <%= simple_form_for media_form,
    wrapper: :showcase_default,
    url: { controller: 'submissions', action: 'create' },
    html: {
      data: { behavior: 'work-form', 'param-key' => 'media' },
      multipart: true
    } do |f| %>
      <% if Flipflop.proxy_deposit? && current_user.can_make_deposits_for.any? %>
        <div class="hide">
          <%= f.input :on_behalf_of,
          collection: current_user.can_make_deposits_for.map{ |u| [u.display_name, u.user_key] },
          prompt: "Myself" %>
        </div>
      <% end %>
      <%= f.hidden_field :accepted_formats, :value => "" %>
      <div class="row">
        <!-- file upload column -->
        <div class="col-lg-6 order-lg-2">
          <div class="showcase showcase-edit showcase-section mt-2">
            <h2 class="required-flag">Upload File <span class="badge badge-info"></span></h2>
            <div class="content-block">
              <ul class="nav nav-tabs pt-0" role="tablist">
                <li role="presentation" id="tab-local-file-section" class="nav-item active">
                  <a href="#local-file-section" aria-controls="local-file-section" role="tab" data-toggle="tab" aria-expanded="false" class="nav-link active">
                  Upload From Computer / Cloud
                  </a>
                </li>
                <li role="presentation" id="tab-remote-file-section" class="nav-item hide">
                  <a href="#remote-file-section" aria-controls="remote-file-section" role="tab" data-toggle="tab" aria-expanded="false" class="nav-link">
                  Remote File Location
                  </a>
                </li>
              </ul>

              <!-- Tab panes -->
              <div class="tab-content tab-borders mt-0">
                <div role="tabpanel" class="tab-pane active" id="local-file-section">
                  <div class="form-tab-content">
                    <%= render 'hyrax/media/form_files_edit', f: f %>
                  </div>
                </div>
                <div role="tabpanel" class="tab-pane hide" id="remote-file-section">
                  <div class="form-tab-content">
                    <%= render 'hyrax/media/form_files_remote', f: f %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="showcase showcase-edit showcase-section mt-2">
            <%= render 'submissions/media/custom_thumbnail', f: f %>
          </div>
        </div>

        <!-- general details column -->
        <div class="col-lg-6 order-lg-1">
          <div class="showcase showcase-edit showcase-section mt-2">
            <h2>General Details</h2>
            <div class="content-block">
              <%= render_edit_field_partial('media_type', f: f) %>
              <%= f.input :part, label: 'Element or part of the object', as: :multi_value %>
              <%= f.input :short_title, placeholder: 'Custom title here' %>
              <%= render_edit_field_partial('custom_title_case_sensitive', f: f) %>
              <%= render_edit_field_partial('side', f: f) %>
              <%= f.input :orientation, as: :multi_value %>
              <%= f.input :short_description, label: 'Short description' %>
              <%= render_edit_field_partial('description', f: f) %>
              <%= f.input :creator, as: :multi_value %>
              <div class="row">
                <div class="col-6 showcase-label">Date created</div>
                <div class="col-6 showcase-value">
                <%= f.date_field :date_created, wrapper: :inline, value: f.object.date_created || Date.today, class: 'datepicker form-control' %>
                  </div>
              </div>
            </div>
          </div>
        </div>

        <!-- ownership and permissions column -->
        <div class="col-lg-6 order-lg-3">
          <div class="showcase showcase-edit showcase-section mt-2">
            <h2>Ownership And Permissions</h2>
            <%= render 'submission_media_ownership', f: f %>
          </div>

          
        </div>

        <!-- collections, tags, and external identifiers column -->
        <div class="col-lg-6 order-lg-4">
          <div id="file-object-details" class="showcase showcase-edit showcase-section mt-2">
            <h2>File Object Details</h2>

            <div class="content-block">
              <%= render 'submissions/media/edit_file_object_details', f: f %>
            </div>
          </div>

          <div class="showcase showcase-edit showcase-section mt-2">
            <h2>Projects and Teams</h2>

            <% if @submission.collection_id %>
              <div class="row">
                <div class="content-block">
                  <span>Media will be added to <%= @submission.collection_name %>. Add to additional teams and projects below if desired.</span>
                  <input class="collection_id" type="hidden" name="collection_id" value="<%= @submission.collection_id %>" />
                </div>

              </div>
            <% end %>

            <div class="content-block">
              <%= render 'submissions/media/form_member_of_collections', f: f %>
            </div>
          </div>

          <div class="showcase showcase-edit showcase-section mt-2">
            <h2>Media Tags</h2>
            <div class="content-block">
              <%= render 'submissions/media/tags', f: f %>
            </div>
          </div>

          <div class="showcase showcase-edit showcase-section mt-2">
            <h2>Identifiers And External Links</h2>
            <div class="content-block">
              <%= f.input :identifier, label: 'External identifier' %>
              <%= f.input :related_url, label: 'External media URL' %>
            </div>
          </div>
        </div>
      </div>

      <div class="row justify-content-center mt-3">
        <%= f.submit 'Submit Media', class: "btn btn-primary btn-continue btn-save-media", id: :media_submit %>
      </div>

    <% end %>
  </div>
</div>
