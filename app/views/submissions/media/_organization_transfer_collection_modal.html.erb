<!-- Modal used to warn user about organizational media transfer -->
<div class="modal fade" id="organizationTransferCollectionModal" tabindex="-1" role="dialog" aria-labelledby="requestModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h1>
          Important: Organization Media Transfer
        </h1>
      </div>
      <div class="modal-body">
        <p><%= t("morphosource.submission.organization_data_management_for_collection1").html_safe %></p>
        <p><%= t("morphosource.submission.organization_data_management_for_collection2").html_safe %></p>
      </div>
      <div class="modal-footer">
        <button type="button" id="modal-okay" class="btn btn-primary" data-dismiss="modal">I Understand</button>
      </div>
    </div><!-- /.modal-content -->
  </div><!-- /.modal-dialog -->
</div><!-- /.modal -->
