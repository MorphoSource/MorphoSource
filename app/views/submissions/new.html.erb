<% provide :page_title, t('morphosource.submission.page_title') %>

<script type="text/javascript">
  var submissionYaml = <%= json_escape(YAML.load_file(Rails.root.join('config','submission.yml')).to_json.html_safe) %>;
  var orgData = <%= @organizations_select2.to_json.html_safe %>;
  var nullOrg = <%= @null_organization.to_json.html_safe %>;
  var deviceData = <%= @devices_with_ids.to_json.html_safe %>;
  var findMediaUrl = "<%= find_media_autocomplete_url.html_safe %>";
  var findTaxonomyUrl = "<%= find_taxonomy_submission_autocomplete_url.html_safe %>";
</script>

<div class="submission_flow" id="submission_new">
	<% # All form partials loaded, submission.js used To control visibility %>
	<% # Initial Information %>
  <%= render(partial: 'submissions/initial_information/raw_derived_media') %>
  <%= render(partial: 'submissions/initial_information/parents_in_ms') %>
  <% # Physical Object %>
  <%= render(partial: 'submissions/physical_object/physical_object') %>
  <%= render(partial: 'submissions/physical_object/organization') %>
  <%= render(partial: 'submissions/physical_object/taxonomy') %>
  <%= render(partial: 'submissions/physical_object/physical_object_details') %>
  <% # Media %>
  <%= render(partial: 'submissions/media/device') %>
  <%= render(partial: 'submissions/media/image_capture') %>
  <%= render(partial: 'submissions/media/processing_event') %>
  <div id="media-container">
    <%= render(partial: 'submissions/media/media', locals: { media_form: @media_form }) %>
  </div>
</div>
