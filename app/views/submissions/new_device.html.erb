<div>
	<h2>NEW DEVICE</h2>

	<p>Create a new device by filling in fields below and selecting Create new device. You can also go back and select device instead. </p>

	<%= simple_form_for @device_form, url: new_device_submit_submissions_url do |f| %>
	  <div class="form-group">
	    <%= render partial: 'work_creation_metadata', locals: {f: f} %>
	    <div>
	      <%= f.submit 'Create new device', class: "btn btn-primary" %>
			  <button type="button" class="btn btn-secondary cancel">Cancel</button>
	    </div>
	  </div>
	<% end %>

</div>