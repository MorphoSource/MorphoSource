<div>
	<h2>NEW INSTITUTION</h2>
	
	<p>Create a new taxonomy by filling in fields below and selecting Create New Taxonomy. You can also go back and <a class="cancel">select taxonomy</a> instead. </p>

	<%= simple_form_for @taxonomy_form, url: new_taxonomy_submit_submissions_url do |f| %>
	  <div class="form-group">
	    <%= render partial: 'work_creation_metadata', locals: {f: f} %>
	    <div>
	      <%= f.submit 'Create New Taxonomy', class: "btn btn-primary" %>
			  <button type="button" class="btn btn-secondary cancel">Cancel</button>
	    </div>
	  </div>
	<% end %>
</div>