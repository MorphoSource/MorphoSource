<div id="submission_create_cho_details">
  <%= simple_form_for @cho_form, wrapper: :showcase_default do |f| %>
    <div class="row">
      <!-- left column  -->
      <div class="col-xs-12 col-md-6">

        <div class="block showcase-edit showcase-section">
          <div class="row showcase-section-header">
            <span class="h2">OBJECT IDENTIFIERS AND EXTERNAL LINKS</span>
          </div>

          <div class="content-block">
            <%= f.input :vouchered, as: :select,
                collection: ['Yes','No'],
                include_blank: true,
                # item_helper: method(:include_current_value),
                input_html: { class: 'form-control' },
                label_wrapper_html: { class: 'required-flag' } 
            %>
            <%= f.input :institution_code, collection: [], label_wrapper_html: { class: 'recommended-flag' }  %>
            <%= f.input :collection_code, collection: [], label_wrapper_html: { class: 'recommended-flag' }  %>
            <%= f.input :catalog_number, label_wrapper_html: { class: 'recommended-flag' }  %>
            <%= f.input :short_title, label_wrapper_html: { class: 'recommended-flag' }  %>
            <%= f.input :identifier, as: :multi_value %>
            <%= f.input :related_url, as: :multi_value %>
          </div>
        </div>

        <div class="block showcase-edit showcase-section">
          <div class="row showcase-section-header">
            <span class="h2">TIME AND PLACE DETAILS</span>
          </div>

          <div class="content-block">
            <%= f.input :periodic_time, label: 'Time Period', as: :multi_value %>
            <%= f.input :based_near, label: 'Current Location', as: :controlled_vocabulary %>
            <%= f.input :original_location %>
            <!--  todo: the html below can be removed if simpleform config wrapper can be used.  In that case, we need to figure out pass the content for the tooltip
            <div class="form-group row">
                <div class="col-xs-12 showcase-label">
                    <label class="control-label">Geographical coordinates</label><span class="glyphicon glyphicon-question-sign tooltip-icon" data-original-title="" title=""></span>
                </div>
            </div>
            -->
            <%= f.input 'Geographical coordinates', value_wrapper: false %>
            <%= f.input :latitude, tooltip_wrapper: false, label_wrapper_html: { class: 'indent' } %>
            <%= f.input :longitude, tooltip_wrapper: false, label_wrapper_html: { class: 'indent' } %>
            <%= f.input :numeric_time, label: 'Absolute Age' %>
          </div>
        </div>

      </div>
      <!-- /left column  -->

      <!-- right column  -->
      <div class="col-xs-12 col-md-6">

        <div class="block showcase-edit showcase-section">
          <div class="row showcase-section-header">
            <span class="h2">GENERAL DETAILS</span>
          </div>
          
          <div class="content-block">
            <%= f.input :description, label: 'Description' %>
            <%= f.input :cho_type, as: :multi_value %>
            <%= f.input :material, as: :multi_value %>
            <%# todo: render date_field in simple_form_bootstrap %>
            <div class="row">
              <div class="col-xs-6 showcase-label">Date created</div>
              <div class="col-xs-6 showcase-value">
              <%= f.date_field :date_created, wrapper: :inline, value: f.object.date_created || Date.today, class: 'datepicker form-control' %>
                </div>
            </div>
            <%= f.input :creator, as: :multi_value %>
            <%= f.input :contributor, as: :multi_value %>
            <%= f.input :publisher %>
          </div>
        </div>

      </div>
      <!-- / right column -->
    </div>

    <div class="row">
      <%= f.submit t('morphosource.submission.continue'), 
        class: "btn btn-primary btn-continue", 
        id: 'submission_create_cho_continue' 
      %>
    </div>
  <% end %>
</div>
