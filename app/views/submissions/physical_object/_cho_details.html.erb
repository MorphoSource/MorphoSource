<div id="submission_create_cho_details">
  <%= simple_form_for @cho_form, wrapper: :showcase_default do |f| %>
    <% if Flipflop.proxy_deposit? && current_user.can_make_deposits_for.any? %>
      <div class="hide">
      <%= f.input :on_behalf_of,
        collection: current_user.can_make_deposits_for.map{ |u| [u.display_name, u.user_key] },
        prompt: "Myself" %>
      </div>
    <% end %>
    <div class="row">
      <!-- left column  -->
      <div class="col-12 col-md-6">

        <div class="block showcase-edit showcase-section">
          <div class="row showcase-section-header">
            <span class="h2">IDENTIFIERS AND EXTERNAL LINKS</span>
          </div>
          <div class="content-block">
            <%= render 'hyrax/cultural_heritage_objects/edit/identifiers', f: f %>
          </div>
        </div>

        <div class="block showcase-edit showcase-section">
          <div class="row showcase-section-header">
            <span class="h2">OBJECT DETAILS</span>
          </div>

          <div class="content-block">
            <%= render 'hyrax/cultural_heritage_objects/edit/object_details', f: f %>
          </div>
        </div>

      </div>
      <!-- /left column  -->

      <!-- right column  -->
      <div class="col-12 col-md-6">

        <div class="block showcase-edit showcase-section">
          <div class="row showcase-section-header">
            <span class="h2">OBJECT DATING</span>
          </div>

          <div class="content-block">
            <%= render 'hyrax/cultural_heritage_objects/edit/object_dating', f: f %>
          </div>
        </div>

        <div class="block showcase-edit showcase-section">
          <div class="row showcase-section-header">
            <span class="h2">OBJECT ORIGINAL LOCATION</span>
          </div>

          <div class="content-block">
            <%= render 'hyrax/cultural_heritage_objects/edit/original_location', f: f %>
          </div>
        </div>

        <div class="block showcase-edit showcase-section">
          <div class="row showcase-section-header">
            <span class="h2">PROVENANCE</span>
          </div>

          <div class="content-block">
            <%= render 'hyrax/cultural_heritage_objects/edit/provenance', f: f %>
          </div>
        </div>

      </div>
      <!-- / right column -->
    </div>

    <div class="row">
      <%= f.submit t('morphosource.submission.continue'),
        class: "btn btn-primary btn-continue",
        id: 'submission_create_cho_continue'
      %>
    </div>
  <% end %>
</div>
