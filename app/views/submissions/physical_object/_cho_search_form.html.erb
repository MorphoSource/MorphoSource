<!-- Bootstrap container-fluid class div is in parent view partial -->
<div id="submission_cho_search_form" class="new_media">
  <div class="row">
    <h4><%= t('morphosource.submission.header_text.cho_search') %></h4>
  </div>

  <%= simple_form_for @submission, 
    url: {controller: 'submissions', action: 'search_po_ajax'},
    html: { id: :cho_search_ajax_form },
    method: :post,
    remote: true do |f| %>
    <div class="form-group">
      <div class="row">
        <div class="col-sm-6 col-sm-offset-3">
          <%= f.input :cultural_heritage_object_search_occurrence_id, input_html: { class: 'form-control-sm' } %>
        </div>
      </div>

      <div class="row">
        <div class="col-sm-2 col-sm-offset-3">
          <%= f.input :cultural_heritage_object_search_institution_code, input_html: {class: 'form-control-sm'} %>
        </div>
        <div class="col-sm-2">
          <%= f.input :cultural_heritage_object_search_collection_code, input_html: { class: 'form-control-sm' } %>
        </div>
        <div class="col-sm-2">
          <%= f.input :cultural_heritage_object_search_catalog_number, input_html: {class: 'form-control-sm'} %>
        </div>
      </div>

      <div class="row">
        <div class="col-sm-6 col-sm-offset-3">
          <%= f.input :cultural_heritage_object_search_short_title, input_html: { class: 'form-control-sm' } %>
        </div>
      </div>

      <div class="row hide">
          <%= f.input :biological_specimen_or_cultural_heritage_object, 
            :as => :hidden, 
            :input_html => { :value => "cho" } 
          %> 
        </div>
    </div>

    <div>
      <div class="row">
        <%= f.submit 'Search', name: 'cho_search', class: 'btn btn-primary btn-continue' %>
      </div>
    </div>
  <% end %>
  
  <div id="cho_search_non_search_options">
    <div class="row">
      <b><%= t('morphosource.submission.or') %></b>
    </div>

    <div class="row">
      <a href="#" id="submission_will_create_cho" class="btn btn-primary btn-continue">
        <%= t('morphosource.submission.new_object') %>  
      </a>
    </div>

    <div class="row">
      <b><%= t('morphosource.submission.or') %></b>
    </div>

    <div class="row">
      <a href="#" class="btn btn-primary btn-continue submission_back_to_po_type">
        <%= t('morphosource.submission.go_back') %>  
      </a>
    </div>
  </div>
</div>
