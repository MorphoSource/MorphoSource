<div id="submission_create_eo_details">
  <%= simple_form_for @eo_form, wrapper: :showcase_default do |f| %>
    <div class="row">
      <!-- left column  -->
      <div class="col-xs-12 col-md-6">

        <div class="block showcase-edit showcase-section">
          <div class="row showcase-section-header">
            <span class="h2">ENGINEERING OBJECT IDENTIFIERS AND EXTERNAL LINKS</span>
          </div>

          <div class="content-block">
            <%= f.input :institution_code, collection: [], label_wrapper_html: { class: 'recommended-flag' }  %>
            <%= f.input :catalog_number, label_wrapper_html: { class: 'recommended-flag' }  %>
            <%= f.input :identifier, as: :multi_value %>
            <%= f.input :related_url, as: :multi_value %>
          </div>
        </div>

        <div class="block showcase-edit showcase-section">
          <div class="row showcase-section-header">
            <span class="h2">ENGINEERING OBJECT META DATA</span>
          </div>
          <%= f.input :is_pak, collection: ['Yes', 'No'] %>
          <%= f.input :is_built_in_fiducials_present, collection: ['Yes', 'No'] %>
          <%= f.input :snl_assembler %>
          <div class="row">
            <div class="col-xs-6 showcase-label">Assembly Date</div>
            <div class="col-xs-6 showcase-value">
            <%= f.date_field :assembly_date, wrapper: :inline, value: f.object.assembly_date || Date.today, class: 'datepicker form-control' %>
              </div>
          </div>
          <%= f.input :preparation_notes %>
          <%= f.input :anonymize_origin, collection: ['NOT Anonymize Origin', 'Anonymize Origin'] %>
          <%= f.input :anonymize_meta_data, collection: ['NOT Anonymize Meta Data', 'Anonymize Meta Data'] %>
        </div>
      </div>
      <!-- /left column  -->

      <!-- right column  -->
      <div class="col-xs-12 col-md-6">

        <div class="block showcase-edit showcase-section">
          <div class="row showcase-section-header">
            <span class="h2">GENERAL DETAILS</span>
          </div>
          
          <div class="content-block">
            <%= f.input :description, label: 'Description' %>
            <div class="row">
              <div class="col-xs-6 showcase-label">Date created</div>
              <div class="col-xs-6 showcase-value">
              <%= f.date_field :date_created, wrapper: :inline, value: f.object.date_created || Date.today, class: 'datepicker form-control' %>
                </div>
            </div>
            <%= f.input :creator, as: :multi_value %>
            <%= f.input :contributor, as: :multi_value %>
            <%= f.input :publisher %>
          </div>
        </div>

      </div>
      <!-- / right column -->
    </div>

    <div class="row">
      <%= f.submit t('morphosource.submission.continue'), 
        class: "btn btn-primary btn-continue", 
        id: 'submission_create_eo_continue' 
      %>
    </div>
  <% end %>
</div>
