<div id="submission_organization" class="submission_section submission_flow submission-v2 hide">
  <div class="container">
    <div class="row justify-content-center text-center">
      <div class="col-md-9">
        <span class="h5"><%= t('morphosource.submission.header_text.po_organization') %></span>
      </div>
    </div>

    <div id="submission_select_organization_section">
      <%= simple_form_for @submission, html: { id: :organization_search_form } do |f| %>

        <%= render(partial: 'submissions/physical_object/organization_select', locals: { f: f }) %>

        <div id="submission_organization_select_display_container">
          <div class="row justify-content-center">
            <div class="col-md-9 col-lg-6 showcase showcase-section">
              <%= render(partial: 'submissions/physical_object/organization_select_display') %>
            </div>
          </div>
        </div>

        <div class="row justify-content-center mt-3">
          <%= f.submit t('morphosource.submission.continue'), id: 'submission_select_organization', class: 'btn btn-primary btn-continue', disabled: true %>
        </div> 

      <% end %>
    </div>

    <!-- only admins can select 'no organization' -->
    <% if current_user.admin? %>
      <div id="submission_no_organization_section">
        <div class="row justify-content-center mt-1">
          <b><%= t('morphosource.submission.or') %></b>
        </div>

        <div class="row justify-content-center mt-1">
          <a href="#" id="submission_no_organization" class="btn btn-primary btn-continue">
            <%= t('morphosource.submission.no_organization') %>
          </a>
        </div>
      </div>
    <% end %>

    <div id="submission_no_organization_display_section" class="hide">
      <div class="row justify-content-center mt-2">
        <div class="col-md-9 col-lg-6">
          <div class="block p-3">
            <div class="d-flex justify-content-between align-items-center">
              <span class="label-padding"><b>Object not managed by organization</b></span>
              <i id="no-organization-close" class="fas fa-lg fa-times clickable"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="row justify-content-center mt-2 text-left">
      <div class="col-md-9 col-lg-6 text-left">
        <div class="block p-3">
          <%= t('morphosource.submission.cant_find_organization').html_safe %>
        </div>
      </div>
    </div>
  </div>
</div>
