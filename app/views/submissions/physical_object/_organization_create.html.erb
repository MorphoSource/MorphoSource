<%= simple_form_for @organization_form, wrapper: :showcase_default do |f| %>
<div class="row">
	<div id="submission_organization_create" class="col-sm-8 col-sm-offset-2 block showcase showcase-edit showcase-section form-group">
	  <div class="row showcase-section-header">
	    <span class="h2">CREATE NEW ORGANIZATION</span>
	    <i id="organization-create-close" class="fas fa-times clickable" style='float: right;'></i>
	  </div>
	  
    <div class="form-group">
      <%= render partial: 'work_creation_metadata', locals: {f: f} %>
    </div>
	</div>
</div>

<div class="row">
  <%= f.submit t('morphosource.submission.continue'), 
    class: "btn btn-primary btn-continue", 
    id: 'submission_create_organization_continue' 
  %>
</div>
<% end %>
