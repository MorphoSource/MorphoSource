  </div>

  <div class="row text-left">
    <div class="col-xs-6 showcase-label"><%= t('simple_form.labels.organization.state_province') %></div>
    <div class="col-xs-6 showcase-value" id="state_province"></div>
  </div>

  <div class="row text-left">
    <div class="col-xs-6 showcase-label"><%= t('simple_form.labels.organization.postal_code') %></div>
    <div class="col-xs-6 showcase-value" id="postal_code"></div>
