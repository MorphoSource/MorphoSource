<div id="submission_taxonomy" class="submission_section submission_flow submission-v2 hide">
  <div class="container-fluid">

    <div class="row">
      <h4><%= t('morphosource.submission.header_text.po_taxonomy') %></h4>
    </div>
  
   
    <div id="submission_select_taxonomy_section">
      <%= simple_form_for @submission, html: { id: :taxonomy_search_form } do |f| %>
        <div class="row">
          <div class="col-xs-12 col-sm-6 col-sm-offset-3 no-padding">
            <%= f.input :taxonomy_search,
            placeholder: "Enter taxonomy keywords here",
            input_html: { class: 'form-control' } %>
          </div>
        </div>

        <div>
          <a id="btn_add_taxonomy" class="hide btn btn-primary">Add</a>
        </div>
        <div id="taxonomies" class="row">
          <input class="taxonomy_title" type="hidden" name="taxonomy_title" value="" />
          <input class="taxonomy_id" type="hidden" name="taxonomy_id" value="" />
          <input class="taxonomy_gbif_key" type="hidden" name="taxonomy_gbif_key" value="" />
          <div class="taxonomy_row">
          </div>
        </div>
      <% end %>
    </div>

    <div class="row">
      <b><%= t('morphosource.submission.and_or') %></b>
    </div>

    <div id="submission_create_taxonomy_form_section" class="hide">
      <div class="row">
        <%= render(partial: 'submissions/physical_object/taxonomy_create') %>
      </div>
    </div>

    <div id="submission_create_taxonomy_button_section">
      

      <div class="row form-group">
        <div id="submission_show_create_taxonomy" class="col-sm-6 col-sm-offset-3 block clickable">
          <span>
            <%= t('morphosource.submission.create_custom_taxonomy') %>
          </span>
          <i class="fas fa-plus" style="float: right; margin-top: 3px;"></i> 
        </div>
      </div>
    </div>



    <div id="submission_taxonomy_continue_section">
      <div class="row">
        <a href="#" id="submission_select_taxonomy_submit" class="btn btn-primary btn-continue" disabled>
          <%= t('morphosource.submission.continue') %>
        </a>
      </div>  
    </div>

    

  </div>
</div>

<script>
$(function(){
  $('#submission_taxonomy_search').autocomplete({
    select: function(event, ui) {
        event.preventDefault();
        $("input.taxonomy_id").val(ui.item.value);
        console.log(ui.item.value);
        $("input.taxonomy_gbif_key").val(ui.item.gbif_key);
        console.log(ui.item.gbif_key);
        $("input.taxonomy_title").val(build_name_no_formatting(ui.item.name, ui.item.rank));
        console.log(build_name_no_formatting(ui.item.name, ui.item.rank));

        $('a#btn_add_taxonomy').trigger('click');
        $("#submission_taxonomy_search").val('');
    },
    source: function (request, response) {
      $.ajax({
        url: "<%= find_taxonomy_autocomplete_url %>" + request.term,
        type: 'GET',
        dataType: 'json',
        complete: function (xhr, status) {
          var results = $.parseJSON(xhr.responseText);
          response(results);
        }
      });
    },
    autoFocus: false
  }).autocomplete('instance')._renderItem = function(ul, item) {
    // Overwrite default autocomplete list display
    return $(
      "<li><div style='border-bottom: 1px solid #D2D2D2;'>" + 
      build_name(item.name, item.rank) + 
      "<br/><span style='font-size: small;'>" + 
      item.higher_taxonomy + 
      "</span><br/>" +
      item.source_info + 
      "</div></li>"
    ).appendTo(ul);
  };

  var build_name = function(name, rank) {
    var s = "";
    if (rank) {
      if (rank == 'GENUS' || rank == 'SPECIES' || rank == 'SUBSPECIES') {
        s = s + "<i>" + name + "</i>";
      } else {
        s = s + name;
      }
      s = s + " (" + rank.toLowerCase() + ")";
    } else {
      s = s + "<i>" + name + "</i>";
    }
    return s;
  }

  var build_name_no_formatting = function(name, rank) {
    var s = name;
    if (rank) {
      s = s + " (" + rank.toLowerCase() + ")";
    }
    return s;
  }

});
</script>



