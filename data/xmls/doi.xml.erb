<doi_batch xmlns="http://www.crossref.org/schema/4.4.2" version="4.4.2">
  <head>
    <doi_batch_id><%= doi_batch_id %></doi_batch_id>
    <timestamp><%= timestamp %></timestamp>
    <depositor>
      <depositor_name>MorphoSource</depositor_name>
      <email_address>morphosource-dev-team-request@duke.edu</email_address>
    </depositor>
    <registrant>MorphoSource</registrant>
  </head>
  <body>
    <database>
      <database_metadata language="en">
        <titles>
          <title>MorphoSource Media</title>
        </titles>
        <institution>
          <institution_name>MorphoSource</institution_name>
        </institution>
      </database_metadata>
      <dataset dataset_type="record">
        <contributors>
        <% if organization && !organization.blank? %>
          <organization contributor_role="author" sequence="first"><%= organization %></organization>
        <% elsif author_first && !author_first.blank? && author_last && !author_last.blank? %>
          <person_name contributor_role="author" sequence="first">
            <given_name><%= author_first %></given_name>
            <surname><%= author_last %></surname>
          </person_name>
        <% end %>
        </contributors>
        <titles>
          <title><%= title %></title>
        </titles>
        <database_date>
          <publication_date>
            <year><%= publication_year %></year>
          </publication_date>
        </database_date>
        <format><%= resource_type %></format>
        <doi_data>
          <doi><%= doi %></doi>
          <resource><%= url %></resource>
        </doi_data>
      </dataset>
    </database>
  </body>
</doi_batch>
