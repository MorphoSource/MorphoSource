### Customize these fields for your instance (must add values for recaptcha) ###

# Postgres DB user and pass
DB_USERNAME=hydra
DB_PASSWORD=hydra

# Fedora user and pass
FCREPO_USERNAME=fedoraAdmin
FCREPO_PASSWORD=fedoraAdmin

# Initial MorphoSource user, will be granted admin access
MS_INIT_USR=admin@email.com
MS_INIT_PW=password

# Site branding settings
HOST_NAME=localhost
SITE_TITLE="3D Data Repository"

# For custom logo image, place image in public/ and label with leading slash, e.g. "/image.png"
# LOGO_IMAGE=

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

### System configuration fields, should not need to be customized ###

BLENDER_PATH=/app/blender/

BUNDLE_GEMFILE=./Gemfile

DB_HOST=postgres
DB_PORT=5432
DB_NAME=development

DCMDICTPATH=/app/dcmtk/share/dcmtk/dicom.dic

DERIVATIVES_PATH=/app/samvera/hyrax-webapp/derivatives/

FCREPO_HOST=fcrepo
FCREPO_PORT=8080
FCREPO_URL=http://fcrepo:8080/rest
FCREPO_BASE_PATH=/dev

FIJI_PATH=/app/fiji/

FITS_PATH=/app/fits/fits.sh

HYRAX_UPLOAD_PATH=/app/samvera/hyrax-webapp/uploads/

IN_DOCKER=true

MEMCACHED_HOST=memcached

RAILS_ENV=development
RAILS_LOG_TO_STDOUT=1
RAILS_ROOT=/app/samvera/hyrax-webapp/

REDIS_HOST=redis
RAILS_RESQUE_REDIS=redis:6379
RESQUE_WORKER_COUNT=1

SOLR_HOST=solr
SOLR_PORT=8983
SOLR_URL=http://solr:8983/solr/hydra-development
