function set_initial_value() {
  let selected_visibility = $('#selected_visibility').attr('class');

  set_visibility(selected_visibility);
}

function set_visibility(val) {
  let open = $('#media_visibility_open');
  let restricted_download = $('#media_visibility_restricted_download');
  let preview = $('#media_visibility_preview');
  let hidden = $('#media_visibility_hidden');

  let current_visibility_value = $('#current_visibility_value');

  switch (val) {
    case 'new':
      select_visibility(open);
      display_value = "Publish with Open Download";
      display_class = "label-success";
      break;
    case 'open':
      select_visibility(open);
      display_value = "Publish with Open Download";
      display_class = "label-success";
      break;
    case 'restricted_download':
      select_visibility(restricted_download);
      display_value = "Publish with Restricted Download";
      display_class = "label-info";
      break;
    case 'preview':
      select_visibility(preview);
      display_value = "Publish with No Download";
      display_class = "label-info";
      break;
    case 'hidden':
      select_visibility(hidden);
      display_value = "Publish with Hidden File";
      display_class = "label-info";
      break;
    default:
      display_value = "Private";
      display_class = "label-danger";
  }

  if (current_visibility_value.length) {
    current_visibility_value.text(display_value);
    current_visibility_value
      .removeClass('label-success')
      .removeClass('label-info')
      .removeClass('label-danger');
    current_visibility_value.addClass(display_class);
  }
}

function select_visibility(visibility) {
  visibility.prop("checked", true);
}

$(document).on('turbolinks:load', function() {
  if ( $('form[id*="edit_media"]').length || 
       $('form[id*="new_media"]').length ) { // if media form page (add/edit)
    set_initial_value();


    $('input[name="media[visibility]"]').change(function(event){
      console.log('Radio visibility changed');

      if ($(this).val()){
        console.log('Value provided');
        console.log($(this).val()); 
        set_visibility($(this).val());    
      }
    });
  }
});
