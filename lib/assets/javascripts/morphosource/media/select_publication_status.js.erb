function set_initial_value() {
  let selected_visibility = $('#selected_visibility').attr('class');

  set_visibility(selected_visibility);
}

function set_visibility(val) {
  let open = $('#media_visibility_open, #batch_submission_media_visibility_open').first();
  let restricted_download = $('#media_visibility_restricted_download, #batch_submission_media_visibility_restricted_download').first();
  let preview = $('#media_visibility_preview, #batch_submission_media_visibility_preview').first();
  let hidden = $('#media_visibility_hidden, #batch_submission_media_visibility_hidden').first();

  let current_visibility_value = $('#current_visibility_value');

  switch (val) {
    case 'open':
      select_visibility(open);
      display_value = "Publish with Open Download";
      display_class = "badge-success";
      break;
    case 'restricted_download':
      select_visibility(restricted_download);
      display_value = "Publish with Restricted Download";
      display_class = "badge-info";
      break;
    case 'preview':
      select_visibility(preview);
      display_value = "Publish with No Download";
      display_class = "badge-info";
      break;
    case 'hidden':
      select_visibility(hidden);
      display_value = "Publish with Hidden File";
      display_class = "badge-info";
      break;
    default:
      display_value = "Private";
      display_class = "badge-danger";
  }

  if (current_visibility_value.length) {
    current_visibility_value.text(display_value);
    current_visibility_value
      .removeClass('badge-success')
      .removeClass('badge-info')
      .removeClass('badge-danger');
    current_visibility_value.addClass(display_class);
  }
}

function select_visibility(visibility) {
  visibility.prop("checked", true);
}

$( document ).ready(function() {
  if ( $('form[id*="edit_media"]').length ||
       $('form[id*="new_media"]').length || 
       $('form[id="batch_submission_form"]').length ) { 

    if (typeof batchSubmissionForm == 'undefined' || batchSubmissionForm.previousSubmissionData == null) {
      set_initial_value();
    }    
    $('input[name="media[visibility]"], input[name="batch_submission[media][visibility]"]').change(function(event){
      console.log('Radio visibility changed');

      if ($(this).val()){
        console.log('Value provided');
        console.log($(this).val());
        set_visibility($(this).val());
      }
    });
  }
});