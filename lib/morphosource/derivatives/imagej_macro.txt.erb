run("Image Sequence...", "open=<%= @input_path %> sort");

if (bitDepth()==32) {
	run("16-bit");
} else if (bitDepth()==24) {
	run("8-bit");
}

run("Scale...", "x=<%= @linear_scale_factor %> y=<%= @linear_scale_factor %> z=<%= @linear_scale_factor %> interpolation=Bilinear average process");

run("Image Sequence... ", "format=TIFF save=<%= @output_path %>");
