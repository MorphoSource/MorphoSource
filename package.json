{
  "name": "morphosource",
  "description": "This is a simple package file to help developers periodically install or update the Universal Viewer packaged with MorphoSource. It is not part of regular install or setup processes.",
  "private": true,
  "repository": "git@github.com:MorphoSource/MorphoSource.git",
  "dependencies": {
  "universalviewer": "MorphoSource/universalviewer#webpack-al_aleph-0.0.21_dist"
},
"scripts": {
  "preinstall": "rm -rf ./public/uv/ & rm -rf ./public/uv-assets/ & rm -rf ./public/uv-dist-umd/",
  "postinstall": "yarn run uv-install && yarn run uv-subdir-copy && yarn run uv-subdir-remove && yarn run uv-config",
  "uv-install": "cp -r ./node_modules/universalviewer/dist ./public/uv",
  "uv-subdir-copy": "cp -r ./node_modules/universalviewer/dist/uv-assets ./public/uv-assets & cp -r ./node_modules/universalviewer/dist/uv-dist-umd ./public/uv-dist-umd",
  "uv-subdir-remove": "rm -rf ./public/uv/uv-assets/ & rm -rf ./public/uv/uv-dist-umd/",
  "uv-config": "cp ./config/uv/uv.html ./public/uv/uv.html & cp ./config/uv/uv-config.json ./public/uv/uv-config.json & cp ./config/uv/uv-config-front-page.json ./public/uv/uv-config-front-page.json"
  },
  "devDependencies": {}
}