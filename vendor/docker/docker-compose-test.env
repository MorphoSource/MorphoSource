### Environment variables specific to test environment ###

# FCREPO_HOST=app_test
# FCREPO_PORT=8986
# FCREPO_URL=http://app_test:8986/rest
FCREPO_BASE_PATH=/test

RAILS_ENV=test
RAILS_LOG_TO_STDOUT=0

# Blank in test so the RSpec suite stays deterministic: an organization depositor
# becomes its manager unless a spec opts in by stubbing
# Morphosource.default_organization_manager with another user's ms_id. Kept here
# even though docker-compose.env no longer sets it, so a value added there
# cannot reach app_test. NB: CI does not load this file (.gitlab-ci.yml passes
# docker-compose.env only), so docker-compose.env must stay unset as well.
DEFAULT_ORGANIZATION_MANAGER=

SOLR_HOST=solr
SOLR_PORT=8983
SOLR_URL=http://solr:8983/solr/hydra-test
