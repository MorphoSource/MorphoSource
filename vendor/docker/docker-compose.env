### Customize these fields for your instance ###

# Site settings
HOST_NAME=localhost
SITE_TITLE="3D Data Repository"

# For custom logo image, place image in public/ and label with leading slash, e.g. "/image.png"
LOGO_IMAGE=

# Number of Resque background workers
COUNT=3

### System configuration fields, should not need to be customized ###

BLENDER_PATH=

BUNDLE_GEMFILE=./Gemfile
BUNDLE_PATH=/app/samvera/hyrax-webapp/vendor/bundle
BUNDLE_WITHOUT="" # For prod deploy, change to BUNDLE_WITHOUT="development test"

DB_HOST=postgres
DB_PORT=5432

DERIVATIVES_PATH=/app/samvera/hyrax-webapp/derivatives/

FCREPO_HOST=fcrepo
FCREPO_PORT=8080
FCREPO_URL=http://fcrepo:8080/fcrepo/rest
FCREPO_BASE_PATH=/dev

FIJI_PATH=/app/fiji/

# On anything but M1 Mac, this could maybe be commented out? TODO Test
FIJI_SCRIPT_COMMAND="/app/fiji/Fiji.app/ImageJ.sh --headless -- --run"

FITS_PATH=/app/fits/fits.sh

HYRAX_UPLOAD_PATH=/app/samvera/hyrax-webapp/uploads/

IN_DOCKER=true

MEMCACHED_HOST=memcached

# Creates a null organization for objects and devices that don't have an organization
# Morphosource setup will create an OrganizationCollection with this id
# Also used for Hyrax.config.null_organization_id
NULL_ORGANIZATION_ID="000987987"

POSTGRES_DB=development
POSTGRES_HOST_AUTH_METHOD=trust

RAILS_ENV=development
RAILS_ROOT=/app/samvera/hyrax-webapp/

REDIS_HOST=redis
RAILS_RESQUE_REDIS=redis:6379

SKIP_PYMESHLAB_CHARACTERIZATION=true

SOLR_HOST=solr
SOLR_PORT=8983
SOLR_TEST_URL=http://solr:8983/solr/hyrax_test
SOLR_URL=http://solr:8983/solr/hyrax

WHITELISTED_INGEST_DIRS=/app/samvera/hyrax-webapp/

### Apache config fields, will only be used if using docker-compose-apache.yml ###

APACHE_HTTP_PORT_NUMBER=80
APACHE_HTTPS_PORT_NUMBER=443

TERM_CHILD=1
RESQUE_WORKERS="{\"default,batch_submission_ingest\":1,\"default,mass_ingest,update_fast,update_medium,update_slow\":1,\"default,update_fast,update_medium,update_slow\":1,\"heavy,default\":1}"